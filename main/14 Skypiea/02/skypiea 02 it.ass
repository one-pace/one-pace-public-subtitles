Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=24}===============================DialOGUE============================
Dialogue: 0,0:01:52.88,0:01:55.01,Main-207-,,0,0,0,,Ma com'è fatto?!
Dialogue: 0,0:01:55.01,0:01:57.50,Main-207-,,0,0,0,,{Sembra una specie di fascia,\Nè una strada di nuvole! - obi è la fascia del kimono o anche le fascette quelle di carta}Sembra una specie di nastro, \Nè una strada di nuvole!{Cora}
Dialogue: 0,0:02:03.81,0:02:07.31,Main-207-,,0,0,0,,{[/q2]Non pare proprio sia qualcosa di naturale. - nel senso che è stata sicuramente costruita}{\q2}Non sembra essere qualcosa di naturale.{Cora}
Dialogue: 0,0:02:03.81,0:02:07.31,Secondary-207-,,0,0,0,,{[/an8]Hai ragione, cara Nami, perorin~! - il perorin non so cosa dirvi onestamente}{\an8}Hai ragione, cara Nami, {\i1}mellorine{\i0}~!{Io ci sento mellorine, anche perché sennò sarebbe Perospero XD -Cora}
Dialogue: 0,0:02:07.31,0:02:09.53,Main-207-,,0,0,0,,{Ma sicuramente non è naturale\Nuna roba del genere! - cps}Quella roba di sicuro non è naturale!{Cora}
Dialogue: 0,0:02:19.48,0:02:22.30,Main-207-,,0,0,0,,{\q2}È l'uscita! \NC'è scritto qualcosa!
Dialogue: 0,0:02:22.30,0:02:23.66,Main-207-,,0,0,0,,"God Land"...
Dialogue: 0,0:02:23.66,0:02:26.12,Main-207-,,0,0,0,,il Paese di dio, Skypiea?!{G - luoghi}
Dialogue: 0,0:02:28.29,0:02:29.54,Main-207-,,0,0,0,,Non è l'uscita!
Dialogue: 0,0:02:29.54,0:02:31.29,Main-207-,,0,0,0,,È l'entrata!
Dialogue: 0,0:02:58.15,0:02:59.40,Main-207-,,0,0,0,,È un'isola!
Dialogue: 0,0:03:00.60,0:03:02.92,Main-207-,,0,0,0,,{Used as flashback in Enies Lobby 25 @13:32}È l'Isola nel Cielo!
Dialogue: 0,0:03:09.38,0:03:13.25,Main-207-,,0,0,0,,Ehi... \NIl cartello di prima diceva "Skypiea"...
Dialogue: 0,0:03:13.25,0:03:13.84,Main-207-,,0,0,0,,Sì!
Dialogue: 0,0:03:13.84,0:03:17.05,Main-207-,,0,0,0,,È lo stesso nome della\N mappa che ha trovato Luffy!
Dialogue: 0,0:03:19.64,0:03:25.19,Main-207-,,0,0,0,,{\q2}Quel galeone che stava cadendo su \Ndi noi sembra sia davvero stato qui!
Dialogue: 0,0:03:25.19,0:03:29.43,Main-207-,,0,0,0,,Duecento anni fa hanno visto questo stesso panorama!
Dialogue: 0,0:03:37.27,0:03:38.94,Main-207-,,0,0,0,,Ma che posto assurdo è questo?
Dialogue: 0,0:03:39.19,0:03:41.90,Main-207-,,0,0,0,,{\q2}Si sente già un gran profumo di avventura!{gran è per cercare di rendere quel "punpun"...}
Dialogue: 0,0:03:41.90,0:03:43.66,Main-207-,,0,0,0,,– Oplà!\N– Ah! Idiota, aspetta!
Dialogue: 0,0:03:44.19,0:03:45.50,Main-207-,,0,0,0,,{Ci sto in piedi! - nel senso che lì l'acqua non è profonda e quindi ci tocca (e suppongo che quindi non affonda)}Qui si tocca!{Cora}
Dialogue: 0,0:03:47.29,0:03:50.33,Main-207-,,0,0,0,,Ehi! Va tutto bene, Usopp?
Dialogue: 0,0:03:54.85,0:03:57.76,Main-207-,,0,0,0,,{\q2}Ma quest'isola è fatta di nuvole morbide?
Dialogue: 0,0:03:57.76,0:03:59.50,Main-207-,,0,0,0,,È proprio morbidoso!{sarebbe morbido again, ma luffy dai, ci sta}
Dialogue: 0,0:03:59.50,0:04:01.13,Main-207-,,0,0,0,,Lo è davvero!
Dialogue: 0,0:04:02.76,0:04:04.89,Main-207-,,0,0,0,,{A terra! - nel senso di sbarchiamo, ma loro son già scesi}Verso la terraferma!{Cora}
Dialogue: 0,0:04:06.49,0:04:08.00,Main-207-,,0,0,0,,L'Isola nel Cielo~!
Dialogue: 0,0:04:08.00,0:04:10.26,Main-207-,,0,0,0,,Oh! Anch'io, anch'io!
Dialogue: 0,0:04:10.26,0:04:12.35,Main-207-,,0,0,0,,Vado a cambiarmi e arrivo!
Dialogue: 0,0:04:13.13,0:04:15.84,Main-207-,,0,0,0,,Ehi, Luffy! \NChe facciamo con l'ancora?
Dialogue: 0,0:04:15.84,0:04:17.89,Main-207-,,0,0,0,,Non c'è un fondale qui, giusto?
Dialogue: 0,0:04:17.89,0:04:20.07,Main-207-,,0,0,0,,Ma chi se ne importa!
Dialogue: 0,0:04:20.82,0:04:22.35,Main-207-,,0,0,0,,Infatti, ma che importa~!
Dialogue: 0,0:04:22.35,0:04:23.33,Main-207-,,0,0,0,,Che importa~!
Dialogue: 0,0:04:23.33,0:04:24.44,Main-207-,,0,0,0,,Lascia perdere~!
Dialogue: 0,0:04:24.44,0:04:25.27,Main-207-,,0,0,0,,Lascia perdere~!
Dialogue: 0,0:04:25.27,0:04:26.24,Main-207-,,0,0,0,,Anch'io, anch'io!
Dialogue: 0,0:04:29.14,0:04:33.27,Main-207-,,0,0,0,,Veloci, venite anche voi! \NQuesta spiaggia è morbidosa!{again, morbida, ma luffy}
Dialogue: 0,0:04:33.27,0:04:35.46,Main-207-,,0,0,0,,Rotola, rotola, rotola~!
Dialogue: 0,0:04:35.46,0:04:36.95,Main-207-,,0,0,0,,Anch'io, anch'io!
Dialogue: 0,0:04:41.61,0:04:44.88,Main-207-,,0,0,0,,Comunque, questo panorama... \Nmi lascia davvero a bocca aperta.
Dialogue: 0,0:04:44.88,0:04:46.71,Main-207-,,0,0,0,,Sembra un sogno.
Dialogue: 0,0:04:46.71,0:04:48.52,Main-207-,,0,0,0,,Già, infatti.
Dialogue: 0,0:04:48.52,0:04:51.34,Main-207-,,0,0,0,,E loro sono così su di giri già da ora...
Dialogue: 0,0:04:51.88,0:04:53.89,Main-207-,,0,0,0,,Sono proprio senza speranze.
Dialogue: 0,0:04:54.27,0:04:56.43,Main-207-,,0,0,0,,Yahoo!
Dialogue: 0,0:04:57.24,0:04:59.19,Main-207-,,0,0,0,,Vale anche per te.
Dialogue: 0,0:05:00.11,0:05:02.78,Main-207-,,0,0,0,,{\q2}Ahi, ahi, ahi! \NScusa! Ho detto scusa!
Dialogue: 0,0:05:07.30,0:05:10.93,Main-207-,,0,0,0,,Ci siamo davvero portati dietro il South Bird?
Dialogue: 0,0:05:10.93,0:05:12.92,Main-207-,,0,0,0,,Mi sono dimenticata di liberarlo prima.
Dialogue: 0,0:05:12.92,0:05:17.12,Main-207-,,0,0,0,,Pare che qui ci viva della gente, \N sopravviverà comunque, no?{circa}
Dialogue: 0,0:05:17.12,0:05:19.47,Main-207-,,0,0,0,,{E, se ce la mette tutta,\Npotrebbe anche riuscire a scendere. - cps}{\q2}Se s'impegna potrebbe \Npure riuscire a scendere.{Cora}
Dialogue: 0,0:05:19.47,0:05:20.76,Main-207-,,0,0,0,,È un uccello dopotutto.
Dialogue: 0,0:05:22.20,0:05:24.51,Main-207-,,0,0,0,,{\q2}Ah, giusto! \NEhi, e l'ancora?
Dialogue: 0,0:05:25.06,0:05:26.68,Main-207-,,0,0,0,,{L'ho conficcata sotto. - ew}L'ho gettata di sotto.{Cora}
Dialogue: 0,0:05:26.68,0:05:29.72,Main-207-,,0,0,0,,{Pare che le nuvole morbide di prima\Nsiano le fondamenta di quest'isola. - cps (volendo base invece di fondamenta)}Le nuvole morbide di prima pare facciano da base per l'isola.{Cora}
Dialogue: 0,0:05:29.72,0:05:33.22,Main-207-,,0,0,0,,Se così fosse, vorrebbe dire \Nche l'isola galleggia sul mare.
Dialogue: 0,0:05:33.22,0:05:37.19,Main-207-,,0,0,0,,{[/q2]Potrebbe rimanere sempre nello stesso\Nposto senza essere trascinata dalla corrente? - cps}{\q2}Rimarrà nello stesso posto senza \Nessere trascinata dalla corrente?{Cora}
Dialogue: 0,0:05:37.19,0:05:40.65,Main-207-,,0,0,0,,{[/q2]Beh, non possiamo far altro che\Naccettare la cosa per come l'abbiamo vista! - cps}{\q2}Beh, non possiamo far altro che \Nprendere le cose per come le vediamo!{Cora}
Dialogue: 0,0:05:40.65,0:05:43.73,Main-207-,,0,0,0,,{\q2}In effetti queste sono tutte cose incredibili, ma
Dialogue: 0,0:05:43.73,0:05:47.11,Main-207-,,0,0,0,,in ogni caso ciò che è certo \Nè che l'Isola nel Cielo è qui.
Dialogue: 0,0:05:51.91,0:05:53.07,Main-207-,,0,0,0,,Visto?
Dialogue: 0,0:05:54.13,0:05:58.21,Main-207-,,0,0,0,,{Non posso dubitarne dopo\Naverlo provato sulla mia pelle! - OG}{\q2}Ora che l'ho provata sulla \Nmia pelle non ho più dubbi!{Cora}
Dialogue: 0,0:05:58.21,0:05:59.58,Main-207-,,0,0,0,,Vieni anche tu!
Dialogue: 0,0:05:59.58,0:06:01.99,Main-207-,,0,0,0,,Qui si tocca, non affonderai. Capito?
Dialogue: 0,0:06:03.93,0:06:05.13,Main-207-,,0,0,0,,E tu?
Dialogue: 0,0:06:06.60,0:06:08.26,Main-207-,,0,0,0,,Sì, arrivo.
Dialogue: 0,0:06:11.05,0:06:13.31,Main-207-,,0,0,0,,"Profumo di avventura", eh?
Dialogue: 0,0:06:14.93,0:06:17.77,Main-207-,,0,0,0,,{\q2}Non ho mai pensato che \Nnavigare e vedere nuove terre
Dialogue: 0,0:06:19.02,0:06:20.73,Main-207-,,0,0,0,,potessero essere avventure.
Dialogue: 0,0:06:26.73,0:06:31.34,Main-207-,,0,0,0,,{\q2}Sembra proprio che l'Isola nel \NCielo faccia venire sonnolenza...
Dialogue: 0,0:06:35.13,0:06:37.11,Main-207-,,0,0,0,,Ah! Qui parla il capitano!
Dialogue: 0,0:06:37.11,0:06:40.71,Main-207-,,0,0,0,,È così divertente che non so \Nda dove iniziare! Passo!{tipo walkie talkie}
Dialogue: 0,0:06:40.71,0:06:45.46,Main-207-,,0,0,0,,Qui parla Usopp! Che ne dici di \Nrilassarci qui per un po'? Passo!
Dialogue: 0,0:06:45.81,0:06:47.97,Main-207-,,0,0,0,,{\q2}"Rilassarci qui per un po'", eh? \NBello~!
Dialogue: 0,0:06:47.97,0:06:48.93,Main-207-,,0,0,0,,Bocciato!
Dialogue: 0,0:06:48.93,0:06:51.26,Main-207-,,0,0,0,,"Bocciato"?! \NMa quello vuol dire che non va bene!
Dialogue: 0,0:06:51.26,0:06:52.45,Main-207-,,0,0,0,,Oh!
Dialogue: 0,0:06:52.45,0:06:55.01,Main-207-,,0,0,0,,Qui sbocciano dei fiori \Nproprio strani, eh?
Dialogue: 0,0:06:58.53,0:07:00.33,Main-207-,,0,0,0,,Anche questi saranno palloncini?
Dialogue: 0,0:07:00.33,0:07:02.40,Main-207-,,0,0,0,,{\q2}Chissà se scoppiano come quel pesce...
Dialogue: 0,0:07:07.41,0:07:09.08,Main-207-,,0,0,0,,Che bellezza!
Dialogue: 0,0:07:09.08,0:07:13.50,Main-207-,,0,0,0,,{Qui la Marina non ci inseguirà!\NPossiamo prendercela comoda! - è un modo di dire, lett è "possiamo distendere la ali"}Qui la Marina non ci inseguirà!\NPossiamo spiegare le ali!{Non mi dispiace visto il contesto -Cora}
Dialogue: 0,0:07:16.68,0:07:19.41,Main-207-,,0,0,0,,Ehi, Chopper, guarda! \NCosa sono quelli?
Dialogue: 0,0:07:21.05,0:07:21.75,Main-207-,,0,0,0,,Ah?
Dialogue: 0,0:07:21.75,0:07:24.02,Main-207-,,0,0,0,,Woah! Ho trovato un frutto strano~!
Dialogue: 0,0:07:24.02,0:07:26.71,Main-207-,,0,0,0,,Buon appetito!
Dialogue: 0,0:07:27.70,0:07:29.64,Main-207-,,0,0,0,,Ma cos'è?!
Dialogue: 0,0:07:29.64,0:07:31.40,Main-207-,,0,0,0,,È durissimo!
Dialogue: 0,0:07:32.29,0:07:34.89,Main-207-,,0,0,0,,{\q2}Ehi, Usopp! \NTi passo questo frutto! Prendilo!
Dialogue: 0,0:07:36.60,0:07:39.50,Main-207-,,0,0,0,,Che male, bastardo! \NApposto, aspetta lì dove stai!
Dialogue: 0,0:07:40.98,0:07:42.85,Main-207-,,0,0,0,,Ah! Dolce Robin~!
Dialogue: 0,0:07:43.51,0:07:46.76,Main-207-,,0,0,0,,È un fiore dell'Isola nel Cielo! \NEccone uno per te, mia dolce Robin...
Dialogue: 0,0:07:46.76,0:07:48.47,Main-207-,,0,0,0,,E l'altro...
Dialogue: 0,0:07:49.17,0:07:50.93,Main-207-,,0,0,0,,Nami cara~!
Dialogue: 0,0:07:50.93,0:07:54.62,Main-207-,,0,0,0,,Nami cara~!\N Ho un fiore~!
Dialogue: 0,0:07:55.59,0:07:58.49,Main-207-,,0,0,0,,{\q2}Woah!\N Anche questa poltrona è fatta di nuvole!
Dialogue: 0,0:07:58.49,0:08:01.38,Main-207-,,0,0,0,,Avrannno una tecnica per \Ncreare oggetti fatti di nuvole?
Dialogue: 0,0:08:01.38,0:08:03.69,Main-207-,,0,0,0,,È diversa dalle nuvole morbide.
Dialogue: 0,0:08:03.69,0:08:05.15,Main-207-,,0,0,0,,Questa è super soffice!
Dialogue: 0,0:08:03.69,0:08:06.63,Secondary-207-,,0,0,0,,{\an8}Nami cara, ho un fiore~!
Dialogue: 0,0:08:06.63,0:08:09.59,Main-207-,,0,0,0,,{\q2}Ma come fa il mare di nuvole a bagnare?!
Dialogue: 0,0:08:09.59,0:08:11.55,Main-207-,,0,0,0,,Oh? Ah, proprio ciò che serviva.
Dialogue: 0,0:08:18.35,0:08:19.50,Main-207-,,0,0,0,,Scusa.
Dialogue: 0,0:08:21.06,0:08:24.10,Main-207-,,0,0,0,,{\q2}Eh? Ma cos'è? \NUna volpe?
Dialogue: 0,0:08:26.79,0:08:29.19,Main-207-,,0,0,0,,Ah? Cos'è questo suono?
Dialogue: 0,0:08:31.78,0:08:34.70,Main-207-,,0,0,0,,Ehi! C'è qualcuno! È laggiù!
Dialogue: 0,0:08:35.45,0:08:37.78,Main-207-,,0,0,0,,{Che sia... di nuovo quel gorilla?! - OG}Che sia... \Nun'altro attacco di guerriglia?!{Occhio che è ゲリラ (gerira) e non ゴリラ (gorira) XD -Cora}
Dialogue: 0,0:08:37.78,0:08:41.04,Main-207-,,0,0,0,,Il fischietto... Dov'è il fischietto? \NChiamiamo di nuovo aiuto!
Dialogue: 0,0:08:41.04,0:08:44.79,Main-207-,,0,0,0,,{\q2}No, aspettate, vi sbagliate. \NQuello è...
Dialogue: 0,0:08:45.14,0:08:46.63,Main-207-,,0,0,0,,un angelo!
Dialogue: 0,0:08:48.00,0:08:49.30,Main-207-,,0,0,0,,"Un angelo"?
Dialogue: 0,0:08:54.75,0:08:56.05,Main-207-,,0,0,0,,{\i1}Heso!{\i0}{G - varie}
Dialogue: 0,0:08:57.00,0:08:58.10,Main-207-,,0,0,0,,– "{\i1}Heso{\i0}"!\N– "{\i1}Heso{\i0}"?
Dialogue: 0,0:08:58.10,0:08:59.76,Main-207-,,0,0,0,,Suu, vieni!{G - personaggi}
Dialogue: 0,0:09:02.33,0:09:04.10,Main-207-,,0,0,0,,Venite dal Mare Blu?
Dialogue: 0,0:09:04.10,0:09:06.26,Main-207-,,0,0,0,,Sì, siamo volati quassù da sotto.
Dialogue: 0,0:09:06.26,0:09:08.34,Main-207-,,0,0,0,,Tu... sei di qui?
Dialogue: 0,0:09:08.34,0:09:10.36,Main-207-,,0,0,0,,Sì, io vivo qui.
Dialogue: 0,0:09:12.69,0:09:15.35,Main-207-,,0,0,0,,Benvenuti alla Angel Beach di Skypiea.
Dialogue: 0,0:09:16.28,0:09:18.07,Main-207-,,0,0,0,,Quello... vuoi berlo?
Dialogue: 0,0:09:18.07,0:09:20.20,Main-207-,,0,0,0,,Eh? S-Sì...
Dialogue: 0,0:09:21.32,0:09:25.84,Main-207-,,0,0,0,,{\q2}Nella parte sopra la buccia del conash è \Ndura come il ferro, quindi non va morsa.{G - varie}
Dialogue: 0,0:09:25.84,0:09:27.82,Main-207-,,0,0,0,,Da dietro, invece...
Dialogue: 0,0:09:31.25,0:09:32.68,Main-207-,,0,0,0,,Ecco a te.
Dialogue: 0,0:09:36.49,0:09:38.85,Main-207-,,0,0,0,,Che buonooo~!
Dialogue: 0,0:09:38.85,0:09:40.47,Main-207-,,0,0,0,,{\q2}Cosa?! \NÈ così buono?!
Dialogue: 0,0:09:40.47,0:09:41.95,Main-207-,,0,0,5,,Anch'io, anch'io!
Dialogue: 0,0:09:42.74,0:09:45.83,Main-207-,,0,0,5,,Che buonooo~!
Dialogue: 0,0:09:45.83,0:09:47.40,Main-207-,,0,0,5,,Io sono Conis.{G - personaggi}
Dialogue: 0,0:09:47.40,0:09:50.11,Main-207-,,0,0,5,,{\q2}E questa è una volpe delle nuvole, si chiama Suu.{deve starci in una riga}
Dialogue: 0,0:09:50.11,0:09:52.94,Main-207-,,0,0,0,,{Se avete bisogno di aiuto,\Nlasciate che vi aiuti. - OG}Se avete bisogno di aiuto, saremo lieti di aiutarvi.{Cora}
Dialogue: 0,0:09:52.94,0:09:54.92,Main-207-,,0,0,0,,Sì, ecco...
Dialogue: 0,0:09:54.92,0:09:56.66,Main-207-,,0,0,0,,{[/q2]Il tuo sguardo brucia nel mio cuore e... - cps}{\q2}I tuoi occhi ardono il mio cuore e...{Cora}
Dialogue: 0,0:09:56.66,0:09:59.10,Main-207-,,0,0,0,,Ahia!
Dialogue: 0,0:09:58.06,0:09:59.10,Secondary-207-,,0,0,0,,Sei in mezzo!
Dialogue: 0,0:09:59.86,0:10:02.09,Main-207-,,0,0,0,,{\q2}Ci sono un sacco di cose che vorrei sapere!
Dialogue: 0,0:10:02.09,0:10:05.79,Main-207-,,0,0,0,,Dopotutto, questo è un posto \Npieno di cose misteriose per noi.
Dialogue: 0,0:10:06.12,0:10:08.37,Main-207-,,0,0,0,,Certo! \NChiedimi tutto quello che vuoi!
Dialogue: 0,0:10:08.37,0:10:10.92,Main-207-,,0,0,0,,Ehi! Sta arrivando qualcosa!
Dialogue: 0,0:10:10.92,0:10:12.50,Main-207-,,0,0,0,,Ah, è mio padre!
Dialogue: 0,0:10:12.50,0:10:14.72,Main-207-,,0,0,0,,{Signora Conis, heso! - ew, ma la chiama san}Signorina Conis, {\i1}heso{\i0}!{Cora}
Dialogue: 0,0:10:14.72,0:10:17.08,Main-207-,,0,0,0,,Sì, {\i1}heso{\i0}, padre!
Dialogue: 0,0:10:17.08,0:10:19.34,Main-207-,,0,0,0,,Ma voi che state dicendo?
Dialogue: 0,0:10:19.34,0:10:22.97,Main-207-,,0,0,0,,Ah... Cos'è quel veicolo?
Dialogue: 0,0:10:22.97,0:10:25.22,Main-207-,,0,0,0,,Ah, intendi il Waver?
Dialogue: 0,0:10:25.22,0:10:27.98,Main-207-,,0,0,0,,Oh! Quella cosa sembra una figata!
Dialogue: 0,0:10:28.74,0:10:30.06,Main-207-,,0,0,0,,Waver...
Dialogue: 0,0:10:30.39,0:10:33.82,Main-207-,,0,0,0,,Sì, scusate, ora mi fermo!
Dialogue: 0,0:10:40.79,0:10:43.74,Main-207-,,0,0,0,,Signori e signore, siete feriti?
Dialogue: 0,0:10:43.74,0:10:45.70,Main-207-,,0,0,0,,E tu scusa?!
Dialogue: 0,0:10:46.06,0:10:49.95,Main-207-,,0,0,0,,{\q2}Ehi, Luffy! Non avevi trovato una \Ncosa simile sul fondale marino?
Dialogue: 0,0:10:49.95,0:10:51.38,Main-207-,,0,0,0,,Sì, è vero.
Dialogue: 0,0:10:53.14,0:10:55.34,Main-207-,,0,0,0,,{Quindi è quello di cui abbiamo\Nletto nel diario di Noland. - cps grave}Allora è quello del diario di Noland.{Cora}
Dialogue: 0,0:10:55.81,0:10:58.03,Main-207-,,0,0,0,,{\q2}La barca che può muoversi senza vento...
Dialogue: 0,0:10:58.98,0:11:01.34,Main-207-,,0,0,0,,Sono tuoi amici, signorina Conis?
Dialogue: 0,0:11:01.69,0:11:03.82,Main-207-,,0,0,0,,Sì, li ho appena conosciuti.
Dialogue: 0,0:11:03.82,0:11:05.49,Main-207-,,0,0,0,,Pare vengano dal Mare Blu.
Dialogue: 0,0:11:05.49,0:11:09.31,Main-207-,,0,0,0,,Capisco. Allora saranno sicuramente confusi da un sacco di cose, vero?
Dialogue: 0,0:11:09.31,0:11:11.40,Main-207-,,0,0,0,,{\q2}Scusate, questo è il Mare Bianco Bianco.{scusa/scusate è un po' il suo intercalare}
Dialogue: 0,0:11:11.40,0:11:12.98,Main-207-,,0,0,0,,Ah, no, si figuri...
Dialogue: 0,0:11:12.98,0:11:16.81,Main-207-,,0,0,0,,{Perdonate il ritardo,\Nil mio nome è Pagaya, scusate. - G - personaggi}{\q2}Scusate, non mi sono ancora \Npresentato, mi chiamo Pagaya.{Cora}
Dialogue: 0,0:11:16.81,0:11:18.57,Main-207-,,0,0,0,,{Ah, no, no, no, vale anche per noi. - OG}Ah, no, no, no, scusa noi piuttosto.{Cora}
Dialogue: 0,0:11:18.96,0:11:21.35,Main-207-,,0,0,0,,Padre, hai preso dei pesci?
Dialogue: 0,0:11:21.35,0:11:23.32,Main-207-,,0,0,0,,Sì, in grande quantità.
Dialogue: 0,0:11:23.71,0:11:27.06,Main-207-,,0,0,0,,{\q2}Giusto! \NVolete venire a casa nostra?
Dialogue: 0,0:11:27.06,0:11:29.33,Main-207-,,0,0,0,,Lasciate che vi offra dei frutti del cielo.
Dialogue: 0,0:11:29.33,0:11:31.57,Main-207-,,0,0,0,,Davvero possiamo?! \NAndiamo, andiamo!
Dialogue: 0,0:11:31.57,0:11:33.29,Main-207-,,0,0,0,,La cucina dell'Isola nel Cielo, eh?
Dialogue: 0,0:11:33.29,0:11:35.96,Main-207-,,0,0,0,,Lascia che ti aiuti!
Dialogue: 0,0:11:36.65,0:11:38.80,Main-207-,,0,0,0,,Ma prima, posso chiedervi una cosa?
Dialogue: 0,0:11:38.80,0:11:43.18,Main-207-,,0,0,0,,{\q2}Questo... \Nnon ha una vela e neanche dei remi...
Dialogue: 0,0:11:43.69,0:11:45.85,Main-207-,,0,0,0,,Come fa a muoversi in mare?
Dialogue: 0,0:11:46.47,0:11:49.72,Main-207-,,0,0,0,,Ah, ma non conoscete i Dial?
Dialogue: 0,0:11:49.72,0:11:51.31,Main-207-,,0,0,0,,"Dial"?
Dialogue: 0,0:11:57.22,0:12:00.69,Main-207-,,0,0,0,,C-C-C-Cos'è 'sto tremolio?! \NNon riesco a fermarmi!
Dialogue: 0,0:12:03.88,0:12:06.36,Main-207-,,0,0,0,,{\q2}Ah, oh no! \NChe sia rimasto ferito?!
Dialogue: 0,0:12:06.36,0:12:09.96,Main-207-,,0,0,0,,Che disastro! \NScusate per avergli prestato il Waver!
Dialogue: 0,0:12:10.60,0:12:13.88,Main-207-,,0,0,0,,{Pensandoci, che succede ai\Npossessori dei poteri in questo mare? - ...fa sempre schifo... è che non lo dicono frutto del diavolo qua}Ora che ci penso, come funziona qui per chi ha i poteri come lui?{Cora}
Dialogue: 0,0:12:13.88,0:12:17.03,Main-207-,,0,0,0,,{\q2}In effetti... qui è diverso dal mare normale...
Dialogue: 0,0:12:17.03,0:12:19.38,Main-207-,,0,0,0,,Potrebbe galleggiare.
Dialogue: 0,0:12:22.49,0:12:23.20,Main-207-,,0,0,0,,È affondato.
Dialogue: 0,0:12:23.20,0:12:24.66,Main-207-,,0,0,0,,{Non c'è verso, eh? - era la cosa che rendeva meglio}Era scontato, eh?{Cora}
Dialogue: 0,0:12:24.66,0:12:27.30,Main-207-,,0,0,0,,Wah! Che guaio!
Dialogue: 0,0:12:27.30,0:12:31.27,Main-207-,,0,0,0,,{L'ha rischiata, sai?! Era sul\Npunto di precipitare di sotto! - OG}L'ha rischiata grossa, sai?! \NStava per precipitare di sotto!{Cora}
Dialogue: 0,0:12:31.27,0:12:34.77,Main-207-,,0,0,0,,{Ma è colpa delle cavolate che hai\Nsparato che sono partito in ritardo! - OG}Ti sei messo a sparare le tue \Ncavolate e sono partito in ritardo!{Cora}
Dialogue: 0,0:12:34.77,0:12:37.61,Main-207-,,0,0,0,,{\q2}Che cavolo... \NMa perché sei saltato dentro anche tu?
Dialogue: 0,0:12:37.61,0:12:39.94,Main-207-,,0,0,0,,{JT, updated to match Usopp from Sky 01 at 7:22}L'Isola nel Cielo fa paura, \Nl'Isola nel Cielo fa paura...
Dialogue: 0,0:12:40.44,0:12:43.75,Main-207-,,0,0,0,,Scusate, non avrei dovuto \Nprestarlo ad un principiante.
Dialogue: 0,0:12:43.75,0:12:49.32,Main-207-,,0,0,0,,{\q2}Lo scafo del Waver è talmente leggero che anche \Nla più piccola onda può influenzarne la rotta.
Dialogue: 0,0:12:49.32,0:12:53.54,Main-207-,,0,0,0,,{\q2}Se non si conosce molto bene il mare, \Nè difficile da utilizzare, scusate.
Dialogue: 0,0:12:54.08,0:12:56.79,Main-207-,,0,0,0,,{\q2}Anch'io ho imparato solo di recente a guidarlo.
Dialogue: 0,0:12:56.79,0:12:58.93,Main-207-,,0,0,0,,È così difficile?
Dialogue: 0,0:12:58.93,0:13:01.75,Main-207-,,0,0,0,,Beh, con un po' di allenamento, \Nservono almeno dieci anni.
Dialogue: 0,0:13:01.75,0:13:03.30,Main-207-,,0,0,0,,Che fatica!
Dialogue: 0,0:13:03.71,0:13:05.30,Main-207-,,0,0,0,,Ma lei lo sta guidando!
Dialogue: 0,0:13:05.30,0:13:06.51,Main-207-,,0,0,0,,Stupendo!{sarebbe "il migliore"}
Dialogue: 0,0:13:06.51,0:13:10.03,Main-207-,,0,0,0,,Cara Nami! Sei tu ad essere stupenda!{again, la migliore}
Dialogue: 0,0:13:10.03,0:13:13.03,Main-207-,,0,0,0,,Pazzesco! È incredibile! \NNon riesco a crederci!
Dialogue: 0,0:13:13.03,0:13:15.35,Main-207-,,0,0,0,,{\q2}Ma come fa a guidare quel coso?!{circa}
Dialogue: 0,0:13:15.35,0:13:17.69,Main-207-,,0,0,0,,In effetti serve un po' di pratica!
Dialogue: 0,0:13:18.07,0:13:21.40,Main-207-,,0,0,0,,È troppo delicato per te, Luffy!
Dialogue: 0,0:13:22.99,0:13:24.24,Main-207-,,0,0,0,,Ehi, Nami!
Dialogue: 0,0:13:24.24,0:13:26.85,Main-207-,,0,0,0,,Andiamo a casa del vecchio, \Nscendi subito, sbrigati!
Dialogue: 0,0:13:26.85,0:13:27.99,Main-207-,,0,0,0,,Cretina!
Dialogue: 0,0:13:27.99,0:13:29.36,Main-207-,,0,0,0,,Non prendertela con  lei!
Dialogue: 0,0:13:29.36,0:13:31.94,Main-207-,,0,0,0,,Cretina!
Dialogue: 0,0:13:30.60,0:13:31.94,Secondary-207-,,0,0,0,,Andate avanti per primi!
Dialogue: 0,0:13:31.94,0:13:34.76,Main-207-,,0,0,0,,{\q2}Signore, posso giocarci un altro po', vero?
Dialogue: 0,0:13:34.76,0:13:36.96,Main-207-,,0,0,0,,Sì! Sta' attenta però!
Dialogue: 0,0:13:37.67,0:13:42.10,Main-207-,,0,0,0,,{[/q2]Il fatto che una nave che può muoversi così\Nliberamente senza vento esista è come un sogno! - non bellissima}{\q2}Esiste una barca in grado di muoversi \Nliberamente senza vento, sembra un sogno!{Cora}
Dialogue: 0,0:13:42.10,0:13:45.38,Main-207-,,0,0,0,,Chissà se lo si può usare\N anche nel mare normale!
Dialogue: 0,0:13:45.88,0:13:49.02,Main-207-,,0,0,0,,Ehi! È un cantiere quello?
Dialogue: 0,0:13:51.28,0:13:53.60,Main-207-,,0,0,0,,Sì, è la taglieria di nuvole.{...di suo è tipo un nome come 作業場 (sagyouba) che vuol dire fabbrica/ufficina, ma l'ha costruito Oda usando il kanji di nuvola, il kanji di tagliare e 場 che indica il luogo in cui. quello che ho messo è la roba migliore che mi venisse in mente. also G - luoghi}
Dialogue: 0,0:13:54.62,0:13:57.96,Main-207-,,0,0,0,,È dove vengono tagliate le nuvole \Nche poi verranno lavorate.
Dialogue: 0,0:13:57.96,0:14:00.56,Main-207-,,0,0,0,,Ma le nuvole si possono tagliare?
Dialogue: 0,0:14:00.56,0:14:04.66,Main-207-,,0,0,0,,Per arrivare al Mare Bianco Bianco \Nsiete passati per la Milky Road, no?{G - luoghi}
Dialogue: 0,0:14:04.66,0:14:08.25,Main-207-,,0,0,0,,"Milky Road"? Intendi quella rotta \Nmarittima piena di curve?
Dialogue: 0,0:14:08.25,0:14:10.78,Main-207-,,0,0,0,,Quello è un canale artificiale
Dialogue: 0,0:14:10.80,0:14:13.54,Main-207-,,0,0,0,,costruito con le nuvole tagliate lì.
Dialogue: 0,0:14:13.96,0:14:16.82,Main-207-,,0,0,0,,{\q2}Esistono due tipologie di nuvole naturali.
Dialogue: 0,0:14:16.82,0:14:19.95,Main-207-,,0,0,0,,Quelle su cui avete navigato con \Nla nave sono le nuvole marine.{G - varie}
Dialogue: 0,0:14:19.95,0:14:25.55,Main-207-,,0,0,0,,{\q2}Mentre le nuvole soffici su cui si \Npuò camminare sono le nuvole isola.{G - varie}
Dialogue: 0,0:14:26.26,0:14:29.17,Main-207-,,0,0,0,,{\q2}In ogni caso, \Nnon sono normali, giusto?
Dialogue: 0,0:14:29.17,0:14:33.80,Main-207-,,0,0,0,,Giusto. I nuclei di condensazione \Nche le creano sono diversi dagli altri.{penso si intenda rispetto alle nuvole "del cielo" (aka non di skypiea)}
Dialogue: 0,0:14:34.44,0:14:38.67,Main-207-,,0,0,0,,Pare che nel Mare Blu esista un\N minerale detto Pietra Marina...
Dialogue: 0,0:14:38.67,0:14:41.73,Main-207-,,0,0,0,,"Pietra Marina"? \NC'entra qualcosa?
Dialogue: 0,0:14:41.73,0:14:42.52,Main-207-,,0,0,0,,Sì.
Dialogue: 0,0:14:42.52,0:14:46.67,Main-207-,,0,0,0,,{Le sostanze cornee dette\Npyrobloin contenute al suo interno - G - varie}La sostanza cornea detta \Npyrobloina contenuta al suo interno{la italianizzerei -Cora}
Dialogue: 0,0:14:46.67,0:14:50.38,Main-207-,,0,0,0,,{\q2}viene trasportata in cielo grazie ai vulcani e,\N in contatto con l'umidità,
Dialogue: 0,0:14:50.38,0:14:55.45,Main-207-,,0,0,0,,{\q2}si trasforma in nuvole marine o nuvole \Nisola in base alla differenza di densità.
Dialogue: 0,0:14:55.97,0:14:58.12,Main-207-,,0,0,0,,Ah, capisco. Quello.{<io in questo momento}
Dialogue: 0,0:14:58.12,0:15:01.41,Main-207-,,0,0,0,,Ah, giusto! Esatto, esatto! \NÈ proprio quello!
Dialogue: 0,0:15:01.41,0:15:04.44,Main-207-,,0,0,0,,Ci giocavo spesso da bambino \Ncon le sostanze cornee.
Dialogue: 0,0:15:04.44,0:15:06.13,Main-207-,,0,0,0,,Non sono giocattoli!
Dialogue: 0,0:15:06.44,0:15:08.96,Main-207-,,0,0,0,,Beh, in ogni caso, \Nle nuvole qui sono di tre tipi:
Dialogue: 0,0:15:08.96,0:15:11.17,Main-207-,,0,0,0,,nuvole marine, nuvole isola e in più
Dialogue: 0,0:15:11.17,0:15:15.64,Main-207-,,0,0,0,,{\q2}quelle create lavorando le nuvole isola.
Dialogue: 0,0:15:16.05,0:15:18.00,Main-207-,,0,0,0,,Bene, prego, da questa parte.
Dialogue: 0,0:15:18.00,0:15:20.34,Main-207-,,0,0,0,,Che bella vista!
Dialogue: 0,0:15:20.34,0:15:23.31,Main-207-,,0,0,0,,Ah! Si vede anche Nami sul Waver!
Dialogue: 0,0:15:23.31,0:15:25.82,Main-207-,,0,0,0,,Ehi, Luffy! Che fai?
Dialogue: 0,0:15:25.82,0:15:29.75,Main-207-,,0,0,0,,Ma guardala... \NCome fa ad andare così liscia?
Dialogue: 0,0:15:29.75,0:15:30.39,Main-207-,,0,0,0,,Affonda!
Dialogue: 0,0:15:30.39,0:15:31.49,Main-207-,,0,0,0,,Ma sei un bamboccio?!
Dialogue: 0,0:15:32.15,0:15:34.92,Main-207-,,0,0,0,,Ahia! Mi hai fatto \Nmordere la lingua, Sanji!
Dialogue: 0,0:15:34.92,0:15:37.34,Main-207-,,0,0,0,,{\q2}Oh, scusi signore! \NDov'è la cucina?
Dialogue: 0,0:15:37.34,0:15:39.87,Main-207-,,0,0,0,,Prego, da questa parte.
Dialogue: 0,0:15:44.73,0:15:45.88,Main-207-,,0,0,0,,Che succede?
Dialogue: 0,0:15:47.43,0:15:51.42,Main-207-,,0,0,0,,{\q2}No, ecco, mi sembrava un po' insolita, \Nquindi ho provato a leccarne un po'...
Dialogue: 0,0:15:51.42,0:15:56.96,Main-207-,,0,0,0,,{\q2}Come dire... Ha un sapore piuttosto \Nintenso questa salsa azzurra.{sorairo = colore del cielo (aka azzurro)}
Dialogue: 0,0:15:56.96,0:15:58.30,Main-207-,,0,0,0,,Non mi sento più la lingua...
Dialogue: 0,0:15:58.30,0:15:58.95,Main-207-,,0,0,0,,Ah–
Dialogue: 0,0:16:00.41,0:16:02.04,Main-207-,,0,0,0,,Scusami, è marcia.
Dialogue: 0,0:16:02.04,0:16:04.61,Main-207-,,0,0,0,,Ma non tenerla da parte allora!
Dialogue: 0,0:16:04.61,0:16:07.74,Secondary-207-,,0,0,0,,{\an8}Ho davvero leccato quello schifo!
Dialogue: 0,0:16:05.61,0:16:07.73,Main-207-,,0,0,0,,Sembrano proprio vivaci di là!
Dialogue: 0,0:16:07.73,0:16:11.18,Secondary-207-,,0,0,0,,{\an8}{\q2}Ma accorgiti che sta andando a male, no?
Dialogue: 0,0:16:07.74,0:16:11.18,Main-207-,,0,0,0,,Sarà contento perché gli \Ningredienti del cielo sono isoliti, no?
Dialogue: 0,0:16:12.69,0:16:14.41,Main-207-,,0,0,0,,Perdoni la mia fretta, signorina...
Dialogue: 0,0:16:15.24,0:16:18.82,Main-207-,,0,0,0,,ma potresti spiegarci qualcosa \Nsui Dial che hai nominato prima?
Dialogue: 0,0:16:18.82,0:16:23.42,Main-207-,,0,0,0,,Sì! Vediamo... Come potrei spiegarvi?{io davvero le regole del timing non le capisco. Il sì lo terrei diviso io, ma pacis}
Dialogue: 0,0:16:25.54,0:16:29.30,Main-207-,,0,0,0,,Ah~ Un divano super soffice!
Dialogue: 0,0:16:29.30,0:16:32.97,Main-207-,,0,0,0,,Eh? Cos'è questa? \NUna conchiglia?
Dialogue: 0,0:16:32.97,0:16:36.93,Main-207-,,0,0,0,,Sì! Prova a dire qualcosa \Ntenendola vicina.
Dialogue: 0,0:16:36.93,0:16:39.56,Main-207-,,0,0,0,,Usopp, sei un cretino!
Dialogue: 0,0:16:38.59,0:16:39.56,Secondary-207-,,0,0,0,,Ma perché~?!
Dialogue: 0,0:16:39.56,0:16:40.56,Main-207-,,0,0,0,,Perché? Perché?
Dialogue: 0,0:16:42.34,0:16:45.19,Main-207-,,0,0,0,,{\q2}Ora prova a premere l'umbone della conchiglia.
Dialogue: 0,0:16:46.05,0:16:47.48,Main-207-,,0,0,0,,Che sarebbe "l'umbone"?{<me}
Dialogue: 0,0:16:47.49,0:16:49.41,Main-207-,,0,0,0,,La cima della conchiglia, no?!
Dialogue: 0,0:16:49.41,0:16:51.11,Main-207-,,0,0,0,,{\i1}Usopp, sei un cretino!{\i0}
Dialogue: 0,0:16:51.11,0:16:53.48,Main-207-,,0,0,0,,{\an8\i1}Ma perché~? Perché? Perché?{\i0}
Dialogue: 0,0:16:51.11,0:16:53.90,Main-207-,,0,0,0,,Ah! La conchiglia sta \Nprendendo in giro Usopp!
Dialogue: 0,0:16:53.90,0:16:55.72,Main-207-,,0,0,0,,No, è la tua voce!
Dialogue: 0,0:16:54.68,0:16:57.07,Main-207-,,0,0,0,,{\q2\an8\i1}Ora prova a premere l'umbone della conchiglia.{\i0}
Dialogue: 0,0:16:57.47,0:17:01.36,Main-207-,,0,0,0,,{\q2}Eeh, incredibile.\N Ha registrato i suoni?
Dialogue: 0,0:17:01.36,0:17:03.04,Main-207-,,0,0,0,,Quella conchiglia è un Dial?
Dialogue: 0,0:17:03.04,0:17:06.13,Main-207-,,0,0,0,,Sì. Questo è un Tone Dial.{G - oggetti}
Dialogue: 0,0:17:06.13,0:17:11.21,Main-207-,,0,0,0,,{\q2}È una conchiglia del Mare Bianco Bianco\Ncon la capacità di registrare i suoni.
Dialogue: 0,0:17:11.21,0:17:14.56,Main-207-,,0,0,0,,{\q2}Però... il mare qui non ha un fondale, giusto?
Dialogue: 0,0:17:14.56,0:17:16.92,Main-207-,,0,0,0,,Dove vivono le conchiglie?
Dialogue: 0,0:17:16.92,0:17:18.93,Main-207-,,0,0,0,,{\q2}Sulle scogliere in acque poco profonde.
Dialogue: 0,0:17:19.39,0:17:22.94,Main-207-,,0,0,0,,Però non penso che basti \Nper far muovere quel Waver.
Dialogue: 0,0:17:23.46,0:17:26.42,Main-207-,,0,0,0,,Esatto. Il motore del Waver è questo.
Dialogue: 0,0:17:26.42,0:17:28.48,Main-207-,,0,0,0,,Questo è un po' piccolo, ma
Dialogue: 0,0:17:28.48,0:17:31.11,Main-207-,,0,0,0,,il principio è lo stesso del Tone Dial.
Dialogue: 0,0:17:35.85,0:17:37.94,Main-207-,,0,0,0,,Quello fa uscire del vento, eh?
Dialogue: 0,0:17:37.94,0:17:39.28,Main-207-,,0,0,0,,Prestamelo!
Dialogue: 0,0:17:40.15,0:17:41.95,Main-207-,,0,0,0,,Questo è un Breath Dial.{G - oggetti}
Dialogue: 0,0:17:41.95,0:17:45.45,Main-207-,,0,0,0,,Accumula il vento e poi lo si \Npuò rilasciare a piacimento.
Dialogue: 0,0:17:49.32,0:17:52.30,Main-207-,,0,0,0,,{\q2}La capacità varia in base alle dimensioni, ma
Dialogue: 0,0:17:52.30,0:17:56.07,Main-207-,,0,0,0,,montandolo a poppa, è possibile \Nmuovere barche di piccola taglia.
Dialogue: 0,0:17:56.61,0:17:58.39,Main-207-,,0,0,0,,Proprio come un Waver...{di suo è tipo "quindi è quello che è un waver"}
Dialogue: 0,0:17:59.19,0:18:03.81,Main-207-,,0,0,0,,Capisco! \NQuindi si muove rilasciando del vento!
Dialogue: 0,0:18:03.81,0:18:05.56,Main-207-,,0,0,0,,Che invidia voglio un Waver...{giusto per il tono imo}
Dialogue: 0,0:18:06.84,0:18:11.69,Main-207-,,0,0,0,,In realtà ne esistono di molti tipi. \NCome il tipo skate e il tipo board.
Dialogue: 0,0:18:11.69,0:18:14.57,Main-207-,,0,0,0,,Ma per me è già abbastanza \Nimpegnativo pilotare il Waver.
Dialogue: 0,0:18:15.10,0:18:16.61,Main-207-,,0,0,0,,Voglio salirci~!
Dialogue: 0,0:18:16.61,0:18:18.04,Main-207-,,0,0,0,,Che fortunata che ha!
Dialogue: 0,0:18:18.04,0:18:20.81,Main-207-,,0,0,0,,Ne abbiamo pure uno...
Dialogue: 0,0:18:20.81,0:18:22.74,Main-207-,,0,0,0,,Avete un Waver?
Dialogue: 0,0:18:22.74,0:18:27.08,Main-207-,,0,0,0,,{\q2}Sì! Per pura coincidenza! \NNe abbiamo trovato uno messo male!
Dialogue: 0,0:18:27.08,0:18:30.97,Main-207-,,0,0,0,,Tanto per iniziare, ha duecento anni, \Nè impossibile che funzioni ancora!
Dialogue: 0,0:18:30.97,0:18:33.00,Main-207-,,0,0,0,,Quello non è detto.
Dialogue: 0,0:18:33.68,0:18:36.81,Main-207-,,0,0,0,,{\q2}I Dial usano i resti dei molluschi, perciò
Dialogue: 0,0:18:36.81,0:18:40.90,Main-207-,,0,0,0,,finché il guscio non si rompe, \Nfunzionerà praticamente per sempre.
Dialogue: 0,0:18:40.90,0:18:41.93,Main-207-,,0,0,0,,Ecco, visto?!
Dialogue: 0,0:18:41.93,0:18:43.37,Main-207-,,0,0,0,,Tanto non sai guidarlo, no?
Dialogue: 0,0:18:43.37,0:18:45.05,Main-207-,,0,0,0,,Che invidia...{sempre perché rende meglio il tono}
Dialogue: 0,0:18:45.05,0:18:47.67,Main-207-,,0,0,0,,Pare ci siano anche altre tipologie.
Dialogue: 0,0:18:47.67,0:18:48.73,Main-207-,,0,0,0,,Anche questo ne è uno?
Dialogue: 0,0:18:48.73,0:18:51.19,Main-207-,,0,0,0,,Sì. È un Lamp Dial.{G - oggetti}
Dialogue: 0,0:18:52.06,0:18:54.27,Main-207-,,0,0,0,,Wah! La conchiglia si è illuminata!
Dialogue: 0,0:18:55.03,0:18:58.24,Main-207-,,0,0,0,,C'è anche il Flame Dial\N che immagazzina il fuoco.{G - oggetti}
Dialogue: 0,0:18:58.84,0:19:01.20,Main-207-,,0,0,0,,Il Flavor Dial che mantiene i sapori.{G -. oggetti}
Dialogue: 0,0:19:01.20,0:19:04.54,Main-207-,,0,0,0,,Il Vision Dial che registra i video. \NCe ne sono davvero di tanti tipi!{di Dial intende}
Dialogue: 0,0:19:05.16,0:19:09.18,Main-207-,,0,0,0,,Che bello! Che bello!
Dialogue: 0,0:19:09.18,0:19:13.03,Main-207-,,0,0,0,,Sono strumenti di cui non possiamo \Nfare a meno nella vita in cielo.
Dialogue: 0,0:19:13.03,0:19:13.84,Main-207-,,0,0,0,,Capisco.
Dialogue: 0,0:19:13.84,0:19:16.28,Main-207-,,0,0,0,,Per questo, si può dire che la cultura dell'isola...
Dialogue: 0,0:19:17.88,0:19:20.60,Main-207-,,0,0,0,,{dell'Isola nel Cielo sia strettamente\Nlegata all'energia dei Dial. - cps}sia legata a doppio filo con l'energia dei Dial.{Cora}
Dialogue: 0,0:19:30.44,0:19:32.52,Main-207-,,0,0,0,,Bene, è pronto!
Dialogue: 0,0:19:32.52,0:19:36.90,Main-207-,,0,0,0,,{Un menù con frutta tipica e frutti\Ndel mare del cielo dell'Isola del Cielo. - ew. li chiama "sky seafood" cmq}{\q2}Un menù con frutti di mare \Ndell'Isola nel Cielo e contorno di frutta.{Cora}
Dialogue: 0,0:19:36.90,0:19:38.08,Main-207-,,0,0,0,,Sembra buonissimo!
Dialogue: 0,0:19:38.08,0:19:39.61,Main-207-,,0,0,0,,Che figata!
Dialogue: 0,0:19:42.70,0:19:44.64,Main-207-,,0,0,0,,Che bontà!
Dialogue: 0,0:19:44.64,0:19:47.66,Main-207-,,0,0,0,,{\q2}Questo gambero... \Ncome posso descriverlo?
Dialogue: 0,0:19:53.43,0:19:55.92,Main-207-,,0,0,0,,Ehi! Dov'è andata Nami?
Dialogue: 0,0:19:56.45,0:19:58.15,Main-207-,,0,0,0,,È lì, no? Nel mare.
Dialogue: 0,0:19:58.15,0:19:59.27,Main-207-,,0,0,0,,No, non c'è.
Dialogue: 0,0:19:59.27,0:20:02.47,Main-207-,,0,0,0,,Allora sarà andata a farsi un giretto, \Nlasciala perdere!
Dialogue: 0,0:20:04.81,0:20:07.38,Main-207-,,0,0,0,,Padre... andrà tutto bene?
Dialogue: 0,0:20:07.38,0:20:10.98,Main-207-,,0,0,0,,Non lo so, signorina Conis... \NAnch'io ho un brutto presentimento.
Dialogue: 0,0:20:11.70,0:20:12.98,Main-207-,,0,0,0,,Cosa? Che c'è?
Dialogue: 0,0:20:13.88,0:20:15.06,Main-207-,,0,0,0,,Qui a Skypiea
Dialogue: 0,0:20:15.06,0:20:19.53,Main-207-,,0,0,0,,c'è un posto in cui non si \Ndovrebbe mai mettere piede.
Dialogue: 0,0:20:20.76,0:20:23.40,Main-207-,,0,0,0,,Quel posto si trova qui vicino e
Dialogue: 0,0:20:23.40,0:20:26.65,Main-207-,,0,0,0,,viaggiando per un po' con il Waver, \Nci si può arrivare, però...
Dialogue: 0,0:20:30.04,0:20:31.51,Main-207-,,0,0,0,,È enorme...
Dialogue: 0,0:20:32.13,0:20:33.58,Main-207-,,0,0,0,,Cos'è questo?
Dialogue: 0,0:20:33.58,0:20:37.39,Main-207-,,0,0,0,,"Un posto in cui non si \Ndovrebbe mai mettere piede"...
Dialogue: 0,0:20:37.39,0:20:38.59,Main-207-,,0,0,0,,Perché?
Dialogue: 0,0:20:39.77,0:20:41.05,Main-207-,,0,0,0,,{È un territorio sacro. - OG}È una terra sacra.{Cora}
Dialogue: 0,0:20:41.05,0:20:42.27,Main-207-,,0,0,0,,{Un territorio sacro? - OG}"Una terra sacra"?{Cora}
Dialogue: 0,0:20:43.09,0:20:45.05,Main-207-,,0,0,0,,Quel posto... viene chiamato così:
Dialogue: 0,0:20:47.00,0:20:50.02,Main-207-,,0,0,0,,{[/q2]Il territorio su cui vive dio, Upper Yard. - OG}{\q2}La terra su cui vive dio, l'Upper Yard.{Cora}
Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=25}===============================DialOGUE============================
