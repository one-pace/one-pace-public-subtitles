Dialogue: 0,0:01:53.56,0:01:56.27,Main-207+,,0,0,0,,Deniz altı volkanları patlamak üzere!
Dialogue: 0,0:01:56.83,0:01:59.20,Main-207+,,0,0,0,,Çok yakınız!
Dialogue: 0,0:01:59.84,0:02:02.51,Main-207+,,0,0,0,,Beyler!
Dialogue: 0,0:02:02.51,0:02:04.71,Main-207+,,0,0,0,,Şimdilik geri çekiliyoruz!
Dialogue: 0,0:02:05.34,0:02:08.68,Main-207+,,0,0,0,,Anlaşıldı, Kaptan Vander Decken!
Dialogue: 0,0:02:08.68,0:02:11.72,Main-207+,,0,0,0,,Fener balığı! Wadatsumi! Gemiyi çekin!
Dialogue: 0,0:02:11.72,0:02:13.12,Main-207+,,0,0,0,,A-Anlaşıldı!
Dialogue: 0,0:02:13.85,0:02:18.02,Main-207+,,0,0,0,,Ben dünyanın en zengin adamı,\NKaptan Vander Decken'im!
Dialogue: 0,0:02:20.06,0:02:21.13,Main-207+,,0,0,0,,Mahvolduk!
Dialogue: 0,0:02:21.53,0:02:25.66,Main-207+,,0,0,0,,Luffy, Kraken'e bizi buradan\Nen hızlı şekilde uzaklaştırmasını söyle!
Dialogue: 0,0:02:25.66,0:02:26.66,Main-207+,,0,0,0,,Tamam!
Dialogue: 0,0:02:26.66,0:02:28.00,Main-207+,,0,0,0,,Hey, Surume!
Dialogue: 0,0:02:28.00,0:02:30.17,Main-207+,,0,0,0,,Dur, buna gerek yok!
Dialogue: 0,0:02:32.00,0:02:34.91,Main-207+,,0,0,0,,Zaten canını kurtarmak için kaçıyor!
Dialogue: 0,0:02:34.91,0:02:37.44,Main-207+,,0,0,0,,Efsanevi canavar demeye bin şahit ister!
Dialogue: 0,0:02:37.44,0:02:39.78,Main-207+,,0,0,0,,Harika! Desene iyi anlaşacağız!
Dialogue: 0,0:02:42.85,0:02:44.21,Main-207+,,0,0,0,,Çok kötü kaçıyor!
Dialogue: 0,0:02:44.21,0:02:46.02,Main-207+,,0,0,0,,Öyle deme!
Dialogue: 0,0:02:46.02,0:02:48.79,Main-207+,,0,0,0,,Bu, patlamadan ne kadar korktuğunu gösteriyor.
Dialogue: 0,0:02:49.35,0:02:50.79,Main-207+,,0,0,0,,Aynen öyle!
Dialogue: 0,0:02:50.79,0:02:52.89,Main-207+,,0,0,0,,Peki şu adam ne yapıyor?
Dialogue: 0,0:02:52.89,0:02:56.36,Main-207+,,0,0,0,,Vay canına! Evet! Hadi!
Dialogue: 0,0:02:56.36,0:02:57.56,Main-207+,,0,0,0,,Tedavi!
Dialogue: 0,0:03:00.13,0:03:02.53,Main-207+,,0,0,0,,Cidden patlamayı görmek istiyorum!
Dialogue: 0,0:03:02.53,0:03:04.87,Main-207+,,0,0,0,,Geminin ön tarafına koşun!
Dialogue: 0,0:03:04.87,0:03:05.94,Main-207+,,0,0,0,,Evet!
Dialogue: 0,0:03:05.94,0:03:09.21,Main-207+,,0,0,0,,Bunun faydası olmaz!\NBirkaç metre hiçbir şeyi değiştirmez!
Dialogue: 0,0:03:26.62,0:03:29.03,Main-207+,,0,0,0,,Magma deniz tabanında ilerliyor!
Dialogue: 0,0:03:29.53,0:03:31.46,Main-207+,,0,0,0,,Suyun sıcaklığı yükseliyor!
Dialogue: 0,0:03:31.46,0:03:34.90,Main-207+,,0,0,0,,Sanki kazanda gibiyiz!
Dialogue: 0,0:03:34.90,0:03:36.37,Main-207+,,0,0,0,,Haşlanacağız!
Dialogue: 0,0:03:34.23,0:03:36.37,Secondary-207+,,0,0,0,,Sıcak! Sıcak!
Dialogue: 0,0:03:46.81,0:03:48.85,Main-207+,,0,0,0,,Hayalet gemi ve Umibōzu!
Dialogue: 0,0:03:52.12,0:03:54.35,Main-207+,,0,0,0,,Kaç, Surume!
Dialogue: 0,0:03:54.35,0:03:56.02,Main-207+,,0,0,0,,Yapabilirsin!
Dialogue: 0,0:03:56.02,0:03:58.42,Main-207+,,0,0,0,,Çok yavaşsın, Surume!
Dialogue: 0,0:03:58.42,0:04:01.29,Main-207+,,0,0,0,,Haşlanmış ahtapota döneceksin!
Dialogue: 0,0:04:03.59,0:04:07.43,Main-207+,,0,0,0,,Haşlanmış ahtapot mu? Kulağa hoş geliyor!\NTadına bakmak isterim!
Dialogue: 0,0:04:10.17,0:04:13.54,Main-207+,,0,0,0,,Sıcaklık farkı akıntıyı girdaba çeviriyor!
Dialogue: 0,0:04:14.04,0:04:15.01,Main-207+,,0,0,0,,Nami-{\i1}san{\i0}.
Dialogue: 0,0:04:16.07,0:04:18.48,Main-207+,,0,0,0,,Balıkadam Adası hangi yön–
Dialogue: 0,0:04:19.21,0:04:21.04,Main-207+,,0,0,0,,Şu durumda bile mi?!
Dialogue: 0,0:04:21.45,0:04:23.08,Main-207+,,0,0,0,,Sanji, tedavine odaklan!
Dialogue: 0,0:04:23.55,0:04:25.95,Main-207+,,0,0,0,,{\fad(0,1019)}Dümdüz ilerlemeye devam!
Dialogue: 0,0:04:27.72,0:04:29.12,Main-207+,,0,0,0,,Yaklaşıyoruz!
Dialogue: 0,0:04:32.86,0:04:34.53,Main-207+,,0,0,0,,Şu çukura atlayın!
Dialogue: 0,0:04:40.36,0:04:41.97,Main-207+,,0,0,0,,Nee?!
Dialogue: 0,0:04:41.97,0:04:44.17,Main-207+,,0,0,0,,Oraya mı?!
Dialogue: 0,0:04:45.50,0:04:48.81,Main-207+,,0,0,0,,{\fad(0,922)}Düpedüz uçurum! Dalga mı geçiyorsun?!
Dialogue: 0,0:04:49.14,0:04:51.98,Main-207+,,0,0,0,,Karanlıktan bile daha karanlık!
Dialogue: 0,0:04:51.98,0:04:55.65,Main-207+,,0,0,0,,Balıkadam Adası gerçekten aşağıda mı?!
Dialogue: 0,0:05:01.69,0:05:04.05,Main-207+,,0,0,0,,Arkamız çok sıcak! Çok sıcak!
Dialogue: 0,0:05:04.05,0:05:06.76,Main-207+,,0,0,0,,Önümüz zifiri karanlık! Korkutucu!
Dialogue: 0,0:05:07.16,0:05:09.49,Main-207+,,0,0,0,,Aşağıda daha fazla canavar olduğu besbelli!
Dialogue: 0,0:05:09.49,0:05:12.03,Main-207+,,0,0,0,,Asla sağ çıkamayız!
Dialogue: 0,0:05:12.03,0:05:13.70,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:05:13.70,0:05:17.80,Main-207+,,0,0,0,,Orası cehenneme bağlanan dipsiz bir kazan!
Dialogue: 0,0:05:17.80,0:05:18.87,Main-207+,,0,0,0,,Demir kazan!
Dialogue: 0,0:05:18.87,0:05:21.24,Main-207+,,0,0,0,,Çaydanlık! Çay-çaydanlık!
Dialogue: 0,0:05:20.64,0:05:24.58,Main-207+,,0,0,0,,{\an8}Atla, Surume!
Dialogue: 0,0:05:30.65,0:05:32.72,Main-207+,,0,0,0,,Bir patlama daha!
Dialogue: 0,0:05:35.65,0:05:36.85,Main-207+,,0,0,0,,O da ne?!
Dialogue: 0,0:05:36.85,0:05:38.46,Main-207+,,0,0,0,,Tam üstümüzde!
Dialogue: 0,0:05:39.16,0:05:40.16,Main-207+,,0,0,0,,Kayalar mı?!
Dialogue: 0,0:05:40.16,0:05:41.12,Main-207+,,0,0,0,,Çepel mi?!
Dialogue: 0,0:05:41.12,0:05:43.06,Main-207+,,0,0,0,,Üstümüze taş, toprak yağıyor!
Dialogue: 0,0:05:43.06,0:05:45.53,Main-207+,,0,0,0,,Deminki patlama yüzünden!
Dialogue: 0,0:05:46.16,0:05:47.86,Main-207+,,0,0,0,,Onları atlat, Surume!
Dialogue: 0,0:05:51.07,0:05:52.90,Main-207+,,0,0,0,,Kabarcıktan çıkıp onları keseceğim!
Dialogue: 0,0:05:52.90,0:05:55.87,Main-207+,,0,0,0,,Luffy! Bacağımı tut!
Dialogue: 0,0:05:55.87,0:05:57.74,Main-207+,,0,0,0,,Tamam, rahat ol!
Dialogue: 0,0:05:58.11,0:05:59.48,Main-207+,,0,0,0,,Zoro, hayır!
Dialogue: 0,0:06:00.24,0:06:01.91,Main-207+,,0,0,0,,Hey, bırak beni!
Dialogue: 0,0:06:01.91,0:06:04.51,Main-207+,,0,0,0,,Yüzeyin 8 bin metre altındayız!
Dialogue: 0,0:06:04.95,0:06:07.95,Main-207+,,0,0,0,,Kabarcıktan çıkarsan su basıncıyla ezilirsin!
Dialogue: 0,0:06:07.95,0:06:09.99,Main-207+,,0,0,0,,Ee, ne yapacağız?!
Dialogue: 0,0:06:09.99,0:06:11.96,Main-207+,,0,0,0,,Bunu ben hallederim!
Dialogue: 0,0:06:12.46,0:06:14.26,Main-207+,,0,0,0,,{\fad(150,150)}Ölümcül Yeşil Yıldız...
Dialogue: 0,0:06:14.26,0:06:15.99,Main-207+,,0,0,0,,{\fad(150,150)}Esmer Yosun!
Dialogue: 0,0:06:22.23,0:06:23.60,Main-207+,,0,0,0,,Yosun çıktı!
Dialogue: 0,0:06:24.03,0:06:25.84,Main-207+,,0,0,0,,Harika, Usopp!
Dialogue: 0,0:06:25.84,0:06:28.21,Main-207+,,0,0,0,,Bize zaman kazandıracaktır.
Dialogue: 0,0:06:28.21,0:06:31.24,Main-207+,,0,0,0,,Fırsatın varken buradan uzaklaş, Surume!
Dialogue: 0,0:06:39.62,0:06:41.12,Main-207+,,0,0,0,,Kıl payı kurtulduk!
Dialogue: 0,0:06:46.46,0:06:49.46,Main-207+,,0,0,0,,Usopp, bu müthişti!
Dialogue: 0,0:06:49.46,0:06:52.83,Main-207+,,0,0,0,,Evet, harika zamanlama!
Dialogue: 0,0:06:51.19,0:06:52.83,Secondary-207+,,0,0,0,,Çocuk oyuncağıydı!
Dialogue: 0,0:06:52.83,0:06:54.13,Main-207+,,0,0,0,,Bizi kurtardın!
Dialogue: 0,0:06:56.03,0:06:59.14,Main-207+,,0,0,0,,Surume, sen de harika iş çıkardın!
Dialogue: 0,0:06:59.14,0:07:00.60,Main-207+,,0,0,0,,Çok rahatladım!
Dialogue: 0,0:07:00.60,0:07:02.11,Main-207+,,0,0,0,,Sağ ol, Surume!
Dialogue: 0,0:07:02.11,0:07:04.21,Main-207+,,0,0,0,,– Surume! Hey!\N– Surume!
Dialogue: 0,0:07:04.21,0:07:06.18,Main-207+,,0,0,0,,– Surume!\N– Surume! Hey!
Dialogue: 0,0:07:06.18,0:07:08.11,Main-207+,,0,0,0,,– Surume! Hadi!\N– Surume!
Dialogue: 0,0:07:08.11,0:07:09.85,Main-207+,,0,0,0,,– Surume!\N– Surume! Hey!
Dialogue: 0,0:07:09.85,0:07:10.35,Main-207+,,0,0,0,,– Su–\N– Su–
Dialogue: 0,0:07:36.21,0:07:38.74,Main-207+,,0,0,0,,G... Güvendeyiz!
Dialogue: 0,0:07:39.14,0:07:40.51,Main-207+,,0,0,0,,Işık mı?
Dialogue: 0,0:07:40.51,0:07:42.55,Main-207+,,0,0,0,,Bu derinlikte mi?
Dialogue: 0,0:07:42.55,0:07:45.45,Main-207+,,0,0,0,,Çok parlak! Gözlerimi kör etti.
Dialogue: 0,0:07:45.45,0:07:48.75,Main-207+,,0,0,0,,Gerçi kör olacak gözlerim yok.
Dialogue: 0,0:07:49.75,0:07:52.42,Main-207+,,0,0,0,,Hey, arkadaşlar! Gelip şuna bakın!
Dialogue: 0,0:07:52.82,0:07:54.73,Main-207+,,0,0,0,,Yukarıda! Tepemizde!
Dialogue: 0,0:07:55.59,0:07:57.73,Main-207+,,0,0,0,,Çok parlak. Pek iyi göremiyorum.
Dialogue: 0,0:07:57.73,0:07:59.43,Main-207+,,0,0,0,,Hey, Nami! Orası mı?
Dialogue: 0,0:07:59.43,0:08:02.07,Main-207+,,0,0,0,,Evet, hiç şüphesiz.
Dialogue: 0,0:08:02.07,0:08:04.33,Main-207+,,0,0,0,,Pusula orayı işaret ediyor!
Dialogue: 0,0:08:04.33,0:08:05.44,Main-207+,,0,0,0,,Orası...
Dialogue: 0,0:08:07.04,0:08:09.31,Main-207+,,0,0,0,,Balıkadam Adası!
Dialogue: 0,0:08:09.31,0:08:11.41,Main-207+,,0,0,0,,Çok büyük!
Dialogue: 0,0:08:11.84,0:08:14.44,Main-207+,,0,0,0,,Devasa bir kabarcıkla kaplı!
Dialogue: 0,0:08:14.44,0:08:16.15,Main-207+,,0,0,0,,İçeride bulutlar mı var?
Dialogue: 0,0:08:16.15,0:08:18.15,Main-207+,,0,0,0,,Belki hava da vardır!
Dialogue: 0,0:08:22.19,0:08:24.02,Main-207+,,0,0,0,,Yaşasın!
Dialogue: 0,0:08:24.02,0:08:25.62,Main-207+,,0,0,0,,Geldik!
Dialogue: 0,0:08:26.76,0:08:29.29,Main-207+,,0,0,0,,Grand Line'ın en meşhur yerlerinden biri!
Dialogue: 0,0:08:30.96,0:08:33.10,Main-207+,,0,0,0,,Demek geldik.
Dialogue: 0,0:08:35.63,0:08:38.00,Main-207+,,0,0,0,,Dans eden deniz kızlarının adası.
Dialogue: 0,0:08:38.00,0:08:39.80,Main-207+,,0,0,0,,Güzelim deniz kızları!
Dialogue: 0,0:08:39.80,0:08:42.17,Main-207+,,0,0,0,,Sonunda geldim!
Dialogue: 0,0:08:42.17,0:08:46.48,Main-207+,,0,0,0,,Çocukluğumdan beri hayalini kurduğum cennetteyim!
Dialogue: 0,0:08:40.27,0:08:46.48,Main-207+,,0,0,0,,{\an8}Yaşasın! Yaşasın! Yaşasın! Yaşasın!
Dialogue: 0,0:08:40.77,0:08:46.48,Secondary-207+,,0,0,0,,{\an8}Süper! Süper! Süper! Süper! Süper! Süper!
Dialogue: 0,0:08:48.38,0:08:53.02,Main-207+,,0,0,0,,– ♪ Deniz kızları! Deniz kızları! ♪\N– ♪ Deniz kızları! Deniz kızları! ♪
Dialogue: 0,0:08:53.02,0:08:55.05,Main-207+,,0,0,0,,– ♪ Deniz kızları! ♪\N– ♪ Deniz kız– ♪
Dialogue: 0,0:08:55.05,0:08:58.66,Main-207+,,0,0,0,,Sanji! Henüz hazır değilsin!\NSakın ha, hayalini bile kurma!
Dialogue: 0,0:08:58.66,0:08:59.52,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:09:09.57,0:09:10.83,Main-207+,,0,0,0,,Çok üzgünüm, Sanji!
Dialogue: 0,0:09:10.83,0:09:12.90,Main-207+,,0,0,0,,Seni zamanında iyileştiremedim!
Dialogue: 0,0:09:13.30,0:09:16.14,Main-207+,,0,0,0,,Gerçek deniz kızlarına\Ngöz ucuyla bile bakmamalısın.
Dialogue: 0,0:09:16.14,0:09:17.64,Main-207+,,0,0,0,,Doktor!
Dialogue: 0,0:09:17.64,0:09:22.01,Main-207+,,0,0,0,,Balıkadam Adası'nın deniz kızlarıyla\Nkarşılaşmak onun hayali!
Dialogue: 0,0:09:22.01,0:09:24.51,Main-207+,,0,0,0,,Ama onlarla karşılaşırsa ölecek!
Dialogue: 0,0:09:24.51,0:09:25.48,Main-207+,,0,0,0,,Olamaz!
Dialogue: 0,0:09:27.38,0:09:29.09,Main-207+,,0,0,0,,Umurumda değil...
Dialogue: 0,0:09:29.09,0:09:29.89,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:09:30.85,0:09:33.72,Main-207+,,0,0,0,,İçimde bu ukdeyle yaşayacağıma...
Dialogue: 0,0:09:34.62,0:09:38.36,Main-207+,,0,0,0,,deniz kızlarına baka baka can veririm daha iyi!
Dialogue: 0,0:09:38.86,0:09:39.80,Main-207+,,0,0,0,,Berbat birisin!
Dialogue: 0,0:09:40.56,0:09:44.84,Main-207+,,0,0,0,,Deniz kızlarıyla karşılaşacağım!
Dialogue: 0,0:09:44.84,0:09:45.70,Main-207+,,0,0,0,,Çok sıcak!
Dialogue: 0,0:09:45.70,0:09:47.04,Main-207+,,0,0,0,,Sapıklık alevleri!
Dialogue: 0,0:09:48.71,0:09:50.14,Main-207+,,0,0,0,,Çok heyecanlıyım!
Dialogue: 0,0:09:50.14,0:09:53.98,Main-207+,,0,0,0,,Acaba Balıkadam Adası'nda ne tür etler yiyorlar.
Dialogue: 0,0:09:53.98,0:09:56.28,Main-207+,,0,0,0,,Luffy, ağzının suyunu silip...
Dialogue: 0,0:09:56.28,0:09:58.28,Main-207+,,0,0,0,,Surume'den bir iyilik isteyebilir misin?
Dialogue: 0,0:09:58.28,0:10:00.65,Main-207+,,0,0,0,,Balıkadam Adası'nın girişini arayalım.
Dialogue: 0,0:10:00.65,0:10:02.35,Main-207+,,0,0,0,,Hey, onlar da neyin nesi?!
Dialogue: 0,0:10:05.09,0:10:08.29,Main-207+,,0,0,0,,Neden şu aciz insanlardan emir alıyorsun...
Dialogue: 0,0:10:08.29,0:10:10.23,Main-207+,,0,0,0,,Kraken?!
Dialogue: 0,0:10:12.00,0:10:14.00,Main-207+,,0,0,0,,Kim bunlar?!
Dialogue: 0,0:10:14.60,0:10:16.90,Main-207+,,0,0,0,,Deniz canavarları sürüsü!
Dialogue: 0,0:10:18.40,0:10:21.57,Main-207+,,0,0,0,,İşimiz bitti! Hem de buraya kadar gelmişken!
Dialogue: 0,0:10:21.97,0:10:26.54,Main-207+,,0,0,0,,Şu deniz canavarları süpermiş!
Dialogue: 0,0:10:28.18,0:10:30.58,Main-207+,,0,0,0,,Birileri onlara biniyor!
Dialogue: 0,0:10:36.62,0:10:38.52,Main-207+,,0,0,0,,{\an8\pos(1442,27)}Ne yapıyorsun, Surume?!
Dialogue: 0,0:10:38.52,0:10:41.02,Main-207+,,0,0,0,,{\an8\pos(1442,27)}Neredeyse varmıştık!
Dialogue: 0,0:10:54.30,0:10:58.17,Main-207+,,0,0,0,,D-Deniz canavarları sürüsünün tam ortasına düşmüşüz!
Dialogue: 0,0:10:59.84,0:11:02.41,Main-207+,,0,0,0,,Siz Hasır Şapka Tayfası'sınız, değil mi?
Dialogue: 0,0:11:03.98,0:11:06.28,Main-207+,,0,0,0,,Sizi gayet iyi biliyorum.
Dialogue: 0,0:11:07.02,0:11:11.76,Main-207+,,0,0,0,,Arlong'un tayfasının hakkından gelen sizsiniz.
Dialogue: 0,0:11:13.56,0:11:16.86,Main-207+,,0,0,0,,Yaptığınız tek halt bu olsaydı işimiz kolaydı!
Dialogue: 0,0:11:17.26,0:11:22.77,Main-207+,,0,0,0,,Fakat iki yıl önce, Arlong Korsanlarının eski yetkililerinden Hachi-{\i1}san{\i0}'ı savunup...
Dialogue: 0,0:11:23.63,0:11:27.60,Main-207+,,0,0,0,,o lanet olası Kutsal Ejderlerden birini de dövmüşsünüz.
Dialogue: 0,0:11:29.11,0:11:35.31,Main-207+,,0,0,0,,Tıpkı Balıkadam Adası'nın saygın kahramanı Fisher Tiger gibi.
Dialogue: 0,0:11:35.95,0:11:37.81,Main-207+,,0,0,0,,Fisher... Tiger...
Dialogue: 0,0:11:40.25,0:11:42.79,Main-207+,,0,0,0,,{\an8}Sizinle ne yapacağıma karar veremiyorum.
Dialogue: 0,0:11:42.79,0:11:45.66,Main-207+,,0,0,0,,{\an8}Hey, söylesenize.
Dialogue: 0,0:11:45.66,0:11:48.53,Main-207+,,0,0,0,,{\an8}Dost musunuz, düşman mısınız?
Dialogue: 0,0:11:49.23,0:11:51.66,Main-207+,,0,0,0,,{\an8}Kararı size bırakıyorum.
Dialogue: 0,0:11:52.20,0:11:55.97,Main-207+,,0,0,0,,{\an8}Yeni Balıkadam Korsanlarına katılacak mısınız?
Dialogue: 0,0:11:56.67,0:11:58.50,Main-207+,,0,0,0,,{\an8}Yoksa ret mi edeceksiniz?
Dialogue: 0,0:11:59.14,0:12:01.37,Main-207+,,0,0,0,,Reddederseniz sonunuz olur.
Dialogue: 0,0:12:01.37,0:12:02.67,Main-207+,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:12:03.67,0:12:05.71,Main-207+,,0,0,0,,Franky, yakıtı doldur.
Dialogue: 0,0:12:05.71,0:12:07.31,Main-207+,,0,0,0,,Ha? Ne planlıyorsun?
Dialogue: 0,0:12:07.88,0:12:11.28,Main-207+,,0,0,0,,Luffy ve diğerlerinin onlara boyun eğmeyeceğini biliyorsun.
Dialogue: 0,0:12:12.22,0:12:15.49,Main-207+,,0,0,0,,Hem 10 bin metre derinlikteyiz.
Dialogue: 0,0:12:15.49,0:12:18.99,Main-207+,,0,0,0,,Bırak kazanmayı, savaşamayız bile!
Dialogue: 0,0:12:19.32,0:12:20.52,Main-207+,,0,0,0,,Kısaca kaçalım!
Dialogue: 0,0:12:21.09,0:12:26.03,Main-207+,,0,0,0,,Kalan havayla Coup de Burst kullanıp\NBalıkadam Adası'na dalalım!
Dialogue: 0,0:12:27.73,0:12:28.80,Main-207+,,0,0,0,,Ciddi misin?!
Dialogue: 0,0:12:29.43,0:12:32.40,Main-207+,,0,0,0,,Diğer türlü buraya onca yolu ölmeye gelmiş olacağız.
Dialogue: 0,0:12:33.34,0:12:37.84,Main-207+,,0,0,0,,Görünen o ki buradan\Nsağ çıkmamızın başka yolu yok!
Dialogue: 0,0:12:37.84,0:12:40.61,Main-207+,,0,0,0,,Tamam, yakıtı doldurmaya gidiyorum.
Dialogue: 0,0:12:40.61,0:12:42.38,Main-207+,,0,0,0,,Franky, dümen ellerinden öper!
Dialogue: 0,0:12:42.38,0:12:45.68,Main-207+,,0,0,0,,Pekâlâ, süper biçimde ilgileneceğim!
Dialogue: 0,0:12:47.12,0:12:52.12,Main-207+,,0,0,0,,Ee, bize biat edecek misiniz,\NHasır Şapkalı Luffy?
Dialogue: 0,0:12:53.66,0:12:55.16,Main-207+,,0,0,0,,Olmaz.
Dialogue: 0,0:12:55.16,0:12:56.63,Main-207+,,0,0,0,,Sersem!
Dialogue: 0,0:12:59.86,0:13:01.63,Main-207+,,0,0,0,,Yani...
Dialogue: 0,0:13:02.23,0:13:05.54,Main-207+,,0,0,0,,Yeni Balıkadam Korsanlarına katılmayı reddediyorsunuz!
Dialogue: 0,0:13:05.94,0:13:08.51,Main-207+,,0,0,0,,Öyleyse balıkadamların düşmanısınız!
Dialogue: 0,0:13:08.51,0:13:11.04,Main-207+,,0,0,0,,Günahkâr bir grup insan!
Dialogue: 0,0:13:14.04,0:13:17.41,Main-207+,,0,0,0,,Niye size biat edelim ki?
Dialogue: 0,0:13:17.41,0:13:20.05,Main-207+,,0,0,0,,Luffy, onları daha fazla kışkırtma!
Dialogue: 0,0:13:20.75,0:13:22.25,Main-207+,,0,0,0,,Çok yazık.
Dialogue: 0,0:13:22.25,0:13:25.19,Main-207+,,0,0,0,,Artık geçmenize izin vermemiz mümkün değil.
Dialogue: 0,0:13:25.72,0:13:28.16,Main-207+,,0,0,0,,Burada batacaksınız!
Dialogue: 0,0:13:29.19,0:13:30.43,Main-207+,,0,0,0,,Deniz aslanı!
Dialogue: 0,0:13:34.70,0:13:36.70,Main-207+,,0,0,0,,Yakıt doldurma işi tamam!
Dialogue: 0,0:13:36.70,0:13:38.33,Main-207+,,0,0,0,,Franky, hazırız!
Dialogue: 0,0:13:39.50,0:13:40.77,Main-207+,,0,0,0,,Batır onları!
Dialogue: 0,0:13:40.77,0:13:42.34,Main-207+,,0,0,0,,Dövüşmek mi istiyorsunuz?!
Dialogue: 0,0:13:45.08,0:13:46.81,Main-207+,,0,0,0,,Şimdi, Franky!
Dialogue: 0,0:13:47.14,0:13:49.11,Main-207+,,0,0,0,,Sunny de aslandır!
Dialogue: 0,0:13:49.88,0:13:53.25,Main-207+,,0,0,0,,Kozumuzu başka zaman paylaşalım, deniz aslanı!
Dialogue: 0,0:13:53.62,0:13:55.09,Main-207+,,0,0,0,,Hazır!
Dialogue: 0,0:13:55.09,0:13:58.05,Main-207+,,0,0,0,,{\fad(150,150)}İtici Patlama!
Dialogue: 0,0:14:03.26,0:14:04.23,Main-207+,,0,0,0,,Gemi...!
Dialogue: 0,0:14:13.67,0:14:15.97,Main-207+,,0,0,0,,Havamız... tükeniyor!
Dialogue: 0,0:14:17.31,0:14:19.34,Main-207+,,0,0,0,,Dümdüz olacağım.
Dialogue: 0,0:14:20.98,0:14:22.65,Main-207+,,0,0,0,,Ciğerlerime hava gitmiyor.
Dialogue: 0,0:14:22.65,0:14:25.25,Main-207+,,0,0,0,,Gerçi ciğerlerim yok.
Dialogue: 0,0:14:26.45,0:14:29.42,Main-207+,,0,0,0,,Balıkadam Adası'na varana dek dayanın!
Dialogue: 0,0:14:32.16,0:14:35.23,Main-207+,,0,0,0,,O geminin nesi var?!
Dialogue: 0,0:14:36.03,0:14:38.23,Main-207+,,0,0,0,,Yarıp geçeceğiz!
Dialogue: 0,0:14:38.23,0:14:40.73,Main-207+,,0,0,0,,Geliyorum, sevgili deniz kızlarım!
Dialogue: 0,0:14:49.84,0:14:51.57,Main-207+,,0,0,0,,Kaplamamız gitti!
Dialogue: 0,0:14:51.57,0:14:54.28,Main-207+,,0,0,0,,Devasa kabarcık tarafından emildi!
Dialogue: 0,0:14:56.35,0:14:57.28,Main-207+,,0,0,0,,Bakın!
Dialogue: 0,0:14:58.11,0:14:59.68,Main-207+,,0,0,0,,O da ne?!
Dialogue: 0,0:15:00.68,0:15:03.85,Main-207+,,0,0,0,,{\fad(0,514)}Kabarcık iki katmandan oluşuyor!
Dialogue: 0,0:15:04.15,0:15:07.36,Main-207+,,0,0,0,,Normal bir gemi bu hava dolu\Ntabakada dimdik aşağı düşerdi!
Dialogue: 0,0:15:07.92,0:15:10.66,Main-207+,,0,0,0,,Bir kabarcığa daha çarpacağız!
Dialogue: 0,0:15:10.66,0:15:12.13,Main-207+,,0,0,0,,Sıkı tutunun!
Dialogue: 0,0:15:20.20,0:15:21.47,Main-207+,,0,0,0,,Su mu?!
Dialogue: 0,0:15:33.12,0:15:36.05,Thoughts-207+,,0,0,0,,{\t(2181,0,1,\c&H000000&\3c&H000000&)}Epey güçlü bir akıntı!
Dialogue: 0,0:15:40.76,0:15:42.76,Main-207+,,0,0,0,,Yardım edin...
Dialogue: 0,0:15:42.76,0:15:44.49,Main-207+,,0,0,0,,{\t(1216,0,1,\c&H000000&}Nefes alamıyorum....
Dialogue: 0,0:15:46.56,0:15:49.27,Thoughts-207+,,0,0,0,,Aramızda şeytan meyvesi kullanıcıları var...
Dialogue: 0,0:15:58.44,0:15:59.64,Thoughts-207+,,0,0,0,,{\t(685,0,1,\c&H000000&\3c&H000000&)}Ellerinizi...
Dialogue: 0,0:16:00.71,0:16:02.21,Thoughts-207+,,0,0,0,,...uzatın!
Dialogue: 0,0:16:05.05,0:16:06.68,Thoughts-207+,,0,0,0,,Nami-{\i1}san{\i0}!
Dialogue: 0,0:16:06.68,0:16:08.32,Thoughts-207+,,0,0,0,,Robin-{\i1}chan{\i0}!
Dialogue: 0,0:16:10.52,0:16:11.79,Thoughts-207+,,0,0,0,,Kahretsin!
Dialogue: 0,0:16:11.79,0:16:14.32,Thoughts-207+,,0,0,0,,{\t(2016,0,1,\c&H000000&\3c&H000000&)}Akıntıya karşı koyamıyorum!
Dialogue: 0,0:16:28.71,0:16:32.38,Main-207+,,0,0,0,,İçeri girmek için delice bir yol seçtiler.\NKendilerini öldürmüş olabilirler.
Dialogue: 0,0:16:32.78,0:16:35.78,Main-207+,,0,0,0,,Peşlerine düşmek ister misin, Hammond?
Dialogue: 0,0:16:35.78,0:16:38.41,Main-207+,,0,0,0,,Gerçi hâlâ hayattalar mı bilmiyorum.
Dialogue: 0,0:16:40.15,0:16:42.29,Main-207+,,0,0,0,,Kontrol etmeliyiz.
Dialogue: 0,0:16:42.29,0:16:45.72,Main-207+,,0,0,0,,Neptune Ordusu'nun onları bizden\Nönce bulmalarını istemeyiz.
Dialogue: 0,0:16:45.72,0:16:50.49,Main-207+,,0,0,0,,Ama önce Noah'a dönüp\Npatronu bu konuda bilgilendirelim.
Dialogue: 0,0:16:50.49,0:16:55.00,Main-207+,,0,0,0,,Arlong-{\i1}san{\i0}'ın hayallerini yıkan\NHasır Şapka'nın geldiğini bilmek isteyecektir.
Dialogue: 0,0:17:06.34,0:17:07.11,Main-207+,,0,0,0,,Hey.
Dialogue: 0,0:17:10.68,0:17:11.71,Main-207+,,0,0,0,,Şuna bakın.
Dialogue: 0,0:17:11.71,0:17:12.58,Main-207+,,0,0,0,,Baktım.
Dialogue: 0,0:17:12.58,0:17:13.65,Main-207+,,0,0,0,,Bakmıyorum!
Dialogue: 0,0:17:13.65,0:17:14.88,Main-207+,,0,0,0,,Sanırım baktım.
Dialogue: 0,0:17:14.88,0:17:16.15,Main-207+,,0,0,0,,Baktıysam ne olmuş?
Dialogue: 0,0:17:18.86,0:17:20.22,Main-207+,,0,0,0,,Bakın, kıpırdadı!
Dialogue: 0,0:17:20.22,0:17:21.22,Main-207+,,0,0,0,,Kıpırdadı!
Dialogue: 0,0:17:21.22,0:17:22.73,Main-207+,,0,0,0,,Kıpırdamadı!
Dialogue: 0,0:17:22.73,0:17:24.63,Main-207+,,0,0,0,,Sanırım kıpırdadı.
Dialogue: 0,0:17:24.63,0:17:25.96,Main-207+,,0,0,0,,Kıpırdadıysa ne olmuş?
Dialogue: 0,0:17:30.27,0:17:32.67,Main-207+,,0,0,0,,Yaşasın, uyandı!
Dialogue: 0,0:17:32.67,0:17:34.64,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:17:37.21,0:17:38.47,Main-207+,,0,0,0,,Luffy-{\i1}chin{\i0}!
Dialogue: 0,0:17:39.74,0:17:42.21,Main-207+,,0,0,0,,İyi olmana çok sevindim!
Dialogue: 0,0:17:42.21,0:17:44.11,Main-207+,,0,0,0,,Nasıl hissediyorsun?
Dialogue: 0,0:17:46.92,0:17:50.85,Main-207+,,0,0,0,,Camie, sensin! Uzun zaman oldu!
Dialogue: 0,0:17:50.85,0:17:55.46,Main-207+,,0,0,0,,Güzelliğine güzellik katmışsın, Camie-{\i1}chwan{\i0}!
Dialogue: 0,0:17:55.46,0:17:58.29,Main-207+,,0,0,0,,O hâlde Balıkadam Adası'ndayız ha?!
Dialogue: 0,0:17:58.29,0:17:59.60,Main-207+,,0,0,0,,Evet, öyle!
Dialogue: 0,0:17:59.60,0:18:03.97,Main-207+,,0,0,0,,Dediklerine göre tam boğuluyormuşuz ki\Ndeniz kızları yetişip bizi kurtarmış!
Dialogue: 0,0:18:03.97,0:18:04.97,Main-207+,,0,0,0,,Aynen.
Dialogue: 0,0:18:04.97,0:18:09.11,Main-207+,,0,0,0,,Aslında biz de birkaç dakika önce uyandık.
Dialogue: 0,0:18:09.11,0:18:11.41,Main-207+,,0,0,0,,Burası Caimie-{\i1}chan{\i0}'ın evi.
Dialogue: 0,0:18:11.41,0:18:12.38,Main-207+,,0,0,0,,İşte şapkan.
Dialogue: 0,0:18:12.38,0:18:14.94,Main-207+,,0,0,0,,Demek Caimie'nin evi!
Dialogue: 0,0:18:14.94,0:18:16.35,Main-207+,,0,0,0,,Üzgünüm!
Dialogue: 0,0:18:16.35,0:18:21.95,Main-207+,,0,0,0,,Sizi önümüzdeki ay bekliyordum\Nyoksa karşılamaya gelirdim.
Dialogue: 0,0:18:21.95,0:18:23.45,Main-207+,,0,0,0,,Dert etme!
Dialogue: 0,0:18:23.45,0:18:24.52,Main-207+,,0,0,0,,Diğerleri nerede?
Dialogue: 0,0:18:25.36,0:18:26.96,Main-207+,,0,0,0,,Şey...
Dialogue: 0,0:18:26.96,0:18:29.36,Main-207+,,0,0,0,,Galiba ayrıldık.
Dialogue: 0,0:18:29.86,0:18:32.63,Main-207+,,0,0,0,,Herkes iyi mi acaba?
Dialogue: 0,0:18:32.63,0:18:33.86,Main-207+,,0,0,0,,Hadi ya?
Dialogue: 0,0:18:33.86,0:18:39.64,Main-207+,,0,0,0,,Evet, elimden geldiğince onlara ulaşmaya çalıştım ama dibe sürüklenen sadece bizdik.
Dialogue: 0,0:18:40.14,0:18:43.14,Main-207+,,0,0,0,,Eminim iyi olacaklardır.
Dialogue: 0,0:18:43.14,0:18:44.57,Main-207+,,0,0,0,,Aynen öyle.
Dialogue: 0,0:18:44.57,0:18:47.08,Main-207+,,0,0,0,,Kemik suda işe yaramaz...
Dialogue: 0,0:18:47.08,0:18:50.58,Main-207+,,0,0,0,,ama robotla yeşil onlarla.\NBaşlarının çaresine bakarlar.
Dialogue: 0,0:18:50.95,0:18:53.52,Main-207+,,0,0,0,,Diğerlerini de görmek istiyorum.
Dialogue: 0,0:18:53.52,0:18:55.08,Main-207+,,0,0,0,,Ah, buyurun!
Dialogue: 0,0:18:55.08,0:18:57.15,Main-207+,,0,0,0,,Hepiniz üşümüşsünüzdür.
Dialogue: 0,0:18:57.15,0:18:59.39,Main-207+,,0,0,0,,Çorba pişirdim, için ve ısının.
Dialogue: 0,0:19:00.66,0:19:01.52,Main-207+,,0,0,0,,İşte!
Dialogue: 0,0:19:01.52,0:19:03.36,Main-207+,,0,0,0,,Soğuk yosun çorbası!
Dialogue: 0,0:19:03.73,0:19:04.46,Main-207+,,0,0,0,,Çok lezzetlidir.
Dialogue: 0,0:19:08.63,0:19:10.50,Main-207+,,0,0,0,,Soğuk çorba mı?
Dialogue: 0,0:19:10.50,0:19:11.33,Main-207+,,0,0,0,,Hı hı!
Dialogue: 0,0:19:14.67,0:19:17.81,Main-207+,,0,0,0,,Soğuk çorba sizi ısıtmaz ki!
Dialogue: 0,0:19:17.81,0:19:19.34,Main-207+,,0,0,0,,Ne yapacağım?!
Dialogue: 0,0:19:19.34,0:19:20.74,Main-207+,,0,0,0,,Nee?!
Dialogue: 0,0:19:20.74,0:19:23.08,Main-207+,,0,0,0,,Yanlış yaptım!
Dialogue: 0,0:19:25.42,0:19:28.79,Main-207+,,0,0,0,,Sorun değil, Caimie-{\i1}chan{\i0}.
Dialogue: 0,0:19:28.79,0:19:31.72,Main-207+,,0,0,0,,Aksine beni ısıtıyor!
Dialogue: 0,0:19:31.72,0:19:33.56,Main-207+,,0,0,0,,Bu mümkün mü?
Dialogue: 0,0:19:33.56,0:19:35.36,Main-207+,,0,0,0,,H-Hey! Sanji, ben de istiyorum!
Dialogue: 0,0:19:37.89,0:19:39.86,Main-207+,,0,0,0,,Elbiseleriniz kurudu!
Dialogue: 0,0:19:39.86,0:19:40.73,Main-207+,,0,0,0,,Kurudu!
Dialogue: 0,0:19:40.73,0:19:42.37,Main-207+,,0,0,0,,Henüz kurumadılar!
Dialogue: 0,0:19:42.37,0:19:43.87,Main-207+,,0,0,0,,Belki kurumuşlardır.
Dialogue: 0,0:19:43.87,0:19:45.13,Main-207+,,0,0,0,,Kurumuşlarsa ne olmuş?
Dialogue: 0,0:19:50.51,0:19:52.78,Main-207+,,0,0,0,,Elbiselerimizi kurutmuşsunuz!
Dialogue: 0,0:19:52.78,0:19:53.88,Main-207+,,0,0,0,,Sağ olun!
Dialogue: 0,0:19:53.88,0:19:54.58,Main-207+,,0,0,0,,Teşekkürler.
Dialogue: 0,0:19:55.14,0:19:57.41,Main-207+,,0,0,0,,Bu arada, siz kimsiniz?
Dialogue: 0,0:19:57.41,0:19:59.35,Main-207+,,0,0,0,,Ah, onlar arkadaşlarım.
Dialogue: 0,0:19:59.35,0:20:01.32,Main-207+,,0,0,0,,Beşiz Medaka Deniz Kızları.
Dialogue: 0,0:20:01.32,0:20:02.45,Main-207+,,0,0,0,,Ben Birka!
Dialogue: 0,0:20:02.45,0:20:03.32,Main-207+,,0,0,0,,İkika!
Dialogue: 0,0:20:03.32,0:20:04.32,Main-207+,,0,0,0,,Üçka!
Dialogue: 0,0:20:04.32,0:20:05.22,Main-207+,,0,0,0,,Dörtka!
Dialogue: 0,0:20:05.22,0:20:06.72,Main-207+,,0,0,0,,Dörtka 2!
Dialogue: 0,0:20:06.72,0:20:08.56,Main-207+,,0,0,0,,Niye Beşka değil?
Dialogue: 0,0:20:09.09,0:20:11.73,Main-207+,,0,0,0,,Hızlı yüzücüdürler ve epey akıllıdırlar.
Dialogue: 0,0:20:11.73,0:20:13.93,Main-207+,,0,0,0,,Harbi mi?
Dialogue: 0,0:20:13.93,0:20:16.83,Main-207+,,0,0,0,,Deniz Kızı Koyu'nun altındayız.
Dialogue: 0,0:20:16.83,0:20:21.10,Main-207+,,0,0,0,,Burası Deniz Kızı Kafe'nin kız yurdu,\Nbu yüzden burada çok arkadaşım var!
Comment: 0,0:20:21.10,0:20:22.17,Main-207+,,0,0,0,,Ne?
Dialogue: 0,0:20:22.57,0:20:23.71,Main-207+,,0,0,0,,Kız yurdu mu?!
Dialogue: 0,0:20:24.07,0:20:25.14,Main-207+,,0,0,0,,Camie-{\i1}chan{\i0}!
Dialogue: 0,0:20:25.14,0:20:28.88,Main-207+,,0,0,0,,D-D-Deniz Kızı Kafe de ne?!
Dialogue: 0,0:20:28.88,0:20:32.12,Main-207+,,0,0,0,,Garson olarak çalıştığım kafe.
Dialogue: 0,0:20:32.12,0:20:34.12,Main-207+,,0,0,0,,Orada bir sürü güzel deniz kızı var.
Dialogue: 0,0:20:34.12,0:20:36.25,Main-207+,,0,0,0,,G-Güzel deniz kızları mı?!
Dialogue: 0,0:20:39.06,0:20:41.16,Main-207+,,0,0,0,,Biraz kahve alır mısınız? Ya da...
Dialogue: 0,0:20:44.06,0:20:46.96,Main-207+,,0,0,0,,– Sanji'nin...\N– ...başı büyük dertte!
Dialogue: 0,0:20:47.50,0:20:48.80,Main-207+,,0,0,0,,Hiç de bile!
Dialogue: 0,0:20:48.80,0:20:49.77,Main-207+,,0,0,0,,– Geri döndü!\N– Geri döndü!
Dialogue: 0,0:20:50.50,0:20:51.47,Main-207+,,0,0,0,,Ben...
Dialogue: 0,0:20:53.20,0:20:57.87,Main-207+,,0,0,0,,Balıkadam Adası'nda asla burnum kanayıp da bayılmayacağıma...
Dialogue: 0,0:20:57.87,0:21:00.44,Main-207+,,0,0,0,,yemin ettim!
Dialogue: 0,0:21:03.55,0:21:08.62,Main-207+,,0,0,0,,Artık ödülümü hak ettim, değil mi...?
Dialogue: 0,0:21:08.62,0:21:10.02,Main-207+,,0,0,0,,Umutsuz vaka...
Dialogue: 0,0:21:10.02,0:21:10.05,Main-207+,,0,0,0,,{\clip(806.14,906.06,1326.21,1080)}Umutsuz vaka...
Dialogue: 0,0:21:10.05,0:21:10.09,Main-207+,,0,0,0,,{\clip(931,887.39,1297.7,1080)}Umutsuz vaka...
Dialogue: 0,0:21:10.09,0:21:10.12,Main-207+,,0,0,0,,{\clip(1053.89,915.89,1338,1080)}Umutsuz vaka...
Dialogue: 0,0:21:10.12,0:21:10.15,Main-207+,,0,0,0,,{\clip(1178.74,937.5,1290.81,1080)}Umutsuz vaka...
Dialogue: 0,0:21:10.85,0:21:11.45,Main-207+,,0,0,0,,Doğru ya!
Dialogue: 0,0:21:11.95,0:21:13.59,Main-207+,,0,0,0,,Hadi yukarı çıkalım!
Dialogue: 0,0:21:13.59,0:21:15.53,Main-207+,,0,0,0,,Sizi arkadaşlarımla tanıştıracağım!
Dialogue: 0,0:21:18.43,0:21:20.40,Main-207+,,0,0,0,,Oha, bir kaplumbağa!
Dialogue: 0,0:21:20.90,0:21:23.27,Main-207+,,0,0,0,,"Deniz Kaplumbağası Asansörü" yazıyor.
Dialogue: 0,0:21:25.13,0:21:26.94,Main-207+,,0,0,0,,Kaplumbağa-{\i1}chin{\i0}, yukarı lütfen.
Dialogue: 0,0:21:32.58,0:21:35.14,Main-207+,,0,0,0,,Burası denizdeki bir mercan apartmanı.
Dialogue: 0,0:21:35.14,0:21:38.11,Main-207+,,0,0,0,,Yurt en alt katta olduğu için kirası ucuz.
Dialogue: 0,0:21:38.11,0:21:41.65,Main-207+,,0,0,0,,Işığın vurduğu üst katlar daha pahalıdır.
Dialogue: 0,0:21:42.65,0:21:44.55,Main-207+,,0,0,0,,Fakir misin sen?
Dialogue: 0,0:21:44.55,0:21:46.46,Main-207+,,0,0,0,,Sahi, Hachi ve Pappagu ne durumda?
Dialogue: 0,0:21:46.46,0:21:49.33,Main-207+,,0,0,0,,Hachin bir yıl önce fena hâlde yaralandı.
Dialogue: 0,0:21:49.33,0:21:54.13,Main-207+,,0,0,0,,Sabaody'de Sunny'yi koruyordu değil mi?
Dialogue: 0,0:21:54.13,0:21:57.77,Main-207+,,0,0,0,,Duyduğuma göre durumu bayağı düzelmiş...
Dialogue: 0,0:21:57.77,0:22:01.77,Main-207+,,0,0,0,,ama Hachin aslında Balıkadam Bölgesi sakini olduğu için orada istirahat ediyor.
Dialogue: 0,0:22:02.91,0:22:04.01,Main-207+,,0,0,0,,Balıkadam Bölgesi mi?
Dialogue: 0,0:22:04.01,0:22:04.94,Main-207+,,0,0,0,,Evet...
Dialogue: 0,0:22:04.94,0:22:10.45,Main-207+,,0,0,0,,Biraz tekinsiz bir yer ama yanınızda güvende hissettiğim için sizi götürebilirim.
Dialogue: 0,0:22:10.45,0:22:11.61,Main-207+,,0,0,0,,Sonra gideriz!
Dialogue: 0,0:22:11.61,0:22:13.78,Main-207+,,0,0,0,,Ona bizzat teşekkür etmeliyim.
Dialogue: 0,0:22:13.78,0:22:15.59,Main-207+,,0,0,0,,Tamam, olur.
Dialogue: 0,0:22:15.59,0:22:18.32,Main-207+,,0,0,0,,Pappagu'ya gelince...
Dialogue: 0,0:22:19.46,0:22:22.33,Main-207+,,0,0,0,,Kendisi çok ünlü bir moda tasarımcısıdır.
Dialogue: 0,0:22:22.33,0:22:27.53,Main-207+,,0,0,0,,Gyoverly Tepeleri denen zenginler bölgesinde kocaman bir konağı var.
Dialogue: 0,0:22:27.53,0:22:31.03,Main-207+,,0,0,0,,Bugün oraya deniztarağı götüreceğim, birlikte gideriz!
Dialogue: 0,0:22:31.37,0:22:32.87,Main-207+,,0,0,0,,Evcil hayvanın değil mi?
Dialogue: 0,0:22:33.57,0:22:35.20,Main-207+,,0,0,0,,Niye birlikte yaşamıyorsunuz?
Dialogue: 0,0:22:36.44,0:22:39.54,Main-207+,,0,0,0,,Ben oraya pek uygun değilim.
Dialogue: 0,0:22:40.01,0:22:42.88,Main-207+,,0,0,0,,Hem buradaki deniztarakları daha iyi.
Dialogue: 0,0:22:42.88,0:22:44.85,Main-207+,,0,0,0,,Neredeyse geldik!
Dialogue: 0,0:22:46.05,0:22:48.78,Main-207+,,0,0,0,,Hey, pipete benzeyen şu şeyler de ne?
Dialogue: 0,0:22:48.78,0:22:49.99,Main-207+,,0,0,0,,Ah, onlar...
Dialogue: 0,0:22:50.35,0:22:54.06,Main-207+,,0,0,0,,bir kabarcık zanaatkârı tarafından yapılan su yolu.
Dialogue: 0,0:22:54.06,0:22:57.03,Main-207+,,0,0,0,,Balıklar ve benim gibi deniz ahalisi o yolu kullanır.
Dialogue: 0,0:22:57.59,0:22:59.46,Main-207+,,0,0,0,,İzleyin!
Dialogue: 0,0:23:06.27,0:23:08.27,Main-207+,,0,0,0,,İşte geldik, yüzeydeyiz!
Dialogue: 0,0:23:08.27,0:23:10.67,Main-207+,,0,0,0,,Luffy-{\i1}chin{\i0}!
Dialogue: 0,0:23:12.84,0:23:13.54,Main-207+,,0,0,0,,Gördünüz mü?
Dialogue: 0,0:23:13.54,0:23:15.88,Main-207+,,0,0,0,,Gökyüzünde bile yüzebiliyorum!
Dialogue: 0,0:23:15.88,0:23:17.88,Main-207+,,0,0,0,,Eğlenceli görünüyor!
Dialogue: 0,0:23:19.08,0:23:20.48,Main-207+,,0,0,0,,Durun!
Dialogue: 0,0:23:20.48,0:23:23.92,Main-207+,,0,0,0,,Her şeyi geçtim, denizin dibinde gökyüzü ve bulutlar var!
Dialogue: 0,0:23:24.29,0:23:26.09,Main-207+,,0,0,0,,Hey, Camie!
Dialogue: 0,0:23:26.09,0:23:27.96,Main-207+,,0,0,0,,Ha? Kadın sesi!
Dialogue: 0,0:23:28.66,0:23:30.59,Main-207+,,0,0,0,,Arkadaşlar!
Dialogue: 0,0:23:32.56,0:23:36.57,Main-207+,,0,0,0,,Korsan arkadaşların şimdi iyi mi?\NAz daha boğulup gidiyorlardı!
Comment: 0,0:23:32.56,0:23:34.80,Main-207+,,0,0,0,,Korsan arkadaşların şimdi iyi mi?
Comment: 0,0:23:34.80,0:23:36.57,Main-207+,,0,0,0,,Az daha boğulup gidiyorlardı!
Dialogue: 0,0:23:39.00,0:23:42.67,Main-207+,,0,0,0,,Girişi kullanmayanlar sizdiniz, değil mi?
Dialogue: 0,0:23:45.21,0:23:46.44,Main-207+,,0,0,0,,Selam!
Dialogue: 0,0:23:46.44,0:23:48.44,Main-207+,,0,0,0,,Pek korkutucu görünmüyorsunuz.
Dialogue: 0,0:23:48.44,0:23:49.95,Main-207+,,0,0,0,,Adaya kaçak mı girdiniz?
Dialogue: 0,0:23:49.95,0:23:51.08,Main-207+,,0,0,0,,Epey çılgınca!
Dialogue: 0,0:23:51.08,0:23:52.72,Main-207+,,0,0,0,,Korsanlara bayılıyorum!
Dialogue: 0,0:24:02.83,0:24:05.59,Main-207+,,0,0,0,,Canlı bir peri masalı gibi!
Dialogue: 0,0:24:05.59,0:24:09.53,Main-207+,,0,0,0,,Mercan diyarı! Deniz Kızı Koyu!
Dialogue: 0,0:24:23.51,0:24:24.38,Main-207+,,0,0,0,,Ha?!
Dialogue: 0,0:24:24.38,0:24:26.42,Main-207+,,0,0,0,,Sanji ağlıyor!
Dialogue: 0,0:24:26.85,0:24:29.49,Main-207+,,0,0,0,,Baratie'den ayrılırken bile böyle ağlamamıştı.
Dialogue: 0,0:24:32.39,0:24:34.89,Main-207+,,0,0,0,,Sonunda buldum!
Dialogue: 0,0:24:35.26,0:24:38.63,Main-207+,,0,0,0,,Burası benim All Blue'm!
Dialogue: 0,0:24:40.86,0:24:43.37,Main-207+,,0,0,0,,{\pos(1320,1053)}Harbiden aradığın bu mu, Sanji?
Dialogue: 0,0:24:44.70,0:24:46.54,Main-207+,,0,0,0,,Sizleri tanıştırayım!
Dialogue: 0,0:24:47.04,0:24:49.54,Main-207+,,0,0,0,,Bu, tayfanın kaptanı Luffy-{\i1}chin{\i0}!
Dialogue: 0,0:24:49.54,0:24:50.74,Main-207+,,0,0,0,,Evet, tanıştığıma sevindim!
Dialogue: 0,0:24:51.37,0:24:53.21,Main-207+,,0,0,0,,Ağlayan kişi Sanji-{\i1}chin{\i0}!
Dialogue: 0,0:24:53.84,0:24:55.71,Main-207+,,0,0,0,,Şu burunlu olansa Usopp-{\i1}chin{\i0}!
Dialogue: 0,0:24:55.71,0:24:56.45,Main-207+,,0,0,0,,Memnun oldum!
Dialogue: 0,0:24:56.95,0:24:59.12,Main-207+,,0,0,0,,O rakun köpek, Chopper-{\i1}chin{\i0}!
Dialogue: 0,0:24:59.12,0:25:00.22,Main-207+,,0,0,0,,Ben ren geyiğiyim!
Dialogue: 0,0:25:01.15,0:25:04.09,Main-207+,,0,0,0,,Sorun nedir? Neden ağlıyorsun?
Dialogue: 0,0:25:05.32,0:25:06.69,Main-207+,,0,0,0,,Gel buraya!
Dialogue: 0,0:25:06.69,0:25:08.79,Main-207+,,0,0,0,,Suda beraber dans edelim!
Dialogue: 0,0:25:13.76,0:25:16.40,Main-207+,,0,0,0,,Evet... şimdi anlıyorum.
Dialogue: 0,0:25:16.40,0:25:19.00,Main-207+,,0,0,0,,Gerçek olmayacak kadar iyi.
Dialogue: 0,0:25:19.00,0:25:21.80,Main-207+,,0,0,0,,Muhtemelen bugün öleceğim!
Dialogue: 0,0:25:21.80,0:25:23.64,Main-207+,,0,0,0,,Çok negatifsin!
Dialogue: 0,0:25:23.64,0:25:26.78,Main-207+,,0,0,0,,Cidden geçtiğimiz iki yıl boyunca sana ne oldu?!
Dialogue: 0,0:25:26.78,0:25:30.15,Main-207+,,0,0,0,,Yıllardır hayalini kurduğun cennet\Ntam karşında işte!
Dialogue: 0,0:25:31.35,0:25:33.58,Main-207+,,0,0,0,,Çok komiksin, Sanji!
Dialogue: 0,0:25:33.58,0:25:35.72,Main-207+,,0,0,0,,– Komiklik falan yapmıyor!\N– Komiklik falan yapmıyor!
Dialogue: 0,0:25:43.83,0:25:45.59,Main-207+,,0,0,5,,Anladım.
Dialogue: 0,0:25:45.59,0:25:50.53,Main-207+,,0,0,5,,Hasır Şapkalı Luffy sonunda geldi demek.
Dialogue: 0,0:25:51.60,0:25:52.60,Main-207+,,0,0,0,,Evet.
Dialogue: 0,0:25:52.60,0:25:56.57,Main-207+,,0,0,0,,N-Ne yapalım, Patron?
Dialogue: 0,0:25:58.77,0:26:00.41,Main-207+,,0,0,0,,Onu buraya,
Dialogue: 0,0:26:01.78,0:26:03.11,Main-207+,,0,0,0,,bana getirin.
Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=21}===============================DIALOGUE============================
