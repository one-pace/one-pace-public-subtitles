Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=14}===============================DIALOGUE============================
Dialogue: 0,0:01:53.56,0:01:56.27,Main-207+,,0,0,0,,海底火山が…　噴火する
Dialogue: 0,0:01:56.83,0:01:59.20,Main-207+,,0,0,0,,近すぎるぞ　この距離は
Dialogue: 0,0:01:59.84,0:02:02.51,Main-207+,,0,0,0,,野郎ども
Dialogue: 0,0:02:02.51,0:02:04.71,Main-207+,,0,0,0,,ここはいったん引き返すぞ
Dialogue: 0,0:02:05.34,0:02:08.68,Main-207+,,0,0,0,,ラジャー\Nキャプテン・バンダー・デッケン
Dialogue: 0,0:02:08.68,0:02:11.72,Main-207+,,0,0,0,,アンコロ！ワダツミ！船を引け
Dialogue: 0,0:02:11.72,0:02:13.12,Main-207+,,0,0,0,,わ、分かったら
Dialogue: 0,0:02:13.85,0:02:18.02,Main-207+,,0,0,0,,俺は世界一の大金持ち\Nキャプテン・バンダー・デッケンだ
Dialogue: 0,0:02:20.06,0:02:21.13,Main-207+,,0,0,0,,大変
Dialogue: 0,0:02:21.53,0:02:25.66,Main-207+,,0,0,0,,ルフィ！クラーケンに言って\Nすぐここから遠ざかるように
Dialogue: 0,0:02:25.66,0:02:26.66,Main-207+,,0,0,0,,おう
Dialogue: 0,0:02:26.66,0:02:28.00,Main-207+,,0,0,0,,おいスルメ！
Dialogue: 0,0:02:28.00,0:02:30.17,Main-207+,,0,0,0,,待った！必要ねえ
Dialogue: 0,0:02:32.00,0:02:34.91,Main-207+,,0,0,0,,もう脇目も振らずに走り出してる
Dialogue: 0,0:02:34.91,0:02:37.44,Main-207+,,0,0,0,,伝説の怪物がものすごい形相で
Dialogue: 0,0:02:37.44,0:02:39.78,Main-207+,,0,0,0,,助かる！案外気が合いそう
Dialogue: 0,0:02:42.85,0:02:44.21,Main-207+,,0,0,0,,ひどい走り方
Dialogue: 0,0:02:44.21,0:02:46.02,Main-207+,,0,0,0,,言ってやるな
Dialogue: 0,0:02:46.02,0:02:48.79,Main-207+,,0,0,0,,そんだけ 噴火は恐ろしいことなんだ
Dialogue: 0,0:02:49.35,0:02:50.79,Main-207+,,0,0,0,,そう
Dialogue: 0,0:02:50.79,0:02:52.89,Main-207+,,0,0,0,,…であいつは何やってんだ？
Dialogue: 0,0:02:52.89,0:02:56.36,Main-207+,,0,0,0,,ウォウ！イエス！カモン！
Dialogue: 0,0:02:56.36,0:02:57.56,Main-207+,,0,0,0,,リハビリだ
Dialogue: 0,0:03:00.13,0:03:02.53,Main-207+,,0,0,0,,でも俺　噴火見てえ
Dialogue: 0,0:03:02.53,0:03:04.87,Main-207+,,0,0,0,,船の前方へ避難せよ
Dialogue: 0,0:03:04.87,0:03:05.94,Main-207+,,0,0,0,,おう！
Dialogue: 0,0:03:05.94,0:03:09.21,Main-207+,,0,0,0,,変わんないわよ\Nたった数十メートル
Dialogue: 0,0:03:26.62,0:03:29.03,Main-207+,,0,0,0,,マグマが海底を駆け下りてる
Dialogue: 0,0:03:29.53,0:03:31.46,Main-207+,,0,0,0,,水温が上がってく…
Dialogue: 0,0:03:31.46,0:03:34.90,Main-207+,,0,0,0,,まるで熱湯の中にいるみてえだ
Dialogue: 0,0:03:34.90,0:03:36.37,Main-207+,,0,0,0,,ゆで上がっちまうぞ
Dialogue: 0,0:03:34.23,0:03:36.37,Secondary-207+,,0,0,0,,熱っ　熱っ…
Dialogue: 0,0:03:46.81,0:03:48.85,Main-207+,,0,0,0,,ゴーストシップと海坊主が
Dialogue: 0,0:03:52.12,0:03:54.35,Main-207+,,0,0,0,,逃げてスルメ
Dialogue: 0,0:03:54.35,0:03:56.02,Main-207+,,0,0,0,,頑張れ！
Dialogue: 0,0:03:56.02,0:03:58.42,Main-207+,,0,0,0,,モタモタしてっとスルメ
Dialogue: 0,0:03:58.42,0:04:01.29,Main-207+,,0,0,0,,おめえゆでダコになっちまうぞ！
Dialogue: 0,0:04:03.59,0:04:07.43,Main-207+,,0,0,0,,ゆでダコ？いいなそれ\N俺食いてえ！
Dialogue: 0,0:04:10.17,0:04:13.54,Main-207+,,0,0,0,,水温差で\N海流が渦巻きはじめた
Dialogue: 0,0:04:14.04,0:04:15.01,Main-207+,,0,0,0,,ナミさん
Dialogue: 0,0:04:16.07,0:04:18.48,Main-207+,,0,0,0,,魚人島は　どっちだ…
Dialogue: 0,0:04:19.21,0:04:21.04,Main-207+,,0,0,0,,こんな時までやましい気持ちが？
Dialogue: 0,0:04:21.45,0:04:23.08,Main-207+,,0,0,0,,サンジはリハビリに集中しろ！
Dialogue: 0,0:04:23.55,0:04:25.95,Main-207+,,0,0,0,,{\fad(0,1019)}まだ　真っすぐ
Dialogue: 0,0:04:27.72,0:04:29.12,Main-207+,,0,0,0,,もう少し
Dialogue: 0,0:04:32.86,0:04:34.53,Main-207+,,0,0,0,,あの海溝へ！
Dialogue: 0,0:04:40.36,0:04:41.97,Main-207+,,0,0,0,,ええっ？
Dialogue: 0,0:04:41.97,0:04:44.17,Main-207+,,0,0,0,,あんなとこへ？
Dialogue: 0,0:04:45.50,0:04:48.81,Main-207+,,0,0,0,,{\fad(0,922)}断崖絶壁！マジかおい
Dialogue: 0,0:04:49.14,0:04:51.98,Main-207+,,0,0,0,,暗黒よりもっと暗い
Dialogue: 0,0:04:51.98,0:04:55.65,Main-207+,,0,0,0,,ホントにあんのか？\Nこん中に魚人島が
Dialogue: 0,0:05:01.69,0:05:04.05,Main-207+,,0,0,0,,後ろが熱い！熱いよ
Dialogue: 0,0:05:04.05,0:05:06.76,Main-207+,,0,0,0,,前は真っ暗だぞ！怖え〜
Dialogue: 0,0:05:07.16,0:05:09.49,Main-207+,,0,0,0,,また怪物が出るに決まってる
Dialogue: 0,0:05:09.49,0:05:12.03,Main-207+,,0,0,0,,生きて帰ってこれる気がしねえ！
Dialogue: 0,0:05:12.03,0:05:13.70,Main-207+,,0,0,0,,ルフィ！
Dialogue: 0,0:05:13.70,0:05:17.80,Main-207+,,0,0,0,,あの闇は地獄へと続く\N底の抜けた鍋だ
Dialogue: 0,0:05:17.80,0:05:18.87,Main-207+,,0,0,0,,お釜だ
Dialogue: 0,0:05:18.87,0:05:21.24,Main-207+,,0,0,0,,茶壺だ　茶壺だ
Dialogue: 0,0:05:20.64,0:05:24.58,Main-207+,,0,0,0,,{\an8}飛び込めスルメ！
Dialogue: 0,0:05:30.65,0:05:32.72,Main-207+,,0,0,0,,また噴火した
Dialogue: 0,0:05:35.65,0:05:36.85,Main-207+,,0,0,0,,ありゃ何だ
Dialogue: 0,0:05:36.85,0:05:38.46,Main-207+,,0,0,0,,上に何か…
Dialogue: 0,0:05:39.16,0:05:40.16,Main-207+,,0,0,0,,岩！？
Dialogue: 0,0:05:40.16,0:05:41.12,Main-207+,,0,0,0,,土砂？
Dialogue: 0,0:05:41.12,0:05:43.06,Main-207+,,0,0,0,,土石流よ　危ない
Dialogue: 0,0:05:43.06,0:05:45.53,Main-207+,,0,0,0,,今の噴火で崩れたんだ
Dialogue: 0,0:05:46.16,0:05:47.86,Main-207+,,0,0,0,,よけてスルメ
Dialogue: 0,0:05:51.07,0:05:52.90,Main-207+,,0,0,0,,シャボンから出て斬ってくる
Dialogue: 0,0:05:52.90,0:05:55.87,Main-207+,,0,0,0,,ルフィ！しっかりつかんでろよ
Dialogue: 0,0:05:55.87,0:05:57.74,Main-207+,,0,0,0,,おう！任せろ
Dialogue: 0,0:05:58.11,0:05:59.48,Main-207+,,0,0,0,,ゾロ！ダメよ
Dialogue: 0,0:06:00.24,0:06:01.91,Main-207+,,0,0,0,,おい　離せ
Dialogue: 0,0:06:01.91,0:06:04.51,Main-207+,,0,0,0,,ここはもう8000メートルの深海
Dialogue: 0,0:06:04.95,0:06:07.95,Main-207+,,0,0,0,,シャボンの外に出ては\N水圧に潰されてしまう
Dialogue: 0,0:06:07.95,0:06:09.99,Main-207+,,0,0,0,,じゃあどうすりゃいいんだ
Dialogue: 0,0:06:09.99,0:06:11.96,Main-207+,,0,0,0,,俺に任せろ
Dialogue: 0,0:06:12.46,0:06:14.26,Main-207+,,0,0,0,,{\fad(150,150)}必殺緑星
Dialogue: 0,0:06:14.26,0:06:15.99,Main-207+,,0,0,0,,{\fad(150,150)}サルガッソ！
Dialogue: 0,0:06:22.23,0:06:23.60,Main-207+,,0,0,0,,海草が飛び出した
Dialogue: 0,0:06:24.03,0:06:25.84,Main-207+,,0,0,0,,すっげえウソップ
Dialogue: 0,0:06:25.84,0:06:28.21,Main-207+,,0,0,0,,一瞬の足止めだ
Dialogue: 0,0:06:28.21,0:06:31.24,Main-207+,,0,0,0,,今のうちに離れろ！スルメ！
Dialogue: 0,0:06:39.62,0:06:41.12,Main-207+,,0,0,0,,セーフ！
Dialogue: 0,0:06:46.46,0:06:49.46,Main-207+,,0,0,0,,ウソップ！やるなあ　お前
Dialogue: 0,0:06:49.46,0:06:52.83,Main-207+,,0,0,0,,いや〜すばらしい判断力
Dialogue: 0,0:06:51.19,0:06:52.83,Secondary-207+,,0,0,0,,簡単だ
Dialogue: 0,0:06:52.83,0:06:54.13,Main-207+,,0,0,0,,助かったぞ
Dialogue: 0,0:06:56.03,0:06:59.14,Main-207+,,0,0,0,,スルメ\Nおめえも よくやったぞ
Dialogue: 0,0:06:59.14,0:07:00.60,Main-207+,,0,0,0,,もう安心だ
Dialogue: 0,0:07:00.60,0:07:02.11,Main-207+,,0,0,0,,ありがとうスルメ
Dialogue: 0,0:07:02.11,0:07:04.21,Main-207+,,0,0,0,,–　スルメ\N–　スルメ　はい
Dialogue: 0,0:07:04.21,0:07:06.18,Main-207+,,0,0,0,,–　スルメ\N–　スルメ　はい
Dialogue: 0,0:07:06.18,0:07:08.11,Main-207+,,0,0,0,,–　スルメ\N–　スルメ　はい
Dialogue: 0,0:07:08.11,0:07:09.85,Main-207+,,0,0,0,,–　スルメ\N–　スルメ　はい
Dialogue: 0,0:07:09.85,0:07:10.35,Main-207+,,0,0,0,,ス—
Dialogue: 0,0:07:36.21,0:07:38.74,Main-207+,,0,0,0,,た、助かった
Dialogue: 0,0:07:39.14,0:07:40.51,Main-207+,,0,0,0,,光…
Dialogue: 0,0:07:40.51,0:07:42.55,Main-207+,,0,0,0,,なぜこんな深海に？
Dialogue: 0,0:07:42.55,0:07:45.45,Main-207+,,0,0,0,,まぶしい\N目がくらむようです
Dialogue: 0,0:07:45.45,0:07:48.75,Main-207+,,0,0,0,,私くらむ目ないんですけどね
Dialogue: 0,0:07:49.75,0:07:52.42,Main-207+,,0,0,0,,おい！お前ら！来てみろ
Dialogue: 0,0:07:52.82,0:07:54.73,Main-207+,,0,0,0,,上見ろよ　上
Dialogue: 0,0:07:55.59,0:07:57.73,Main-207+,,0,0,0,,光っててよく見えねえ
Dialogue: 0,0:07:57.73,0:07:59.43,Main-207+,,0,0,0,,おいナミ　あれか？
Dialogue: 0,0:07:59.43,0:08:02.07,Main-207+,,0,0,0,,ええ　間違いないわ
Dialogue: 0,0:08:02.07,0:08:04.33,Main-207+,,0,0,0,,指針はあの島を指してる
Dialogue: 0,0:08:04.33,0:08:05.44,Main-207+,,0,0,0,,あれが…
Dialogue: 0,0:08:07.04,0:08:09.31,Main-207+,,0,0,0,,魚人島！
Dialogue: 0,0:08:09.31,0:08:11.41,Main-207+,,0,0,0,,でっけえ！
Dialogue: 0,0:08:11.84,0:08:14.44,Main-207+,,0,0,0,,大きなシャボンに囲まれてる
Dialogue: 0,0:08:14.44,0:08:16.15,Main-207+,,0,0,0,,中に雲が？
Dialogue: 0,0:08:16.15,0:08:18.15,Main-207+,,0,0,0,,空気はあるのかも
Dialogue: 0,0:08:22.19,0:08:24.02,Main-207+,,0,0,0,,やった！
Dialogue: 0,0:08:24.02,0:08:25.62,Main-207+,,0,0,0,,着いたぞ！
Dialogue: 0,0:08:26.76,0:08:29.29,Main-207+,,0,0,0,,グランドラインの名スポット
Dialogue: 0,0:08:30.96,0:08:33.10,Main-207+,,0,0,0,,着いちゃったのね
Dialogue: 0,0:08:35.63,0:08:38.00,Main-207+,,0,0,0,,人魚たちの舞い踊る島…
Dialogue: 0,0:08:38.00,0:08:39.80,Main-207+,,0,0,0,,美しい人魚姫…
Dialogue: 0,0:08:39.80,0:08:42.17,Main-207+,,0,0,0,,ついにたどり着いたんだ
Dialogue: 0,0:08:42.17,0:08:46.48,Main-207+,,0,0,0,,ガキの頃から憧れた夢の楽園
Dialogue: 0,0:08:40.27,0:08:46.48,Main-207+,,0,0,0,,{\an8}バンザイ！バンザイ！バンザイ！バンザイ！
Dialogue: 0,0:08:40.77,0:08:46.48,Secondary-207+,,0,0,0,,{\an8}スーパー！スーパー！スーパー！スーパー！スーパー！スーパー！
Dialogue: 0,0:08:48.38,0:08:53.02,Main-207+,,0,0,0,,–　マーメイドゥ！マーメイドゥ！\N–　マーメイドゥ！マーメイドゥ！
Dialogue: 0,0:08:53.02,0:08:55.05,Main-207+,,0,0,0,,–　マーメイ…\N–　マーメイ…
Dialogue: 0,0:08:55.05,0:08:58.66,Main-207+,,0,0,0,,サンジ！やっぱダメだ\N妄想だけでこのざま？
Dialogue: 0,0:08:58.66,0:08:59.52,Main-207+,,0,0,0,,サンジ！
Dialogue: 0,0:09:09.57,0:09:10.83,Main-207+,,0,0,0,,ごめんなサンジ
Dialogue: 0,0:09:10.83,0:09:12.90,Main-207+,,0,0,0,,リハビリが間に合わなかった
Dialogue: 0,0:09:13.30,0:09:16.14,Main-207+,,0,0,0,,本物の人魚たちにも\Nもう会わねえほうが…
Dialogue: 0,0:09:16.14,0:09:17.64,Main-207+,,0,0,0,,ドクター！
Dialogue: 0,0:09:17.64,0:09:22.01,Main-207+,,0,0,0,,魚人島の人魚たちに会うことは\Nこいつの夢なんだよ
Dialogue: 0,0:09:22.01,0:09:24.51,Main-207+,,0,0,0,,だけど会えば命を落とすぞ
Dialogue: 0,0:09:24.51,0:09:25.48,Main-207+,,0,0,0,,そんな…
Dialogue: 0,0:09:27.38,0:09:29.09,Main-207+,,0,0,0,,かまわねえ…
Dialogue: 0,0:09:29.09,0:09:29.89,Main-207+,,0,0,0,,サンジ！
Dialogue: 0,0:09:30.85,0:09:33.72,Main-207+,,0,0,0,,夢かなわず生き永らえるより
Dialogue: 0,0:09:34.62,0:09:38.36,Main-207+,,0,0,0,,人魚たちをエロい目で見て死にたい
Dialogue: 0,0:09:38.86,0:09:39.80,Main-207+,,0,0,0,,最低か
Dialogue: 0,0:09:40.56,0:09:44.84,Main-207+,,0,0,0,,人魚たちに　俺は会う！
Dialogue: 0,0:09:44.84,0:09:45.70,Main-207+,,0,0,0,,熱い
Dialogue: 0,0:09:45.70,0:09:47.04,Main-207+,,0,0,0,,エロの炎が！？
Dialogue: 0,0:09:48.71,0:09:50.14,Main-207+,,0,0,0,,楽しみだなあ～
Dialogue: 0,0:09:50.14,0:09:53.98,Main-207+,,0,0,0,,魚人島の料理には\N何の肉が入ってんのかなあ
Dialogue: 0,0:09:53.98,0:09:56.28,Main-207+,,0,0,0,,ルフィ　ヨダレ拭いて
Dialogue: 0,0:09:56.28,0:09:58.28,Main-207+,,0,0,0,,スルメに頼んでくれる？
Dialogue: 0,0:09:58.28,0:10:00.65,Main-207+,,0,0,0,,魚人島の入り口を探しましょう
Dialogue: 0,0:10:00.65,0:10:02.35,Main-207+,,0,0,0,,おい　何だこいつら
Dialogue: 0,0:10:05.09,0:10:08.29,Main-207+,,0,0,0,,何を人間なんぞに従わされてんだ？
Dialogue: 0,0:10:08.29,0:10:10.23,Main-207+,,0,0,0,,クラーケン
Dialogue: 0,0:10:12.00,0:10:14.00,Main-207+,,0,0,0,,誰だこいつら
Dialogue: 0,0:10:14.60,0:10:16.90,Main-207+,,0,0,0,,海獣の群れ？
Dialogue: 0,0:10:18.40,0:10:21.57,Main-207+,,0,0,0,,終わった\Nここまで来たのに
Dialogue: 0,0:10:21.97,0:10:26.54,Main-207+,,0,0,0,,カッコいいな〜
Dialogue: 0,0:10:28.18,0:10:30.58,Main-207+,,0,0,0,,誰か乗ってるぞ
Dialogue: 0,0:10:36.62,0:10:38.52,Main-207+,,0,0,0,,{\an8\pos(1442,27)}何すんだスルメ！
Dialogue: 0,0:10:38.52,0:10:41.02,Main-207+,,0,0,0,,{\an8\pos(1442,27)}もうひと息運んでくれよ
Dialogue: 0,0:10:54.30,0:10:58.17,Main-207+,,0,0,0,,か、海獣の群れの\Nド真ん中じゃねえかよ！
Dialogue: 0,0:10:59.84,0:11:02.41,Main-207+,,0,0,0,,お前たち麦わらの一味だな
Dialogue: 0,0:11:03.98,0:11:06.28,Main-207+,,0,0,0,,よ〜く知ってるとも
Dialogue: 0,0:11:07.02,0:11:11.76,Main-207+,,0,0,0,,かつて　アーロン一味の\N野望を打ち砕いた海賊たち
Dialogue: 0,0:11:13.56,0:11:16.86,Main-207+,,0,0,0,,それで済めば答えは簡単だったが
Dialogue: 0,0:11:17.26,0:11:22.77,Main-207+,,0,0,0,,よりによって２年前\N元アーロン一味の幹部ハチさんをかばい
Dialogue: 0,0:11:23.63,0:11:27.60,Main-207+,,0,0,0,,あの憎き天竜人を\Nぶちのめしたとも聞いている
Dialogue: 0,0:11:29.11,0:11:35.31,Main-207+,,0,0,0,,まるで我々の敬愛する魚人島の英雄…\Nフィッシャー・タイガーのように
Dialogue: 0,0:11:35.95,0:11:37.81,Main-207+,,0,0,0,,フィッシャー・タイガー？
Dialogue: 0,0:11:40.25,0:11:42.79,Main-207+,,0,0,0,,{\an8}まったく扱いに困る
Dialogue: 0,0:11:42.79,0:11:45.66,Main-207+,,0,0,0,,{\an8}なあ　教えてくれ
Dialogue: 0,0:11:45.66,0:11:48.53,Main-207+,,0,0,0,,{\an8}お前たちは敵なのか 味方なのか
Dialogue: 0,0:11:49.23,0:11:51.66,Main-207+,,0,0,0,,{\an8}選択する権利を与えてやる
Dialogue: 0,0:11:52.20,0:11:55.97,Main-207+,,0,0,0,,{\an8}我々新魚人海賊団の傘下に下るか…
Dialogue: 0,0:11:56.67,0:11:58.50,Main-207+,,0,0,0,,{\an8}拒否するか
Dialogue: 0,0:11:59.14,0:12:01.37,Main-207+,,0,0,0,,拒めばここで沈んでもらう
Dialogue: 0,0:12:01.37,0:12:02.67,Main-207+,,0,0,0,,何だと？
Dialogue: 0,0:12:03.67,0:12:05.71,Main-207+,,0,0,0,,フランキー　燃料補給して
Dialogue: 0,0:12:05.71,0:12:07.31,Main-207+,,0,0,0,,はあ？何する気だ
Dialogue: 0,0:12:07.88,0:12:11.28,Main-207+,,0,0,0,,ルフィたちが\Nあいつらの言うこと聞くわけないでしょ
Dialogue: 0,0:12:12.22,0:12:15.49,Main-207+,,0,0,0,,とはいえ\Nここは深海１万メートル
Dialogue: 0,0:12:15.49,0:12:18.99,Main-207+,,0,0,0,,こっちは戦うことさえできない\N勝機はゼロ
Dialogue: 0,0:12:19.32,0:12:20.52,Main-207+,,0,0,0,,だから逃げる
Dialogue: 0,0:12:21.09,0:12:26.03,Main-207+,,0,0,0,,この船の空気全部使って\Nクー・ド・バーストで魚人島に突っ込むの
Dialogue: 0,0:12:27.73,0:12:28.80,Main-207+,,0,0,0,,正気か？
Dialogue: 0,0:12:29.43,0:12:32.40,Main-207+,,0,0,0,,そうしなきゃここへ来て\N全滅よ
Dialogue: 0,0:12:33.34,0:12:37.84,Main-207+,,0,0,0,,確かに　それ以外に\N生き残るすべはなさそうね
Dialogue: 0,0:12:37.84,0:12:40.61,Main-207+,,0,0,0,,よし\N俺が燃料の補給を
Dialogue: 0,0:12:40.61,0:12:42.38,Main-207+,,0,0,0,,フランキー！操舵を頼む
Dialogue: 0,0:12:42.38,0:12:45.68,Main-207+,,0,0,0,,よし来た　スーパー任せろ
Dialogue: 0,0:12:47.12,0:12:52.12,Main-207+,,0,0,0,,さあ俺たちの手下になるか？\N麦わらのルフィ
Dialogue: 0,0:12:53.66,0:12:55.16,Main-207+,,0,0,0,,ヤダね
Dialogue: 0,0:12:55.16,0:12:56.63,Main-207+,,0,0,0,,バ〜カ！
Dialogue: 0,0:12:59.86,0:13:01.63,Main-207+,,0,0,0,,拒否したな
Dialogue: 0,0:13:02.23,0:13:05.54,Main-207+,,0,0,0,,我々新魚人海賊団の勧誘を
Dialogue: 0,0:13:05.94,0:13:08.51,Main-207+,,0,0,0,,ならばお前たちは魚人の敵
Dialogue: 0,0:13:08.51,0:13:11.04,Main-207+,,0,0,0,,ただの罪深き人間だ
Dialogue: 0,0:13:14.04,0:13:17.41,Main-207+,,0,0,0,,なんでお前らの手下に\Nなんなきゃいけえねえんだ
Dialogue: 0,0:13:17.41,0:13:20.05,Main-207+,,0,0,0,,ルフィ\N逆なでしねえほうが…
Dialogue: 0,0:13:20.75,0:13:22.25,Main-207+,,0,0,0,,残念だ
Dialogue: 0,0:13:22.25,0:13:25.19,Main-207+,,0,0,0,,じゃあ\Nここを通すわけにはいかねえ
Dialogue: 0,0:13:25.72,0:13:28.16,Main-207+,,0,0,0,,お前らにはここで沈んでもらう
Dialogue: 0,0:13:29.19,0:13:30.43,Main-207+,,0,0,0,,海獅子！
Dialogue: 0,0:13:34.70,0:13:36.70,Main-207+,,0,0,0,,燃料補給完了
Dialogue: 0,0:13:36.70,0:13:38.33,Main-207+,,0,0,0,,フランキー！いいぞ！
Dialogue: 0,0:13:39.50,0:13:40.77,Main-207+,,0,0,0,,沈めちまえ！
Dialogue: 0,0:13:40.77,0:13:42.34,Main-207+,,0,0,0,,やんのか？
Dialogue: 0,0:13:45.08,0:13:46.81,Main-207+,,0,0,0,,行ってフランキー！
Dialogue: 0,0:13:47.14,0:13:49.11,Main-207+,,0,0,0,,このサニー号も獅子さ
Dialogue: 0,0:13:49.88,0:13:53.25,Main-207+,,0,0,0,,いずれケリをつけようぜ\N海獅子
Dialogue: 0,0:13:53.62,0:13:55.09,Main-207+,,0,0,0,,いくぞ
Dialogue: 0,0:13:55.09,0:13:58.05,Main-207+,,0,0,0,,{\fad(150,150)}クー・ド・バースト！
Dialogue: 0,0:14:03.26,0:14:04.23,Main-207+,,0,0,0,,帆船が…
Dialogue: 0,0:14:13.67,0:14:15.97,Main-207+,,0,0,0,,空気がなくなる
Dialogue: 0,0:14:17.31,0:14:19.34,Main-207+,,0,0,0,,ペチャンコになる
Dialogue: 0,0:14:20.98,0:14:22.65,Main-207+,,0,0,0,,息ができない
Dialogue: 0,0:14:22.65,0:14:25.25,Main-207+,,0,0,0,,私　肺ないんですけど
Dialogue: 0,0:14:26.45,0:14:29.42,Main-207+,,0,0,0,,耐えて\N魚人島に突っ込むまで
Dialogue: 0,0:14:32.16,0:14:35.23,Main-207+,,0,0,0,,どうなってんだ！？あの船は
Dialogue: 0,0:14:36.03,0:14:38.23,Main-207+,,0,0,0,,突入するぞ
Dialogue: 0,0:14:38.23,0:14:40.73,Main-207+,,0,0,0,,待ってて俺のマーメイドたち
Dialogue: 0,0:14:49.84,0:14:51.57,Main-207+,,0,0,0,,コーティングが剥がれたぞ
Dialogue: 0,0:14:51.57,0:14:54.28,Main-207+,,0,0,0,,巨大シャボンに持ってかれた
Dialogue: 0,0:14:56.35,0:14:57.28,Main-207+,,0,0,0,,前を
Dialogue: 0,0:14:58.11,0:14:59.68,Main-207+,,0,0,0,,何ですかあれ
Dialogue: 0,0:15:00.68,0:15:03.85,Main-207+,,0,0,0,,{\fad(0,514)}このシャボンは二重構造になってる
Dialogue: 0,0:15:04.15,0:15:07.36,Main-207+,,0,0,0,,普通の船なら\Nこの空気の層で落下する
Dialogue: 0,0:15:07.92,0:15:10.66,Main-207+,,0,0,0,,もう１発激突するぞ
Dialogue: 0,0:15:10.66,0:15:12.13,Main-207+,,0,0,0,,しがみつけ
Dialogue: 0,0:15:20.20,0:15:21.47,Main-207+,,0,0,0,,海
Dialogue: 0,0:15:33.12,0:15:36.05,Thoughts-207+,,0,0,0,,{\t(2181,0,1,\c&H000000&\3c&H000000&)}すごい潮の流れ
Dialogue: 0,0:15:40.76,0:15:42.76,Main-207+,,0,0,0,,助けて…
Dialogue: 0,0:15:42.76,0:15:44.49,Main-207+,,0,0,0,,{\t(1216,0,1,\c&H000000&}息が…
Dialogue: 0,0:15:46.56,0:15:49.27,Thoughts-207+,,0,0,0,,能力者が４人もいるってのに
Dialogue: 0,0:15:58.44,0:15:59.64,Thoughts-207+,,0,0,0,,{\t(685,0,1,\c&H000000&\3c&H000000&)}手を…
Dialogue: 0,0:16:00.71,0:16:02.21,Thoughts-207+,,0,0,0,,伸ばせ
Dialogue: 0,0:16:05.05,0:16:06.68,Thoughts-207+,,0,0,0,,ナミさん
Dialogue: 0,0:16:06.68,0:16:08.32,Thoughts-207+,,0,0,0,,ロビンちゃん
Dialogue: 0,0:16:10.52,0:16:11.79,Thoughts-207+,,0,0,0,,クソッ
Dialogue: 0,0:16:11.79,0:16:14.32,Thoughts-207+,,0,0,0,,{\t(2016,0,1,\c&H000000&\3c&H000000&)}流れに逆らえねえ
Dialogue: 0,0:16:28.71,0:16:32.38,Main-207+,,0,0,0,,むちゃな入国を…\N自爆かもしれねえな
Dialogue: 0,0:16:32.78,0:16:35.78,Main-207+,,0,0,0,,追うかいハモンド　内地まで
Dialogue: 0,0:16:35.78,0:16:38.41,Main-207+,,0,0,0,,生きてるかどうかは分からんが
Dialogue: 0,0:16:40.15,0:16:42.29,Main-207+,,0,0,0,,一応行くさ
Dialogue: 0,0:16:42.29,0:16:45.72,Main-207+,,0,0,0,,ネプチューン軍に先に\N見つかってしまうのはしゃくだ
Dialogue: 0,0:16:45.72,0:16:50.49,Main-207+,,0,0,0,,だが　いったんノアへ戻って\Nお頭の耳に入れよう
Dialogue: 0,0:16:50.49,0:16:55.00,Main-207+,,0,0,0,,“アーロンさんの野望を\N打ち砕いた麦わらが来た”と
Dialogue: 0,0:17:06.34,0:17:07.11,Main-207+,,0,0,0,,ほら
Dialogue: 0,0:17:10.68,0:17:11.71,Main-207+,,0,0,0,,ほら　見て
Dialogue: 0,0:17:11.71,0:17:12.58,Main-207+,,0,0,0,,見た
Dialogue: 0,0:17:12.58,0:17:13.65,Main-207+,,0,0,0,,見てない
Dialogue: 0,0:17:13.65,0:17:14.88,Main-207+,,0,0,0,,見たんじゃない？
Dialogue: 0,0:17:14.88,0:17:16.15,Main-207+,,0,0,0,,見たけど何？
Dialogue: 0,0:17:18.86,0:17:20.22,Main-207+,,0,0,0,,ほら動いた
Dialogue: 0,0:17:20.22,0:17:21.22,Main-207+,,0,0,0,,動いた
Dialogue: 0,0:17:21.22,0:17:22.73,Main-207+,,0,0,0,,動いてない！
Dialogue: 0,0:17:22.73,0:17:24.63,Main-207+,,0,0,0,,動いたんじゃない？
Dialogue: 0,0:17:24.63,0:17:25.96,Main-207+,,0,0,0,,動いたから何？
Dialogue: 0,0:17:30.27,0:17:32.67,Main-207+,,0,0,0,,やった　気がついた
Dialogue: 0,0:17:32.67,0:17:34.64,Main-207+,,0,0,0,,ルフィ！
Dialogue: 0,0:17:37.21,0:17:38.47,Main-207+,,0,0,0,,ルフィちん
Dialogue: 0,0:17:39.74,0:17:42.21,Main-207+,,0,0,0,,よかった　無事で
Dialogue: 0,0:17:42.21,0:17:44.11,Main-207+,,0,0,0,,気分はどう？
Dialogue: 0,0:17:46.92,0:17:50.85,Main-207+,,0,0,0,,ケイミーじゃねえか\N久しぶりだな
Dialogue: 0,0:17:50.85,0:17:55.46,Main-207+,,0,0,0,,また一段とかわいくなったね\Nケイミーちゃ〜ん
Dialogue: 0,0:17:55.46,0:17:58.29,Main-207+,,0,0,0,,俺たち魚人島に着いたのか？
Dialogue: 0,0:17:58.29,0:17:59.60,Main-207+,,0,0,0,,そうだぞ！
Dialogue: 0,0:17:59.60,0:18:03.97,Main-207+,,0,0,0,,俺たちが溺れてたとこを\N人魚たちが助けてくれたんだってよ
Dialogue: 0,0:18:03.97,0:18:04.97,Main-207+,,0,0,0,,そうそう
Dialogue: 0,0:18:04.97,0:18:09.11,Main-207+,,0,0,0,,何を隠そう　今の今まで\N俺たちも気を失ってたんだ
Dialogue: 0,0:18:09.11,0:18:11.41,Main-207+,,0,0,0,,ここはケイミーちゃんの家だ
Dialogue: 0,0:18:11.41,0:18:12.38,Main-207+,,0,0,0,,ほら　帽子
Dialogue: 0,0:18:12.38,0:18:14.94,Main-207+,,0,0,0,,へえ　ケイミーの家
Dialogue: 0,0:18:14.94,0:18:16.35,Main-207+,,0,0,0,,ごめんね
Dialogue: 0,0:18:16.35,0:18:21.95,Main-207+,,0,0,0,,私みんなのこと迎えに行くつもりだったのに\N時期を１か月 勘違いしてて…
Dialogue: 0,0:18:21.95,0:18:23.45,Main-207+,,0,0,0,,気にすんな
Dialogue: 0,0:18:23.45,0:18:24.52,Main-207+,,0,0,0,,ほかのみんなは？
Dialogue: 0,0:18:25.36,0:18:26.96,Main-207+,,0,0,0,,それが…
Dialogue: 0,0:18:26.96,0:18:29.36,Main-207+,,0,0,0,,はぐれちゃったみたいでよ
Dialogue: 0,0:18:29.86,0:18:32.63,Main-207+,,0,0,0,,みんな　大丈夫かな
Dialogue: 0,0:18:32.63,0:18:33.86,Main-207+,,0,0,0,,そうなのか？
Dialogue: 0,0:18:33.86,0:18:39.64,Main-207+,,0,0,0,,ああ　途中まで姿を追っていたが\N海底へ流されたのは俺たちだけだ
Dialogue: 0,0:18:40.14,0:18:43.14,Main-207+,,0,0,0,,まあでも\N向こうも何とかなるだろ
Dialogue: 0,0:18:43.14,0:18:44.57,Main-207+,,0,0,0,,まあな
Dialogue: 0,0:18:44.57,0:18:47.08,Main-207+,,0,0,0,,海じゃ骨は役に立たねえが
Dialogue: 0,0:18:47.08,0:18:50.58,Main-207+,,0,0,0,,あっちにはロボも緑もいる\N大丈夫だろ
Dialogue: 0,0:18:50.95,0:18:53.52,Main-207+,,0,0,0,,みんなにも早く会いたいな
Dialogue: 0,0:18:53.52,0:18:55.08,Main-207+,,0,0,0,,あっ　はい！これ
Dialogue: 0,0:18:55.08,0:18:57.15,Main-207+,,0,0,0,,みんな体が冷えちゃったでしょ
Dialogue: 0,0:18:57.15,0:18:59.39,Main-207+,,0,0,0,,スープできたから飲んであったまって
Dialogue: 0,0:19:00.66,0:19:01.52,Main-207+,,0,0,0,,ジャ〜ン
Dialogue: 0,0:19:01.52,0:19:03.36,Main-207+,,0,0,0,,ワカメの冷スープ
Dialogue: 0,0:19:03.73,0:19:04.46,Main-207+,,0,0,0,,おいしいよ
Dialogue: 0,0:19:08.63,0:19:10.50,Main-207+,,0,0,0,,冷…　スープ？
Dialogue: 0,0:19:10.50,0:19:11.33,Main-207+,,0,0,0,,うん！
Dialogue: 0,0:19:14.67,0:19:17.81,Main-207+,,0,0,0,,冷スープじゃ体が温まらないじゃない
Dialogue: 0,0:19:17.81,0:19:19.34,Main-207+,,0,0,0,,どうしよう
Dialogue: 0,0:19:19.34,0:19:20.74,Main-207+,,0,0,0,,ええ〜っ！
Dialogue: 0,0:19:20.74,0:19:23.08,Main-207+,,0,0,0,,間違えちゃった〜っ！
Dialogue: 0,0:19:25.42,0:19:28.79,Main-207+,,0,0,0,,大丈夫さ　ケイミーちゃん
Dialogue: 0,0:19:28.79,0:19:31.72,Main-207+,,0,0,0,,逆にあったまるよ〜
Dialogue: 0,0:19:31.72,0:19:33.56,Main-207+,,0,0,0,,何だ？“逆”って
Dialogue: 0,0:19:33.56,0:19:35.36,Main-207+,,0,0,0,,おい　サンジ俺も
Dialogue: 0,0:19:37.89,0:19:39.86,Main-207+,,0,0,0,,洗濯物乾いたよ
Dialogue: 0,0:19:39.86,0:19:40.73,Main-207+,,0,0,0,,乾いた
Dialogue: 0,0:19:40.73,0:19:42.37,Main-207+,,0,0,0,,まだ乾いてない
Dialogue: 0,0:19:42.37,0:19:43.87,Main-207+,,0,0,0,,乾いたんじゃない？
Dialogue: 0,0:19:43.87,0:19:45.13,Main-207+,,0,0,0,,乾いたから何？
Dialogue: 0,0:19:50.51,0:19:52.78,Main-207+,,0,0,0,,服乾かしてくれたのか
Dialogue: 0,0:19:52.78,0:19:53.88,Main-207+,,0,0,0,,ありがとう
Dialogue: 0,0:19:53.88,0:19:54.58,Main-207+,,0,0,0,,サンキュー
Dialogue: 0,0:19:55.14,0:19:57.41,Main-207+,,0,0,0,,ところでおめえら何だ？
Dialogue: 0,0:19:57.41,0:19:59.35,Main-207+,,0,0,0,,あっ　私のお友達
Dialogue: 0,0:19:59.35,0:20:01.32,Main-207+,,0,0,0,,メダカの人魚の五つ子ちん
Dialogue: 0,0:20:01.32,0:20:02.45,Main-207+,,0,0,0,,イチカです
Dialogue: 0,0:20:02.45,0:20:03.32,Main-207+,,0,0,0,,ニカです
Dialogue: 0,0:20:03.32,0:20:04.32,Main-207+,,0,0,0,,サンカです
Dialogue: 0,0:20:04.32,0:20:05.22,Main-207+,,0,0,0,,ヨンカです
Dialogue: 0,0:20:05.22,0:20:06.72,Main-207+,,0,0,0,,ヨンカツーです
Dialogue: 0,0:20:06.72,0:20:08.56,Main-207+,,0,0,0,,いや\N“ゴカ”でいいだろそこは
Dialogue: 0,0:20:09.09,0:20:11.73,Main-207+,,0,0,0,,泳ぎが速くて情報通なんだよ
Dialogue: 0,0:20:11.73,0:20:13.93,Main-207+,,0,0,0,,へえ～　そうなんだ
Dialogue: 0,0:20:13.93,0:20:16.83,Main-207+,,0,0,0,,ここは人魚の入り江の海底
Dialogue: 0,0:20:16.83,0:20:21.10,Main-207+,,0,0,0,,街のマーメイドカフェの女子寮だから\Nお友達がいっぱいいるの
Comment: 0,0:20:21.10,0:20:22.17,Main-207+,,0,0,0,,えっ！？
Dialogue: 0,0:20:22.57,0:20:23.71,Main-207+,,0,0,0,,女子寮？
Dialogue: 0,0:20:24.07,0:20:25.14,Main-207+,,0,0,0,,ケイミーちゃん！
Dialogue: 0,0:20:25.14,0:20:28.88,Main-207+,,0,0,0,,そ、その　マッマッ\Nマーメイドカフェとは…
Dialogue: 0,0:20:28.88,0:20:32.12,Main-207+,,0,0,0,,私が今\Nウェイトレスをしているお店だよ
Dialogue: 0,0:20:32.12,0:20:34.12,Main-207+,,0,0,0,,美人な人魚がいっぱいいるよ
Dialogue: 0,0:20:34.12,0:20:36.25,Main-207+,,0,0,0,,び、美人　人魚
Dialogue: 0,0:20:39.06,0:20:41.16,Main-207+,,0,0,0,,コーヒーにする？それとも…
Dialogue: 0,0:20:44.06,0:20:46.96,Main-207+,,0,0,0,,–　サンジが…\N–　危ない！
Dialogue: 0,0:20:47.50,0:20:48.80,Main-207+,,0,0,0,,こなくそ〜！
Dialogue: 0,0:20:48.80,0:20:49.77,Main-207+,,0,0,0,,–　耐えた\N–　耐えた
Dialogue: 0,0:20:50.50,0:20:51.47,Main-207+,,0,0,0,,俺は…
Dialogue: 0,0:20:53.20,0:20:57.87,Main-207+,,0,0,0,,俺はこの魚人島では\N鼻血を噴いて意識を失うようなマネは
Dialogue: 0,0:20:57.87,0:21:00.44,Main-207+,,0,0,0,,絶対せんと誓ったんだ
Dialogue: 0,0:21:03.55,0:21:08.62,Main-207+,,0,0,0,,だから…\Nもう報われてもいいはずだ
Dialogue: 0,0:21:08.62,0:21:10.02,Main-207+,,0,0,0,,切実だな
Dialogue: 0,0:21:10.02,0:21:10.05,Main-207+,,0,0,0,,{\clip(806.14,906.06,1326.21,1080)}切実だな
Dialogue: 0,0:21:10.05,0:21:10.09,Main-207+,,0,0,0,,{\clip(931,887.39,1297.7,1080)}切実だな
Dialogue: 0,0:21:10.09,0:21:10.12,Main-207+,,0,0,0,,{\clip(1053.89,915.89,1338,1080)}切実だな
Dialogue: 0,0:21:10.12,0:21:10.15,Main-207+,,0,0,0,,{\clip(1178.74,937.5,1290.81,1080)}切実だな
Dialogue: 0,0:21:10.85,0:21:11.45,Main-207+,,0,0,0,,そうだ
Dialogue: 0,0:21:11.95,0:21:13.59,Main-207+,,0,0,0,,上に行ってみようよ
Dialogue: 0,0:21:13.59,0:21:15.53,Main-207+,,0,0,0,,お友達紹介するね
Dialogue: 0,0:21:18.43,0:21:20.40,Main-207+,,0,0,0,,おっ～！カメだ
Dialogue: 0,0:21:20.90,0:21:23.27,Main-207+,,0,0,0,,“海亀ELEVATOR”だって
Dialogue: 0,0:21:25.13,0:21:26.94,Main-207+,,0,0,0,,カメちん\N上までよろしく
Dialogue: 0,0:21:32.58,0:21:35.14,Main-207+,,0,0,0,,ここは海中のサンゴマンションね
Dialogue: 0,0:21:35.14,0:21:38.11,Main-207+,,0,0,0,,私の寮は家賃も安いから\N最下層なの
Dialogue: 0,0:21:38.11,0:21:41.65,Main-207+,,0,0,0,,光の入る最上階は\N１番値段が高いの
Dialogue: 0,0:21:42.65,0:21:44.55,Main-207+,,0,0,0,,お前貧乏なのか？
Dialogue: 0,0:21:44.55,0:21:46.46,Main-207+,,0,0,0,,そういやハチとパッパグは？
Dialogue: 0,0:21:46.46,0:21:49.33,Main-207+,,0,0,0,,はっちんは１年ほど前に\N大ケガしちゃって…
Dialogue: 0,0:21:49.33,0:21:54.13,Main-207+,,0,0,0,,あいつシャボンディ諸島で\Nサニー号を守ってくれたんだよな
Dialogue: 0,0:21:54.13,0:21:57.77,Main-207+,,0,0,0,,ケガのほうはもう\Nほとんどいいって聞いてるけど
Dialogue: 0,0:21:57.77,0:22:01.77,Main-207+,,0,0,0,,はっちんはもともと魚人街の出身だから\Nそこで養生してるの
Dialogue: 0,0:22:02.91,0:22:04.01,Main-207+,,0,0,0,,魚人街？
Dialogue: 0,0:22:04.01,0:22:04.94,Main-207+,,0,0,0,,うん
Dialogue: 0,0:22:04.94,0:22:10.45,Main-207+,,0,0,0,,少し怖い所でね　ルフィちんたちが\N一緒なら案内してもいいよ
Dialogue: 0,0:22:10.45,0:22:11.61,Main-207+,,0,0,0,,あとで行こう！
Dialogue: 0,0:22:11.61,0:22:13.78,Main-207+,,0,0,0,,ハチの顔見て礼言わなきゃな
Dialogue: 0,0:22:13.78,0:22:15.59,Main-207+,,0,0,0,,うん！分かった
Dialogue: 0,0:22:15.59,0:22:18.32,Main-207+,,0,0,0,,えっと　あとパッパグは…
Dialogue: 0,0:22:19.46,0:22:22.33,Main-207+,,0,0,0,,あの人は超有名デザイナーだから
Dialogue: 0,0:22:22.33,0:22:27.53,Main-207+,,0,0,0,,魚人島の一等地ギョバリーヒルズに\Nおっきな屋敷を持ってるの
Dialogue: 0,0:22:27.53,0:22:31.03,Main-207+,,0,0,0,,今日もハマグリ届けに行くから\N一緒に行こう
Dialogue: 0,0:22:31.37,0:22:32.87,Main-207+,,0,0,0,,おめえ飼い主だろ？
Dialogue: 0,0:22:33.57,0:22:35.20,Main-207+,,0,0,0,,一緒に住まねえのか？
Dialogue: 0,0:22:36.44,0:22:39.54,Main-207+,,0,0,0,,私にはちょっとあの街は身分違いで…
Dialogue: 0,0:22:40.01,0:22:42.88,Main-207+,,0,0,0,,ハマグリもこの辺のがおいしいし
Dialogue: 0,0:22:42.88,0:22:44.85,Main-207+,,0,0,0,,もうちょっとで着きそうだ
Dialogue: 0,0:22:46.05,0:22:48.78,Main-207+,,0,0,0,,おい\Nあのストローみてえなの何だ？
Dialogue: 0,0:22:48.78,0:22:49.99,Main-207+,,0,0,0,,ああ　あれは
Dialogue: 0,0:22:50.35,0:22:54.06,Main-207+,,0,0,0,,島のシャボン職人が加工した\N“ウォーターロード”
Dialogue: 0,0:22:54.06,0:22:57.03,Main-207+,,0,0,0,,魚たちも私たちもあれに乗って…
Dialogue: 0,0:22:57.59,0:22:59.46,Main-207+,,0,0,0,,あっ\Nちょっと見てて
Dialogue: 0,0:23:06.27,0:23:08.27,Main-207+,,0,0,0,,着いた　海上
Dialogue: 0,0:23:08.27,0:23:10.67,Main-207+,,0,0,0,,ルフィち〜ん！
Dialogue: 0,0:23:12.84,0:23:13.54,Main-207+,,0,0,0,,ほら
Dialogue: 0,0:23:13.54,0:23:15.88,Main-207+,,0,0,0,,空だって泳げるの
Dialogue: 0,0:23:15.88,0:23:17.88,Main-207+,,0,0,0,,おおっ　楽しそう
Dialogue: 0,0:23:19.08,0:23:20.48,Main-207+,,0,0,0,,おい待てよ！
Dialogue: 0,0:23:20.48,0:23:23.92,Main-207+,,0,0,0,,それより深海に空と雲がある
Dialogue: 0,0:23:24.29,0:23:26.09,Main-207+,,0,0,0,,お〜い！ケイミー
Dialogue: 0,0:23:26.09,0:23:27.96,Main-207+,,0,0,0,,女子の声！
Dialogue: 0,0:23:28.66,0:23:30.59,Main-207+,,0,0,0,,みんな
Dialogue: 0,0:23:32.56,0:23:36.57,Main-207+,,0,0,0,,お友達もう平気なの？\N溺れてた海賊さんたち
Comment: 0,0:23:32.56,0:23:34.80,Main-207+,,0,0,0,,
Comment: 0,0:23:34.80,0:23:36.57,Main-207+,,0,0,0,,
Dialogue: 0,0:23:39.00,0:23:42.67,Main-207+,,0,0,0,,入り口から入ってこなかったでしょ？\Nあなたたち
Dialogue: 0,0:23:45.21,0:23:46.44,Main-207+,,0,0,0,,こんにちは
Dialogue: 0,0:23:46.44,0:23:48.44,Main-207+,,0,0,0,,あんまり怖そうじゃないのね
Dialogue: 0,0:23:48.44,0:23:49.95,Main-207+,,0,0,0,,不法入国？
Dialogue: 0,0:23:49.95,0:23:51.08,Main-207+,,0,0,0,,ワイルド！
Dialogue: 0,0:23:51.08,0:23:52.72,Main-207+,,0,0,0,,海賊って好きよ私
Dialogue: 0,0:24:02.83,0:24:05.59,Main-207+,,0,0,0,,まるで童話の世界だ
Dialogue: 0,0:24:05.59,0:24:09.53,Main-207+,,0,0,0,,サンゴの大陸　人魚の入り江
Dialogue: 0,0:24:23.51,0:24:24.38,Main-207+,,0,0,0,,なっ！
Dialogue: 0,0:24:24.38,0:24:26.42,Main-207+,,0,0,0,,サンジが号泣中
Dialogue: 0,0:24:26.85,0:24:29.49,Main-207+,,0,0,0,,バラティエを出た時より泣いてんな
Dialogue: 0,0:24:32.39,0:24:34.89,Main-207+,,0,0,0,,見つけたぞ！
Dialogue: 0,0:24:35.26,0:24:38.63,Main-207+,,0,0,0,,ここが俺のオールブルーだ！
Dialogue: 0,0:24:40.86,0:24:43.37,Main-207+,,0,0,0,,{\pos(1320,1053)}いいのかそれで　サンジ
Dialogue: 0,0:24:44.70,0:24:46.54,Main-207+,,0,0,0,,みんなに紹介するね
Dialogue: 0,0:24:47.04,0:24:49.54,Main-207+,,0,0,0,,こちら船長のルフィちん
Dialogue: 0,0:24:49.54,0:24:50.74,Main-207+,,0,0,0,,おう　よろしく
Dialogue: 0,0:24:51.37,0:24:53.21,Main-207+,,0,0,0,,泣いてるのがサンジちん
Dialogue: 0,0:24:53.84,0:24:55.71,Main-207+,,0,0,0,,鼻のウソップちん
Dialogue: 0,0:24:55.71,0:24:56.45,Main-207+,,0,0,0,,よろしくな
Dialogue: 0,0:24:56.95,0:24:59.12,Main-207+,,0,0,0,,タヌキのチョッパーちん
Dialogue: 0,0:24:59.12,0:25:00.22,Main-207+,,0,0,0,,トナカイだよ！
Dialogue: 0,0:25:01.15,0:25:04.09,Main-207+,,0,0,0,,どうしたの？涙流しちゃって
Dialogue: 0,0:25:05.32,0:25:06.69,Main-207+,,0,0,0,,いらっしゃいよ！
Dialogue: 0,0:25:06.69,0:25:08.79,Main-207+,,0,0,0,,一緒に海で踊りましょう！
Dialogue: 0,0:25:13.76,0:25:16.40,Main-207+,,0,0,0,,そうか　理解した
Dialogue: 0,0:25:16.40,0:25:19.00,Main-207+,,0,0,0,,こんな幸せあるわけねえ
Dialogue: 0,0:25:19.00,0:25:21.80,Main-207+,,0,0,0,,俺は\Nきっと今日死ぬんだ
Dialogue: 0,0:25:21.80,0:25:23.64,Main-207+,,0,0,0,,ネガティブ！
Dialogue: 0,0:25:23.64,0:25:26.78,Main-207+,,0,0,0,,ホントこの２年\Nお前の身に何が起きた？
Dialogue: 0,0:25:26.78,0:25:30.15,Main-207+,,0,0,0,,お前の夢みた楽園だろう\Nこの島は
Dialogue: 0,0:25:31.35,0:25:33.58,Main-207+,,0,0,0,,面白えな　サンジは
Dialogue: 0,0:25:33.58,0:25:35.72,Main-207+,,0,0,0,,–　面白くねえよ\N–　面白くねえよ
Dialogue: 0,0:25:43.83,0:25:45.59,Main-207+,,0,0,5,,そうか
Dialogue: 0,0:25:45.59,0:25:50.53,Main-207+,,0,0,5,,麦わらのルフィが　とうとうここまで来たか
Dialogue: 0,0:25:51.60,0:25:52.60,Main-207+,,0,0,0,,ええ
Dialogue: 0,0:25:52.60,0:25:56.57,Main-207+,,0,0,0,,ど、どうします　お頭
Dialogue: 0,0:25:58.77,0:26:00.41,Main-207+,,0,0,0,,連れてこいよ
Dialogue: 0,0:26:01.78,0:26:03.11,Main-207+,,0,0,0,,ここへ
Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=15}===============================DIALOGUE============================
