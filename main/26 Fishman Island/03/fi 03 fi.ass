Dialogue: 0,0:01:53.56,0:01:56.27,Main-207+,,0,0,0,,Merenalainen tulivuori on purkautumassa!
Dialogue: 0,0:01:56.83,0:01:59.20,Main-207+,,0,0,0,,Me ollaan aivan liian lähellä!
Dialogue: 0,0:01:59.84,0:02:02.51,Main-207+,,0,0,0,,Miehet!
Dialogue: 0,0:02:02.51,0:02:04.71,Main-207+,,0,0,0,,Vetäydytään toistaiseksi!
Dialogue: 0,0:02:05.34,0:02:08.68,Main-207+,,0,0,0,,Käskystä, kapteeni Vander Decken!
Dialogue: 0,0:02:08.68,0:02:11.72,Main-207+,,0,0,0,,Krottis! Wadatsumi! Vetäkää laivaa!
Dialogue: 0,0:02:11.72,0:02:13.12,Main-207+,,0,0,0,,S-Selevä homma!
Dialogue: 0,0:02:13.85,0:02:18.02,Main-207+,,0,0,0,,Mies olen maailman varakkain!\NKapteeni Vander Decken!
Dialogue: 0,0:02:20.06,0:02:21.13,Main-207+,,0,0,0,,Kauheaa!
Dialogue: 0,0:02:21.53,0:02:25.66,Main-207+,,0,0,0,,Luffy! Sano krakenille, että meidän\Ntäytyy mennä pian kauas täältä!
Dialogue: 0,0:02:25.66,0:02:26.66,Main-207+,,0,0,0,,Jeah!
Dialogue: 0,0:02:26.66,0:02:28.00,Main-207+,,0,0,0,,Hoi, Jalmari!
Dialogue: 0,0:02:28.00,0:02:30.17,Main-207+,,0,0,0,,Seis! Ei ole tarvis!
Dialogue: 0,0:02:32.00,0:02:34.91,Main-207+,,0,0,0,,Se juoksee jo täyttä häkää!
Dialogue: 0,0:02:34.91,0:02:37.44,Main-207+,,0,0,0,,Se siitä legendojen hirmusta!
Dialogue: 0,0:02:37.44,0:02:39.78,Main-207+,,0,0,0,,Hienoa! Taidamme tulla juttuun!
Dialogue: 0,0:02:42.85,0:02:44.21,Main-207+,,0,0,0,,Kamala juoksutyyli.
Dialogue: 0,0:02:44.21,0:02:46.02,Main-207+,,0,0,0,,Älä kritisoi.
Dialogue: 0,0:02:46.02,0:02:48.79,Main-207+,,0,0,0,,Se vaan tietää, miten\Nhirveä juttu purkaus on!
Dialogue: 0,0:02:49.35,0:02:50.79,Main-207+,,0,0,0,,Niinpä!
Dialogue: 0,0:02:50.79,0:02:52.89,Main-207+,,0,0,0,,Ja mitäs toi nyt puuhaa?
Dialogue: 0,0:02:52.89,0:02:56.36,Main-207+,,0,0,0,,Wau! Jes! Come on!
Dialogue: 0,0:02:56.36,0:02:57.56,Main-207+,,0,0,0,,Kuntoutushoitoa!
Dialogue: 0,0:03:00.13,0:03:02.53,Main-207+,,0,0,0,,Mä haluan nähdä purkauksen!
Dialogue: 0,0:03:02.53,0:03:04.87,Main-207+,,0,0,0,,Evakuoitukaa laivan keulaan!
Dialogue: 0,0:03:04.87,0:03:05.94,Main-207+,,0,0,0,,Joo!
Dialogue: 0,0:03:05.94,0:03:09.21,Main-207+,,0,0,0,,Ei muutamalla metrillä ole väliä!
Dialogue: 0,0:03:26.62,0:03:29.03,Main-207+,,0,0,0,,Laava virtaa pitkin merenpohjaa!
Dialogue: 0,0:03:29.53,0:03:31.46,Main-207+,,0,0,0,,Vesi lämpenee nopeasti!
Dialogue: 0,0:03:31.46,0:03:34.90,Main-207+,,0,0,0,,Kuin kiehuvassa vedessä olisi!
Dialogue: 0,0:03:34.90,0:03:36.37,Main-207+,,0,0,0,,Paahdun elävältä!
Dialogue: 0,0:03:34.23,0:03:36.37,Secondary-207+,,0,0,0,,Kuumaa! Kuumaa!
Dialogue: 0,0:03:46.81,0:03:48.85,Main-207+,,0,0,0,,Aavelaiva ja meripeikko!
Dialogue: 0,0:03:52.12,0:03:54.35,Main-207+,,0,0,0,,Pakoon, Jalmari!
Dialogue: 0,0:03:54.35,0:03:56.02,Main-207+,,0,0,0,,Tsemppiä!
Dialogue: 0,0:03:56.02,0:03:58.42,Main-207+,,0,0,0,,Lonkeroa toisen eteen, Jalmari!
Dialogue: 0,0:03:58.42,0:04:01.29,Main-207+,,0,0,0,,Muuten sä keityt kuin kattilassa!
Dialogue: 0,0:04:03.59,0:04:07.43,Main-207+,,0,0,0,,Keitettyä mustekalaa?\NHyvää! Mulle maistuisi!
Dialogue: 0,0:04:10.17,0:04:13.54,Main-207+,,0,0,0,,Lämpötilaerot synnyttävät pyörteitä!
Dialogue: 0,0:04:14.04,0:04:15.01,Main-207+,,0,0,0,,Nami-neiti...
Dialogue: 0,0:04:16.07,0:04:18.48,Main-207+,,0,0,0,,Missä suunnassa on Nereidisaa–
Dialogue: 0,0:04:19.21,0:04:21.04,Main-207+,,0,0,0,,Tässäkin tilanteessa?!
Dialogue: 0,0:04:21.45,0:04:23.08,Main-207+,,0,0,0,,Muista kuntoutus, Sanji!
Dialogue: 0,0:04:23.55,0:04:25.95,Main-207+,,0,0,0,,{\fad(0,1019)}Yhä suoraan eteenpäin!
Dialogue: 0,0:04:27.72,0:04:29.12,Main-207+,,0,0,0,,Vielä vähän!
Dialogue: 0,0:04:32.86,0:04:34.53,Main-207+,,0,0,0,,Tuohon syvänteeseen!
Dialogue: 0,0:04:40.36,0:04:41.97,Main-207+,,0,0,0,,Mitäh?!
Dialogue: 0,0:04:41.97,0:04:44.17,Main-207+,,0,0,0,,Tuonneko?!
Dialogue: 0,0:04:45.50,0:04:48.81,Main-207+,,0,0,0,,{\fad(0,922)}Mikä jyrkänne! Oletko tosissasi?!
Dialogue: 0,0:04:49.14,0:04:51.98,Main-207+,,0,0,0,,Pimeämpää kuin pimeydessä!
Dialogue: 0,0:04:51.98,0:04:55.65,Main-207+,,0,0,0,,Voiko Nereidisaari oikeasti olla tuolla?!
Dialogue: 0,0:05:01.69,0:05:04.05,Main-207+,,0,0,0,,Takana polttaa! Polttaa!
Dialogue: 0,0:05:04.05,0:05:06.76,Main-207+,,0,0,0,,Ja edessä on säkkipimeää! Pelottaa!
Dialogue: 0,0:05:07.16,0:05:09.49,Main-207+,,0,0,0,,Siellä on taatusti lisää kammotuksia!
Dialogue: 0,0:05:09.49,0:05:12.03,Main-207+,,0,0,0,,Ei tunnu siltä, että päästään elävinä pois!
Dialogue: 0,0:05:12.03,0:05:13.70,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:05:13.70,0:05:17.80,Main-207+,,0,0,0,,Tuo pimeys on pohjaton pata\Njoka johtaa suoraan tuonelaan!
Dialogue: 0,0:05:17.80,0:05:18.87,Main-207+,,0,0,0,,Rautapata!
Dialogue: 0,0:05:18.87,0:05:21.24,Main-207+,,0,0,0,,Teepannu! Teepurkki!
Dialogue: 0,0:05:20.64,0:05:24.58,Main-207+,,0,0,0,,{\an8}Hyppää sinne, Jalmari!
Dialogue: 0,0:05:30.65,0:05:32.72,Main-207+,,0,0,0,,Se purkautuu taas!
Dialogue: 0,0:05:35.65,0:05:36.85,Main-207+,,0,0,0,,Mitä tuo on?!
Dialogue: 0,0:05:36.85,0:05:38.46,Main-207+,,0,0,0,,Ylhäällä!
Dialogue: 0,0:05:39.16,0:05:40.16,Main-207+,,0,0,0,,Järkäleitä?!
Dialogue: 0,0:05:40.16,0:05:41.12,Main-207+,,0,0,0,,Maata?!
Dialogue: 0,0:05:41.12,0:05:43.06,Main-207+,,0,0,0,,Maanvyöry! Voi ei!
Dialogue: 0,0:05:43.06,0:05:45.53,Main-207+,,0,0,0,,Purkaus aiheutti sen!
Dialogue: 0,0:05:46.16,0:05:47.86,Main-207+,,0,0,0,,Väistä, Jalmari!
Dialogue: 0,0:05:51.07,0:05:52.90,Main-207+,,0,0,0,,Käyn ulkona halkaisemassa ne!
Dialogue: 0,0:05:52.90,0:05:55.87,Main-207+,,0,0,0,,Luffy! Pidä tiukasti mun jalasta kiinni!
Dialogue: 0,0:05:55.87,0:05:57.74,Main-207+,,0,0,0,,Jep, niin teen!
Dialogue: 0,0:05:58.11,0:05:59.48,Main-207+,,0,0,0,,Zoro, et saa!
Dialogue: 0,0:06:00.24,0:06:01.91,Main-207+,,0,0,0,,Hei, irti!
Dialogue: 0,0:06:01.91,0:06:04.51,Main-207+,,0,0,0,,Olemme yli 8 000 metrissä!
Dialogue: 0,0:06:04.95,0:06:07.95,Main-207+,,0,0,0,,Jos poistut kuplasta,\Nvedenpaine musertaa sinut!
Dialogue: 0,0:06:07.95,0:06:09.99,Main-207+,,0,0,0,,No mitä me sitten...?!
Dialogue: 0,0:06:09.99,0:06:11.96,Main-207+,,0,0,0,,Antakaa kun hoidan!
Dialogue: 0,0:06:12.46,0:06:14.26,Main-207+,,0,0,0,,{\fad(150,150)}Spesiaalivihertähdenlento...
Dialogue: 0,0:06:14.26,0:06:15.99,Main-207+,,0,0,0,,{\fad(150,150)}Sargasso!
Dialogue: 0,0:06:22.23,0:06:23.60,Main-207+,,0,0,0,,Merilevää ilmestyi!
Dialogue: 0,0:06:24.03,0:06:25.84,Main-207+,,0,0,0,,Vautsi, Usopp!
Dialogue: 0,0:06:25.84,0:06:28.21,Main-207+,,0,0,0,,Se hidastaa vain hetken.
Dialogue: 0,0:06:28.21,0:06:31.24,Main-207+,,0,0,0,,Väistä sivuun sillä välin, Jalmari!
Dialogue: 0,0:06:39.62,0:06:41.12,Main-207+,,0,0,0,,Turvassa...!
Dialogue: 0,0:06:46.46,0:06:49.46,Main-207+,,0,0,0,,Sähän osaat, Usopp!
Dialogue: 0,0:06:49.46,0:06:52.83,Main-207+,,0,0,0,,Toden totta! Mikä tilannetaju!
Dialogue: 0,0:06:51.19,0:06:52.83,Secondary-207+,,0,0,0,,Helppo nakki!
Dialogue: 0,0:06:52.83,0:06:54.13,Main-207+,,0,0,0,,Pelastuttiin!
Dialogue: 0,0:06:56.03,0:06:59.14,Main-207+,,0,0,0,,Jalmari, sullakin meni hienosti!
Dialogue: 0,0:06:59.14,0:07:00.60,Main-207+,,0,0,0,,Turvassa ollaan!
Dialogue: 0,0:07:00.60,0:07:02.11,Main-207+,,0,0,0,,Kiitos, Jalmari!
Dialogue: 0,0:07:02.11,0:07:04.21,Main-207+,,0,0,0,,– Surume! Hoi!\N– Surume!
Dialogue: 0,0:07:04.21,0:07:06.18,Main-207+,,0,0,0,,– Surume!\N– Surume! Hoi!
Dialogue: 0,0:07:06.18,0:07:08.11,Main-207+,,0,0,0,,– Surume! Niin ikään!\N– Surume!
Dialogue: 0,0:07:08.11,0:07:09.85,Main-207+,,0,0,0,,– Surume!\N– Surume! Hoi!
Dialogue: 0,0:07:09.85,0:07:10.35,Main-207+,,0,0,0,,– Su–\N– Su–
Dialogue: 0,0:07:36.21,0:07:38.74,Main-207+,,0,0,0,,Se... Selvittiin...!
Dialogue: 0,0:07:39.14,0:07:40.51,Main-207+,,0,0,0,,Valoa?
Dialogue: 0,0:07:40.51,0:07:42.55,Main-207+,,0,0,0,,Miten näin syvällä...?
Dialogue: 0,0:07:42.55,0:07:45.45,Main-207+,,0,0,0,,Häikäisevää! Silmissä sumenee!
Dialogue: 0,0:07:45.45,0:07:48.75,Main-207+,,0,0,0,,Vaikka eihän minulla ole silmiä,\Njotka sumentuisivat.
Dialogue: 0,0:07:49.75,0:07:52.42,Main-207+,,0,0,0,,Hei, tulkaas kaikki tänne!
Dialogue: 0,0:07:52.82,0:07:54.73,Main-207+,,0,0,0,,Katsokaa ylös!
Dialogue: 0,0:07:55.59,0:07:57.73,Main-207+,,0,0,0,,Niin kirkasta, että hankala katsoa...
Dialogue: 0,0:07:57.73,0:07:59.43,Main-207+,,0,0,0,,Nami! Tuoko se on?!
Dialogue: 0,0:07:59.43,0:08:02.07,Main-207+,,0,0,0,,Kyllä, siitä ei voi erehtyä.
Dialogue: 0,0:08:02.07,0:08:04.33,Main-207+,,0,0,0,,Neula osoittaa sitä kohti!
Dialogue: 0,0:08:04.33,0:08:05.44,Main-207+,,0,0,0,,Tuo tuossa on...
Dialogue: 0,0:08:07.04,0:08:09.31,Main-207+,,0,0,0,,Nereidisaari!
Dialogue: 0,0:08:09.31,0:08:11.41,Main-207+,,0,0,0,,Hurjan iso!
Dialogue: 0,0:08:11.84,0:08:14.44,Main-207+,,0,0,0,,Saarta ympäröi suuri kupla!
Dialogue: 0,0:08:14.44,0:08:16.15,Main-207+,,0,0,0,,Onko sisällä pilviä?
Dialogue: 0,0:08:16.15,0:08:18.15,Main-207+,,0,0,0,,Siellä saattaa olla ilmaa.
Dialogue: 0,0:08:22.19,0:08:24.02,Main-207+,,0,0,0,,Jahuu!
Dialogue: 0,0:08:24.02,0:08:25.62,Main-207+,,0,0,0,,Perillä ollaan!
Dialogue: 0,0:08:26.76,0:08:29.29,Main-207+,,0,0,0,,Grand Linen ykkösnähtävyys!
Dialogue: 0,0:08:30.96,0:08:33.10,Main-207+,,0,0,0,,Vai ollaan myö perillä!
Dialogue: 0,0:08:35.63,0:08:38.00,Main-207+,,0,0,0,,Saari, jolla merenneidot tanssahtelevat.
Dialogue: 0,0:08:38.00,0:08:39.80,Main-207+,,0,0,0,,Ja ihana merenneitoprinsessa!
Dialogue: 0,0:08:39.80,0:08:42.17,Main-207+,,0,0,0,,Olen vihdoin saapunut!
Dialogue: 0,0:08:42.17,0:08:46.48,Main-207+,,0,0,0,,Haaveiteni kohde lapsuudesta\Nsaakka... Unelmien paratiisi!
Dialogue: 0,0:08:40.27,0:08:46.48,Main-207+,,0,0,0,,{\an8}Hurraa! Hurraa! Hurraa! Hurraa!
Dialogue: 0,0:08:40.77,0:08:46.48,Secondary-207+,,0,0,0,,{\an8}Super! Super! Super! Super! Super! Super!
Dialogue: 0,0:08:48.38,0:08:53.02,Main-207+,,0,0,0,,– ♪ Merenneidot! Merenneidot! ♪\N– ♪ Merenneidot! Merenneidot! ♪
Dialogue: 0,0:08:53.02,0:08:55.05,Main-207+,,0,0,0,,– ♪ Merenneidot! ♪\N– ♪ Merennei– ♪
Dialogue: 0,0:08:55.05,0:08:58.66,Main-207+,,0,0,0,,Sanji! Ei tuollainen vetele!\NPelkästä fantasioinnista?!
Dialogue: 0,0:08:58.66,0:08:59.52,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:09:09.57,0:09:10.83,Main-207+,,0,0,0,,Anteeksi, Sanji!
Dialogue: 0,0:09:10.83,0:09:12.90,Main-207+,,0,0,0,,Kuntoutus tuli liian myöhään!
Dialogue: 0,0:09:13.30,0:09:16.14,Main-207+,,0,0,0,,Parasta ettet tapaa aitoja merenneitoja.
Dialogue: 0,0:09:16.14,0:09:17.64,Main-207+,,0,0,0,,Tohtori!
Dialogue: 0,0:09:17.64,0:09:22.01,Main-207+,,0,0,0,,Mutta kaverin unelma on kohdata\NNereidisaaren merenneidot!
Dialogue: 0,0:09:22.01,0:09:24.51,Main-207+,,0,0,0,,Mutta se tietäisi kuolemaa!
Dialogue: 0,0:09:24.51,0:09:25.48,Main-207+,,0,0,0,,Eikä!
Dialogue: 0,0:09:27.38,0:09:29.09,Main-207+,,0,0,0,,Ei väliksi...
Dialogue: 0,0:09:29.09,0:09:29.89,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:09:30.85,0:09:33.72,Main-207+,,0,0,0,,Ennemmin kuin elän\Nhylkäämällä unelmani...
Dialogue: 0,0:09:34.62,0:09:38.36,Main-207+,,0,0,0,,kuolen luoden merenneitoihin\Nirstaita katseita!
Dialogue: 0,0:09:38.86,0:09:39.80,Main-207+,,0,0,0,,Niljake!
Dialogue: 0,0:09:40.56,0:09:44.84,Main-207+,,0,0,0,,Mä näen ne merenneidot vielä!
Dialogue: 0,0:09:44.84,0:09:45.70,Main-207+,,0,0,0,,Polttaa!
Dialogue: 0,0:09:45.70,0:09:47.04,Main-207+,,0,0,0,,Kiiman lieskat!
Dialogue: 0,0:09:48.71,0:09:50.14,Main-207+,,0,0,0,,Tosi jännää!
Dialogue: 0,0:09:50.14,0:09:53.98,Main-207+,,0,0,0,,Millaistahan lihaa\NNereidisaaren ruuissa käytetään...
Dialogue: 0,0:09:53.98,0:09:56.28,Main-207+,,0,0,0,,Luffy, pyyhi kuolasi.
Dialogue: 0,0:09:56.28,0:09:58.28,Main-207+,,0,0,0,,Voitko komentaa Jalmaria?
Dialogue: 0,0:09:58.28,0:10:00.65,Main-207+,,0,0,0,,Etsitään saaren sisäänkäynti.
Dialogue: 0,0:10:00.65,0:10:02.35,Main-207+,,0,0,0,,Hei, mitäs nuo ovat?!
Dialogue: 0,0:10:05.09,0:10:08.29,Main-207+,,0,0,0,,Mitä sä alhaisille ihmisille pokkuroit,
Dialogue: 0,0:10:08.29,0:10:10.23,Main-207+,,0,0,0,,kraken?!
Dialogue: 0,0:10:12.00,0:10:14.00,Main-207+,,0,0,0,,Keitä nuo ovat...?
Dialogue: 0,0:10:14.60,0:10:16.90,Main-207+,,0,0,0,,Meripetojen lauma!
Dialogue: 0,0:10:18.40,0:10:21.57,Main-207+,,0,0,0,,Loppu tuli! Vaikka päästiin tänne asti!
Dialogue: 0,0:10:21.97,0:10:26.54,Main-207+,,0,0,0,,Tosi mageita otuksia! Meripetoja!
Dialogue: 0,0:10:28.18,0:10:30.58,Main-207+,,0,0,0,,Niillä on ratsastaja!
Dialogue: 0,0:10:36.62,0:10:38.52,Main-207+,,0,0,0,,{\an8\pos(1442,27)}Mitä sä teet, Jalmari?!
Dialogue: 0,0:10:38.52,0:10:41.02,Main-207+,,0,0,0,,{\an8\pos(1442,27)}Vähän matkaa vielä!
Dialogue: 0,0:10:54.30,0:10:58.17,Main-207+,,0,0,0,,M-Meripedot on ympäröineet meidät!
Dialogue: 0,0:10:59.84,0:11:02.41,Main-207+,,0,0,0,,Te olette Olkihatun sakki, eikö?
Dialogue: 0,0:11:03.98,0:11:06.28,Main-207+,,0,0,0,,Tuttua porukkaa...
Dialogue: 0,0:11:07.02,0:11:11.76,Main-207+,,0,0,0,,Juuri te tuhositte Arlongin\Njoukon suunnitelmat.
Dialogue: 0,0:11:13.56,0:11:16.86,Main-207+,,0,0,0,,Jos ei olisi muuta, tämä olisi selvä juttu.
Dialogue: 0,0:11:17.26,0:11:22.77,Main-207+,,0,0,0,,Mutta kaksi vuotta takaperin suojelitte\NArlongin vanhaa alipäällikköä, Mustia...
Dialogue: 0,0:11:23.63,0:11:27.60,Main-207+,,0,0,0,,ja kuuleman mukaan myös\Nkurmuutitte inhoja Taivaslohikäärmeitä!
Dialogue: 0,0:11:29.11,0:11:35.31,Main-207+,,0,0,0,,Ihan kuin meidän rakastettu\NNereidisaaren sankari, Fisher Tiger.
Dialogue: 0,0:11:35.95,0:11:37.81,Main-207+,,0,0,0,,Fisher... Tiger...
Dialogue: 0,0:11:40.25,0:11:42.79,Main-207+,,0,0,0,,{\an8}Teitä on hankala luokitella.
Dialogue: 0,0:11:42.79,0:11:45.66,Main-207+,,0,0,0,,{\an8}Kertokaahan!
Dialogue: 0,0:11:45.66,0:11:48.53,Main-207+,,0,0,0,,{\an8}Oletteko ystäviä vai vihollisia?
Dialogue: 0,0:11:49.23,0:11:51.66,Main-207+,,0,0,0,,{\an8}Annan teidän valita.
Dialogue: 0,0:11:52.20,0:11:55.97,Main-207+,,0,0,0,,{\an8}Alistutteko meidän,\NUusien Merenmiespiraattien, komentoon?
Dialogue: 0,0:11:56.67,0:11:58.50,Main-207+,,0,0,0,,{\an8}Vaiko ette?
Dialogue: 0,0:11:59.14,0:12:01.37,Main-207+,,0,0,0,,Jos kieltäydytte, hukutte saman tien.
Dialogue: 0,0:12:01.37,0:12:02.67,Main-207+,,0,0,0,,Jaa mitä?!
Dialogue: 0,0:12:03.67,0:12:05.71,Main-207+,,0,0,0,,Franky, tankki täyteen!
Dialogue: 0,0:12:05.71,0:12:07.31,Main-207+,,0,0,0,,Täh? Mitä aiot?
Dialogue: 0,0:12:07.88,0:12:11.28,Main-207+,,0,0,0,,Ei kai Luffy nyt noita tottele.
Dialogue: 0,0:12:12.22,0:12:15.49,Main-207+,,0,0,0,,Mutta olemme silti\N10 000 metriä pinnan alla.
Dialogue: 0,0:12:15.49,0:12:18.99,Main-207+,,0,0,0,,Emme voi haastaa noita nyt,\Nvoittamisesta puhumattakaan!
Dialogue: 0,0:12:19.32,0:12:20.52,Main-207+,,0,0,0,,Siksi pakenemme!
Dialogue: 0,0:12:21.09,0:12:26.03,Main-207+,,0,0,0,,Syöksymme Nereidisaarelle Purskejytkyllä,\Nkaiken laivalla olevan ilman voimin!
Dialogue: 0,0:12:27.73,0:12:28.80,Main-207+,,0,0,0,,Oletko tolkuissasi?
Dialogue: 0,0:12:29.43,0:12:32.40,Main-207+,,0,0,0,,Muuten kuolemme tähän\Npäästyämme näin pitkälle.
Dialogue: 0,0:12:33.34,0:12:37.84,Main-207+,,0,0,0,,Niinpä tosiaan...\NMuuta keinoa ei taida olla.
Dialogue: 0,0:12:37.84,0:12:40.61,Main-207+,,0,0,0,,Okei, mä hoidan polttoaineen.
Dialogue: 0,0:12:40.61,0:12:42.38,Main-207+,,0,0,0,,Franky, ota ruori!
Dialogue: 0,0:12:42.38,0:12:45.68,Main-207+,,0,0,0,,Ookoo! Jätä superisti meikäläiselle!
Dialogue: 0,0:12:47.12,0:12:52.12,Main-207+,,0,0,0,,Noh?! Ryhdytkö meidän apuriksi,\NOlkihattu-Luffy?!
Dialogue: 0,0:12:53.66,0:12:55.16,Main-207+,,0,0,0,,No en ryhdy!
Dialogue: 0,0:12:55.16,0:12:56.63,Main-207+,,0,0,0,,Pöljä!
Dialogue: 0,0:12:59.86,0:13:01.63,Main-207+,,0,0,0,,Kieltäydytkö...
Dialogue: 0,0:13:02.23,0:13:05.54,Main-207+,,0,0,0,,{\q2}meidän, Uusien Merenmiespiraattien, kutsusta?!
Dialogue: 0,0:13:05.94,0:13:08.51,Main-207+,,0,0,0,,Siinä tapauksessa olette\Nmerenmiesten vihollisia!
Dialogue: 0,0:13:08.51,0:13:11.04,Main-207+,,0,0,0,,Pelkät syntiset ihmiskurjat!
Dialogue: 0,0:13:11.98,0:13:13.64,Main-207+,,0,0,0,,Mäntti!
Dialogue: 0,0:13:14.04,0:13:17.41,Main-207+,,0,0,0,,Mitä varten muka pitäisi\Nteidän alaiseksi ruveta?!
Dialogue: 0,0:13:17.41,0:13:20.05,Main-207+,,0,0,0,,Luffy, ei parane ärsyttää!
Dialogue: 0,0:13:20.75,0:13:22.25,Main-207+,,0,0,0,,Ikävä juttu.
Dialogue: 0,0:13:22.25,0:13:25.19,Main-207+,,0,0,0,,Sitten teitä ei voi päästää ohi.
Dialogue: 0,0:13:25.72,0:13:28.16,Main-207+,,0,0,0,,Uppoatte siis tähän paikkaan!
Dialogue: 0,0:13:29.19,0:13:30.43,Main-207+,,0,0,0,,Merileijona!
Dialogue: 0,0:13:34.70,0:13:36.70,Main-207+,,0,0,0,,Valmista tuli!
Dialogue: 0,0:13:36.70,0:13:38.33,Main-207+,,0,0,0,,Franky, tee se!
Dialogue: 0,0:13:39.50,0:13:40.77,Main-207+,,0,0,0,,Kimppuun!
Dialogue: 0,0:13:40.77,0:13:42.34,Main-207+,,0,0,0,,Tapellako haluatte?!
Dialogue: 0,0:13:45.08,0:13:46.81,Main-207+,,0,0,0,,Antaa mennä, Franky!
Dialogue: 0,0:13:47.14,0:13:49.11,Main-207+,,0,0,0,,Myös {\i1}Sunny{\i0} on jalopeura!
Dialogue: 0,0:13:49.88,0:13:53.25,Main-207+,,0,0,0,,Joskus vielä otetaan matsi, merileijona!
Dialogue: 0,0:13:53.62,0:13:55.09,Main-207+,,0,0,0,,Menoksi!
Dialogue: 0,0:13:55.09,0:13:58.05,Main-207+,,0,0,0,,{\fad(150,150)}Purskejytky!
Dialogue: 0,0:14:03.26,0:14:04.23,Main-207+,,0,0,0,,Purjelaivahan...!
Dialogue: 0,0:14:13.67,0:14:15.97,Main-207+,,0,0,0,,Ilma loppuu...
Dialogue: 0,0:14:17.31,0:14:19.34,Main-207+,,0,0,0,,Meni littanaksi...
Dialogue: 0,0:14:20.98,0:14:22.65,Main-207+,,0,0,0,,En saa henkeä!
Dialogue: 0,0:14:22.65,0:14:25.25,Main-207+,,0,0,0,,Vaikka keuhkoton henki olenkin.
Dialogue: 0,0:14:26.45,0:14:29.42,Main-207+,,0,0,0,,Kestäkää, kunnes pääsemme saarelle!
Dialogue: 0,0:14:32.16,0:14:35.23,Main-207+,,0,0,0,,Mikä ihmeen alus se on?!
Dialogue: 0,0:14:36.03,0:14:38.23,Main-207+,,0,0,0,,Törmäys tulee!
Dialogue: 0,0:14:38.23,0:14:40.73,Main-207+,,0,0,0,,Odottakaa, ihanat merenneitoni!
Dialogue: 0,0:14:49.84,0:14:51.57,Main-207+,,0,0,0,,Päällyste irtosi!
Dialogue: 0,0:14:51.57,0:14:54.28,Main-207+,,0,0,0,,Jättikupla otti sen!
Dialogue: 0,0:14:56.35,0:14:57.28,Main-207+,,0,0,0,,Edessä päin!
Dialogue: 0,0:14:58.11,0:14:59.68,Main-207+,,0,0,0,,Mikä tuo on?!
Dialogue: 0,0:15:00.68,0:15:03.85,Main-207+,,0,0,0,,Kupla on kaksinkertainen!
Dialogue: 0,0:15:04.15,0:15:07.36,Main-207+,,0,0,0,,Normaali alus putoaisi nyt alas\Npelkän ilman ympäröimänä!
Dialogue: 0,0:15:07.92,0:15:10.66,Main-207+,,0,0,0,,Vielä yksi törmäys kuplaan!
Dialogue: 0,0:15:10.66,0:15:12.13,Main-207+,,0,0,0,,Pitäkää kiinni!
Dialogue: 0,0:15:20.20,0:15:21.47,Main-207+,,0,0,0,,Merivettä?!
Dialogue: 0,0:15:33.12,0:15:36.05,Thoughts-207+,,0,0,0,,{\t(2181,0,1,\c&H000000&\3c&H000000&)}Miten voimakas virtaus!
Dialogue: 0,0:15:40.76,0:15:42.76,Main-207+,,0,0,0,,Aut... takaa...
Dialogue: 0,0:15:42.76,0:15:44.49,Main-207+,,0,0,0,,{\t(1216,0,1,\c&H000000&}En saa henkeä...
Dialogue: 0,0:15:46.56,0:15:49.27,Thoughts-207+,,0,0,0,,Neljä pirunmarjavoimaista mukana...!
Dialogue: 0,0:15:58.44,0:15:59.64,Thoughts-207+,,0,0,0,,{\t(685,0,1,\c&H000000&\3c&H000000&)}Koita...
Dialogue: 0,0:16:00.71,0:16:02.21,Thoughts-207+,,0,0,0,,...kurkottaa!
Dialogue: 0,0:16:05.05,0:16:06.68,Thoughts-207+,,0,0,0,,Nami-neiti!
Dialogue: 0,0:16:06.68,0:16:08.32,Thoughts-207+,,0,0,0,,Robin-kulta!
Dialogue: 0,0:16:10.52,0:16:11.79,Thoughts-207+,,0,0,0,,Helkkari!
Dialogue: 0,0:16:11.79,0:16:14.32,Thoughts-207+,,0,0,0,,{\t(2016,0,1,\c&H000000&\3c&H000000&)}Virta on liian voimakas!
Dialogue: 0,0:16:28.71,0:16:32.38,Main-207+,,0,0,0,,Älytön tapa mennä saarelle.\NSaattoi olla niiden loppu.
Dialogue: 0,0:16:32.78,0:16:35.78,Main-207+,,0,0,0,,{\q2}Mennäänkö perään, Hammond? Sisälle saakka...
Dialogue: 0,0:16:35.78,0:16:38.41,Main-207+,,0,0,0,,Vaikka emme tiedä, elävätkö ne...
Dialogue: 0,0:16:40.15,0:16:42.29,Main-207+,,0,0,0,,Käydään nyt.
Dialogue: 0,0:16:42.29,0:16:45.72,Main-207+,,0,0,0,,Olisi harmi, jos Neptunuksen\Njoukot ehtisivät ensin.
Dialogue: 0,0:16:45.72,0:16:50.49,Main-207+,,0,0,0,,Mutta palataan ensin Nooaan\Nja kerrotaan päällikölle...
Dialogue: 0,0:16:50.49,0:16:55.00,Main-207+,,0,0,0,,että herra Arlongin pyrkimykset\Npilannut Olkihattu on saapunut!
Dialogue: 0,0:17:06.34,0:17:07.11,Main-207+,,0,0,0,,No niin.
Dialogue: 0,0:17:10.68,0:17:11.71,Main-207+,,0,0,0,,Katsokaa.
Dialogue: 0,0:17:11.71,0:17:12.58,Main-207+,,0,0,0,,Katsoin.
Dialogue: 0,0:17:12.58,0:17:13.65,Main-207+,,0,0,0,,En katsonut!
Dialogue: 0,0:17:13.65,0:17:14.88,Main-207+,,0,0,0,,Katsoi varmaan?
Dialogue: 0,0:17:14.88,0:17:16.15,Main-207+,,0,0,0,,Entä sitten, jos katsoin?
Dialogue: 0,0:17:18.86,0:17:20.22,Main-207+,,0,0,0,,Hei, liikkuiko hän?
Dialogue: 0,0:17:20.22,0:17:21.22,Main-207+,,0,0,0,,Liikkui!
Dialogue: 0,0:17:21.22,0:17:22.73,Main-207+,,0,0,0,,Ei liikkunut!
Dialogue: 0,0:17:22.73,0:17:24.63,Main-207+,,0,0,0,,Liikkui varmaan?
Dialogue: 0,0:17:24.63,0:17:25.96,Main-207+,,0,0,0,,Entä sitten, jos liikkui?
Dialogue: 0,0:17:30.27,0:17:32.67,Main-207+,,0,0,0,,Hurraa! Tajuissa on!
Dialogue: 0,0:17:32.67,0:17:34.64,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:17:37.21,0:17:38.47,Main-207+,,0,0,0,,Luffyli!
Dialogue: 0,0:17:39.74,0:17:42.21,Main-207+,,0,0,0,,Ihanaa, että olet kunnossa!
Dialogue: 0,0:17:42.21,0:17:44.11,Main-207+,,0,0,0,,Kuinka voit?
Dialogue: 0,0:17:46.92,0:17:50.85,Main-207+,,0,0,0,,Camiehan se siinä! Tosi pitkästä aikaa!
Dialogue: 0,0:17:50.85,0:17:55.46,Main-207+,,0,0,0,,Olet söpöstynyt entisestäkin, Camie-kulta!
Dialogue: 0,0:17:55.46,0:17:58.29,Main-207+,,0,0,0,,Päästiinkö Nereidisaarelle?!
Dialogue: 0,0:17:58.29,0:17:59.60,Main-207+,,0,0,0,,Päästiin!
Dialogue: 0,0:17:59.60,0:18:03.97,Main-207+,,0,0,0,,Oltiin kuulemma hukkumassa,\Nmutta merenneidot pelastivat meidät!
Dialogue: 0,0:18:03.97,0:18:04.97,Main-207+,,0,0,0,,Näin on.
Dialogue: 0,0:18:04.97,0:18:09.11,Main-207+,,0,0,0,,Mitäpä sitä salaamaan... Me kolme oltiin\Ntiedottomina vielä hetki sitten.
Dialogue: 0,0:18:09.11,0:18:11.41,Main-207+,,0,0,0,,Tämä on Camien koti.
Dialogue: 0,0:18:11.41,0:18:12.38,Main-207+,,0,0,0,,Siinä hattusi.
Dialogue: 0,0:18:12.38,0:18:14.94,Main-207+,,0,0,0,,Ahaa, vai että Camien talo!
Dialogue: 0,0:18:14.94,0:18:16.35,Main-207+,,0,0,0,,Anteeksi!
Dialogue: 0,0:18:16.35,0:18:21.95,Main-207+,,0,0,0,,Piti tulla teitä vastaan,\Nmutta muistin kuukauden väärin...
Dialogue: 0,0:18:21.95,0:18:23.45,Main-207+,,0,0,0,,Mitäs siitä!
Dialogue: 0,0:18:23.45,0:18:24.52,Main-207+,,0,0,0,,Missä muut ovat?
Dialogue: 0,0:18:25.36,0:18:26.96,Main-207+,,0,0,0,,Tuota...
Dialogue: 0,0:18:26.96,0:18:29.36,Main-207+,,0,0,0,,Ajauduimme erilleen.
Dialogue: 0,0:18:29.86,0:18:32.63,Main-207+,,0,0,0,,Ovatkohan he kunnossa?
Dialogue: 0,0:18:32.63,0:18:33.86,Main-207+,,0,0,0,,Niinkö siinä kävi?
Dialogue: 0,0:18:33.86,0:18:39.64,Main-207+,,0,0,0,,Juu, seurasin katseella, minkä voin.\NNe ei ajautuneet pohjaan kuten me.
Dialogue: 0,0:18:40.14,0:18:43.14,Main-207+,,0,0,0,,Noh, eiköhän nekin pärjää!
Dialogue: 0,0:18:43.14,0:18:44.57,Main-207+,,0,0,0,,Niinpä kai.
Dialogue: 0,0:18:44.57,0:18:47.08,Main-207+,,0,0,0,,Luiseva kaveri on meressä hyödytön...
Dialogue: 0,0:18:47.08,0:18:50.58,Main-207+,,0,0,0,,mutta mukana on robo sekä viher.\NKyllä ne selviää.
Dialogue: 0,0:18:50.95,0:18:53.52,Main-207+,,0,0,0,,Olisi kiva nähdä heitäkin.
Dialogue: 0,0:18:53.52,0:18:55.08,Main-207+,,0,0,0,,Tässä, olkaa hyvät!
Dialogue: 0,0:18:55.08,0:18:57.15,Main-207+,,0,0,0,,Te palelette varmasti.
Dialogue: 0,0:18:57.15,0:18:59.39,Main-207+,,0,0,0,,Lämmitelkää keittoa syöden.
Dialogue: 0,0:19:00.66,0:19:01.52,Main-207+,,0,0,0,,Tadaa!
Dialogue: 0,0:19:01.52,0:19:03.36,Main-207+,,0,0,0,,Kylmää leväkeittoa!
Dialogue: 0,0:19:03.73,0:19:04.46,Main-207+,,0,0,0,,Tosi hyvää!
Dialogue: 0,0:19:08.63,0:19:10.50,Main-207+,,0,0,0,,Kylmää keittoa..?
Dialogue: 0,0:19:10.50,0:19:11.33,Main-207+,,0,0,0,,Mm-mm!
Dialogue: 0,0:19:14.67,0:19:17.81,Main-207+,,0,0,0,,Eihän kylmä keitto lämmitä!
Dialogue: 0,0:19:17.81,0:19:19.34,Main-207+,,0,0,0,,Mikä nyt neuvoksi?!
Dialogue: 0,0:19:19.34,0:19:20.74,Main-207+,,0,0,0,,Mitäh?!
Dialogue: 0,0:19:20.74,0:19:23.08,Main-207+,,0,0,0,,Mokasin!
Dialogue: 0,0:19:25.42,0:19:28.79,Main-207+,,0,0,0,,Ei huolta, Camie!
Dialogue: 0,0:19:28.79,0:19:31.72,Main-207+,,0,0,0,,Se päinvastoin lämmittää!
Dialogue: 0,0:19:31.72,0:19:33.56,Main-207+,,0,0,0,,Miten päinvastoin?
Dialogue: 0,0:19:33.56,0:19:35.36,Main-207+,,0,0,0,,Hei, Sanji! Mullekin!
Dialogue: 0,0:19:37.89,0:19:39.86,Main-207+,,0,0,0,,Pyykki kuivui jo!
Dialogue: 0,0:19:39.86,0:19:40.73,Main-207+,,0,0,0,,Kyllä kuivui!
Dialogue: 0,0:19:40.73,0:19:42.37,Main-207+,,0,0,0,,Ei vielä kuivunut!
Dialogue: 0,0:19:42.37,0:19:43.87,Main-207+,,0,0,0,,Kuivui varmaan?
Dialogue: 0,0:19:43.87,0:19:45.13,Main-207+,,0,0,0,,Entä sitten, jos kuivui?
Dialogue: 0,0:19:50.51,0:19:52.78,Main-207+,,0,0,0,,Kuivatitteko meidän vaatteet?
Dialogue: 0,0:19:52.78,0:19:53.88,Main-207+,,0,0,0,,Kiitti!
Dialogue: 0,0:19:53.88,0:19:54.58,Main-207+,,0,0,0,,Kiitos!
Dialogue: 0,0:19:55.14,0:19:57.41,Main-207+,,0,0,0,,Keitä muuten oikein olette?
Dialogue: 0,0:19:57.41,0:19:59.35,Main-207+,,0,0,0,,Ystäviäni.
Dialogue: 0,0:19:59.35,0:20:01.32,Main-207+,,0,0,0,,Riisikalamerenneitovitoset!
Dialogue: 0,0:20:01.32,0:20:02.45,Main-207+,,0,0,0,,Olen Ykska!
Dialogue: 0,0:20:02.45,0:20:03.32,Main-207+,,0,0,0,,Olen Kakska!
Dialogue: 0,0:20:03.32,0:20:04.32,Main-207+,,0,0,0,,Minä olen Kolka!
Dialogue: 0,0:20:04.32,0:20:05.22,Main-207+,,0,0,0,,Minä Nelka!
Dialogue: 0,0:20:05.22,0:20:06.72,Main-207+,,0,0,0,,Ja minä Nelka Kakkonen!
Dialogue: 0,0:20:06.72,0:20:08.56,Main-207+,,0,0,0,,Miksi ei Viiska?!
Dialogue: 0,0:20:09.09,0:20:11.73,Main-207+,,0,0,0,,He ovat nopeita uimareita\Nja välittävät tietoja.
Dialogue: 0,0:20:11.73,0:20:13.93,Main-207+,,0,0,0,,Oho, niinkö?
Dialogue: 0,0:20:13.93,0:20:16.83,Main-207+,,0,0,0,,Olemme merenneitojen laguunin alla.
Dialogue: 0,0:20:16.83,0:20:21.10,Main-207+,,0,0,0,,Tämä on Mermaid Cafen tyttöjen\Nasuntola, joten ystäviä riittää!
Comment: 0,0:20:21.10,0:20:22.17,Main-207+,,0,0,0,,What?
Dialogue: 0,0:20:22.57,0:20:23.71,Main-207+,,0,0,0,,T-Tyttöjen?!
Dialogue: 0,0:20:24.07,0:20:25.14,Main-207+,,0,0,0,,Camie!
Dialogue: 0,0:20:25.14,0:20:28.88,Main-207+,,0,0,0,,M-M-Mikä on Mermaid Cafe?!
Dialogue: 0,0:20:28.88,0:20:32.12,Main-207+,,0,0,0,,Liike, jossa olen tarjoilijana.
Dialogue: 0,0:20:32.12,0:20:34.12,Main-207+,,0,0,0,,Siellä on paljon kauniita merenneitoja.
Dialogue: 0,0:20:34.12,0:20:36.25,Main-207+,,0,0,0,,K-Kauniita merenneitojako?!
Dialogue: 0,0:20:39.06,0:20:41.16,Main-207+,,0,0,0,,Kahvia? Vaiko...
Dialogue: 0,0:20:44.06,0:20:46.96,Main-207+,,0,0,0,,– Sanji on...\N– ...vaarassa!
Dialogue: 0,0:20:47.50,0:20:48.80,Main-207+,,0,0,0,,Saakura!
Dialogue: 0,0:20:48.80,0:20:49.77,Main-207+,,0,0,0,,– Hän kesti!\N– Hän kesti!
Dialogue: 0,0:20:50.50,0:20:51.47,Main-207+,,0,0,0,,Minä...
Dialogue: 0,0:20:53.20,0:20:57.87,Main-207+,,0,0,0,,Minä vannoin itselleni, etten\Nsyökse verta ja pökerry Nereidisaarella...
Dialogue: 0,0:20:57.87,0:21:00.44,Main-207+,,0,0,0,,Se olisi hirveää tuhlausta!
Dialogue: 0,0:21:03.55,0:21:08.62,Main-207+,,0,0,0,,Enkö mä vihdoin ansaitse jo\Nhyvääkin onnea...
Dialogue: 0,0:21:08.62,0:21:10.02,Main-207+,,0,0,0,,Otat tämän tosissasi.
Dialogue: 0,0:21:10.02,0:21:10.05,Main-207+,,0,0,0,,{\clip(806.14,906.06,1326.21,1080)}Otat tämän tosissasi.
Dialogue: 0,0:21:10.05,0:21:10.09,Main-207+,,0,0,0,,{\clip(931,887.39,1297.7,1080)}Otat tämän tosissasi.
Dialogue: 0,0:21:10.09,0:21:10.12,Main-207+,,0,0,0,,{\clip(1053.89,915.89,1338,1080)}Otat tämän tosissasi.
Dialogue: 0,0:21:10.12,0:21:10.15,Main-207+,,0,0,0,,{\clip(1178.74,937.5,1290.81,1080)}Otat tämän tosissasi.
Dialogue: 0,0:21:10.85,0:21:11.45,Main-207+,,0,0,0,,Ai, niin!
Dialogue: 0,0:21:11.95,0:21:13.59,Main-207+,,0,0,0,,Mennään ylös!
Dialogue: 0,0:21:13.59,0:21:15.53,Main-207+,,0,0,0,,Esittelen ystäviäni.
Dialogue: 0,0:21:18.43,0:21:20.40,Main-207+,,0,0,0,,Ohhoh! Kilppari!
Dialogue: 0,0:21:20.90,0:21:23.27,Main-207+,,0,0,0,,Siinä lukee "merikilpikonnahissi".
Dialogue: 0,0:21:25.13,0:21:26.94,Main-207+,,0,0,0,,Ylös saakka, kilpikonnuli.
Dialogue: 0,0:21:32.58,0:21:35.14,Main-207+,,0,0,0,,Tämä on vedenalainen kerroskorallitalo.
Dialogue: 0,0:21:35.14,0:21:38.11,Main-207+,,0,0,0,,Asuntola on alinna, kun vuokra on halpa.
Dialogue: 0,0:21:38.11,0:21:41.65,Main-207+,,0,0,0,,Ylimmät ja valoisimmat\Nasunnot maksavat eniten.
Dialogue: 0,0:21:42.65,0:21:44.55,Main-207+,,0,0,0,,Ahaa, sä olet köyhä.
Dialogue: 0,0:21:44.55,0:21:46.46,Main-207+,,0,0,0,,Missä muuten Musti ja Pappagu on?
Dialogue: 0,0:21:46.46,0:21:49.33,Main-207+,,0,0,0,,Mustili loukkaantui pahasti vuosi sitten.
Dialogue: 0,0:21:49.33,0:21:54.13,Main-207+,,0,0,0,,Se suojeli {\i1}Sunnya{\i0} Sabaodylla, vai mitä!
Dialogue: 0,0:21:54.13,0:21:57.77,Main-207+,,0,0,0,,Hän voi kuulemma jo melko hyvin.
Dialogue: 0,0:21:57.77,0:22:01.77,Main-207+,,0,0,0,,Mustili on kotoisin\Nmerenmiesalueelta ja lepää siellä.
Dialogue: 0,0:22:02.91,0:22:04.01,Main-207+,,0,0,0,,Merenmiesalue?
Dialogue: 0,0:22:04.01,0:22:04.94,Main-207+,,0,0,0,,Niin...
Dialogue: 0,0:22:04.94,0:22:10.45,Main-207+,,0,0,0,,Se on hiukan pelottava paikka...\NTeidän kanssanne kyllä uskallan mennä.
Dialogue: 0,0:22:10.45,0:22:11.61,Main-207+,,0,0,0,,Käydään myöhemmin!
Dialogue: 0,0:22:11.61,0:22:13.78,Main-207+,,0,0,0,,Haluan nähdä Mustin ja kiittää!
Dialogue: 0,0:22:13.78,0:22:15.59,Main-207+,,0,0,0,,Selvä on!
Dialogue: 0,0:22:15.59,0:22:18.32,Main-207+,,0,0,0,,Ja niin, Pappagu puolestaan...
Dialogue: 0,0:22:19.46,0:22:22.33,Main-207+,,0,0,0,,Hän on suunnittelijana oikea supertähti,
Dialogue: 0,0:22:22.33,0:22:27.53,Main-207+,,0,0,0,,ja asuu kartanossa\NFisherly Hillsin hienostoalueella.
Dialogue: 0,0:22:27.53,0:22:31.03,Main-207+,,0,0,0,,Menen tänään viemään\Nsimpukoita, tulkaa mukaan!
Dialogue: 0,0:22:31.37,0:22:32.87,Main-207+,,0,0,0,,Olet sen emäntä, eikö?
Dialogue: 0,0:22:33.57,0:22:35.20,Main-207+,,0,0,0,,Mikset asu sen luona?
Dialogue: 0,0:22:36.44,0:22:39.54,Main-207+,,0,0,0,,En oikein tunne kuuluvani sille seudulle.
Dialogue: 0,0:22:40.01,0:22:42.88,Main-207+,,0,0,0,,Ja täältä löytyy parempia simpukoita.
Dialogue: 0,0:22:42.88,0:22:44.85,Main-207+,,0,0,0,,Ollaan melkein perillä!
Dialogue: 0,0:22:46.05,0:22:48.78,Main-207+,,0,0,0,,Hei, mitä nuo pillijutut on?
Dialogue: 0,0:22:48.78,0:22:49.99,Main-207+,,0,0,0,,Aa, nuo.
Dialogue: 0,0:22:50.35,0:22:54.06,Main-207+,,0,0,0,,Saaren kuplaseppien\Nrakentamia "vedenteitä".
Dialogue: 0,0:22:54.06,0:22:57.03,Main-207+,,0,0,0,,Niillä kalat ja mekin voimme kulkea, ja...
Dialogue: 0,0:22:57.59,0:22:59.46,Main-207+,,0,0,0,,Katsokaahan!
Dialogue: 0,0:23:06.27,0:23:08.27,Main-207+,,0,0,0,,Tultiin pinnalle!
Dialogue: 0,0:23:08.27,0:23:10.67,Main-207+,,0,0,0,,Luffyli!
Dialogue: 0,0:23:12.84,0:23:13.54,Main-207+,,0,0,0,,Kas näin!
Dialogue: 0,0:23:13.54,0:23:15.88,Main-207+,,0,0,0,,Voin uida taivaallakin!
Dialogue: 0,0:23:15.88,0:23:17.88,Main-207+,,0,0,0,,Oho, näyttää lystiltä!
Dialogue: 0,0:23:19.08,0:23:20.48,Main-207+,,0,0,0,,Hetkonen nyt!
Dialogue: 0,0:23:20.48,0:23:23.92,Main-207+,,0,0,0,,Siitä viis, miten merenpohjassa\Non taivas ja pilviä?!
Dialogue: 0,0:23:24.29,0:23:26.09,Main-207+,,0,0,0,,Hei, Camie!
Dialogue: 0,0:23:26.09,0:23:27.96,Main-207+,,0,0,0,,Oah! Naisääni!
Dialogue: 0,0:23:28.66,0:23:30.59,Main-207+,,0,0,0,,Ystävät!
Dialogue: 0,0:23:32.56,0:23:36.57,Main-207+,,0,0,0,,Ovatko vettä nielleet\Nmerirosvoystäväsi kunnossa?
Comment: 0,0:23:32.56,0:23:34.80,Main-207+,,0,0,0,,Are your friends fine now?
Comment: 0,0:23:34.80,0:23:36.57,Main-207+,,0,0,0,,The pirates who were drowning.
Dialogue: 0,0:23:39.00,0:23:42.67,Main-207+,,0,0,0,,Tehän ette edes tulleet sisäänkäynnistä!
Dialogue: 0,0:23:45.21,0:23:46.44,Main-207+,,0,0,0,,Päivää!
Dialogue: 0,0:23:46.44,0:23:48.44,Main-207+,,0,0,0,,Ette vaikuta kovin pelottavilta.
Dialogue: 0,0:23:48.44,0:23:49.95,Main-207+,,0,0,0,,Laiton maahantulo?
Dialogue: 0,0:23:49.95,0:23:51.08,Main-207+,,0,0,0,,Rajua!
Dialogue: 0,0:23:51.08,0:23:52.72,Main-207+,,0,0,0,,Merirosvot ovat minun makuuni!
Dialogue: 0,0:24:02.83,0:24:05.59,Main-207+,,0,0,0,,Kuin satujen maailmassa!
Dialogue: 0,0:24:05.59,0:24:09.53,Main-207+,,0,0,0,,Korallimanner! Merenneitolaguuni!
Dialogue: 0,0:24:23.51,0:24:24.38,Main-207+,,0,0,0,,Häh?!
Dialogue: 0,0:24:24.38,0:24:26.42,Main-207+,,0,0,0,,Sanji parkuu vain!
Dialogue: 0,0:24:26.85,0:24:29.49,Main-207+,,0,0,0,,Itkee enemmän kuin Baratieltä lähtiessä.
Dialogue: 0,0:24:32.39,0:24:34.89,Main-207+,,0,0,0,,Löysin sen!
Dialogue: 0,0:24:35.26,0:24:38.63,Main-207+,,0,0,0,,All Blue on silmieni edessä!
Dialogue: 0,0:24:40.86,0:24:43.37,Main-207+,,0,0,0,,{\pos(1320,1053)}Oletko vakavissasi, Sanji?
Dialogue: 0,0:24:44.70,0:24:46.54,Main-207+,,0,0,0,,Antakaa kun esittelen!
Dialogue: 0,0:24:47.04,0:24:49.54,Main-207+,,0,0,0,,Tässä on kapteeni Luffyli.
Dialogue: 0,0:24:49.54,0:24:50.74,Main-207+,,0,0,0,,Juu, kiva tavata!
Dialogue: 0,0:24:51.37,0:24:53.21,Main-207+,,0,0,0,,Itkevä mies on Sanjili.
Dialogue: 0,0:24:53.84,0:24:55.71,Main-207+,,0,0,0,,Sitten nenuisa Usoppli.
Dialogue: 0,0:24:55.71,0:24:56.45,Main-207+,,0,0,0,,Terve vaan!
Dialogue: 0,0:24:56.95,0:24:59.12,Main-207+,,0,0,0,,Ja supi on Chopperli.
Dialogue: 0,0:24:59.12,0:25:00.22,Main-207+,,0,0,0,,Ei vaan poro!
Dialogue: 0,0:25:01.15,0:25:04.09,Main-207+,,0,0,0,,Mikä hätänä? Miksi kummassa itket?
Dialogue: 0,0:25:05.32,0:25:06.69,Main-207+,,0,0,0,,Tule nyt!
Dialogue: 0,0:25:06.69,0:25:08.79,Main-207+,,0,0,0,,Tanssitaan yhdessä meressä!
Dialogue: 0,0:25:13.76,0:25:16.40,Main-207+,,0,0,0,,Aivan, tajuan nyt.
Dialogue: 0,0:25:16.40,0:25:19.00,Main-207+,,0,0,0,,Eihän tällainen onni voi kestää.
Dialogue: 0,0:25:19.00,0:25:21.80,Main-207+,,0,0,0,,Tämä on varmaan mun kuolinpäiväni!
Dialogue: 0,0:25:21.80,0:25:23.64,Main-207+,,0,0,0,,Mikä negatiivisuus!
Dialogue: 0,0:25:23.64,0:25:26.78,Main-207+,,0,0,0,,Mitä näinä kahtena vuotena\Non tapahtunut?!
Dialogue: 0,0:25:26.78,0:25:30.15,Main-207+,,0,0,0,,Tämä on sun unelmoimasi paratiisi!
Dialogue: 0,0:25:31.35,0:25:33.58,Main-207+,,0,0,0,,Sanji on tosi lysti!
Dialogue: 0,0:25:33.58,0:25:35.72,Main-207+,,0,0,0,,– Ei hän koita olla lysti!\N– Ei hän koita olla lysti!
Dialogue: 0,0:25:43.83,0:25:45.59,Main-207+,,0,0,5,,Vai niin.
Dialogue: 0,0:25:45.59,0:25:50.53,Main-207+,,0,0,5,,{\q2}Olkihattu-Luffy siis tuli vihdoin tänne saakka?
Dialogue: 0,0:25:51.60,0:25:52.60,Main-207+,,0,0,0,,Kyllä.
Dialogue: 0,0:25:52.60,0:25:56.57,Main-207+,,0,0,0,,M-Mitä tehdään, päällikkö?
Dialogue: 0,0:25:58.77,0:26:00.41,Main-207+,,0,0,0,,Hakekaa hänet tänne...
Dialogue: 0,0:26:01.78,0:26:03.11,Main-207+,,0,0,0,,minun luokseni!
Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=27}===============================DIALOGUE============================
