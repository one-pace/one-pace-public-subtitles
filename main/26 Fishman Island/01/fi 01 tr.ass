Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=62}===============================DIALOGUE============================
Dialogue: 0,0:01:57.77,0:01:59.77,Main-207+,,0,0,5,,Abi, burayı kazmak çok zor!
Dialogue: 0,0:01:59.77,0:02:01.01,Main-207+,,0,0,5,,Elbette öyle!
Dialogue: 0,0:02:01.01,0:02:03.21,Main-207+,,0,0,5,,Ada çoğunlukla ağaç köklerinden oluşuyor.
Dialogue: 0,0:02:04.71,0:02:07.31,Main-207+,,0,0,0,,Lütfen canımızı bağışla, bizi gömme!
Dialogue: 0,0:02:07.31,0:02:09.85,Main-207+,,0,0,0,,Ne istersen yaparız, yeter ki bizi öldürme!
Dialogue: 0,0:02:09.85,0:02:13.78,Main-207+,,0,0,0,,Bizi kaptan zorladı! Kahrolası Black!
Dialogue: 0,0:02:15.19,0:02:18.56,Main-207+,,0,0,0,,Tayfanıza katılır katılmaz...
Dialogue: 0,0:02:19.92,0:02:23.66,Main-207+,,0,0,0,,meşhur Hasır Şapka Korsanlarının...
Dialogue: 0,0:02:24.86,0:02:26.80,Main-207+,,0,0,0,,her birini...
Dialogue: 0,0:02:28.17,0:02:33.00,Main-207+,,0,0,0,,öldürmeyi planlamıştık!
Dialogue: 0,0:02:36.11,0:02:37.74,Main-207+,,0,0,0,,Drip!
Dialogue: 0,0:02:37.74,0:02:39.91,Main-207+,,0,0,0,,Hey, lütfen dur! Ölecek!
Dialogue: 0,0:02:39.91,0:02:42.11,Main-207+,,0,0,0,,Şeytan meyvesi güçlerin mi var?!
Dialogue: 0,0:02:42.11,0:02:44.05,Main-207+,,0,0,0,,K-Kes şunu!
Dialogue: 0,0:02:44.62,0:02:47.08,Main-207+,,0,0,0,,İşte bu! Onu hakladım...
Dialogue: 0,0:02:50.82,0:02:53.89,Main-207+,,0,0,0,,Ha? Neler oluyor, Logia mı...?!
Dialogue: 0,0:02:56.23,0:02:57.90,Main-207+,,0,0,0,,Bak şu olanlara!
Dialogue: 0,0:02:57.90,0:03:03.23,Main-207+,,0,0,0,,İki yıldır görmediğimden herifin değiştiğini falan sanmıştım!
Dialogue: 0,0:03:03.23,0:03:05.10,Main-207+,,0,0,0,,Ama korsan Hasır Şapka...
Dialogue: 0,0:03:05.10,0:03:06.90,Main-207+,,0,0,0,,bir hiç çıktı!
Dialogue: 0,0:03:06.90,0:03:09.01,Main-207+,,0,0,0,,Pis sahtekâr!
Dialogue: 0,0:03:09.01,0:03:12.31,Main-207+,,0,0,0,,Sence Tanrı bunu affeder mi, Coribou?!
Dialogue: 0,0:03:12.31,0:03:13.81,Main-207+,,0,0,0,,Kaz! Kaz!
Dialogue: 0,0:03:13.81,0:03:15.21,Main-207+,,0,0,0,,Aynen öyle!
Dialogue: 0,0:03:15.21,0:03:17.01,Main-207+,,0,0,0,,Onları gömelim!
Dialogue: 0,0:03:17.01,0:03:19.45,Main-207+,,0,0,0,,Tanrım!
Dialogue: 0,0:03:19.45,0:03:23.19,Main-207+,,0,0,0,,Bu embesilleri gömeceğiz!
Dialogue: 0,0:03:24.49,0:03:27.19,Main-207+,,0,0,0,,Durun! Yalvarırım beni öldürmeyin!
Dialogue: 0,0:03:27.19,0:03:33.60,Main-207+,,0,0,0,,Ama gerçek Hasır Şapkalı Luffy'yi\Nkendi gözlerimle gördüm!
Dialogue: 0,0:03:35.57,0:03:39.64,Main-207+,,0,0,5,,Diyorum ya, yapabileceğimiz bir şey yoktu.
Dialogue: 0,0:03:40.34,0:03:43.21,Main-207+,,0,0,0,,Kara Kral Rayleigh'e karşıydık.
Dialogue: 0,0:03:43.21,0:03:45.34,Main-207+,,0,0,0,,Kizaru Amca bile onu geçememişti!
Dialogue: 0,0:03:45.34,0:03:47.01,Main-207+,,0,0,0,,Biz ne yapabilirdik ki?
Dialogue: 0,0:03:47.95,0:03:55.65,Main-207+,,0,0,0,,Caribou kardeşler ve tayfasıyla, sahtekâr Hasır Şapkaların bir kısmı kaçmayı başardı!
Dialogue: 0,0:03:55.65,0:04:02.46,Main-207+,,0,0,0,,{\q2}Geri kalanları enseledik ama gerçek Hasır Şapkalar\Niki Pacifista'yı resmen hurdaya çevirdi.
Dialogue: 0,0:03:55.65,0:04:02.46,Note-207+,,0,0,0,,Pacifista: Barışsever
Dialogue: 0,0:04:02.86,0:04:06.73,Main-207+,,0,0,0,,İki yıl önce, onları köşeye\Nsıkıştıran prototiplerin aynısı.
Dialogue: 0,0:04:06.73,0:04:09.47,Main-207+,,0,0,0,,Elbette Pacifistaların güçleri değişemez.
Dialogue: 0,0:04:09.47,0:04:11.94,Main-207+,,0,0,0,,Ama onlarınki değişmiş!
Dialogue: 0,0:04:13.00,0:04:16.77,Main-207+,,0,0,0,,Geçen iki yılda kendilerini epey geliştirmişler!
Dialogue: 0,0:04:18.78,0:04:22.55,Main-207+,,0,0,0,,Yeni Dünya'daki Karargâh'a derhal rapor geçin!
Dialogue: 0,0:04:23.15,0:04:27.55,Main-207+,,0,0,0,,Hasır Şapka Korsanları yeniden dirildiler!
Dialogue: 0,0:04:31.09,0:04:33.62,Main-207+,,0,0,0,,Göz açıp kapayıncaya dek gittiler.
Dialogue: 0,0:04:38.26,0:04:42.20,Main-207+,,0,0,0,,Monkey-{\i1}chan{\i0} ve diğerleri gerçekten güçlenmiş.
Dialogue: 0,0:04:43.57,0:04:44.80,Main-207+,,0,0,0,,İzliyor muydun?
Dialogue: 0,0:04:44.80,0:04:46.37,Main-207+,,0,0,0,,Elbette, sonuçta hayranlarıyım.
Dialogue: 0,0:04:48.67,0:04:52.18,Main-207+,,0,0,0,,Bir şey mi hatırladın, Ray-{\i1}san{\i0}?
Dialogue: 0,0:04:53.31,0:04:54.68,Main-207+,,0,0,0,,Şey...
Dialogue: 0,0:04:55.45,0:04:57.01,Main-207+,,0,0,0,,Evet...
Dialogue: 0,0:05:02.55,0:05:04.69,Flashbacks-207+,,0,0,0,,Hey, güzel gemiymiş!
Dialogue: 0,0:05:04.69,0:05:06.42,Flashbacks-207+,,0,0,0,,Çaldım.
Dialogue: 0,0:05:06.42,0:05:08.76,Flashbacks-207+,,0,0,0,,Evim yandığı için burada yaşıyorum.
Dialogue: 0,0:05:08.76,0:05:11.26,Flashbacks-207+,,0,0,0,,Anlıyorum. Adın ne?
Dialogue: 0,0:05:11.26,0:05:12.40,Flashbacks-207+,,0,0,0,,Rayleigh.
Dialogue: 0,0:05:13.50,0:05:15.00,Flashbacks-207+,,0,0,0,,Ben Roger!
Dialogue: 0,0:05:15.00,0:05:18.07,Flashbacks-207+,,0,0,0,,Karşılaşmamız kaderimizde varmış, Rayleigh!
Dialogue: 0,0:05:18.07,0:05:19.77,Flashbacks-207+,,0,0,0,,Kader mi?
Dialogue: 0,0:05:19.77,0:05:23.21,Flashbacks-207+,,0,0,0,,Benimle birlikte şu dünyanın\Naltını üstüne getirmeye ne dersin?
Dialogue: 0,0:05:23.64,0:05:24.71,Flashbacks-207+,,0,0,0,,Ha?
Dialogue: 0,0:05:24.71,0:05:26.18,Flashbacks-207+,,0,0,0,,Dünyanın mı?
Dialogue: 0,0:05:27.21,0:05:29.18,Flashbacks-207+,,0,0,0,,Sen kim olduğunu sanıyorsun?
Dialogue: 0,0:05:29.65,0:05:31.01,Flashbacks-207+,,0,0,0,,Kaybol.
Dialogue: 0,0:05:31.88,0:05:36.02,Main-207+,,0,0,0,,Belki de bu dünyada tesadüf yoktur.
Dialogue: 0,0:05:36.02,0:05:39.26,Main-207+,,0,0,0,,Her şeyin bir sebepten dolayı olması muhtemel.
Dialogue: 0,0:05:40.42,0:05:43.56,Main-207+,,0,0,0,,Kader, gizemli şekillerde tecelli ediyor.
Dialogue: 0,0:05:43.56,0:05:46.90,Main-207+,,0,0,0,,Her neyse, o şapka Luffy'nin üzerinde...
Dialogue: 0,0:05:46.90,0:05:50.97,Main-207+,,0,0,0,,eskisinden bile daha afili duruyor.
Dialogue: 0,0:05:51.30,0:05:54.74,Main-207+,,0,0,0,,Belki de şu hayata biraz daha tutunmak fena olmaz!
Dialogue: 0,0:05:55.67,0:05:58.11,Main-207+,,0,0,5,,Şimdiden bayağı uzaklaştık.
Dialogue: 0,0:05:58.11,0:05:59.91,Main-207+,,0,0,0,,Ne manzara ama!
Dialogue: 0,0:05:59.91,0:06:03.71,Main-207+,,0,0,0,,Denizaltına bu kadar büyük bir pencere koyamazsın!
Dialogue: 0,0:06:03.71,0:06:06.05,Main-207+,,0,0,0,,Battıkça batıyoruz!
Dialogue: 0,0:06:06.62,0:06:09.55,Main-207+,,0,0,0,,İçeri su basacak diye endişeleniyorum!
Dialogue: 0,0:06:09.55,0:06:13.29,Main-207+,,0,0,0,,İnsanların dünyasını terk etmek beni geriyor!
Dialogue: 0,0:06:13.29,0:06:18.53,Main-207+,,0,0,0,,Y-Yüzeye dönebilecek miyiz?
Dialogue: 0,0:06:19.13,0:06:21.40,Main-207+,,0,0,0,,K-Korktuğumdan falan değil ama...
Dialogue: 0,0:06:23.63,0:06:26.14,Main-207+,,0,0,0,,Deniz harika görünüyor!
Dialogue: 0,0:06:34.34,0:06:36.58,Main-207+,,0,0,0,,Şuraya bakın!
Dialogue: 0,0:06:39.35,0:06:41.59,Main-207+,,0,0,0,,Ağaçlar... Hayır, kökler!
Dialogue: 0,0:06:44.52,0:06:46.19,Main-207+,,0,0,0,,Doğru ya!
Dialogue: 0,0:06:46.19,0:06:50.66,Main-207+,,0,0,0,,Sabaody Takımadaları aslında\Ndev mangrov ağaçlarından oluşuyor!
Dialogue: 0,0:06:50.66,0:06:53.50,Main-207+,,0,0,0,,Bir doğa harikası resmen!
Dialogue: 0,0:06:53.50,0:06:56.00,Main-207+,,0,0,0,,Şaşkınlıktan gözlerim yerinden fırlayabilir!
Dialogue: 0,0:06:56.00,0:06:57.87,Main-207+,,0,0,0,,Gerçi gözlerim yok.
Dialogue: 0,0:06:59.07,0:07:01.14,Main-207+,,0,0,0,,Bunu zaten gördüm.
Dialogue: 0,0:07:01.14,0:07:03.11,Main-207+,,0,0,0,,Çünkü yanlış gemiye binmiştin.
Dialogue: 0,0:07:03.11,0:07:05.38,Main-207+,,0,0,0,,Kapa çeneni de şunun tadını çıkaralım!
Dialogue: 0,0:07:06.18,0:07:09.85,Main-207+,,0,0,0,,Şu köklerin ta denizin dibine kadar uzandığına inanamıyorum!
Dialogue: 0,0:07:10.61,0:07:13.32,Main-207+,,0,0,0,,Devasa ve görkemliler!
Dialogue: 0,0:07:19.49,0:07:21.16,Main-207+,,0,0,0,,Daha fazla tutamadım!
Dialogue: 0,0:07:21.16,0:07:22.63,Main-207+,,0,0,0,,Hey, Chopper...
Dialogue: 0,0:07:22.63,0:07:24.66,Main-207+,,0,0,0,,O ağaçların ardında bir şey var!
Dialogue: 0,0:07:24.66,0:07:25.40,Main-207+,,0,0,0,,Ne?
Dialogue: 0,0:07:26.46,0:07:29.37,Main-207+,,0,0,0,,Oha, çok büyük!
Dialogue: 0,0:07:29.37,0:07:31.34,Main-207+,,0,0,0,,Çok heyecanlıyım!
Dialogue: 0,0:07:31.34,0:07:33.20,Main-207+,,0,0,0,,Tam bir deniz altı macerası!
Dialogue: 0,0:07:33.20,0:07:34.94,Main-207+,,0,0,0,,Rüya gibi!
Dialogue: 0,0:07:34.94,0:07:37.04,Main-207+,,0,0,0,,Oo, balık!
Dialogue: 0,0:07:37.04,0:07:38.34,Main-207+,,0,0,0,,Yakalayabilirim!
Dialogue: 0,0:07:39.64,0:07:42.48,Main-207+,,0,0,0,,Bu tarafta da leziz görünümlü balıklar var.
Dialogue: 0,0:07:44.15,0:07:46.12,Main-207+,,0,0,0,,Kesin şunu, ahmaklar!
Dialogue: 0,0:07:46.12,0:07:48.89,Main-207+,,0,0,0,,Kabarcık patlarsa ne olacak?!
Dialogue: 0,0:07:48.89,0:07:50.85,Main-207+,,0,0,0,,Rahat durun yoksa sizi öldürürüm!
Dialogue: 0,0:07:50.85,0:07:56.39,Main-207+,,0,0,0,,{\q2}Nami-{\i1}san{\i0}, şu salaklar başımıza iş açmadan önce\Ngemide nelerin yasak olduğunu bize bir anlat!
Dialogue: 0,0:07:56.89,0:07:58.76,Main-207+,,0,0,0,,Haklısın, Sanji-{\i1}kun{\i0}.
Dialogue: 0,0:07:58.76,0:08:01.13,Main-207+,,0,0,0,,Rayleigh-{\i1}san{\i0} bana birkaç not vermişti.
Dialogue: 0,0:08:01.13,0:08:03.20,Main-207+,,0,0,0,,Pekâlâ, iyi dinleyin...
Dialogue: 0,0:08:03.20,0:08:04.10,Main-207+,,0,0,0,,Hareket etti!
Dialogue: 0,0:08:04.57,0:08:06.30,Main-207+,,0,0,0,,Gerçek bir güzellik!
Dialogue: 0,0:08:06.30,0:08:07.87,Main-207+,,0,0,0,,– Sanji!\N– Sanji!
Dialogue: 0,0:08:07.87,0:08:09.27,Main-207+,,0,0,0,,Patlayacak! Patlayacak!
Dialogue: 0,0:08:09.27,0:08:11.81,Main-207+,,0,0,0,,Burun kanamasıyla ne kadar\Nuzağa fırlatılabilirsin ki?
Dialogue: 0,0:08:13.88,0:08:15.31,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 0,0:08:15.31,0:08:17.41,Main-207+,,0,0,0,,– Sanji denize fırladı!\N– Sanji denize fırladı!
Dialogue: 0,0:08:17.41,0:08:18.72,Main-207+,,0,0,0,,Çok tuhaf.
Dialogue: 0,0:08:18.72,0:08:26.59,Main-207+,,0,0,0,,Bu derinlikteki muazzam basınca bana mısın demeyen kabarcığı...
Dialogue: 0,0:08:26.59,0:08:30.53,Main-207+,,0,0,0,,bu şekilde hızlıca delip geçmek mümkün demek.
Dialogue: 0,0:08:31.33,0:08:32.90,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:08:32.90,0:08:35.47,Main-207+,,0,0,0,,Geri dön!
Dialogue: 0,0:08:36.97,0:08:38.74,Main-207+,,0,0,0,,Deniz, gücümü tüketiyor...
Dialogue: 0,0:08:39.17,0:08:41.07,Main-207+,,0,0,0,,– Dayan!\N– Dayan!
Dialogue: 0,0:08:52.58,0:08:55.75,Main-207+,,0,0,0,,Ne oldu sana, Sanji?!
Dialogue: 0,0:08:55.75,0:08:58.99,Main-207+,,0,0,0,,Kadınlara olan zaafın resmen tavan yapmış!
Dialogue: 0,0:08:58.99,0:09:00.42,Main-207+,,0,0,0,,Bu sen değilsin!
Dialogue: 0,0:09:00.42,0:09:01.89,Main-207+,,0,0,0,,Zavallı şey...
Dialogue: 0,0:09:02.39,0:09:06.83,Main-207+,,0,0,0,,Geçtiğimiz iki yılda, zampara Sanji-{\i1}san{\i0} bu hâle gelecek ne yaşamış olabilir ki?
Dialogue: 0,0:09:07.30,0:09:13.90,Main-207+,,0,0,0,,{\q2}Bu durumda, görmeyi çok istediği\Ndeniz kızlarıyla karşılaşınca kan kaybından ölebilir.
Dialogue: 0,0:09:13.90,0:09:16.57,Main-207+,,0,0,0,,Endişelenmeden edemiyorum.
Dialogue: 0,0:09:16.57,0:09:19.94,Main-207+,,0,0,0,,Balıkadam Adası'na vardığımızda kan bağışına ihtiyacı olacak!
Dialogue: 0,0:09:19.94,0:09:24.21,Main-207+,,0,0,0,,Acaba balıkadamlarla deniz kızlarının kanı insanlarla uyuşuyor mudur?
Dialogue: 0,0:09:24.21,0:09:28.52,Main-207+,,0,0,0,,Yani Sunny'yi kaplayan kabarcık...
Dialogue: 0,0:09:28.52,0:09:33.29,Main-207+,,0,0,0,,Sabaody Takımadalarında gördüklerimizle aynı özellikte.
Dialogue: 0,0:09:33.66,0:09:36.69,Main-207+,,0,0,0,,Kabarcığı böyle sakin bir tavırla analiz etmeyi bırak!
Dialogue: 0,0:09:36.69,0:09:38.50,Main-207+,,0,0,0,,Aynen öyle, Robin haklı.
Dialogue: 0,0:09:39.23,0:09:41.16,Main-207+,,0,0,0,,Temelde aynılar.
Dialogue: 0,0:09:41.16,0:09:46.17,Main-207+,,0,0,0,,Belirli mesafeye kadar uzarlar ve\Nsonrasında delinip geçilebilirler. Yani...
Dialogue: 0,0:09:46.27,0:09:51.24,Main-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,383,1,\3c&H000000&\4c&H000000&)}saldırıya uğrarsak\Nsilah veya top ateşleyebiliriz...
Dialogue: 0,0:09:51.24,0:09:52.88,Main-207+,,0,0,0,,Kabarcık patlamayacak.
Dialogue: 0,0:09:52.88,0:09:53.51,Main-207+,,0,0,0,,Ha?
Dialogue: 0,0:09:54.08,0:09:57.61,Main-207+,,0,0,0,,Peki hangi durumda kabarcık patlar?
Dialogue: 0,0:09:57.61,0:10:02.15,Main-207+,,0,0,0,,Tahmin edebileceğiniz gibi, tek seferde\Nbirçok delik açılırsa fazla dayanmaz.
Dialogue: 0,0:10:02.15,0:10:07.42,Main-207+,,0,0,0,,Örneğin, bir deniz kralı gemiyi ısırırsa işimiz biter.
Dialogue: 0,0:10:11.23,0:10:13.46,Main-207+,,0,0,0,,{\fad(0,548)}– Geliyor işte!\N– Geliyor işte!
Dialogue: 0,0:10:13.73,0:10:15.53,Main-207+,,0,0,0,,Birbirlerine girdiler... Kurtulduk!
Dialogue: 0,0:10:16.00,0:10:21.14,Main-207+,,0,0,0,,Ya da gemi, bir kayaya veya yarığa çarpıp parçalanırsa...
Dialogue: 0,0:10:21.14,0:10:27.14,Main-207+,,0,0,0,,kırılan tahtaların kabarcığı patlatmasıyla resmen ayvayı yeriz.
Dialogue: 0,0:10:27.14,0:10:30.78,Main-207+,,0,0,0,,Yani deniz yaratıklarına ve engellere karşı gözümüzü dört açmalıyız!
Dialogue: 0,0:10:30.78,0:10:33.98,Main-207+,,0,0,0,,Aptalca bir şey yapmadığımız sürece\Nendişelenecek bir şey yok.
Dialogue: 0,0:10:34.62,0:10:37.15,Main-207+,,0,0,0,,Anladım, sandığımdan daha sağlammış!
Dialogue: 0,0:10:38.12,0:10:39.19,Main-207+,,0,0,0,,Ancak...
Dialogue: 0,0:10:40.22,0:10:43.19,Main-207+,,0,0,0,,Balıkadam Adası'na doğru yola çıkan gemilerin...
Dialogue: 0,0:10:43.19,0:10:46.03,Main-207+,,0,0,0,,%70'i yok olmuş. Bu yüzden temkinli olun.
Dialogue: 0,0:10:47.20,0:10:49.10,Main-207+,,0,0,0,,– Bize ne olacak?!\N– Bize ne olacak?!
Dialogue: 0,0:10:49.67,0:10:54.30,Main-207+,,0,0,0,,Mitralyöz saldırımla eminim hepsini yakalayabilirim!
Dialogue: 0,0:10:54.30,0:10:57.91,Main-207+,,0,0,0,,O zaman hodri meydan, bakalım hangimiz daha çok balık tutacak!
Dialogue: 0,0:10:59.41,0:11:02.41,Main-207+,,0,0,0,,Nami'yi dinlemediniz mi?!
Dialogue: 0,0:11:02.41,0:11:04.71,Main-207+,,0,0,0,,Bir sürü delik açamayız!
Dialogue: 0,0:11:04.71,0:11:08.12,Main-207+,,0,0,0,,Bir daha denerseniz sizi öldürürüm!
Dialogue: 0,0:11:08.12,0:11:09.39,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 0,0:11:09.39,0:11:15.56,Main-207+,,0,0,0,,Hachi bize rehberlik eder diye\Nbu yolculuk kazasız belasız geçer sanmıştım!
Dialogue: 0,0:11:15.93,0:11:16.76,Main-207+,,0,0,0,,Bu arada!
Dialogue: 0,0:11:16.76,0:11:19.90,Main-207+,,0,0,0,,Yanıma dünya kadar yolluk verdiler!
Dialogue: 0,0:11:19.90,0:11:22.93,Main-207+,,0,0,0,,Madem Sanji hasta, hadi bunları yiyelim millet!
Dialogue: 0,0:11:23.80,0:11:25.34,Main-207+,,0,0,0,,Midem gurulduyor!
Dialogue: 0,0:11:26.57,0:11:28.27,Main-207+,,0,0,0,,Benim de kemiklerim!
Dialogue: 0,0:11:28.71,0:11:32.71,Main-207+,,0,0,0,,Nami, gemi güvende olacak mı?
Dialogue: 0,0:11:32.71,0:11:35.08,Main-207+,,0,0,0,,Tetikte olmamız gerekmez mi?
Dialogue: 0,0:11:35.08,0:11:36.25,Main-207+,,0,0,0,,İyi olacağız.
Dialogue: 0,0:11:36.25,0:11:39.62,Main-207+,,0,0,0,,Şimdilik sadece bu koca akıntıya kendimizi salmamız lazım!
Dialogue: 0,0:11:39.98,0:11:43.35,Main-207+,,0,0,0,,Yani bir süre daha bu şekilde devam edebiliriz.
Dialogue: 0,0:11:43.35,0:11:46.52,Main-207+,,0,0,0,,Şimdilik yapacak pek bir işimiz yok.
Dialogue: 0,0:11:46.52,0:11:49.09,Main-207+,,0,0,0,,O zaman biraz boş vaktimiz var ha!
Dialogue: 0,0:11:49.76,0:11:54.43,Main-207+,,0,0,0,,Size anlatacaklarım var.
Dialogue: 0,0:11:54.43,0:11:56.63,Main-207+,,0,0,0,,– Robot sırlarınla ilgili mi?!\N– Robot sırlarınla ilgili mi?!
Dialogue: 0,0:11:56.63,0:11:59.10,Main-207+,,0,0,0,,Daha başka sırların da mı var?
Dialogue: 0,0:11:59.10,0:12:01.00,Main-207+,,0,0,0,,Daha ne şekillere girebiliyorsun?!
Dialogue: 0,0:12:01.00,0:12:03.41,Main-207+,,0,0,0,,Yoksa içinde gizli bir silah mı var?
Dialogue: 0,0:12:03.41,0:12:05.44,Main-207+,,0,0,0,,Söyle bize, Robot Abi!
Dialogue: 0,0:12:05.44,0:12:09.18,Main-207+,,0,0,0,,{\fnCalligraph421 BT\fs95\c&H2C3AA7&\fad(150,150)}Süper {\c&H9797D4&\alpha&HFF&}Zırh{\c&HC2B698&}lı {\c&HE1D672&}Ben!
Dialogue: 1,0:12:06.98,0:12:09.18,Main-207+,,0,0,0,,{\fnCalligraph421 BT\fs95\c&H2C3AA7&\fad(150,150)\alpha&HFF&}Süper {\c&H9797D4&\alpha&H00&\4a&H78&}Zırh{\c&HC2B698&}lı {\c&HE1D672&\alpha&HFF&}Ben!
Dialogue: 2,0:12:08.31,0:12:09.18,Main-207+,,0,0,0,,{\fnCalligraph421 BT\fs95\c&H2C3AA7&\fad(150,150)\alpha&HFF&}Süper {\c&H9797D4&}Zırh{\c&HC2B698&}lı {\c&HE1D672&\alpha&H00&\4a&H78&}Ben!
Dialogue: 0,0:12:14.68,0:12:16.92,Main-207+,,0,0,0,,Hayır, ne yazık ki...
Dialogue: 0,0:12:16.92,0:12:18.96,Main-207+,,0,0,0,,{\fnCalligraph421 BT\b1}Ne yazık ki hayır-robo.
Dialogue: 0,0:12:18.96,0:12:21.49,Main-207+,,0,0,0,,– Vay canına! Robotça konuştu!\N– Vay canına! Robotça konuştu!
Dialogue: 0,0:12:23.29,0:12:26.76,Main-207+,,0,0,0,,Söylemek istediğim şey çok daha önemli.
Dialogue: 0,0:12:26.76,0:12:29.63,Main-207+,,0,0,0,,Siz yemeğinizi yerken anlatayım.
Dialogue: 0,0:12:29.63,0:12:34.50,Main-207+,,0,0,0,,Aslında, Hachi bizimle gelmeyi ve\Nrehberimiz olmayı istemişti.
Dialogue: 0,0:12:34.50,0:12:40.31,Main-207+,,0,0,0,,Ama Sabaody'de büyük yaralar aldığını duydum ve şimdi Balıkadam Adası'nda iyileşiyor.
Dialogue: 0,0:12:40.31,0:12:43.31,Main-207+,,0,0,0,,Sebebi Duvalinkiyle aynı.
Dialogue: 0,0:12:44.21,0:12:48.22,Main-207+,,0,0,0,,Thousand Sunny'yi korumak için mücadele vermiş.
Dialogue: 0,0:12:48.79,0:12:52.49,Main-207+,,0,0,0,,Bir yıl önce, Sunny'nin nerede demirlendiğini Denizciler öğrenmiş.
Dialogue: 0,0:12:52.49,0:12:56.53,Main-207+,,0,0,0,,Çıkan şiddetli mücadelede geri çekilmeye zorlanmışlar.
Dialogue: 0,0:12:56.53,0:12:57.59,Main-207+,,0,0,0,,Ha?
Dialogue: 0,0:12:57.59,0:13:01.23,Main-207+,,0,0,0,,Peki onca şeyden sonra gemi nasıl sapasağlam kaldı?
Dialogue: 0,0:13:01.67,0:13:04.47,Main-207+,,0,0,0,,Çünkü bir koruyucu daha vardı.
Dialogue: 0,0:13:04.47,0:13:06.87,Main-207+,,0,0,0,,Bir koruyucu daha mı?
Dialogue: 0,0:13:06.87,0:13:12.08,Main-207+,,0,0,0,,Aslında, iki yıl önce\Nbizi ayıran adamın ta kendisi.
Dialogue: 0,0:13:14.58,0:13:18.68,Main-207+,,0,0,0,,{\t(3350,0,1,\c&H000000&)}Koskoca Shichibukai, Bartholomew Kuma!
Dialogue: 0,0:13:18.82,0:13:25.69,Main-207+,,0,0,0,,Birkaç gün önce, Sunny'ye vardığımda gözlerime inanamadım...
Dialogue: 0,0:13:30.29,0:13:31.83,Flashbacks-207+,,0,0,0,,Sizi bekliyordum.
Dialogue: 0,0:13:33.43,0:13:35.50,Flashbacks-207+,,0,0,0,,Burada ne arıyorsun?!
Dialogue: 0,0:13:36.73,0:13:38.80,Flashbacks-207+,,0,0,0,,Görev tamamlandı.
Dialogue: 0,0:13:55.59,0:13:58.96,Main-207+,,0,0,0,,Sunny'nin üstünde tek bir çizik bile yoktu.
Dialogue: 0,0:13:59.46,0:14:02.26,Main-207+,,0,0,0,,Sonrasında Rayleigh'le konuştuğumda...
Dialogue: 0,0:14:02.73,0:14:05.73,Flashbacks-207+,,0,0,0,,Devrim Ordusu için çalışıyorum.
Dialogue: 0,0:14:05.73,0:14:09.27,Flashbacks-207+,,0,0,0,,Onların buradan kaçmalarına yardım etmek için sebeplerim var.
Dialogue: 0,0:14:09.63,0:14:13.20,Main-207+,,0,0,0,,Bunu sizin de farkettiğinizi tahmin ediyorum.
Dialogue: 0,0:14:13.20,0:14:16.37,Main-207+,,0,0,0,,O sırada hayatlarımızı kurtardı.
Dialogue: 0,0:14:18.54,0:14:21.51,Main-207+,,0,0,0,,Biz adadan gönderildikten sonra,
Dialogue: 0,0:14:21.51,0:14:25.12,Main-207+,,0,0,0,,Kuma-{\i1}san{\i0}, Rayleigh'i ziyaret etmiş ve...
Dialogue: 0,0:14:25.25,0:14:26.92,Flashbacks-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,515,1,\3c&H525252&\4c&H000000&)}Zamanım...
Dialogue: 0,0:14:28.02,0:14:29.69,Flashbacks-207+,,0,0,0,,tükeniyor.
Dialogue: 0,0:14:31.02,0:14:34.22,Main-207+,,0,0,0,,Denizcilere neden boyun eğdiğini bilmiyorum...
Dialogue: 0,0:14:34.22,0:14:39.76,Main-207+,,0,0,0,,ama kobay olup vücudunu parça parça siborga çevirmelerine izin vermiş!
Dialogue: 0,0:14:39.76,0:14:45.70,Main-207+,,0,0,0,,Zirve Savaşı'ndan önce kişiliğini kaybedecek bir değişiklik geçirmeyi kabul etmiş.
Dialogue: 0,0:14:45.70,0:14:52.78,Main-207+,,0,0,0,,Ama hepimizi farklı yerlere uçurduktan sonra ne yapacağımızı bildiğini hiç sanmıyorum!
Dialogue: 0,0:14:52.78,0:14:56.51,Main-207+,,0,0,0,,Yine de kişiliğini kaybetmesine rağmen gemiyi mi korumuş?
Dialogue: 0,0:14:56.51,0:15:00.42,Main-207+,,0,0,0,,Onu modifiye eden Dr. Vegapunk'a...
Dialogue: 0,0:15:00.85,0:15:05.36,Main-207+,,0,0,0,,zihnine bir görev programlamasını kabul ettirmiş.
Dialogue: 0,0:15:05.36,0:15:11.80,Main-207+,,0,0,0,,"Hasır Şapka Korsanlarından biri\Ndönene kadar gemiyi koru."
Dialogue: 0,0:15:12.36,0:15:15.90,Main-207+,,0,0,0,,Bu yüzden iki yıldır\Nanısız bir insan silah olarak...
Dialogue: 0,0:15:16.47,0:15:21.87,Main-207+,,0,0,0,,eski benliğinden kalma emirlere itaat ediyordu.
Dialogue: 0,0:15:23.01,0:15:25.64,Main-207+,,0,0,0,,Bu çılgınca.
Dialogue: 0,0:15:25.64,0:15:27.41,Main-207+,,0,0,0,,Bizim için bunu niye yaptı ki?
Dialogue: 0,0:15:27.88,0:15:30.28,Main-207+,,0,0,0,,Devrim Ordusu'yla birlikteymiş.
Dialogue: 0,0:15:30.28,0:15:35.39,Main-207+,,0,0,0,,Düşünebildiğim tek açıklama,\NLuffy'nin babasının onların patronu olması.
Dialogue: 0,0:15:36.25,0:15:42.19,Main-207+,,0,0,0,,Babamla ilgili pek bir şey bilmiyorum ama şu ayıya benzeyen adam iyi biriymiş ha?
Dialogue: 0,0:15:43.29,0:15:44.49,Thoughts-207+,,0,0,0,,Kuma...
Dialogue: 0,0:15:44.49,0:15:54.24,Main-207+,,0,0,0,,Bize verimli geçirdiğimiz iki yılı verenin o herif olduğu gün gibi ortada!
Dialogue: 0,0:15:54.24,0:16:01.04,Main-207+,,0,0,0,,Bunu neden yaptığını artık ona soramayız ama bunu kafanıza kazıyın.
Dialogue: 0,0:16:01.04,0:16:08.38,Main-207+,,0,0,0,,Bartholomew Kuma'ya can borcu olduğumuzu sakın unutmayın.
Comment: 0,0:16:01.04,0:16:05.42,Main-207+,,0,0,0,,Bartholomew Kuma'ya can borcu olduğumuzu sakın unutmayın.
Comment: 0,0:16:05.82,0:16:08.38,Main-207+,,0,0,0,,Bartholomew Kuma'ya can borcu olduğumuzu sakın unutmayın.
Dialogue: 0,0:16:08.38,0:16:12.56,Main-207+,,0,0,0,,Ama onunla bir daha karşılaşırsak\NKuma acımasız bir...
Dialogue: 0,0:16:12.56,0:16:15.19,Main-207+,,0,0,0,,insan silahtan başka bir şey olmayacak.
Dialogue: 0,0:16:15.19,0:16:17.16,Main-207+,,0,0,0,,Söyleyeceklerim bu kadardı.
Dialogue: 0,0:16:17.69,0:16:23.00,Main-207+,,0,0,0,,Ona minnettarız eyvallah ama ortada hâlâ bazı gizemler var, umarım bir gün amacını öğreniriz.
Dialogue: 0,0:16:23.43,0:16:24.77,Main-207+,,0,0,0,,Demek ona borçluyuz...
Dialogue: 0,0:16:24.77,0:16:26.84,Main-207+,,0,0,0,,Ah, Sanji, uyandın mı?
Dialogue: 0,0:16:26.84,0:16:29.57,Main-207+,,0,0,0,,Yemek ye! Kadınlar Adası'ndan!
Dialogue: 0,0:16:29.57,0:16:31.21,Main-207+,,0,0,0,,Kadınlar Adası mı?
Dialogue: 0,0:16:31.77,0:16:34.68,Main-207+,,0,0,0,,Neden Kuma'ya minnettar olayım?
Dialogue: 0,0:16:34.68,0:16:37.68,Main-207+,,0,0,0,,İki yıl boyunca nerede olduğum\Nhakkında fikriniz var mı?!
Dialogue: 0,0:16:37.68,0:16:42.59,Main-207+,,0,0,0,,Tamamı kadın olan hayaller adasında\Nne tür bir çalışma yaptın, Luffy?!
Dialogue: 0,0:16:42.59,0:16:44.75,Main-207+,,0,0,0,,Tamam, tamam, tamam, Sanji-{\i1}san{\i0}.
Dialogue: 0,0:16:44.75,0:16:50.09,Main-207+,,0,0,0,,Neler atlattığını bilmiyorum ama artık şu yolculuğun sefasını sürelim!
Dialogue: 0,0:16:50.09,0:16:51.49,Main-207+,,0,0,0,,Birlikte şarkı söyleyelim mi?
Dialogue: 0,0:16:51.49,0:16:54.23,Main-207+,,0,0,0,,Beni rahatlatmaya çalışma, zavallı hissediyorum!
Dialogue: 0,0:16:54.23,0:16:57.30,Main-207+,,0,0,0,,Abi, işte orada... Hasır Şapka.
Dialogue: 0,0:16:57.30,0:17:01.97,Main-207+,,0,0,0,,Görüyorum herhâlde aptal!
Dialogue: 0,0:17:02.94,0:17:06.14,Main-207+,,0,0,0,,Bu sefer kesinlikle onlara katılacağım!
Dialogue: 0,0:17:06.14,0:17:08.55,Main-207+,,0,0,0,,Acaba ne kadar indik?
Dialogue: 0,0:17:08.55,0:17:12.85,Main-207+,,0,0,0,,Etraf fena kararmaya başladı!
Dialogue: 0,0:17:12.85,0:17:17.99,Main-207+,,0,0,0,,Güneş ışığı alan katmanı geride bıraktık, neredeyse alacakaranlık bölgesinin dibindeyiz.
Dialogue: 0,0:17:17.99,0:17:20.32,Main-207+,,0,0,0,,Sanırım iki bin metreden fazla inmiş olmalıyız.
Dialogue: 0,0:17:20.99,0:17:22.23,Main-207+,,0,0,0,,Çok sessiz.
Dialogue: 0,0:17:22.23,0:17:25.50,Main-207+,,0,0,0,,Denizaltılardan farklı hissettiriyor.
Dialogue: 0,0:17:25.50,0:17:28.23,Main-207+,,0,0,0,,Sanki gökyüzünde uçuyor gibiyiz.
Dialogue: 0,0:17:28.23,0:17:30.17,Main-207+,,0,0,0,,Balina! Bu bir balina!
Dialogue: 0,0:17:30.17,0:17:32.07,Main-207+,,0,0,0,,Laboon! Laboon!
Dialogue: 0,0:17:32.07,0:17:34.70,Main-207+,,0,0,0,,Hayır, bu bizim ihtiyar Beyazsakal!
Dialogue: 0,0:17:37.24,0:17:40.74,Main-207+,,0,0,0,,Saat 6 yönünde bir şey görüyorum! Yaratık mı...?
Dialogue: 0,0:17:40.74,0:17:41.54,Main-207+,,0,0,0,,Hayır...
Dialogue: 0,0:17:41.54,0:17:44.98,Main-207+,,0,0,0,,Hazır mısınız, beyler?
Dialogue: 0,0:17:44.98,0:17:46.38,Main-207+,,0,0,0,,Evet, abi!
Dialogue: 0,0:17:46.38,0:17:47.88,Main-207+,,0,0,0,,– Evet, evet!\N– Evet, evet!
Dialogue: 0,0:17:47.88,0:17:50.62,Main-207+,,0,0,0,,Hedefimiz tam karşımızda!
Dialogue: 0,0:17:50.62,0:17:56.93,Main-207+,,0,0,0,,Gemilerini parçalayıp denizin dibine yollamak kolay olurdu...
Dialogue: 0,0:17:56.93,0:18:01.93,Main-207+,,0,0,0,,Ama bu iyi olmazdı.\NKimse onları öldürdüğümüzü bilmezdi.
Dialogue: 0,0:18:01.93,0:18:09.41,Main-207+,,0,0,0,,Dünyaya Caribou'nun gücünü göstermek için kellelerini alıp yüzeye çıkaracağız.
Dialogue: 0,0:18:09.81,0:18:10.84,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:18:11.17,0:18:13.64,Main-207+,,0,0,0,,Dövüş için tamamen hazırlıksız olacaklar!
Dialogue: 0,0:18:13.64,0:18:15.41,Main-207+,,0,0,0,,Tam bir sürpriz saldırı olacak!
Dialogue: 0,0:18:15.41,0:18:18.15,Main-207+,,0,0,0,,Sakın yüzünüze gözünüze bulaştırmayın!
Dialogue: 0,0:18:18.15,0:18:19.62,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:18:19.62,0:18:21.12,Main-207+,,0,0,0,,Evet! Evet!
Dialogue: 0,0:18:21.65,0:18:25.69,Main-207+,,0,0,0,,Hey, çocuklar!\NArkamızdan gemiye benzer bir şey geliyor!
Dialogue: 0,0:18:25.69,0:18:26.59,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:18:26.59,0:18:27.26,Main-207+,,0,0,0,,Gemi mi?!
Dialogue: 0,0:18:27.26,0:18:28.83,Main-207+,,0,0,0,,Doğruca üstümüze geliyor!
Dialogue: 0,0:18:29.19,0:18:30.83,Main-207+,,0,0,0,,Saldırın!
Dialogue: 0,0:18:38.74,0:18:39.87,Main-207+,,0,0,0,,Korsan gemisi bu!
Dialogue: 0,0:18:39.87,0:18:41.97,Main-207+,,0,0,0,,Gemimize tosluyorlar!
Dialogue: 0,0:18:41.97,0:18:45.27,Main-207+,,0,0,0,,Geri çekilin! Kabarcık patlayacak!
Dialogue: 0,0:18:51.68,0:18:54.58,Main-207+,,0,0,0,,Olamaz! Kabarcığımıza girmeye çalışıyorlar!
Dialogue: 0,0:18:55.52,0:18:56.72,Main-207+,,0,0,0,,Kim bunlar?!
Dialogue: 0,0:18:58.52,0:19:00.29,Main-207+,,0,0,0,,Kaçalım!
Dialogue: 0,0:19:01.69,0:19:02.93,Main-207+,,0,0,0,,Dümeni çevirin!
Dialogue: 0,0:19:09.73,0:19:11.20,Main-207+,,0,0,0,,Hadi, deniz ineği!
Dialogue: 0,0:19:14.94,0:19:16.24,Main-207+,,0,0,0,,Peşimizden geliyorlar!
Dialogue: 0,0:19:16.24,0:19:16.94,Main-207+,,0,0,0,,Bu ses...
Dialogue: 0,0:19:17.74,0:19:19.31,Main-207+,,0,0,0,,Çok ısrarcılar!
Dialogue: 0,0:19:21.04,0:19:22.61,Main-207+,,0,0,0,,Bu heriflerin nesi var?!
Dialogue: 0,0:19:26.35,0:19:27.72,Main-207+,,0,0,0,,Kesin şunu!
Dialogue: 0,0:19:27.72,0:19:29.22,Main-207+,,0,0,0,,Kabarcık patlayacak!
Dialogue: 0,0:19:29.55,0:19:31.42,Main-207+,,0,0,0,,Aferin, deniz ineği!
Dialogue: 0,0:19:31.42,0:19:32.49,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:19:32.49,0:19:34.86,Main-207+,,0,0,0,,Gemimize mi çıkacaklar?
Dialogue: 0,0:19:33.79,0:19:34.86,Secondary-207+,,0,0,0,,Deniz ineği mi?
Dialogue: 0,0:19:36.13,0:19:37.46,Main-207+,,0,0,0,,Durun! Bu...
Dialogue: 0,0:19:41.33,0:19:43.17,Main-207+,,0,0,0,,Kabarcıklar birleşti.
Dialogue: 0,0:19:43.17,0:19:44.97,Main-207+,,0,0,0,,Abi, fırsat bu fırsat!
Dialogue: 0,0:19:44.97,0:19:46.54,Main-207+,,0,0,0,,Pekâlâ!
Dialogue: 0,0:19:46.54,0:19:48.37,Main-207+,,0,0,0,,İşe koyulalım mı?!
Dialogue: 0,0:19:48.37,0:19:49.61,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:19:49.61,0:19:51.24,Main-207+,,0,0,0,,Hey, Momoo!
Dialogue: 0,0:19:51.24,0:19:53.48,Main-207+,,0,0,0,,Sen Arlong'un tayfasındaki Momoo'sun değil mi?
Dialogue: 0,0:19:54.54,0:19:56.25,Main-207+,,0,0,0,,Beni hatırladın mı?
Dialogue: 0,0:19:56.25,0:19:57.61,Main-207+,,0,0,0,,Nami ben!
Dialogue: 0,0:19:57.61,0:19:59.42,Main-207+,,0,0,0,,Arlong Park'taydım!
Dialogue: 0,0:20:01.55,0:20:03.02,Main-207+,,0,0,0,,Hey, Luffy...
Dialogue: 0,0:20:03.02,0:20:04.52,Main-207+,,0,0,0,,Bunu daha önce görmemiş miydik?
Dialogue: 0,0:20:04.89,0:20:05.86,Main-207+,,0,0,0,,Görmüş müydük?
Dialogue: 0,0:20:07.02,0:20:09.26,Flashbacks-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,518,1,\3c&H525252&\4c&H000000&)}Öl, seni lanet olası!{Arlong 02 - 10:21}
Dialogue: 0,0:20:09.26,0:20:12.03,Flashbacks-207+,,0,0,0,,{\fad(150,150)}Lastik-Lastik Tabanca!
Dialogue: 0,0:20:14.83,0:20:17.13,Main-207+,,0,0,0,,Gemiyi bordaya alın!
Dialogue: 0,0:20:17.13,0:20:17.87,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:20:20.37,0:20:22.14,Main-207+,,0,0,0,,Oha! Kabarcıktan girdi!
Dialogue: 0,0:20:22.14,0:20:23.94,Main-207+,,0,0,0,,Olamaz, biri girdi bile!
Dialogue: 0,0:20:23.94,0:20:25.71,Main-207+,,0,0,0,,Sanırım dövüşmemiz lazım.
Dialogue: 0,0:20:29.01,0:20:30.51,Main-207+,,0,0,0,,Beyler!
Dialogue: 0,0:20:30.51,0:20:32.22,Main-207+,,0,0,0,,Hazır mısınız?!
Dialogue: 0,0:20:32.22,0:20:33.38,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:20:34.02,0:20:41.32,Main-207+,,0,0,0,,Şunlar şaşkın hâlde beklerken...
Dialogue: 0,0:20:41.32,0:20:44.86,Main-207+,,0,0,0,,alayının işini bitirin!
Dialogue: 0,0:20:46.56,0:20:47.40,Main-207+,,0,0,0,,Gidelim!
Dialogue: 0,0:20:47.40,0:20:50.43,Main-207+,,0,0,0,,Evet!
Dialogue: 0,0:20:50.43,0:20:53.64,Main-207+,,0,0,0,,Beyler, peşimden gelin!
Dialogue: 0,0:20:56.37,0:20:59.28,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 0,0:20:59.28,0:21:00.81,Main-207+,,0,0,0,,Ne oldu, deniz ineği?!
Dialogue: 0,0:21:00.81,0:21:02.18,Main-207+,,0,0,0,,Neyin var?
Dialogue: 0,0:21:02.18,0:21:05.45,Main-207+,,0,0,0,,Eyvah, Kaptan Caribou o gemide kaldı!
Dialogue: 0,0:21:05.45,0:21:07.42,Main-207+,,0,0,0,,Abi!
Dialogue: 0,0:21:09.72,0:21:13.72,Main-207+,,0,0,0,,Pekâlâ, "selam" niyetine şunların üzerine...
Dialogue: 0,0:21:14.46,0:21:18.43,Main-207+,,0,0,0,,mitralyözle mermi yağdırın!
Dialogue: 0,0:21:19.03,0:21:25.97,Main-207+,,0,0,0,,Hasır Şapkaların her birini öldürün!
Dialogue: 0,0:21:29.41,0:21:29.97,Main-207+,,0,0,0,,Ha?
Dialogue: 0,0:21:40.82,0:21:45.89,Main-207+,,0,0,0,,Yapma! Lütfen beni denize atma!
Dialogue: 0,0:21:46.29,0:21:51.73,Main-207+,,0,0,0,,Tek istediğim bu! Lütfen!\NBundan başka her şey olur!
Dialogue: 0,0:21:51.73,0:21:55.50,Main-207+,,0,0,0,,Başkasının hayatına bu kadar\Numursamazca son vermemelisin!
Dialogue: 0,0:21:55.50,0:21:59.50,Main-207+,,0,0,0,,Tanrı... Tanrı sizi izliyor, farkında değil misiniz?!
Dialogue: 0,0:22:00.64,0:22:03.04,Main-207+,,0,0,0,,Yüzsüzlük etme!
Dialogue: 0,0:22:03.04,0:22:06.71,Main-207+,,0,0,0,,Demin mitralyöz kullanarak hepimizi katletmekten bahseden kimdi?!
Dialogue: 0,0:22:07.08,0:22:08.91,Main-207+,,0,0,0,,Yanlış anladınız, o sadece...
Dialogue: 0,0:22:08.91,0:22:11.75,Main-207+,,0,0,0,,lafın gelişiydi. Öyle demek istememiştim!
Dialogue: 0,0:22:11.75,0:22:13.32,Main-207+,,0,0,0,,Gayet ciddiydin.
Dialogue: 0,0:22:13.32,0:22:15.18,Main-207+,,0,0,0,,Kimsin sen?
Dialogue: 0,0:22:15.18,0:22:17.82,Main-207+,,0,0,0,,O geminin kaptanı olmalısın.
Dialogue: 0,0:22:17.82,0:22:19.96,Thoughts-207+,,0,0,0,,Oo, Roronoa Zoro!
Dialogue: 0,0:22:21.76,0:22:24.86,Main-207+,,0,0,0,,Yanılıyorsunuz! Kaptan değilim ben!
Dialogue: 0,0:22:24.86,0:22:26.50,Main-207+,,0,0,0,,Ben sadece...
Dialogue: 0,0:22:26.50,0:22:30.60,Main-207+,,0,0,0,,onların kölesi olarak kullanılıyordum.
Dialogue: 0,0:22:30.60,0:22:33.50,Main-207+,,0,0,0,,O gemide olmaktan bıktım usandım!
Dialogue: 0,0:22:33.50,0:22:35.20,Main-207+,,0,0,0,,Sahi! Lütfen!
Dialogue: 0,0:22:35.20,0:22:38.57,Main-207+,,0,0,0,,Bir süreliğine geminize sığınsam olur mu?
Dialogue: 0,0:22:38.57,0:22:39.78,Main-207+,,0,0,0,,Lütfen! Yalvarıyorum!
Dialogue: 0,0:22:39.78,0:22:43.45,Main-207+,,0,0,0,,Şey, ona acımaya başladım...
Dialogue: 0,0:22:43.45,0:22:46.12,Main-207+,,0,0,0,,Hadi ama! Bariz yalan söylüyor!
Dialogue: 0,0:22:46.12,0:22:48.45,Main-207+,,0,0,0,,Ne?! Hepsi yalan mıydı?!
Dialogue: 0,0:22:48.78,0:22:52.66,Main-207+,,0,0,0,,Hey, geminizi çeken o deniz ineğini nereden buldunuz?
Dialogue: 0,0:22:52.66,0:22:54.72,Main-207+,,0,0,0,,Bak hele...
Dialogue: 0,0:22:56.06,0:22:57.36,Main-207+,,0,0,0,,Burada...
Dialogue: 0,0:22:57.99,0:22:59.73,Main-207+,,0,0,0,,tam bir afet varmış.
Dialogue: 0,0:23:00.33,0:23:02.93,Main-207+,,0,0,0,,Sen Hırsız Kedi olmalısın.
Dialogue: 0,0:23:03.47,0:23:07.97,Main-207+,,0,0,0,,{\fad(0,252)}Rotacımızı o pis gözlerinle süzmeyi bırak ulan!
Dialogue: 0,0:23:08.50,0:23:10.07,Main-207+,,0,0,0,,Nami-{\i1}san{\i0}!
Dialogue: 0,0:23:10.07,0:23:13.38,Main-207+,,0,0,0,,Artık güvende... sin!
Dialogue: 0,0:23:13.38,0:23:16.05,Main-207+,,0,0,0,,Bu iş can sıkıcı olmaya başladı!
Dialogue: 0,0:23:16.05,0:23:20.38,Main-207+,,0,0,0,,O deniz canavarını öylesine bir yerde yakaladık işte...
Dialogue: 0,0:23:21.62,0:23:26.79,Main-207+,,0,0,0,,Bu işin kurdu olanlar\Ngemilerini o hayvanlara çektirir.
Dialogue: 0,0:23:26.79,0:23:28.06,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:23:28.06,0:23:30.09,Main-207+,,0,0,0,,Demek öyle!
Dialogue: 0,0:23:31.29,0:23:33.43,Main-207+,,0,0,0,,Dur! Dur, deniz ineği!
Dialogue: 0,0:23:33.43,0:23:34.70,Main-207+,,0,0,0,,Ne oldu sana?!
Dialogue: 0,0:23:35.06,0:23:38.73,Main-207+,,0,0,0,,Abi, seni kurtaracağım!
Dialogue: 0,0:23:39.14,0:23:42.07,Main-207+,,0,0,0,,Acaba etrafta hiç deniz canavarı var mı?
Dialogue: 0,0:23:42.07,0:23:43.47,Main-207+,,0,0,0,,Dur biraz, Luffy.
Dialogue: 0,0:23:43.47,0:23:45.47,Main-207+,,0,0,0,,Ne yapmayı planlıyorsun?
Dialogue: 0,0:23:46.44,0:23:50.18,Main-207+,,0,0,0,,Tedavisine daha az uyarıcı fotoğraflarla başlayalım.
Dialogue: 0,0:23:50.18,0:23:51.81,Main-207+,,0,0,0,,Hey, Nami.
Dialogue: 0,0:23:51.81,0:23:54.95,Main-207+,,0,0,0,,Rotamız pek de seyir belirleyicinin gösterdiği yöne gitmiyor.
Dialogue: 0,0:23:54.95,0:23:56.52,Main-207+,,0,0,0,,Evet ama sorun yok.
Dialogue: 0,0:23:57.09,0:24:00.52,Main-207+,,0,0,0,,İğnenin gösterdiği yerin biraz güneybatısından gitmek en iyi yol.
Dialogue: 0,0:24:00.52,0:24:05.39,Main-207+,,0,0,0,,Düz gitmek daha hızlı, niye saptık?
Dialogue: 0,0:24:05.39,0:24:09.93,Main-207+,,0,0,0,,Doğruca aşağı gitseydik deniz akıntısına kapılıp...
Dialogue: 0,0:24:09.93,0:24:13.37,Main-207+,,0,0,0,,deniz dağına veya deniz altındaki volkanlara toslayacaktık.
Dialogue: 0,0:24:13.37,0:24:15.57,Main-207+,,0,0,0,,Ne?! Volkan mı?!
Dialogue: 0,0:24:15.57,0:24:17.04,Main-207+,,0,0,0,,Deniz altı korkunç!
Dialogue: 0,0:24:17.04,0:24:22.11,Main-207+,,0,0,0,,İyi de Grand Line'daki akıntıların sağı solu belli olmaz sanıyordum.
Dialogue: 0,0:24:22.11,0:24:24.38,Main-207+,,0,0,0,,Koskoca denizde sabit bir akıntı yok mu?
Dialogue: 0,0:24:24.85,0:24:26.58,Main-207+,,0,0,0,,Sadece bir tane var.
Dialogue: 0,0:24:26.58,0:24:28.05,Main-207+,,0,0,0,,Böyle iyi.
Dialogue: 0,0:24:28.05,0:24:29.39,Main-207+,,0,0,0,,Kıpırdamadan dur.
Dialogue: 0,0:24:29.39,0:24:34.39,Main-207+,,0,0,0,,Millet! Birazdan etraf soğuyacak.\NPalto falan giyseniz iyi olur.
Dialogue: 0,0:24:34.39,0:24:38.46,Main-207+,,0,0,0,,Evet, hava soğuyor; tenimde hissediyorum.
Dialogue: 0,0:24:38.46,0:24:40.60,Main-207+,,0,0,0,,Ah! Gerçi benim...
Dialogue: 0,0:24:40.60,0:24:43.40,Main-207+,,0,0,0,,Sen bir iskeletsin, o yüzden tenin falan yok.
Dialogue: 0,0:24:44.57,0:24:46.24,Main-207+,,0,0,0,,Chopper-{\i1}san{\i0}...
Dialogue: 0,0:24:46.24,0:24:48.40,Main-207+,,0,0,0,,Bunu yapamazsın...
Dialogue: 0,0:24:48.40,0:24:51.11,Main-207+,,0,0,0,,Repliğimi çalamazsın...
Dialogue: 0,0:24:51.11,0:24:54.34,Main-207+,,0,0,0,,Soğuk bir yere mi gidiyoruz?\NDenizin dibine inmiyor muyduk?
Dialogue: 0,0:24:54.34,0:24:57.91,Main-207+,,0,0,0,,Denizin derinliklerine indikçe\Nsuyun soğuk olduğunu bilmiyor musun?
Dialogue: 0,0:24:57.91,0:25:01.55,Main-207+,,0,0,0,,Tıpkı küvetteki gibi, sıcak su yukarı çıkar soğuk su aşağı çöker!
Dialogue: 0,0:25:01.55,0:25:04.39,Main-207+,,0,0,0,,Öyle mi? Banyo yapmayı hiç sevmiyorum.
Dialogue: 0,0:25:04.39,0:25:05.96,Main-207+,,0,0,0,,Tabii ya.
Dialogue: 0,0:25:05.96,0:25:10.23,Main-207+,,0,0,0,,Deniz için de durum aynıysa\Nderinlerdeki su yüzeydekinden daha soğuktur.
Dialogue: 0,0:25:10.23,0:25:13.16,Main-207+,,0,0,0,,Farklı olan sadece sıcaklık değil.
Dialogue: 0,0:25:14.03,0:25:16.17,Main-207+,,0,0,0,,Şunu atlatır mısın artık?!
Dialogue: 0,0:25:16.17,0:25:17.67,Main-207+,,0,0,0,,Denizin derinliklerinde,
Dialogue: 3,0:25:18.30,0:25:24.91,Main-207+,,0,0,0,,"derin deniz akıntısı" denen nadir dev akıntılar vardır.
Dialogue: 3,0:25:24.91,0:25:29.98,Main-207+,,0,0,0,,Karşılaştığınız tüm yüzey akıntılarından tamamen farklıdırlar.
Dialogue: 0,0:25:29.98,0:25:33.05,Main-207+,,0,0,0,,Akıntıların altında başka akıntılar mı var?!
Dialogue: 0,0:25:33.05,0:25:34.78,Main-207+,,0,0,0,,Gerçekten bilgilisin!
Dialogue: 0,0:25:36.25,0:25:37.92,Main-207+,,0,0,0,,Çok fazla yaşadığım için!
Dialogue: 0,0:25:38.32,0:25:41.72,Main-207+,,0,0,0,,Tüm akıntıların bir yere bağlanması gerekir.
Dialogue: 0,0:25:41.72,0:25:44.93,Main-207+,,0,0,0,,Bir akıntı doğuya doğru akarken diğeri batıya akabilir.
Dialogue: 0,0:25:44.93,0:25:48.20,Main-207+,,0,0,0,,Aynı şekilde yukarı veya aşağı yönde de akabilirler.
Dialogue: 0,0:25:48.20,0:25:50.77,Main-207+,,0,0,0,,Tıpkı devasa bir ejderha gibi.
Dialogue: 0,0:25:50.77,0:25:55.30,Main-207+,,0,0,0,,Derin akıntılar gerçekten çok yavaş akar.
Dialogue: 0,0:25:55.30,0:26:01.18,Main-207+,,0,0,0,,Deniz tabanına indikten sonra tekrar yüzeye çıkmaları...
Dialogue: 0,0:26:01.18,0:26:04.01,Main-207+,,0,0,0,,tam iki bin yıl sürer.
Dialogue: 0,0:26:04.01,0:26:05.61,Main-207+,,0,0,0,,– İki bin yıl mı?!\N– İki bin yıl mı?!
Dialogue: 0,0:26:05.61,0:26:06.72,Main-207+,,0,0,0,,Evet...
Dialogue: 0,0:26:07.25,0:26:11.14,Main-207+,,0,0,0,,İşte bu yüzden,\Nderin deniz akıntılarının ulaştığı...
Dialogue: 0,0:26:11.17,0:26:14.86,Main-207+,,0,0,0,,karanlık ve bilinmeyen yerler\Nhakkında bir sürü efsane vardır.
Dialogue: 0,0:26:14.86,0:26:16.26,Main-207+,,0,0,0,,Canavarlar!
Dialogue: 0,0:26:16.26,0:26:17.39,Main-207+,,0,0,0,,Lanetler!
Dialogue: 0,0:26:17.39,0:26:19.96,Main-207+,,0,0,0,,Ölülerin ruhları!
Dialogue: 0,0:26:19.96,0:26:21.06,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:26:21.06,0:26:23.00,Main-207+,,0,0,0,,Denizin dibinde hayaletler mi var?!
Dialogue: 0,0:26:23.00,0:26:25.30,Main-207+,,0,0,0,,Ha?! Harbi mi?! Korkunç!
Dialogue: 0,0:26:25.30,0:26:26.67,Main-207+,,0,0,0,,Heyecanlanıyorum!
Dialogue: 0,0:26:26.67,0:26:28.80,Main-207+,,0,0,0,,Demek hayaletler...
Dialogue: 0,0:26:28.80,0:26:30.57,Main-207+,,0,0,0,,Bu konuda bilgim yok.
Dialogue: 0,0:26:30.57,0:26:35.88,Main-207+,,0,0,0,,Fakat bizim yüzeyden dibe doğru inen bir akıntıya kapılmamız şart.
Dialogue: 0,0:26:35.88,0:26:40.02,Main-207+,,0,0,0,,Deniz tabanına işte bu şekilde ineceğiz.
Dialogue: 0,0:26:42.15,0:26:45.12,Main-207+,,0,0,0,,– Yani basitçe, gizemli akıntılar...\N– Yani basitçe, gizemli akıntılar...{Gab, matching the gag in RM 01 - 07:59}
Dialogue: 0,0:26:45.12,0:26:47.99,Main-207+,,0,0,0,,Hiçbir bok anlamadınız, değil mi?!
Dialogue: 0,0:26:50.23,0:26:51.76,Main-207+,,0,0,0,,Şarkı söyleyelim mi, Nami-{\i1}san{\i0}?
Dialogue: 0,0:26:51.76,0:26:52.70,Main-207+,,0,0,0,,Kes sesini!
Dialogue: 0,0:26:57.73,0:26:58.53,Main-207+,,0,0,0,,Bu olmalı!
Dialogue: 0,0:26:58.53,0:27:00.37,Main-207+,,0,0,0,,Nami, görüyorum!
Dialogue: 0,0:27:00.37,0:27:01.37,Main-207+,,0,0,0,,Gerçekten mi?
Dialogue: 0,0:27:01.37,0:27:03.24,Main-207+,,0,0,0,,Gizemli akıntı ha?!{Gab, 26:38}
Dialogue: 0,0:27:04.61,0:27:06.04,Main-207+,,0,0,0,,Nerede?! Nerede?!
Dialogue: 0,0:27:06.04,0:27:07.81,Main-207+,,0,0,0,,Bu müthiş!
Dialogue: 0,0:27:09.65,0:27:10.65,Main-207+,,0,0,0,,Bu da ne?
Dialogue: 0,0:27:10.65,0:27:14.08,Main-207+,,0,0,0,,Demek derinlere kadar inen deniz akıntısı bu.
Dialogue: 0,0:27:14.08,0:27:16.19,Main-207+,,0,0,0,,Aşağı giden akıntı bulutu!
Dialogue: 0,0:27:17.49,0:27:20.46,Main-207+,,0,0,0,,Müüt... hiş!
Dialogue: 0,0:27:20.46,0:27:23.56,Main-207+,,0,0,0,,Bu sanki devasa bir...
Dialogue: 0,0:27:25.83,0:27:29.63,Main-207+,,0,0,0,,deniz altı şelalesi!
Dialogue: 0,0:27:29.63,0:27:32.23,Main-207+,,0,0,0,,Su dibe doğru akıp duruyor!
Dialogue: 0,0:27:32.23,0:27:35.14,Main-207+,,0,0,0,,İnanılmaz hızlı!
Dialogue: 0,0:27:35.14,0:27:36.64,Main-207+,,0,0,0,,Çok ilginç!
Dialogue: 0,0:27:39.04,0:27:41.11,Main-207+,,0,0,0,,Doğa tek kelimeyle harika!
Dialogue: 0,0:27:41.48,0:27:43.65,Main-207+,,0,0,0,,Ne muhteşem bir akıntı!
Dialogue: 0,0:27:43.65,0:27:46.12,Main-207+,,0,0,0,,Acaba uzunluğu kaç metre...
Dialogue: 0,0:27:46.55,0:27:50.82,Main-207+,,0,0,0,,Kendi gözlerinle görmek,\Nhikâyelerde duymaktan tamamen farklı!
Dialogue: 0,0:27:51.19,0:27:53.09,Main-207+,,0,0,0,,Dibini göremiyorum!
Dialogue: 0,0:27:53.09,0:27:54.99,Main-207+,,0,0,0,,Aşağısı zifiri karanlık!
Dialogue: 0,0:27:55.36,0:27:56.79,Main-207+,,0,0,0,,Ayvayı yedik!
Dialogue: 0,0:27:56.79,0:28:01.63,Main-207+,,0,0,0,,Bu hızda düşersek\Ndeniz tabanına çarpıp geberir gideriz!
Dialogue: 0,0:28:02.06,0:28:05.07,Main-207+,,0,0,0,,Bu akıntıyı kullanınca\Nbir şey olmayacağına emin misin?
Dialogue: 0,0:28:05.07,0:28:07.24,Main-207+,,0,0,0,,Gemi konusunda sıkıntı yok.
Dialogue: 0,0:28:07.24,0:28:12.01,Main-207+,,0,0,0,,Sunny, Değerli Adem Ağacı'ndan yapıldı.\NVar olan en güçlü gemi.
Dialogue: 0,0:28:14.81,0:28:16.05,Main-207+,,0,0,0,,Olamaz!
Dialogue: 0,0:28:16.05,0:28:21.58,Main-207+,,0,0,0,,O şeyin aşağıda yaşadığını bilmiyordum!
Dialogue: 0,0:28:21.58,0:28:24.52,Main-207+,,0,0,0,,Engin denizde dolaşan efsanevi iblis!
Dialogue: 0,0:28:25.09,0:28:27.86,Main-207+,,0,0,0,,Tüm insanlığın düşmanı!
Dialogue: 0,0:28:28.99,0:28:31.19,Main-207+,,0,0,0,,Hasır Şapkalar!
Dialogue: 0,0:28:31.19,0:28:32.86,Main-207+,,0,0,0,,Hemen geri dönün!
Dialogue: 0,0:28:32.86,0:28:34.66,Main-207+,,0,0,0,,Mahvolduk!
Dialogue: 0,0:28:34.66,0:28:36.47,Main-207+,,0,0,0,,Seni tamamen unutmuştum.
Dialogue: 0,0:28:36.47,0:28:38.63,Main-207+,,0,0,0,,Orada bir canavar var!
Dialogue: 0,0:28:39.24,0:28:40.20,Main-207+,,0,0,0,,O...
Dialogue: 0,0:28:40.97,0:28:41.84,Main-207+,,0,0,0,,Orada...
Dialogue: 0,0:28:41.84,0:28:44.11,Main-207+,,0,0,0,,Kesin şunu!
Dialogue: 0,0:28:44.11,0:28:46.28,Main-207+,,0,0,0,,A-Arkanda...
Dialogue: 0,0:28:46.64,0:28:48.28,Main-207+,,0,0,0,,Neden bahsediyorsunuz?
Dialogue: 0,0:28:51.58,0:28:52.41,Main-207+,,0,0,0,,Ar-
Dialogue: 0,0:28:53.92,0:28:55.42,Main-207+,,0,0,0,,...kamda mı?
Dialogue: 0,0:29:02.39,0:29:05.26,Main-207+,,0,0,0,,Kraken bu!
Dialogue: 0,0:29:06.63,0:29:08.93,Main-207+,,0,0,0,,Kocaman bir canavar ahtapot!
Dialogue: 0,0:29:09.63,0:29:12.33,Main-207+,,0,0,0,,Aynı anda birkaç gemiyi birden parçalıyor.
Dialogue: 0,0:29:12.80,0:29:15.70,Main-207+,,0,0,0,,Yeni Dünya'ya yelken açan gemilere saldırmış!
Dialogue: 0,0:29:16.04,0:29:19.04,Main-207+,,0,0,0,,Lütfen! Ölmek istemiyorum!
Dialogue: 0,0:29:19.04,0:29:20.24,Main-207+,,0,0,0,,Geri dönün!
Dialogue: 0,0:29:20.24,0:29:23.78,Main-207+,,0,0,0,,Birkaç gün beklersek eminim o canavar–
Dialogue: 0,0:29:23.78,0:29:25.81,Main-207+,,0,0,0,,Kapa' çeneni! Sessiz ol!
Dialogue: 0,0:29:26.82,0:29:29.25,Main-207+,,0,0,0,,Aklıma harika bir fikir geldi!
Dialogue: 0,0:29:30.05,0:29:32.02,Main-207+,,0,0,0,,Hadi onu evcilleştirelim!
Dialogue: 0,0:29:32.82,0:29:33.89,Main-207+,,0,0,0,,– Hah?\N– Hah?
