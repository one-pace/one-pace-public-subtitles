Dialogue: 0,0:01:57.77,0:01:59.77,Main-207+,,0,0,5,,Velitsu! Hankala kaivaa!
Dialogue: 0,0:01:59.77,0:02:01.01,Main-207+,,0,0,5,,Niin, no...
Dialogue: 0,0:02:01.01,0:02:03.21,Main-207+,,0,0,5,,{\q2}Onhan saari paljolti puunjuurten päällä.
Dialogue: 0,0:02:04.71,0:02:07.31,Main-207+,,0,0,0,,Armoa! Älkää haudatko meitä!
Dialogue: 0,0:02:07.31,0:02:09.85,Main-207+,,0,0,0,,Me tehdään mitä vain,\Nkunhan säästätte henkemme!
Dialogue: 0,0:02:09.85,0:02:13.78,Main-207+,,0,0,0,,Me vain toteltiin kapteenia!\NSitä Blackin kurjimusta...!
Dialogue: 0,0:02:15.19,0:02:18.56,Main-207+,,0,0,0,,Mie kuulkaas ajattelin...
Dialogue: 0,0:02:19.92,0:02:23.66,Main-207+,,0,0,0,,että Olkihatun toveriksi päästyämme...
Dialogue: 0,0:02:24.86,0:02:26.80,Main-207+,,0,0,0,,voitaisiin sisältäpäin...
Dialogue: 0,0:02:28.17,0:02:33.00,Main-207+,,0,0,0,,listiä koko sakki vapaasti.
Dialogue: 0,0:02:36.11,0:02:37.74,Main-207+,,0,0,0,,Drip!
Dialogue: 0,0:02:37.74,0:02:39.91,Main-207+,,0,0,0,,Hei, lopeta! Sehän kuolee!
Dialogue: 0,0:02:39.91,0:02:42.11,Main-207+,,0,0,0,,Onko sullakin pirunmarjavoimat?!
Dialogue: 0,0:02:42.11,0:02:44.05,Main-207+,,0,0,0,,K-Käskin lopettaa!
Dialogue: 0,0:02:44.62,0:02:47.08,Main-207+,,0,0,0,,Jes! Osuipas...
Dialogue: 0,0:02:50.82,0:02:53.89,Main-207+,,0,0,0,,Häh? Mitä hittoa... Logia-tyyppikö?!
Dialogue: 0,0:02:56.23,0:02:57.90,Main-207+,,0,0,0,,Ja kuinkas sitten kävikään!
Dialogue: 0,0:02:57.90,0:03:03.23,Main-207+,,0,0,0,,Kyllä kahdessa vuodessa\Nnaama ja kroppa ehtii muuttua, ajattelin...
Dialogue: 0,0:03:03.23,0:03:05.10,Main-207+,,0,0,0,,Olkihattu-piraatti...
Dialogue: 0,0:03:05.10,0:03:06.90,Main-207+,,0,0,0,,Mutta eipä mitään!
Dialogue: 0,0:03:06.90,0:03:09.01,Main-207+,,0,0,0,,Kyseessä oli vain puijari!
Dialogue: 0,0:03:09.01,0:03:12.31,Main-207+,,0,0,0,,Salliiko jumalat tällaista, Coribou?
Dialogue: 0,0:03:12.31,0:03:13.81,Main-207+,,0,0,0,,Kaivan, kaivan!
Dialogue: 0,0:03:13.81,0:03:15.21,Main-207+,,0,0,0,,Jetsulleen.
Dialogue: 0,0:03:15.21,0:03:17.01,Main-207+,,0,0,0,,Haudataan kaikki tyynni!
Dialogue: 0,0:03:17.01,0:03:19.45,Main-207+,,0,0,0,,Voi jumalat!
Dialogue: 0,0:03:19.45,0:03:23.19,Main-207+,,0,0,0,,Myö hautaamme joka iikan\Nnäistä tyhmyreistä!
Dialogue: 0,0:03:24.49,0:03:27.19,Main-207+,,0,0,0,,Lopettakaa! Älkää tappako meitä!
Dialogue: 0,0:03:27.19,0:03:33.60,Main-207+,,0,0,0,,Mutta näin ikiomin silmin myös\Naidon Olkihattu-Luffyn!
Dialogue: 0,0:03:35.57,0:03:39.64,Main-207+,,0,0,5,,{\q2}Kerroinhan jo. Ei siinä tilanteessa voinut muuta.
Dialogue: 0,0:03:40.34,0:03:43.21,Main-207+,,0,0,0,,Eteen asettui "Haades" Rayleigh!
Dialogue: 0,0:03:43.21,0:03:45.34,Main-207+,,0,0,0,,Mies pysäytti setä Kizarunkin!
Dialogue: 0,0:03:45.34,0:03:47.01,Main-207+,,0,0,0,,Mitä meidän muka pitäisi tehdä?
Dialogue: 0,0:03:47.95,0:03:55.65,Main-207+,,0,0,0,,{\q2}Aukiolta pääsivät livahtamaan Caribou-veljekset\Njoukkoineen, ja osa valeolkihatuista.
Dialogue: 0,0:03:55.65,0:04:02.46,Main-207+,,0,0,0,,{\q2}Nappasimme kaikki muut, mutta aidot\NOlkihatut vaurioittivat pahasti kahta pasifistaa.
Dialogue: 0,0:04:02.86,0:04:06.73,Main-207+,,0,0,0,,{\q2}Kyllä, prototyyppejä, jotka kaksi\Nvuotta sitten panivat heidät ahtaalle.
Dialogue: 0,0:04:06.73,0:04:09.47,Main-207+,,0,0,0,,Pasifistojen voimat ei ole muuttuneet...
Dialogue: 0,0:04:09.47,0:04:11.94,Main-207+,,0,0,0,,vaan sen {\i1}porukan{\i0}!
Dialogue: 0,0:04:13.00,0:04:16.77,Main-207+,,0,0,0,,Piileskelyaikanaan he ovat\Nkehittyneet rajusti!
Dialogue: 0,0:04:18.78,0:04:22.55,Main-207+,,0,0,0,,Varmistakaa, että päämaja\NUudessa Maailmassa tajuaa!
Dialogue: 0,0:04:23.15,0:04:27.55,Main-207+,,0,0,0,,Olkihatun sakki on taas iskukykyinen!
Dialogue: 0,0:04:31.09,0:04:33.62,Main-207+,,0,0,0,,Lähtö kävi äkkiä.
Dialogue: 0,0:04:38.26,0:04:42.20,Main-207+,,0,0,0,,Pikku Monkey ja muut olivat varttuneet...
Dialogue: 0,0:04:43.57,0:04:44.80,Main-207+,,0,0,0,,Katselit siis.
Dialogue: 0,0:04:44.80,0:04:46.37,Main-207+,,0,0,0,,Toki, olenhan fani.
Dialogue: 0,0:04:48.67,0:04:52.18,Main-207+,,0,0,0,,Ray... Muistelitko kenties jotain?
Dialogue: 0,0:04:53.31,0:04:54.68,Main-207+,,0,0,0,,No...
Dialogue: 0,0:04:55.45,0:04:57.01,Main-207+,,0,0,0,,Itse asiassa...
Dialogue: 0,0:05:02.55,0:05:04.69,Flashbacks-207+,,0,0,0,,Hoi! Komea pursi!
Dialogue: 0,0:05:04.69,0:05:06.42,Flashbacks-207+,,0,0,0,,Kunhan pöllin.
Dialogue: 0,0:05:06.42,0:05:08.76,Flashbacks-207+,,0,0,0,,Asun tällä, kun taloni paloi poroksi.
Dialogue: 0,0:05:08.76,0:05:11.26,Flashbacks-207+,,0,0,0,,Ahaa. Mikä on nimi?
Dialogue: 0,0:05:11.26,0:05:12.40,Flashbacks-207+,,0,0,0,,Rayleigh.
Dialogue: 0,0:05:13.50,0:05:15.00,Flashbacks-207+,,0,0,0,,Mä olen Roger!
Dialogue: 0,0:05:15.00,0:05:18.07,Flashbacks-207+,,0,0,0,,Kohtalo toi meidät yhteen, Rayleigh!
Dialogue: 0,0:05:18.07,0:05:19.77,Flashbacks-207+,,0,0,0,,Kohtalo?
Dialogue: 0,0:05:19.77,0:05:23.21,Flashbacks-207+,,0,0,0,,Keikautetaanko yhdessä\Nmaailma ylösalaisin?
Dialogue: 0,0:05:23.64,0:05:24.71,Flashbacks-207+,,0,0,0,,Häh?
Dialogue: 0,0:05:24.71,0:05:26.18,Flashbacks-207+,,0,0,0,,Maailma?
Dialogue: 0,0:05:27.21,0:05:29.18,Flashbacks-207+,,0,0,0,,Mikä luulet olevasi?
Dialogue: 0,0:05:29.65,0:05:31.01,Flashbacks-207+,,0,0,0,,Ala kalppia!
Dialogue: 0,0:05:31.88,0:05:36.02,Main-207+,,0,0,0,,Ehkä tässä maailmassa\Nei olekaan sattumia.
Dialogue: 0,0:05:36.02,0:05:39.26,Main-207+,,0,0,0,,{\q2}Tapahtumat ja siteet muodostavat kuvioita,
Dialogue: 0,0:05:40.42,0:05:43.56,Main-207+,,0,0,0,,kuin kaikki olisi jo ennalta saneltua.
Dialogue: 0,0:05:43.56,0:05:46.90,Main-207+,,0,0,0,,Oli miten oli, Luffysta on tullut mies,
Dialogue: 0,0:05:46.90,0:05:50.97,Main-207+,,0,0,0,,jolle tuo hattu sopii aina vain paremmin!
Dialogue: 0,0:05:51.30,0:05:54.74,Main-207+,,0,0,0,,Elämällä saattaa olla vielä jotain\Nhauskaa tarjottavaa...
Dialogue: 0,0:05:55.67,0:05:58.11,Main-207+,,0,0,5,,Pinta on jo noin kaukana.
Dialogue: 0,0:05:58.11,0:05:59.91,Main-207+,,0,0,0,,Mitkä näkymät!
Dialogue: 0,0:05:59.91,0:06:03.71,Main-207+,,0,0,0,,Sukellusveneeseen ei saisi\Nnäin leveää ikkunaa!
Dialogue: 0,0:06:03.71,0:06:06.05,Main-207+,,0,0,0,,Vajoamme aina vain syvemmälle!
Dialogue: 0,0:06:06.62,0:06:09.55,Main-207+,,0,0,0,,Onko ihan varma, että vesi ei tule sisälle?!
Dialogue: 0,0:06:09.55,0:06:13.29,Main-207+,,0,0,0,,Ihmismaailma tuntuu jotenkin\Nkaukaiselta... Jännittää!
Dialogue: 0,0:06:13.29,0:06:18.53,Main-207+,,0,0,0,,P-Päästäänkö vielä takaisin maan päälle?
Dialogue: 0,0:06:19.13,0:06:21.40,Main-207+,,0,0,0,,E-Ei sillä että pelkäisin...
Dialogue: 0,0:06:23.63,0:06:26.14,Main-207+,,0,0,0,,Meri on tosi kaunis...!
Dialogue: 0,0:06:34.34,0:06:36.58,Main-207+,,0,0,0,,Vilkaiskaapa vierellemme!
Dialogue: 0,0:06:39.35,0:06:41.59,Main-207+,,0,0,0,,Puita... Ei kun juuria!
Dialogue: 0,0:06:44.52,0:06:46.19,Main-207+,,0,0,0,,Tosiaan.
Dialogue: 0,0:06:46.19,0:06:50.66,Main-207+,,0,0,0,,Kun asiaa ajattelee, koko Sabaodyhan\Non iso mangrovemetsä...
Dialogue: 0,0:06:50.66,0:06:53.50,Main-207+,,0,0,0,,Luonto näyttää mahtinsa!
Dialogue: 0,0:06:53.50,0:06:56.00,Main-207+,,0,0,0,,Melkein poksahtavat silmät ulos kallosta!
Dialogue: 0,0:06:56.00,0:06:57.87,Main-207+,,0,0,0,,Ah, mutta eihän minulla niitä ole.
Dialogue: 0,0:06:59.07,0:07:01.14,Main-207+,,0,0,0,,Mä näin jo.
Dialogue: 0,0:07:01.14,0:07:03.11,Main-207+,,0,0,0,,Väärällä laivalla!
Dialogue: 0,0:07:03.11,0:07:05.38,Main-207+,,0,0,0,,Pää kii ja anna toisten vaikuttua!
Dialogue: 0,0:07:06.18,0:07:09.85,Main-207+,,0,0,0,,Juuret ulottuvat pohjaan saakka...
Dialogue: 0,0:07:10.61,0:07:13.32,Main-207+,,0,0,0,,Tämä valtavuus vetää sanattomaksi.
Dialogue: 0,0:07:19.49,0:07:21.16,Main-207+,,0,0,0,,Jo riitti minulle!
Dialogue: 0,0:07:21.16,0:07:22.63,Main-207+,,0,0,0,,Hei, Chopper...
Dialogue: 0,0:07:22.63,0:07:24.66,Main-207+,,0,0,0,,Puun takana on jotain!
Dialogue: 0,0:07:24.66,0:07:25.40,Main-207+,,0,0,0,,Täh?
Dialogue: 0,0:07:26.46,0:07:29.37,Main-207+,,0,0,0,,Vau, se on iso!
Dialogue: 0,0:07:29.37,0:07:31.34,Main-207+,,0,0,0,,Tosi jänskää!
Dialogue: 0,0:07:31.34,0:07:33.20,Main-207+,,0,0,0,,Seikkailu meren alla!
Dialogue: 0,0:07:33.20,0:07:34.94,Main-207+,,0,0,0,,Kuin näkisi unta!
Dialogue: 0,0:07:34.94,0:07:37.04,Main-207+,,0,0,0,,Oho! Kaloja!
Dialogue: 0,0:07:37.04,0:07:38.34,Main-207+,,0,0,0,,Melkein saan kiinni..!
Dialogue: 0,0:07:39.64,0:07:42.48,Main-207+,,0,0,0,,Toikin näyttää makoisalta.
Dialogue: 0,0:07:44.15,0:07:46.12,Main-207+,,0,0,0,,Nyt loppuu tuollainen!
Dialogue: 0,0:07:46.12,0:07:48.89,Main-207+,,0,0,0,,Entä jos kupla puhkeaa?!
Dialogue: 0,0:07:48.89,0:07:50.85,Main-207+,,0,0,0,,Saatte köniin jos teette noin vielä!
Dialogue: 0,0:07:50.85,0:07:56.39,Main-207+,,0,0,0,,Nami-neiti, kertokaa, miten pitää toimia,\Nennen kuin nuo hölmöävät jotain.
Dialogue: 0,0:07:56.89,0:07:58.76,Main-207+,,0,0,0,,Olet oikeassa, Sanji!
Dialogue: 0,0:07:58.76,0:08:01.13,Main-207+,,0,0,0,,Herra Rayleigh kirjoitti ohjeet.
Dialogue: 0,0:08:01.13,0:08:03.20,Main-207+,,0,0,0,,No niin, kaikki! Selitän...
Dialogue: 0,0:08:03.20,0:08:04.10,Main-207+,,0,0,0,,Liikkui!
Dialogue: 0,0:08:04.57,0:08:06.30,Main-207+,,0,0,0,,Livekaunotar!
Dialogue: 0,0:08:06.30,0:08:07.87,Main-207+,,0,0,0,,– Sanji!\N– Sanji!
Dialogue: 0,0:08:07.87,0:08:09.27,Main-207+,,0,0,0,,Hajoaa! Hajoaa! Hajoaa!
Dialogue: 0,0:08:09.27,0:08:11.81,Main-207+,,0,0,0,,Miten purskauksesta noin voi lentää?
Dialogue: 0,0:08:13.88,0:08:15.31,Main-207+,,0,0,0,,– Täh?!\N– Täh?!
Dialogue: 0,0:08:15.31,0:08:17.41,Main-207+,,0,0,0,,– Sanji putkahti mereen!\N– Sanji putkahti mereen!
Dialogue: 0,0:08:17.41,0:08:18.72,Main-207+,,0,0,0,,Kiehtovaa.
Dialogue: 0,0:08:18.72,0:08:26.59,Main-207+,,0,0,0,,{\q2}Kupla ei hajoa huolimatta näin syvällä\Nveden alla vallitsevasta valtavasta paineesta,
Dialogue: 0,0:08:26.59,0:08:30.53,Main-207+,,0,0,0,,mutta sen läpi kykenee\Nmenemään tuosta noin vain.
Dialogue: 0,0:08:31.33,0:08:32.90,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:08:32.90,0:08:35.47,Main-207+,,0,0,0,,Tule takaisin!
Dialogue: 0,0:08:36.97,0:08:38.74,Main-207+,,0,0,0,,Meri vie voimat...
Dialogue: 0,0:08:39.17,0:08:41.07,Main-207+,,0,0,0,,– Tsemppiä!\N– Tsemppiä!
Dialogue: 0,0:08:52.58,0:08:55.75,Main-207+,,0,0,0,,Mikä sinua vaivaa, Sanji?!
Dialogue: 0,0:08:55.75,0:08:58.99,Main-207+,,0,0,0,,Kuin et enää kestäisi naisia!
Dialogue: 0,0:08:58.99,0:09:00.42,Main-207+,,0,0,0,,Ei se ole sinunlaistasi!
Dialogue: 0,0:09:00.42,0:09:01.89,Main-207+,,0,0,0,,Surullista...
Dialogue: 0,0:09:02.39,0:09:06.83,Main-207+,,0,0,0,,Mitä Sanji, naisrakas ystävämme,\Non näiden vuosien aikana kokenut...?
Dialogue: 0,0:09:07.30,0:09:13.90,Main-207+,,0,0,0,,Ja jos tällä menolla kohtaamme\Nmerenneitoja, hän vielä vuotaa kuiviin.
Dialogue: 0,0:09:13.90,0:09:16.57,Main-207+,,0,0,0,,En voi olla kuin huolissani.
Dialogue: 0,0:09:16.57,0:09:19.94,Main-207+,,0,0,0,,Täytyy saada lisää verta Nereidisaarella...
Dialogue: 0,0:09:19.94,0:09:24.21,Main-207+,,0,0,0,,Onkohan nereidien ja merenmiesten\Nveri kuin ihmisillä?
Dialogue: 0,0:09:24.21,0:09:28.52,Main-207+,,0,0,0,,{\i1}Sunnyn{\i0} päällyste toimii samalla tavalla
Dialogue: 0,0:09:28.52,0:09:33.29,Main-207+,,0,0,0,,kuten Sabaodyn kuplat,\Nkuten juuri näimme. Niinkö?
Dialogue: 0,0:09:33.66,0:09:36.69,Main-207+,,0,0,0,,Älä sä vain viileänä analysoi kuplia!
Dialogue: 0,0:09:36.69,0:09:38.50,Main-207+,,0,0,0,,Osuit naulan kantaan, Robin.
Dialogue: 0,0:09:39.23,0:09:41.16,Main-207+,,0,0,0,,Pitkälti samasta on kyse.
Dialogue: 0,0:09:41.16,0:09:46.17,Main-207+,,0,0,0,,Se venyy jonkin verran ja sitten päästää läpi.
Dialogue: 0,0:09:46.27,0:09:51.24,Main-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,383,1,\3c&H000000&\4c&H000000&)}Lyhyesti sanottuna: Vaikka ampuisimme\Nhyökkäävää petoa tykein ja pyssyin,
Dialogue: 0,0:09:51.24,0:09:52.88,Main-207+,,0,0,0,,kupla ei kuulemma hajoa.
Dialogue: 0,0:09:52.88,0:09:53.51,Main-207+,,0,0,0,,Täh?
Dialogue: 0,0:09:54.08,0:09:57.61,Main-207+,,0,0,0,,No mistä se sitten menee rikki?
Dialogue: 0,0:09:57.61,0:10:02.15,Main-207+,,0,0,0,,Kuten odottaa saattaa, lukuisia\Nreikiä yhdellä kertaa se ei kestä.
Dialogue: 0,0:10:02.15,0:10:07.42,Main-207+,,0,0,0,,Esimerkiksi merihirviön hammasrivistö\Nolisi luultavasti liikaa.
Dialogue: 0,0:10:11.23,0:10:13.46,Main-207+,,0,0,0,,{\fad(0,548)}– Takana päin!\N– Takana päin!
Dialogue: 0,0:10:13.73,0:10:15.53,Main-207+,,0,0,0,,Tappelevat... Selvittiin!
Dialogue: 0,0:10:16.00,0:10:21.14,Main-207+,,0,0,0,,Kehnosti käy myös silloin,\Njos laiva törmää kareihin tai muihin,
Dialogue: 0,0:10:21.14,0:10:27.14,Main-207+,,0,0,0,,Ja katkennut masto tai\Nrikkoutunut runko hajottaa kuplan.
Dialogue: 0,0:10:27.14,0:10:30.78,Main-207+,,0,0,0,,Eli veden alla pitää varoa\Neläimiä sekä esteitä.
Dialogue: 0,0:10:30.78,0:10:33.98,Main-207+,,0,0,0,,Muutoin kaikki on OK,\Njos sisällä ollaan kunnolla.
Dialogue: 0,0:10:34.62,0:10:37.15,Main-207+,,0,0,0,,Ai jaa, aika vankkaa tekoa siis!
Dialogue: 0,0:10:38.12,0:10:39.19,Main-207+,,0,0,0,,Mutta...
Dialogue: 0,0:10:40.22,0:10:43.19,Main-207+,,0,0,0,,70% Nereidisaarelle\Nsuuntaavista laivoista...
Dialogue: 0,0:10:43.19,0:10:46.03,Main-207+,,0,0,0,,tuhoutuu. Varokaa siis.
Dialogue: 0,0:10:47.20,0:10:49.10,Main-207+,,0,0,0,,– Mitä niille oikein tapahtuu?!\N– Mitä niille oikein tapahtuu?!
Dialogue: 0,0:10:49.67,0:10:54.30,Main-207+,,0,0,0,,Mun Gatlingillani saa takuulla\Nkoko kalaparven kerralla!
Dialogue: 0,0:10:54.30,0:10:57.91,Main-207+,,0,0,0,,Otetaan sitten matsi,\Nkumpi nappaa enemmän.
Dialogue: 0,0:10:59.41,0:11:02.41,Main-207+,,0,0,0,,Kuuntelitteko Namia lainkaan?!
Dialogue: 0,0:11:02.41,0:11:04.71,Main-207+,,0,0,0,,"Ei lukuisia reikiä", meneekö jakeluun?!
Dialogue: 0,0:11:04.71,0:11:08.12,Main-207+,,0,0,0,,Kohta lätty lätisee! Riittää tuollainen!
Dialogue: 0,0:11:08.12,0:11:09.39,Main-207+,,0,0,0,,Helkatti!
Dialogue: 0,0:11:09.39,0:11:15.56,Main-207+,,0,0,0,,{\q2}Kun Musti lupasi opastaa Nereidisaarelle.\NLuulin, että sinne pääsisi turvallisesti!
Dialogue: 0,0:11:15.93,0:11:16.76,Main-207+,,0,0,0,,Ai joo!
Dialogue: 0,0:11:16.76,0:11:19.90,Main-207+,,0,0,0,,Ne antoi mulle paljon evästä!
Dialogue: 0,0:11:19.90,0:11:22.93,Main-207+,,0,0,0,,Syödään lounas tästä,\Nkun Sanji on epäkunnossa!
Dialogue: 0,0:11:23.80,0:11:25.34,Main-207+,,0,0,0,,Maha kurniikin jo!
Dialogue: 0,0:11:26.57,0:11:28.27,Main-207+,,0,0,0,,Minunkin luuni kurnivat!
Dialogue: 0,0:11:28.71,0:11:32.71,Main-207+,,0,0,0,,Nami, pysyykö laiva kurssissa?
Dialogue: 0,0:11:32.71,0:11:35.08,Main-207+,,0,0,0,,Eikö meidän ole tarve tehdä mitään?
Dialogue: 0,0:11:35.08,0:11:36.25,Main-207+,,0,0,0,,Ehei.
Dialogue: 0,0:11:36.25,0:11:39.62,Main-207+,,0,0,0,,Kuljemme nyt ison merivirran mukana.
Dialogue: 0,0:11:39.98,0:11:43.35,Main-207+,,0,0,0,,Voimme siis jatkaa huoleti\Ntällä lailla jonkin aikaa.
Dialogue: 0,0:11:43.35,0:11:46.52,Main-207+,,0,0,0,,Tehtävää meillä on vasta myöhemmin.
Dialogue: 0,0:11:46.52,0:11:49.09,Main-207+,,0,0,0,,Meillä siis on aikaa.
Dialogue: 0,0:11:49.76,0:11:54.43,Main-207+,,0,0,0,,Meikäläisellä on kerrottavaa teille kaikille.
Dialogue: 0,0:11:54.43,0:11:56.63,Main-207+,,0,0,0,,– Robotin salaisuuksiako?!\N– Robotin salaisuuksiako?!
Dialogue: 0,0:11:56.63,0:11:59.10,Main-207+,,0,0,0,,Vieläkö sulla riittää salaisuuksia?!
Dialogue: 0,0:11:59.10,0:12:01.00,Main-207+,,0,0,0,,Voitko muuttaa muotoasi?!
Dialogue: 0,0:12:01.00,0:12:03.41,Main-207+,,0,0,0,,Vai onko sinulla jokin salainen ase?!
Dialogue: 0,0:12:03.41,0:12:05.44,Main-207+,,0,0,0,,Kerro meille, roboveli!
Dialogue: 0,0:12:05.44,0:12:09.18,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\fs95\c&H2C3AA7&\fad(150,150)}Super{\c&H9797D4&\alpha&HFF&}panssaroi{\c&HC2B698&}tu {\c&HE1D672&}Meitsi!
Dialogue: 1,0:12:06.98,0:12:09.18,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\fs95\c&H2C3AA7&\fad(150,150)\alpha&HFF&}Super{\c&H9797D4&\alpha&H00&\4a&H78&}panssaroi{\c&HC2B698&}tu {\c&HE1D672&\alpha&HFF&}Meitsi!
Dialogue: 2,0:12:08.31,0:12:09.18,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\fs95\c&H2C3AA7&\fad(150,150)\alpha&HFF&}Super{\c&H9797D4&}panssaroi{\c&HC2B698&}tu {\c&HE1D672&\alpha&H00&\4a&H78&}Meitsi!
Dialogue: 0,0:12:14.68,0:12:16.92,Main-207+,,0,0,0,,Ikävä kyllä...
Dialogue: 0,0:12:16.92,0:12:18.96,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\b1}Ikävä kyllä ei nytpiip.
Dialogue: 0,0:12:18.96,0:12:21.49,Main-207+,,0,0,0,,– Vauh! Robopuhetta!\N– Vauh! Robopuhetta!
Dialogue: 0,0:12:23.29,0:12:26.76,Main-207+,,0,0,0,,Tällaista sanottavaa siis oli.
Dialogue: 0,0:12:26.76,0:12:29.63,Main-207+,,0,0,0,,Syökää vaan samalla kun kuuntelette.
Dialogue: 0,0:12:29.63,0:12:34.50,Main-207+,,0,0,0,,Musti tosiaan lupasi olla\Noppaamme meren syvyyksissä,
Dialogue: 0,0:12:34.50,0:12:40.31,Main-207+,,0,0,0,,{\q2}mutta hän kuulemma haavoittui pahasti Sabaodylla\Nja on nyt Nereidisaarella sairaalassa.
Dialogue: 0,0:12:40.31,0:12:43.31,Main-207+,,0,0,0,,Syy oli justiinsa sama kuin Duvalilla.
Dialogue: 0,0:12:44.21,0:12:48.22,Main-207+,,0,0,0,,Hän oli suojellut {\i1}Thousand Sunnya{\i0}.
Dialogue: 0,0:12:48.79,0:12:52.49,Main-207+,,0,0,0,,Noin vuosi sitten {\i1}Sunnyn{\i0}\Nsijainti paljastui merivoimille.
Dialogue: 0,0:12:52.49,0:12:56.53,Main-207+,,0,0,0,,Seurasi raju taistelu, jossa\Nkumpikin päätyi toipilaaksi.
Dialogue: 0,0:12:56.53,0:12:57.59,Main-207+,,0,0,0,,Häh?
Dialogue: 0,0:12:57.59,0:13:01.23,Main-207+,,0,0,0,,Miten laiva sitten säilyi turvassa sen jälkeen?
Dialogue: 0,0:13:01.67,0:13:04.47,Main-207+,,0,0,0,,Sotureita oli vielä yksi.
Dialogue: 0,0:13:04.47,0:13:06.87,Main-207+,,0,0,0,,Vielä yksi soturi?
Dialogue: 0,0:13:06.87,0:13:12.08,Main-207+,,0,0,0,,Hän oli meidät kaksi vuotta sitten\Nhajalleen lennättänyt mies.
Dialogue: 0,0:13:14.58,0:13:18.68,Main-207+,,0,0,0,,{\q2\t(3350,0,\c&H000000&)}Jättimäinen kaapparilordi: Bartholomew Kuma!
Dialogue: 0,0:13:18.82,0:13:25.69,Main-207+,,0,0,0,,Kun meikäläinen joitakin päiviä sitten\Nsaapui {\i1}Sunnyn{\i0} luo, en ollut uskoa silmiäni!
Dialogue: 0,0:13:30.29,0:13:31.83,Flashbacks-207+,,0,0,0,,Odotin sinua.
Dialogue: 0,0:13:33.43,0:13:35.50,Flashbacks-207+,,0,0,0,,Mitä sinä siinä teet?!
Dialogue: 0,0:13:36.73,0:13:38.80,Flashbacks-207+,,0,0,0,,Tehtävä suoritettu.
Dialogue: 0,0:13:55.59,0:13:58.96,Main-207+,,0,0,0,,{\i1}Sunnyssa{\i0} ei ollut naarmuakaan.
Dialogue: 0,0:13:59.46,0:14:02.26,Main-207+,,0,0,0,,Kuulin myöhemmin Rayleighilta...
Dialogue: 0,0:14:02.73,0:14:05.73,Flashbacks-207+,,0,0,0,,Kuulun kapinallisten johtoon.
Dialogue: 0,0:14:05.73,0:14:09.27,Flashbacks-207+,,0,0,0,,Tietyistä syistä tahdon auttaa heidät pakoon.
Dialogue: 0,0:14:09.63,0:14:13.20,Main-207+,,0,0,0,,Tekin olette jo kai hiffanneet...
Dialogue: 0,0:14:13.20,0:14:16.37,Main-207+,,0,0,0,,että se mies pelasti meidät!
Dialogue: 0,0:14:18.54,0:14:21.51,Main-207+,,0,0,0,,Ja kun olimme kadonneet saarelta,
Dialogue: 0,0:14:21.51,0:14:25.12,Main-207+,,0,0,0,,hän kertoi Rayleighille lisää...
Dialogue: 0,0:14:25.25,0:14:26.92,Flashbacks-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,515,1,\3c&H525252&\4c&H000000&)}Minulla...
Dialogue: 0,0:14:28.02,0:14:29.69,Flashbacks-207+,,0,0,0,,ei ole enää aikaa.
Dialogue: 0,0:14:31.02,0:14:34.22,Main-207+,,0,0,0,,En tiedä, millä hallitus häntä kiristää,
Dialogue: 0,0:14:34.22,0:14:39.76,Main-207+,,0,0,0,,{\q2}mutta kaverille tehtiin ihmiskokeita,\Njossa hänet muutettiin vähitellen kyborgiksi.
Dialogue: 0,0:14:39.76,0:14:45.70,Main-207+,,0,0,0,,Diilin mukaan persoonallisuuden\Noli määrä kadota juuri ennen sotaa.
Dialogue: 0,0:14:45.70,0:14:52.78,Main-207+,,0,0,0,,Mutta ei hän voinut tietää,\Nmitä meille hajaantumisen jälkeen kävisi!
Dialogue: 0,0:14:52.78,0:14:56.51,Main-207+,,0,0,0,,Odottiko hän silti laivalla?!\NIlman persoonallisuutta?!
Dialogue: 0,0:14:56.51,0:15:00.42,Main-207+,,0,0,0,,Hän ja muokkaukset tehnyt tri Vegapunk
Dialogue: 0,0:15:00.85,0:15:05.36,Main-207+,,0,0,0,,olivat kuulemma sopineet\Nyhden asian ohjelmoinnista.
Dialogue: 0,0:15:05.36,0:15:11.80,Main-207+,,0,0,0,,{\q2}"Suojele alusta siihen saakka,\Nkunnes joku Olkihatuista palaa sen luokse."
Dialogue: 0,0:15:12.36,0:15:15.90,Main-207+,,0,0,0,,Joten kaveri vahti laivaa kaksi vuotta
Dialogue: 0,0:15:16.47,0:15:21.87,Main-207+,,0,0,0,,menneen itsensä käskystä,\Nilman, että varsinaisesti muisti asioita.
Dialogue: 0,0:15:23.01,0:15:25.64,Main-207+,,0,0,0,,Kuulostaa hullun hommalta.
Dialogue: 0,0:15:25.64,0:15:27.41,Main-207+,,0,0,0,,Ja miksi meidän takia...
Dialogue: 0,0:15:27.88,0:15:30.28,Main-207+,,0,0,0,,Kun puhutaan kapinallisista,
Dialogue: 0,0:15:30.28,0:15:35.39,Main-207+,,0,0,0,,ainoa syy joka mulle tulee mieleen\Non niiden johtaja, joka on Luffyn isä.
Dialogue: 0,0:15:36.25,0:15:42.19,Main-207+,,0,0,0,,{\q2}En mä tiedä siitä paljoa.\NMutta karhumainen heppu oli siis hyvä heppu.
Dialogue: 0,0:15:43.29,0:15:44.49,Thoughts-207+,,0,0,0,,Kuma...
Dialogue: 0,0:15:44.49,0:15:54.24,Main-207+,,0,0,0,,Ja joka tapauksessa juuri tämä kaveri antoi meille nämä kaksi tärkeää vuotta.
Dialogue: 0,0:15:54.24,0:16:01.04,Main-207+,,0,0,0,,Emme voi enää kysellä häneltä syistä,\Nmutta painakaa mieleenne nämä:
Dialogue: 0,0:16:01.04,0:16:08.38,Main-207+,,0,0,0,,{\q2}Bartholomew Kuma olikin loppujen lopuksi\Nporukkamme merkittävä liittolainen.
Comment: 0,0:16:01.04,0:16:05.42,Main-207+,,0,0,0,,Bartholomew Kuma turned out to be one of our greatest allies.
Comment: 0,0:16:05.82,0:16:08.38,Main-207+,,0,0,0,,Bartholomew Kuma turned out to be one of our greatest allies.
Dialogue: 0,0:16:08.38,0:16:12.56,Main-207+,,0,0,0,,Ja jos vielä kerran kohtaamme,
Dialogue: 0,0:16:12.56,0:16:15.19,Main-207+,,0,0,0,,Kuma on sieluton ihmisase.
Dialogue: 0,0:16:15.19,0:16:17.16,Main-207+,,0,0,0,,Siinä oli kaikki.
Dialogue: 0,0:16:17.69,0:16:23.00,Main-207+,,0,0,0,,Velassa ollaan, mutta silti kysymyksiä\Njää auki... Kun tietäis sen aikeet.
Dialogue: 0,0:16:23.43,0:16:24.77,Main-207+,,0,0,0,,"Liittolainen"?
Dialogue: 0,0:16:24.77,0:16:26.84,Main-207+,,0,0,0,,Oho! Sanji, olet tajuissasi.
Dialogue: 0,0:16:26.84,0:16:29.57,Main-207+,,0,0,0,,Ota evästä! Naissaarievästä!
Dialogue: 0,0:16:29.57,0:16:31.21,Main-207+,,0,0,0,,Naissaari...?
Dialogue: 0,0:16:31.77,0:16:34.68,Main-207+,,0,0,0,,Onko Kuma muka oikeasti liittolaisemme?
Dialogue: 0,0:16:34.68,0:16:37.68,Main-207+,,0,0,0,,Tiedättekö, missä mä olin kaksi vuotta?
Dialogue: 0,0:16:37.68,0:16:42.59,Main-207+,,0,0,0,,Mitä sä oikein treenasit sellaisella\Nunelmien saarella, Luffy?!
Dialogue: 0,0:16:42.59,0:16:44.75,Main-207+,,0,0,0,,Noh noh, herra Sanji.
Dialogue: 0,0:16:44.75,0:16:50.09,Main-207+,,0,0,0,,En tiedä koettelemuksistasi,\Nmutta nautitaan nyt vain matkasta!
Dialogue: 0,0:16:50.09,0:16:51.49,Main-207+,,0,0,0,,Laulaisimmeko?
Dialogue: 0,0:16:51.49,0:16:54.23,Main-207+,,0,0,0,,Älä yritä piristää! Se masentaa!
Dialogue: 0,0:16:54.23,0:16:57.30,Main-207+,,0,0,0,,Velitsu! Näkyy. Olkihatut näkyy.
Dialogue: 0,0:16:57.30,0:17:01.97,Main-207+,,0,0,0,,Mie huomaan kyllä itsekin, tyhmyri!
Dialogue: 0,0:17:02.94,0:17:06.14,Main-207+,,0,0,0,,Tällä kertaa saatte ottaa meitit laivaan!
Dialogue: 0,0:17:06.14,0:17:08.55,Main-207+,,0,0,0,,Paljonkohan ollaan sukellettu?
Dialogue: 0,0:17:08.55,0:17:12.85,Main-207+,,0,0,0,,Enää ei valokaan yllä kuin hämärästi...
Dialogue: 0,0:17:12.85,0:17:17.99,Main-207+,,0,0,0,,Olemme ohittaneet eufoottisen alueen,\Nja kohta myös mesopelagisen.
Dialogue: 0,0:17:17.99,0:17:20.32,Main-207+,,0,0,0,,Kilometri meni jo varmaan rikki.
Dialogue: 0,0:17:20.99,0:17:22.23,Main-207+,,0,0,0,,Onpa hiljaista...
Dialogue: 0,0:17:22.23,0:17:25.50,Main-207+,,0,0,0,,Aivan eri tunne kuin sukellusveneessä.
Dialogue: 0,0:17:25.50,0:17:28.23,Main-207+,,0,0,0,,Kuin lentäisimme taivaalla.
Dialogue: 0,0:17:28.23,0:17:30.17,Main-207+,,0,0,0,,Hei! Valaita!
Dialogue: 0,0:17:30.17,0:17:32.07,Main-207+,,0,0,0,,Laboon! Laboon!
Dialogue: 0,0:17:32.07,0:17:34.70,Main-207+,,0,0,0,,Ei kun Valkoparta-ukkeli!
Dialogue: 0,0:17:37.24,0:17:40.74,Main-207+,,0,0,0,,Kello kuudessa näkyy jotain! Meripeto...?
Dialogue: 0,0:17:40.74,0:17:41.54,Main-207+,,0,0,0,,Ei...
Dialogue: 0,0:17:41.54,0:17:44.98,Main-207+,,0,0,0,,Olettekos valmiita, miehistöseni?!
Dialogue: 0,0:17:44.98,0:17:46.38,Main-207+,,0,0,0,,Joäh, velitsu!
Dialogue: 0,0:17:46.38,0:17:47.88,Main-207+,,0,0,0,,– Joäh, joäh!\N– Joäh, joäh!
Dialogue: 0,0:17:47.88,0:17:50.62,Main-207+,,0,0,0,,Kohde on neniemme edessä!
Dialogue: 0,0:17:50.62,0:17:56.93,Main-207+,,0,0,0,,Olisi helppo upottaa laiva\Nja hukuttaa koko joukko,
Dialogue: 0,0:17:56.93,0:18:01.93,Main-207+,,0,0,0,,mutta se ei käy,\Nsitten ei käy ilmi kuka sen teki.
Dialogue: 0,0:18:01.93,0:18:09.41,Main-207+,,0,0,0,,{\q2}Kun tuomme niiden päät näytille,\Nvasta sitten kansa tietää ylistää Cariboun nimeä!
Dialogue: 0,0:18:09.81,0:18:10.84,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:18:11.17,0:18:13.64,Main-207+,,0,0,0,,Hyö eivät osaa valmistautua.
Dialogue: 0,0:18:13.64,0:18:15.41,Main-207+,,0,0,0,,Yllätys on täydellinen!
Dialogue: 0,0:18:15.41,0:18:18.15,Main-207+,,0,0,0,,Älkääs herpaantuko, ronttiseni!
Dialogue: 0,0:18:18.15,0:18:19.62,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:18:19.62,0:18:21.12,Main-207+,,0,0,0,,Joäh! Joäh!
Dialogue: 0,0:18:21.65,0:18:25.69,Main-207+,,0,0,0,,Hei, kuulkaa! Takana näkyy laivan hahmo!
Dialogue: 0,0:18:25.69,0:18:26.59,Main-207+,,0,0,0,,Mitäh?
Dialogue: 0,0:18:26.59,0:18:27.26,Main-207+,,0,0,0,,Laivan?
Dialogue: 0,0:18:27.26,0:18:28.83,Main-207+,,0,0,0,,Se syöksyy tännepäin!
Dialogue: 0,0:18:29.19,0:18:30.83,Main-207+,,0,0,0,,Rynnäkköön!
Dialogue: 0,0:18:38.74,0:18:39.87,Main-207+,,0,0,0,,Merirosvoalus!
Dialogue: 0,0:18:39.87,0:18:41.97,Main-207+,,0,0,0,,Se puskee päin!
Dialogue: 0,0:18:41.97,0:18:45.27,Main-207+,,0,0,0,,Äkkiä loitommas! Tai kupla puhkeaa!
Dialogue: 0,0:18:51.68,0:18:54.58,Main-207+,,0,0,0,,Eivät kai ne aio loikata kuplan läpi?!
Dialogue: 0,0:18:55.52,0:18:56.72,Main-207+,,0,0,0,,Keitä nuo ovat?
Dialogue: 0,0:18:58.52,0:19:00.29,Main-207+,,0,0,0,,Karkuun!
Dialogue: 0,0:19:01.69,0:19:02.93,Main-207+,,0,0,0,,Paapuuriin päin!
Dialogue: 0,0:19:09.73,0:19:11.20,Main-207+,,0,0,0,,Puskii, merilehmä!
Dialogue: 0,0:19:14.94,0:19:16.24,Main-207+,,0,0,0,,He ovat perässämme!
Dialogue: 0,0:19:16.24,0:19:16.94,Main-207+,,0,0,0,,Tuo äänihän...
Dialogue: 0,0:19:17.74,0:19:19.31,Main-207+,,0,0,0,,Miten sinnikkäitä!
Dialogue: 0,0:19:21.04,0:19:22.61,Main-207+,,0,0,0,,Mitä ne meistä tahtovat?
Dialogue: 0,0:19:26.35,0:19:27.72,Main-207+,,0,0,0,,Seis!
Dialogue: 0,0:19:27.72,0:19:29.22,Main-207+,,0,0,0,,Kupla puhkeaa!
Dialogue: 0,0:19:29.55,0:19:31.42,Main-207+,,0,0,0,,Hienoa työtä, merilehmä!
Dialogue: 0,0:19:31.42,0:19:32.49,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:19:32.49,0:19:34.86,Main-207+,,0,0,0,,Nousevatko he kyytiin?
Dialogue: 0,0:19:33.79,0:19:34.86,Secondary-207+,,0,0,0,,Merilehmä?
Dialogue: 0,0:19:36.13,0:19:37.46,Main-207+,,0,0,0,,Hetkinen, onko tuo...
Dialogue: 0,0:19:41.33,0:19:43.17,Main-207+,,0,0,0,,Kuplat on yhdistyneet!
Dialogue: 0,0:19:43.17,0:19:44.97,Main-207+,,0,0,0,,Velitsu, nyt mennään!
Dialogue: 0,0:19:44.97,0:19:46.54,Main-207+,,0,0,0,,Kas niin!
Dialogue: 0,0:19:46.54,0:19:48.37,Main-207+,,0,0,0,,Mennäänkö, ronttiseni?!
Dialogue: 0,0:19:48.37,0:19:49.61,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:19:49.61,0:19:51.24,Main-207+,,0,0,0,,Hei, Mööm!
Dialogue: 0,0:19:51.24,0:19:53.48,Main-207+,,0,0,0,,Olet Arlongin sakin Mööm, etkö olekin?
Dialogue: 0,0:19:54.54,0:19:56.25,Main-207+,,0,0,0,,Muistatko minut?
Dialogue: 0,0:19:56.25,0:19:57.61,Main-207+,,0,0,0,,Nami tässä!
Dialogue: 0,0:19:57.61,0:19:59.42,Main-207+,,0,0,0,,Nähtiin Arlong Parkissa!
Dialogue: 0,0:20:01.55,0:20:03.02,Main-207+,,0,0,0,,Hei, Luffy...
Dialogue: 0,0:20:03.02,0:20:04.52,Main-207+,,0,0,0,,Tuttu naama, vai mitä?
Dialogue: 0,0:20:04.89,0:20:05.86,Main-207+,,0,0,0,,Niinkö vai?
Dialogue: 0,0:20:07.02,0:20:09.26,Flashbacks-207+,,0,0,0,,{\3c&HFFFFFF&\4c&HFFFFFF&\t(0,518,1,\3c&H525252&\4c&H000000&)}Kuole, saasta!{Arlong 02 - 10:21}
Dialogue: 0,0:20:09.26,0:20:12.03,Flashbacks-207+,,0,0,0,,{\fad(150,150)}Gumigumipyssy!
Dialogue: 0,0:20:14.83,0:20:17.13,Main-207+,,0,0,0,,Seuratkaa perässä! Hakkaa päälle!
Dialogue: 0,0:20:17.13,0:20:17.87,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:20:20.37,0:20:22.14,Main-207+,,0,0,0,,Oho! Se meni kuplan läpi!
Dialogue: 0,0:20:22.14,0:20:23.94,Main-207+,,0,0,0,,Aagh! Joku tulee laivallemme!
Dialogue: 0,0:20:23.94,0:20:25.71,Main-207+,,0,0,0,,Tästä tulee tappelu!
Dialogue: 0,0:20:29.01,0:20:30.51,Main-207+,,0,0,0,,Ronttiseni!
Dialogue: 0,0:20:30.51,0:20:32.22,Main-207+,,0,0,0,,Oletteko valmiita?!
Dialogue: 0,0:20:32.22,0:20:33.38,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:20:34.02,0:20:41.32,Main-207+,,0,0,0,,Käytämme niiden hämmennystä hyväksi,
Dialogue: 0,0:20:41.32,0:20:44.86,Main-207+,,0,0,0,,ja tapamme jok'ikisen laivalla olijan!
Dialogue: 0,0:20:46.56,0:20:47.40,Main-207+,,0,0,0,,Menoksi!
Dialogue: 0,0:20:47.40,0:20:50.43,Main-207+,,0,0,0,,Joäh!
Dialogue: 0,0:20:50.43,0:20:53.64,Main-207+,,0,0,0,,Seuratkaa johtajaa!
Dialogue: 0,0:20:56.37,0:20:59.28,Main-207+,,0,0,0,,– Täh?!\N– Täh?!
Dialogue: 0,0:20:59.28,0:21:00.81,Main-207+,,0,0,0,,Mikä on, merilehmä?!
Dialogue: 0,0:21:00.81,0:21:02.18,Main-207+,,0,0,0,,Mitä varten, merilehmä?!
Dialogue: 0,0:21:02.18,0:21:05.45,Main-207+,,0,0,0,,Voi sentään! Kapteeni\NCaribou meni sinne yksin!
Dialogue: 0,0:21:05.45,0:21:07.42,Main-207+,,0,0,0,,Velitsu!
Dialogue: 0,0:21:09.72,0:21:13.72,Main-207+,,0,0,0,,Kas niin, tervehdyksestä käy...
Dialogue: 0,0:21:14.46,0:21:18.43,Main-207+,,0,0,0,,gatlingin räime!
Dialogue: 0,0:21:19.03,0:21:25.97,Main-207+,,0,0,0,,Nirri poies joka ainoalta Olkihatulta!
Dialogue: 0,0:21:29.41,0:21:29.97,Main-207+,,0,0,0,,Heä...?
Dialogue: 0,0:21:40.82,0:21:45.89,Main-207+,,0,0,0,,Älähän nyt...! Äläpäs\Nsentään mereen heitä!
Dialogue: 0,0:21:46.29,0:21:51.73,Main-207+,,0,0,0,,Ei sellainen peli vetele! Ihan tosi, hei!
Dialogue: 0,0:21:51.73,0:21:55.50,Main-207+,,0,0,0,,Jokainen elämä on arvokas!
Dialogue: 0,0:21:55.50,0:21:59.50,Main-207+,,0,0,0,,Jumalat...! Jumalat katselee! Muista sie se!
Dialogue: 0,0:22:00.64,0:22:03.04,Main-207+,,0,0,0,,Paraskin puhuja!
Dialogue: 0,0:22:03.04,0:22:06.71,Main-207+,,0,0,0,,Teikäläinen kiljui äsken\Njoukkomurhaa ja gatlingia!
Dialogue: 0,0:22:07.08,0:22:08.91,Main-207+,,0,0,0,,Äh, sehän oli vain...
Dialogue: 0,0:22:08.91,0:22:11.75,Main-207+,,0,0,0,,Sehän oli pelkkää leikinlaskua.
Dialogue: 0,0:22:11.75,0:22:13.32,Main-207+,,0,0,0,,Et sä mitään leikkiä laske.
Dialogue: 0,0:22:13.32,0:22:15.18,Main-207+,,0,0,0,,Kuka ja mikä sä olet?
Dialogue: 0,0:22:15.18,0:22:17.82,Main-207+,,0,0,0,,Varmaan äskeisen sakin kapteeni?
Dialogue: 0,0:22:17.82,0:22:19.96,Thoughts-207+,,0,0,0,,Uogh, Roronoa Zoro!
Dialogue: 0,0:22:21.76,0:22:24.86,Main-207+,,0,0,0,,Eips! En mie suinkaan mikään kapteeni ole!
Dialogue: 0,0:22:24.86,0:22:26.50,Main-207+,,0,0,0,,Mie, tuota...
Dialogue: 0,0:22:26.50,0:22:30.60,Main-207+,,0,0,0,,Olen pelkkä juoksupoika! Tykinruokaa!
Dialogue: 0,0:22:30.60,0:22:33.50,Main-207+,,0,0,0,,Sain tarpeekseni siitä poppoosta!
Dialogue: 0,0:22:33.50,0:22:35.20,Main-207+,,0,0,0,,Hei, kävipä sopivasti!
Dialogue: 0,0:22:35.20,0:22:38.57,Main-207+,,0,0,0,,Saisinko olla hetken tällä aluksella?
Dialogue: 0,0:22:38.57,0:22:39.78,Main-207+,,0,0,0,,Jookosta?
Dialogue: 0,0:22:39.78,0:22:43.45,Main-207+,,0,0,0,,Hei, kaveri käy vähän sääliksi...
Dialogue: 0,0:22:43.45,0:22:46.12,Main-207+,,0,0,0,,Puhu pukille! Valetta kaikki!
Dialogue: 0,0:22:46.12,0:22:48.45,Main-207+,,0,0,0,,Täh?! Kaikkiko valetta?!
Dialogue: 0,0:22:48.78,0:22:52.66,Main-207+,,0,0,0,,Hei, kuulehan! Mistä saitte\Nlaivaa vetäneen merilehmän?
Dialogue: 0,0:22:52.66,0:22:54.72,Main-207+,,0,0,0,,Oppista...
Dialogue: 0,0:22:56.06,0:22:57.36,Main-207+,,0,0,0,,Jopa on...
Dialogue: 0,0:22:57.99,0:22:59.73,Main-207+,,0,0,0,,nätti neiti!
Dialogue: 0,0:23:00.33,0:23:02.93,Main-207+,,0,0,0,,Siekö olet "Pitkäkynsi"?
Dialogue: 0,0:23:03.47,0:23:07.97,Main-207+,,0,0,0,,{\fad(0,252)}Älä sä kyylää meidän\Nsulonavigaattoria riettain silmin!
Dialogue: 0,0:23:08.50,0:23:10.07,Main-207+,,0,0,0,,Neiti Nami!
Dialogue: 0,0:23:10.07,0:23:13.38,Main-207+,,0,0,0,,Ei huolta e... nääh!
Dialogue: 0,0:23:13.38,0:23:16.05,Main-207+,,0,0,0,,Tuo alkaa jo olla rasittavaa!
Dialogue: 0,0:23:16.05,0:23:20.38,Main-207+,,0,0,0,,Se otus oli pelkkä lähistöltä\Nnapattu meripeto...
Dialogue: 0,0:23:21.62,0:23:26.79,Main-207+,,0,0,0,,Ne, jotka osaavat asiansa, matkaavat\Nveden alla sellaisten vetämänä.
Dialogue: 0,0:23:26.79,0:23:28.06,Main-207+,,0,0,0,,Mitä?!
Dialogue: 0,0:23:28.06,0:23:30.09,Main-207+,,0,0,0,,Ihan tosi?
Dialogue: 0,0:23:31.29,0:23:33.43,Main-207+,,0,0,0,,Seis! Pysähdy, merilehmä!
Dialogue: 0,0:23:33.43,0:23:34.70,Main-207+,,0,0,0,,Mikä mättää?!
Dialogue: 0,0:23:35.06,0:23:38.73,Main-207+,,0,0,0,,Tullaan taatusti avuks, velitsu!
Dialogue: 0,0:23:39.14,0:23:42.07,Main-207+,,0,0,0,,Näkyisikö meripetoja...?
Dialogue: 0,0:23:42.07,0:23:43.47,Main-207+,,0,0,0,,Hei, Luffy!
Dialogue: 0,0:23:43.47,0:23:45.47,Main-207+,,0,0,0,,Mitä sinä nyt suunnittelet?
Dialogue: 0,0:23:46.44,0:23:50.18,Main-207+,,0,0,0,,Aloitetaan kuntoutus vaikka valokuvilla.
Dialogue: 0,0:23:50.18,0:23:51.81,Main-207+,,0,0,0,,Nami hei!
Dialogue: 0,0:23:51.81,0:23:54.95,Main-207+,,0,0,0,,Eikös me mennä vähän\Neri suuntaan kuin lokitikku näyttää?
Dialogue: 0,0:23:54.95,0:23:56.52,Main-207+,,0,0,0,,Tiedän, ei huolta.
Dialogue: 0,0:23:57.09,0:24:00.52,Main-207+,,0,0,0,,Oikea väylä vie neulan\Nsuunnasta lounaaseen.
Dialogue: 0,0:24:00.52,0:24:05.39,Main-207+,,0,0,0,,Miksi muka? Suora reitti on\Ntietenkin kaikista nopein!
Dialogue: 0,0:24:05.39,0:24:09.93,Main-207+,,0,0,0,,Suoraan etenemällä joutuisimme\Nväärien merivirtojen viemiksi,
Dialogue: 0,0:24:09.93,0:24:13.37,Main-207+,,0,0,0,,ja murskautuisimme merenalaisiin\Ntuli- tai muihin vuoriin.
Dialogue: 0,0:24:13.37,0:24:15.57,Main-207+,,0,0,0,,Täh?! Tulivuoriin?!
Dialogue: 0,0:24:15.57,0:24:17.04,Main-207+,,0,0,0,,Pelottava paikka!
Dialogue: 0,0:24:17.04,0:24:22.11,Main-207+,,0,0,0,,Mutta eikö Grand Linen virrat\Nole joka tapauksessa tolkuttomia?
Dialogue: 0,0:24:22.11,0:24:24.38,Main-207+,,0,0,0,,Voiko mihinkään virtaan luottaa?
Dialogue: 0,0:24:24.85,0:24:26.58,Main-207+,,0,0,0,,Yhteen voi.
Dialogue: 0,0:24:26.58,0:24:28.05,Main-207+,,0,0,0,,Kas noin.
Dialogue: 0,0:24:28.05,0:24:29.39,Main-207+,,0,0,0,,Pysypä sit tyynenä.
Dialogue: 0,0:24:29.39,0:24:34.39,Main-207+,,0,0,0,,Hei kaikki! Parasta pukea\Ntakki ylle, pian tulee kylmä.
Dialogue: 0,0:24:34.39,0:24:38.46,Main-207+,,0,0,0,,Totta. Tunnen hiukan vilpoisuutta ihollani.
Dialogue: 0,0:24:38.46,0:24:40.60,Main-207+,,0,0,0,,Ai! Mutta eihän...
Dialogue: 0,0:24:40.60,0:24:43.40,Main-207+,,0,0,0,,Olet luuranko, eikä sinulla ole ihoa.
Dialogue: 0,0:24:44.57,0:24:46.24,Main-207+,,0,0,0,,Chopper...
Dialogue: 0,0:24:46.24,0:24:48.40,Main-207+,,0,0,0,,Ethän sinä noin vain...
Dialogue: 0,0:24:48.40,0:24:51.11,Main-207+,,0,0,0,,voi varastaa repliikkiäni...
Dialogue: 0,0:24:51.11,0:24:54.34,Main-207+,,0,0,0,,Kylmään paikkaanko mennään?\NEi siis merenpohjaan?
Dialogue: 0,0:24:54.34,0:24:57.91,Main-207+,,0,0,0,,Etkö tiedä, että syvänmeren\Nvesi on kylmää?
Dialogue: 0,0:24:57.91,0:25:01.55,Main-207+,,0,0,0,,Kylvyssäkin on kuuminta\Npinnalla ja viileintä pohjalla.
Dialogue: 0,0:25:01.55,0:25:04.39,Main-207+,,0,0,0,,Ai jaa? Mä en juurikaan kylve.
Dialogue: 0,0:25:04.39,0:25:05.96,Main-207+,,0,0,0,,Ahaa!
Dialogue: 0,0:25:05.96,0:25:10.23,Main-207+,,0,0,0,,Jos sama pätee mereen,\Nalas mentäessä kylmenee.
Dialogue: 0,0:25:10.23,0:25:13.16,Main-207+,,0,0,0,,Eikä ero ole ainoastaan lämpötilassa.
Dialogue: 0,0:25:14.03,0:25:16.17,Main-207+,,0,0,0,,Vieläkö sä synkistelet?!
Dialogue: 0,0:25:16.17,0:25:17.67,Main-207+,,0,0,0,,Näin syvissä vyöhykkeissä...
Dialogue: 3,0:25:18.30,0:25:24.91,Main-207+,,0,0,0,,{\an8}on valtavia syvänmeren virtoja, joita\Nemme normaalisti edes havaitse.
Dialogue: 3,0:25:24.91,0:25:29.98,Main-207+,,0,0,0,,{\an8}Ne kulkevat aivan toisin\Nkuin pintavirtaukset.
Dialogue: 0,0:25:29.98,0:25:33.05,Main-207+,,0,0,0,,Merivirtoja merivirtojen alla?!
Dialogue: 0,0:25:33.05,0:25:34.78,Main-207+,,0,0,0,,Olet sä aika tietäväinen!
Dialogue: 0,0:25:36.25,0:25:37.92,Main-207+,,0,0,0,,On näet ikää ja kokemusta!
Dialogue: 0,0:25:38.32,0:25:41.72,Main-207+,,0,0,0,,Kaikki virrat ovat yhteydessä toisiinsa.
Dialogue: 0,0:25:41.72,0:25:44.93,Main-207+,,0,0,0,,Yksi kulkee itään ja toinen länteen päin.
Dialogue: 0,0:25:44.93,0:25:48.20,Main-207+,,0,0,0,,Eivätkä pelkästään vaakatasossa,\Nvaan myös pystysuunnassa.
Dialogue: 0,0:25:48.20,0:25:50.77,Main-207+,,0,0,0,,Kuin valtava, kiemurteleva lohikäärme.
Dialogue: 0,0:25:50.77,0:25:55.30,Main-207+,,0,0,0,,Kuuleman mukaan syvävirtaukset\Nsaattavat kulkea sangen hitaasti.
Dialogue: 0,0:25:55.30,0:26:01.18,Main-207+,,0,0,0,,Pääsee seuraavan kerran pintaan\Nnäkemään auringonvalon...
Dialogue: 0,0:26:01.18,0:26:04.01,Main-207+,,0,0,0,,vasta 2000 vuoden kuluttua.
Dialogue: 0,0:26:04.01,0:26:05.61,Main-207+,,0,0,0,,– Kahden tuhannen?!\N– Kahden tuhannen?!
Dialogue: 0,0:26:05.61,0:26:06.72,Main-207+,,0,0,0,,Aivan...
Dialogue: 0,0:26:07.25,0:26:14.86,Main-207+,,0,0,0,,{\q2}Siksi pimeistä, tuntemattomista virtauksista\Nkerrotaan monia tarinoita...
Dialogue: 0,0:26:14.86,0:26:16.26,Main-207+,,0,0,0,,Hirviöitä!
Dialogue: 0,0:26:16.26,0:26:17.39,Main-207+,,0,0,0,,Kirouksia!
Dialogue: 0,0:26:17.39,0:26:19.96,Main-207+,,0,0,0,,Hukkuneiden sieluja!
Dialogue: 0,0:26:19.96,0:26:21.06,Main-207+,,0,0,0,,Täh?!
Dialogue: 0,0:26:21.06,0:26:23.00,Main-207+,,0,0,0,,Onko alhaalla kummituksia?!
Dialogue: 0,0:26:23.00,0:26:25.30,Main-207+,,0,0,0,,Täh?! Onko?! Pelottaa!
Dialogue: 0,0:26:25.30,0:26:26.67,Main-207+,,0,0,0,,Alkaa ihan jänskättää!
Dialogue: 0,0:26:26.67,0:26:28.80,Main-207+,,0,0,0,,Kummituksia...
Dialogue: 0,0:26:28.80,0:26:30.57,Main-207+,,0,0,0,,Miten lie...
Dialogue: 0,0:26:30.57,0:26:35.88,Main-207+,,0,0,0,,Oli miten oli, me siis yhytämme\Npystyvirtauksen, joka vie meidät alaspäin.
Dialogue: 0,0:26:35.88,0:26:40.02,Main-207+,,0,0,0,,Sillä tavalla saavutamme\Nsyvänmeren merivirtoineen!
Dialogue: 0,0:26:42.15,0:26:45.12,Main-207+,,0,0,0,,{\q2}– On siis olemassa tosi ihmeellinen merivirta...!\N– On siis olemassa tosi ihmeellinen merivirta...!{Gab, matching the gag in RM 01 - 07:59}
Dialogue: 0,0:26:45.12,0:26:47.99,Main-207+,,0,0,0,,Ette siis tajunneet lainkaan, ettekö?!
Dialogue: 0,0:26:50.23,0:26:51.76,Main-207+,,0,0,0,,Laulaisimmeko, neiti Nami?
Dialogue: 0,0:26:51.76,0:26:52.70,Main-207+,,0,0,0,,Kuono umpeen!
Dialogue: 0,0:26:57.73,0:26:58.53,Main-207+,,0,0,0,,Tämä se on!
Dialogue: 0,0:26:58.53,0:27:00.37,Main-207+,,0,0,0,,Nami, se on näkyvissä!
Dialogue: 0,0:27:00.37,0:27:01.37,Main-207+,,0,0,0,,Niinkö?
Dialogue: 0,0:27:01.37,0:27:03.24,Main-207+,,0,0,0,,Se ihmeellinen merivirta?!{Gab, 26:38}
Dialogue: 0,0:27:04.61,0:27:06.04,Main-207+,,0,0,0,,Missä se on?! Missä se on?!
Dialogue: 0,0:27:06.04,0:27:07.81,Main-207+,,0,0,0,,Päheetä!
Dialogue: 0,0:27:09.65,0:27:10.65,Main-207+,,0,0,0,,Mikä tuo...?
Dialogue: 0,0:27:10.65,0:27:14.08,Main-207+,,0,0,0,,Siinä se alas kulkeva merivirta on!
Dialogue: 0,0:27:14.08,0:27:16.19,Main-207+,,0,0,0,,Laskeutuva merivirta "Plume"!
Dialogue: 0,0:27:17.49,0:27:20.46,Main-207+,,0,0,0,,Aika hurja!
Dialogue: 0,0:27:20.46,0:27:23.56,Main-207+,,0,0,0,,Sehän on kuin merenalainen...
Dialogue: 0,0:27:25.83,0:27:29.63,Main-207+,,0,0,0,,jättiläisvesiputous!
Dialogue: 0,0:27:29.63,0:27:32.23,Main-207+,,0,0,0,,Meri putoaa kauas alaspäin!
Dialogue: 0,0:27:32.23,0:27:35.14,Main-207+,,0,0,0,,Ihan hervoton nopeus!
Dialogue: 0,0:27:35.14,0:27:36.64,Main-207+,,0,0,0,,Jännää!
Dialogue: 0,0:27:39.04,0:27:41.11,Main-207+,,0,0,0,,Kyllä luonto osaa!
Dialogue: 0,0:27:41.48,0:27:43.65,Main-207+,,0,0,0,,Kuinka valtava virta!
Dialogue: 0,0:27:43.65,0:27:46.12,Main-207+,,0,0,0,,Mitenköhän syvä se mahtaa olla?
Dialogue: 0,0:27:46.55,0:27:50.82,Main-207+,,0,0,0,,On aivan eri asia kuulla\Nja nähdä omin silmin!
Dialogue: 0,0:27:51.19,0:27:53.09,Main-207+,,0,0,0,,Pohjaa ei edes näy!
Dialogue: 0,0:27:53.09,0:27:54.99,Main-207+,,0,0,0,,Se syöksyy pilkkopimeyteen!
Dialogue: 0,0:27:55.36,0:27:56.79,Main-207+,,0,0,0,,Loppu tuli!
Dialogue: 0,0:27:56.79,0:28:01.63,Main-207+,,0,0,0,,Tuolla vauhdilla laiva\Npirstoutuu merenpohjaan!
Dialogue: 0,0:28:02.06,0:28:05.07,Main-207+,,0,0,0,,Voimmeko tosiaan kulkea tuosta?
Dialogue: 0,0:28:05.07,0:28:07.24,Main-207+,,0,0,0,,Älkää laivasta huoliko!
Dialogue: 0,0:28:07.24,0:28:12.01,Main-207+,,0,0,0,,{\i1}Sunny{\i0} on laivoista vahvin,\NAarrepuu Adamista syntynyt!
Dialogue: 0,0:28:14.81,0:28:16.05,Main-207+,,0,0,0,,Ei voi olla!
Dialogue: 0,0:28:16.05,0:28:21.58,Main-207+,,0,0,0,,En mie tiennyt, että {\i1}tuo{\i0}\Nolisi asettunut tänne...!
Dialogue: 0,0:28:21.58,0:28:24.52,Main-207+,,0,0,0,,Se on meriä samoava paholainen!
Dialogue: 0,0:28:25.09,0:28:27.86,Main-207+,,0,0,0,,Ihmiskunnan arkkivihollinen!
Dialogue: 0,0:28:28.99,0:28:31.19,Main-207+,,0,0,0,,Olkihatut!
Dialogue: 0,0:28:31.19,0:28:32.86,Main-207+,,0,0,0,,Äkkiä takaisin!
Dialogue: 0,0:28:32.86,0:28:34.66,Main-207+,,0,0,0,,Vaara uhkaa!
Dialogue: 0,0:28:34.66,0:28:36.47,Main-207+,,0,0,0,,Ai niin, säkin olit.
Dialogue: 0,0:28:36.47,0:28:38.63,Main-207+,,0,0,0,,Alhaalla on hirviö!
Dialogue: 0,0:28:39.24,0:28:40.20,Main-207+,,0,0,0,,Se on...
Dialogue: 0,0:28:40.97,0:28:41.84,Main-207+,,0,0,0,,aivan edessä...
Dialogue: 0,0:28:41.84,0:28:44.11,Main-207+,,0,0,0,,Riittää jo, kaverit!
Dialogue: 0,0:28:44.11,0:28:46.28,Main-207+,,0,0,0,,T-Takanasi...
Dialogue: 0,0:28:46.64,0:28:48.28,Main-207+,,0,0,0,,Mitä te nyt...
Dialogue: 0,0:28:51.58,0:28:52.41,Main-207+,,0,0,0,,Ta...
Dialogue: 0,0:28:53.92,0:28:55.42,Main-207+,,0,0,0,,Takanani?
Dialogue: 0,0:29:02.39,0:29:05.26,Main-207+,,0,0,0,,Kraken!
Dialogue: 0,0:29:06.63,0:29:08.93,Main-207+,,0,0,0,,Älyttömän kokoinen hirmumustekala!
Dialogue: 0,0:29:09.63,0:29:12.33,Main-207+,,0,0,0,,Sehän on murskannut jo monta laivaa!
Dialogue: 0,0:29:12.80,0:29:15.70,Main-207+,,0,0,0,,Viime päivinä lähteneet alukset\Novat kai jääneet saaliiksi!
Dialogue: 0,0:29:16.04,0:29:19.04,Main-207+,,0,0,0,,Rukoilen! En mie tahdo kuolla!
Dialogue: 0,0:29:19.04,0:29:20.24,Main-207+,,0,0,0,,Kääntykää takaisin!
Dialogue: 0,0:29:20.24,0:29:23.78,Main-207+,,0,0,0,,Ehkä se ajan mittaan lähtee ja–
Dialogue: 0,0:29:23.78,0:29:25.81,Main-207+,,0,0,0,,Pää kiinni siellä!
Dialogue: 0,0:29:26.82,0:29:29.25,Main-207+,,0,0,0,,Sain loistoidean!
Dialogue: 0,0:29:30.05,0:29:32.02,Main-207+,,0,0,0,,Mä kesytän tuon!
Dialogue: 0,0:29:32.82,0:29:33.89,Main-207+,,0,0,0,,– Häh?\N– Häh?
Comment: 0,0:29:33.89,0:29:36.89,Main-207+,,0,0,0,,{=97}===============================DIALOGUE============================
