Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=36}===============================DIALOGUE============================
Dialogue: 0,0:01:56.47,0:01:58.57,Main-207+,,0,0,0,,Mitä sä juuri päästit suustasi, Luffy?!
Dialogue: 0,0:01:58.57,0:02:01.67,Main-207+,,0,0,0,,Kesytän mustekalan.\NSe saa vetää meidän laivaa!
Dialogue: 0,0:02:01.67,0:02:03.14,Main-207+,,0,0,0,,Älä houri!
Dialogue: 0,0:02:03.87,0:02:08.81,Main-207+,,0,0,0,,Katso tarkkaan! Tai ei tarvi, näet\Nvarmasti muutenkin tuon hirmujätin!
Dialogue: 0,0:02:08.81,0:02:11.28,Main-207+,,0,0,0,,Ohhoh, miten iso!
Dialogue: 0,0:02:11.28,0:02:12.72,Main-207+,,0,0,0,,Me ollaan mennyttä!
Dialogue: 0,0:02:13.18,0:02:15.79,Main-207+,,0,0,0,,Kuka tietää miten monta\Nvuosisataa se on elänyt!
Comment: 0,0:02:15.79,0:02:19.02,Main-207+,,0,0,0,,The kraken appears\Nin many myths in the world -
Comment: 0,0:02:19.02,0:02:22.29,Main-207+,,0,0,0,,it's like a visionary creature!
Dialogue: 0,0:02:15.79,0:02:19.02,Main-207+,,0,0,0,,Kraken tunnetaan\Nmyyteissä kautta maailman!
Dialogue: 0,0:02:19.02,0:02:22.29,Main-207+,,0,0,0,,Se on tarujen hirviö!
Dialogue: 0,0:02:22.29,0:02:24.80,Main-207+,,0,0,0,,Luuton lihakasa...
Dialogue: 0,0:02:24.80,0:02:27.03,Main-207+,,0,0,0,,ja lihaton luukasa...
Dialogue: 0,0:02:27.77,0:02:31.00,Main-207+,,0,0,0,,Tavallaan minun antiteesini.
Dialogue: 0,0:02:31.00,0:02:32.34,Main-207+,,0,0,0,,Mitä väliä!
Dialogue: 0,0:02:33.50,0:02:35.61,Main-207+,,0,0,0,,Ei yhtään hullumpaa jälkeä.
Dialogue: 0,0:02:35.94,0:02:38.11,Main-207+,,0,0,0,,Tuota näkyä ei kohtaa usein, joten...
Dialogue: 0,0:02:38.11,0:02:39.84,Main-207+,,0,0,0,,Piirrätkö sitä?! Jokin raja hei!
Dialogue: 0,0:02:39.84,0:02:43.68,Main-207+,,0,0,0,,En pane vastaan, mutta\Nonko suunnitelmaa, Luffy?
Dialogue: 0,0:02:43.68,0:02:46.62,Main-207+,,0,0,0,,Ongelmana on se, että ollaan meressä.
Dialogue: 0,0:02:47.12,0:02:49.29,Main-207+,,0,0,0,,Ei suinkaan.
Dialogue: 0,0:02:49.99,0:02:52.76,Main-207+,,0,0,0,,Ongelmana on otuksen koko.
Dialogue: 0,0:02:52.76,0:02:54.99,Main-207+,,0,0,0,,Maallakin oltaisiin pulassa.
Dialogue: 0,0:02:55.63,0:02:58.46,Thoughts-207+,,0,0,0,,Mikä noita vaivaa?
Dialogue: 0,0:02:58.46,0:03:04.47,Thoughts-207+,,0,0,0,,Eikö tällaisessa tilanteessa kaikkien\Npitäisi yhdessä keskittyä pakenemiseen?!
Dialogue: 0,0:03:04.47,0:03:06.70,Main-207+,,0,0,0,,Kurssi kohti etelää!
Dialogue: 0,0:03:07.14,0:03:09.64,Main-207+,,0,0,0,,Ei, Nami! Vaan suoraan mustekalaa päin!
Dialogue: 0,0:03:09.64,0:03:11.14,Main-207+,,0,0,0,,Älä typerehdi!
Dialogue: 0,0:03:09.64,0:03:11.14,Secondary-207+,,0,0,0,,Kuules nyt!
Dialogue: 0,0:03:11.14,0:03:12.94,Main-207+,,0,0,0,,Mustekalahan...
Dialogue: 0,0:03:11.14,0:03:12.94,Secondary-207+,,0,0,0,,Noh, noh, Nami-neiti.
Dialogue: 0,0:03:12.94,0:03:14.55,Main-207+,,0,0,0,,Mä olen...
Dialogue: 0,0:03:15.25,0:03:16.55,Main-207+,,0,0,0,,olen...
Dialogue: 0,0:03:20.28,0:03:21.39,Main-207+,,0,0,0,,kanssanne!
Dialogue: 0,0:03:21.39,0:03:22.95,Main-207+,,0,0,0,,Hän kesti!
Dialogue: 0,0:03:22.95,0:03:24.09,Main-207+,,0,0,0,,Hyvin tehty!
Dialogue: 0,0:03:24.09,0:03:27.62,Main-207+,,0,0,0,,Kuntoutuksen tulosta... ja sen,\Nettä Namilla on takki.
Dialogue: 0,0:03:27.99,0:03:31.60,Thoughts-207+,,0,0,0,,Täällä on vaarallista! Miun täytyy\Nsuojella omaa henkiriepua...!
Dialogue: 0,0:03:32.03,0:03:33.86,Main-207+,,0,0,0,,Jokin lähestyy takaa!
Dialogue: 0,0:03:36.43,0:03:38.80,Main-207+,,0,0,0,,Velitsu!
Dialogue: 0,0:03:38.80,0:03:39.74,Main-207+,,0,0,0,,Se on se äskeinen...!
Dialogue: 0,0:03:40.44,0:03:43.24,Main-207+,,0,0,0,,Coribou! Ja ronttiseni!
Dialogue: 0,0:03:43.24,0:03:46.01,Main-207+,,0,0,0,,Me pelastetaan velitsu!
Dialogue: 0,0:03:46.01,0:03:47.21,Main-207+,,0,0,0,,– Joäh!\N– Joäh!
Dialogue: 0,0:03:47.21,0:03:51.42,Main-207+,,0,0,0,,Työkös tulitte avittamaan...?!
Dialogue: 0,0:03:57.02,0:03:58.46,Main-207+,,0,0,0,,Älä!
Dialogue: 0,0:04:01.43,0:04:03.99,Main-207+,,0,0,0,,Kuplapäällystys pamahti rikki!
Dialogue: 0,0:04:03.99,0:04:06.56,Main-207+,,0,0,0,,{\q2\i1}Sunnya{\i0} isompi alus meni kertarutistuksella!
Dialogue: 0,0:04:09.97,0:04:12.74,Main-207+,,0,0,0,,Ronttiseni!
Dialogue: 0,0:04:20.44,0:04:21.71,Main-207+,,0,0,0,,Ihan kuin meduusoja.
Dialogue: 0,0:04:21.71,0:04:24.18,Main-207+,,0,0,0,,Turpa rullalle, Roronoa!
Dialogue: 0,0:04:26.18,0:04:27.42,Main-207+,,0,0,0,,Se tulee!
Dialogue: 0,0:04:30.59,0:04:32.02,Main-207+,,0,0,0,,Ihan valtava!
Dialogue: 0,0:04:32.02,0:04:34.69,Main-207+,,0,0,0,,Mitä me voidaan tuota vastaan?!
Dialogue: 0,0:04:35.23,0:04:36.03,Main-207+,,0,0,0,,{\fad(150,0)}Vaihde Kol–
Dialogue: 0,0:04:36.03,0:04:38.53,Main-207+,,0,0,0,,Lopettakaa!
Dialogue: 0,0:04:38.53,0:04:40.66,Main-207+,,0,0,0,,Hajotatte vielä kuplan!
Dialogue: 0,0:04:43.33,0:04:45.67,Main-207+,,0,0,0,,{\fad(150,175)}Kananlento!
Dialogue: 0,0:04:46.97,0:04:49.77,Main-207+,,0,0,0,,Mitä me... sitten teemme?!
Dialogue: 0,0:04:49.77,0:04:52.04,Main-207+,,0,0,0,,{\q2}Älä sä tee mitään, me taistellaan sen kanssa!
Dialogue: 0,0:04:52.04,0:04:55.31,Main-207+,,0,0,0,,Lopeta, jooko! Kupla hajoaa muuten!
Dialogue: 0,0:04:55.65,0:05:01.49,Main-207+,,0,0,0,,{\q2}Kuunnelkaas! Jos työ välttämättä\Nhaluatte taistella, voin tarjota suunnitelman!
Dialogue: 0,0:05:01.49,0:05:02.05,Main-207+,,0,0,0,,Häh?
Dialogue: 0,0:05:02.49,0:05:04.35,Main-207+,,0,0,0,,Mitäs se on? Sano pois.
Dialogue: 0,0:05:05.89,0:05:07.82,Main-207+,,0,0,0,,Noin juuri!
Dialogue: 0,0:05:08.33,0:05:11.33,Main-207+,,0,0,0,,Tuollainen on "räpiköintipäällystys"!
Dialogue: 0,0:05:11.33,0:05:14.03,Main-207+,,0,0,0,,Toisin sanoen sukelluspuku!
Dialogue: 0,0:05:14.73,0:05:20.84,Main-207+,,0,0,0,,Kun hyppäätte laivasta,\Nvoitte taistella mielin määrin!
Dialogue: 0,0:05:21.21,0:05:25.11,Thoughts-207+,,0,0,0,,Jos en auta näitä tyhmyreitä, kärsin itsekin!
Dialogue: 0,0:05:25.11,0:05:27.41,Main-207+,,0,0,0,,Miksi sä sekaannut tähän?!
Dialogue: 0,0:05:27.41,0:05:29.98,Main-207+,,0,0,0,,Meidän piti paeta!
Dialogue: 0,0:05:29.98,0:05:32.08,Main-207+,,0,0,0,,Mutta nyt ne tahtoo taistella!
Comment: 0,0:05:32.08,0:05:38.02,Main-207+,,0,0,0,,I told you guys to run from the beginning\Nbut that Captain{-san} won't listen!
Dialogue: 0,0:05:32.08,0:05:38.02,Main-207+,,0,0,0,,Niinhän miekin sanoin heti kättelyssä!\NMutta kuunteleekos kapteeninne?!
Dialogue: 0,0:05:38.56,0:05:42.66,Main-207+,,0,0,0,,Se on joko tämä tai sitten ne\Nriehuvat laivalta käsin, tyhmyri!
Dialogue: 0,0:05:42.99,0:05:44.66,Main-207+,,0,0,0,,Ookoo, antaa mennä!
Dialogue: 0,0:05:44.66,0:05:45.73,Main-207+,,0,0,0,,Niin kauas kuin pääset!
Dialogue: 0,0:05:45.73,0:05:47.23,Main-207+,,0,0,0,,Naru on tiellä.
Dialogue: 0,0:05:47.63,0:05:49.87,Main-207+,,0,0,0,,Älkää sitten taistelko laivan lähellä!
Dialogue: 0,0:05:49.87,0:05:51.03,Main-207+,,0,0,0,,Selvä.
Dialogue: 0,0:05:51.90,0:05:53.20,Main-207+,,0,0,0,,Okei, menoksi!
Dialogue: 0,0:05:53.54,0:05:54.04,Main-207+,,0,0,0,,– Joo!\N– Joo!
Dialogue: 0,0:05:55.84,0:05:56.77,Main-207+,,0,0,0,,Täh?
Dialogue: 0,0:05:56.77,0:05:58.48,Main-207+,,0,0,0,,Hei!
Dialogue: 0,0:05:58.48,0:06:00.34,Main-207+,,0,0,0,,Kiinnittäkää köydet!
Dialogue: 0,0:06:00.71,0:06:02.91,Main-207+,,0,0,0,,Te ajaudutte eroon meistä!
Dialogue: 0,0:06:02.91,0:06:05.38,Main-207+,,0,0,0,,Nami-neiti on huolissaan minusta!
Dialogue: 0,0:06:06.15,0:06:07.05,Main-207+,,0,0,0,,Hei kaverit!
Dialogue: 0,0:06:07.72,0:06:09.72,Main-207+,,0,0,0,,Hankkikaa te mulle hetki aikaa!
Dialogue: 0,0:06:10.05,0:06:11.96,Main-207+,,0,0,0,,Hoitelen sen yhdellä iskulla!
Dialogue: 0,0:06:12.36,0:06:15.23,Main-207+,,0,0,0,,Sitä odottaessa mä ehdin ensin.
Dialogue: 0,0:06:15.23,0:06:17.19,Main-207+,,0,0,0,,Sä leikkelisit sen!
Dialogue: 0,0:06:17.69,0:06:19.80,Main-207+,,0,0,0,,Mustekalasta tulee mulle lemmikki!
Dialogue: 0,0:06:22.03,0:06:23.33,Main-207+,,0,0,0,,Onko ne kunnossa?
Dialogue: 0,0:06:23.33,0:06:26.24,Main-207+,,0,0,0,,Pysykää sitten loitolla! Millikin liian...
Dialogue: 0,0:06:27.97,0:06:30.04,Main-207+,,0,0,0,,Yhä se sihtaa meihin!
Dialogue: 0,0:06:30.04,0:06:31.81,Main-207+,,0,0,0,,Siirtykää syrjään!
Dialogue: 0,0:06:33.38,0:06:35.45,Main-207+,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:06:38.05,0:06:41.02,Main-207+,,0,0,0,,{\fad(150,150)}Raketinheitin!
Dialogue: 0,0:06:42.79,0:06:43.99,Main-207+,,0,0,0,,Torjui sen!
Dialogue: 0,0:06:43.99,0:06:45.89,Main-207+,,0,0,0,,Juukerin tehokas!
Dialogue: 0,0:06:46.52,0:06:49.23,Main-207+,,0,0,0,,Taas uusi lonkero!
Dialogue: 0,0:06:49.23,0:06:50.86,Main-207+,,0,0,0,,Miksi se vain meitä?!
Dialogue: 0,0:06:52.90,0:06:54.10,Main-207+,,0,0,0,,{\fad(150,150)}Suojausvaihde!
Dialogue: 0,0:06:55.37,0:06:57.10,Main-207+,,0,0,0,,Nyt tuli iso osuma!
Dialogue: 0,0:06:58.24,0:06:59.80,Main-207+,,0,0,0,,Ovatko kaikki kunnossa?
Dialogue: 0,0:07:01.14,0:07:03.54,Main-207+,,0,0,0,,K-Kestimme!
Dialogue: 0,0:07:03.54,0:07:04.64,Main-207+,,0,0,0,,Hienosti tehty!
Dialogue: 0,0:07:04.64,0:07:06.11,Main-207+,,0,0,0,,Upeaa, Chopper!
Dialogue: 0,0:07:08.25,0:07:11.32,Main-207+,,0,0,0,,Tällä kertaa törmäämme vuoreen!
Dialogue: 0,0:07:12.22,0:07:13.82,Main-207+,,0,0,0,,{\fad(150,150)}Mil Fleurs!
Dialogue: 0,0:07:14.38,0:07:16.02,Main-207+,,0,0,0,,{\fad(150,150)}Gigantesco Mano!
Dialogue: 0,0:07:20.99,0:07:22.83,Main-207+,,0,0,0,,Oho, mitkä kädet!
Dialogue: 0,0:07:24.96,0:07:25.83,Main-207+,,0,0,0,,– Jes!\N– Jes!
Dialogue: 0,0:07:25.83,0:07:28.67,Main-207+,,0,0,0,,Hyvä, Robin! Selvittiin!
Dialogue: 0,0:07:30.17,0:07:31.44,Main-207+,,0,0,0,,Hienoa.
Dialogue: 0,0:07:31.44,0:07:35.24,Main-207+,,0,0,0,,Se toimi kuin toimikin\Npienen hetken vedessä.
Dialogue: 0,0:07:35.74,0:07:38.91,Main-207+,,0,0,0,,No niin, mun vuoroni!
Dialogue: 0,0:07:42.05,0:07:43.78,Main-207+,,0,0,0,,{\fad(150,150)}Vaihde Kolme!
Dialogue: 0,0:08:01.20,0:08:02.87,Main-207+,,0,0,0,,{\fad(150,150)}Aseväritys!
Dialogue: 0,0:08:09.74,0:08:12.94,Main-207+,,0,0,0,,Meri vie voimat!
Dialogue: 0,0:08:15.58,0:08:18.68,Main-207+,,0,0,0,,Vai yrittää luikero torjua.
Dialogue: 0,0:08:19.15,0:08:20.65,Main-207+,,0,0,0,,{\fad(150,150)}Blue Walk!
Dialogue: 0,0:08:21.08,0:08:24.45,Main-207+,,0,0,0,,Täh? Herra Sanji poistui kuplasta!
Dialogue: 0,0:08:24.45,0:08:26.69,Main-207+,,0,0,0,,Siitä viis! Katsokaa mikä vauhti!
Dialogue: 0,0:08:26.69,0:08:28.13,Main-207+,,0,0,0,,Ihan kuin merenmiehellä!
Dialogue: 0,0:08:28.13,0:08:29.03,Main-207+,,0,0,0,,Päheetä!
Dialogue: 0,0:08:29.59,0:08:31.46,Thoughts-207+,,0,0,0,,Juoksin juoksemasta päästyäni...
Dialogue: 0,0:08:31.46,0:08:34.30,Thoughts-207+,,0,0,0,,iljetyksiä paeten kaksi vuotta.
Dialogue: 0,0:08:34.93,0:08:38.40,Thoughts-207+,,0,0,0,,Vai että hirviö?! Niihin verrattuna\Ntuo ei ole mitään!
Dialogue: 0,0:08:38.40,0:08:40.04,Thoughts-207+,,0,0,0,,Näyttää jopa suloiselta.
Dialogue: 0,0:08:40.04,0:08:42.24,Main-207+,,0,0,0,,{\fad(150,150)}Diable Jambe!
Dialogue: 0,0:08:47.58,0:08:48.98,Main-207+,,0,0,0,,{\fad(150,150)}Bien Cuit...
Dialogue: 0,0:08:49.41,0:08:51.52,Main-207+,,0,0,0,,{\fad(150,150)}Grill Shot!
Dialogue: 0,0:09:00.52,0:09:02.73,Main-207+,,0,0,0,,{\fad(150,150)}Kolmen Miekan Ydintekniikka...
Dialogue: 0,0:09:02.93,0:09:04.26,Main-207+,,0,0,0,,{\fad(150,150)}Seksagesimaali!
Comment: 0,0:09:14.34,0:09:16.94,Main-207+,,0,0,0,,Hey hey, Zoro! Sanji!
Dialogue: 0,0:09:14.34,0:09:16.94,Main-207+,,0,0,0,,Hei nyt, Zoro, Sanji!
Dialogue: 0,0:09:16.94,0:09:19.44,Main-207+,,0,0,0,,Siltä loppuu kohta jalat!
Dialogue: 0,0:09:19.44,0:09:21.75,Main-207+,,0,0,0,,{\fad(150,150)}Gumigumi...
Dialogue: 0,0:09:23.65,0:09:27.15,Main-207+,,0,0,0,,{\fad(150,150)}Norsupyssy!
Dialogue: 0,0:09:33.22,0:09:34.36,Main-207+,,0,0,0,,Ketoon lensi!
Dialogue: 0,0:09:34.36,0:09:37.16,Main-207+,,0,0,0,,Kuinka paljon hän oikein on vahvistunut?!
Dialogue: 0,0:09:42.70,0:09:44.94,Main-207+,,0,0,0,,Hei, siellä on jokin!
Dialogue: 0,0:09:44.94,0:09:45.87,Main-207+,,0,0,0,,– Häh?\N– Häh?
Dialogue: 0,0:09:46.80,0:09:48.17,Main-207+,,0,0,0,,Hai?
Dialogue: 0,0:09:53.84,0:09:54.85,Main-207+,,0,0,0,,Hai?
Dialogue: 0,0:09:54.85,0:09:57.11,Main-207+,,0,0,0,,Onko sillä vaatteet?
Dialogue: 0,0:09:57.11,0:09:59.25,Main-207+,,0,0,0,,On muuten iso.
Dialogue: 0,0:10:12.43,0:10:14.66,Main-207+,,0,0,0,,Kolmikko imeytyi virtaan!
Dialogue: 0,0:10:14.66,0:10:17.20,Main-207+,,0,0,0,,Äkkiä perään! Pitää pysyä yhdessä!
Dialogue: 0,0:10:17.20,0:10:18.50,Main-207+,,0,0,0,,Okei!
Dialogue: 0,0:10:21.87,0:10:24.41,Main-207+,,0,0,0,,En halua kuolla tänne!
Dialogue: 0,0:10:24.41,0:10:26.04,Main-207+,,0,0,0,,Mie en usko tätä!
Dialogue: 0,0:10:26.04,0:10:27.04,Main-207+,,0,0,0,,Vieläkö sä täällä olet?
Dialogue: 0,0:10:27.04,0:10:27.98,Main-207+,,0,0,0,,Älä ole noin lunki!
Dialogue: 0,0:10:29.65,0:10:31.01,Main-207+,,0,0,0,,Silmät pyörivät kuin mikä!
Dialogue: 0,0:10:31.01,0:10:32.62,Main-207+,,0,0,0,,Mutta eihän minulla niitä olekaan!
Dialogue: 0,0:10:36.95,0:10:38.82,Main-207+,,0,0,0,,Pidä puomi suorassa!
Dialogue: 0,0:10:38.82,0:10:42.26,Main-207+,,0,0,0,,Käännä paapuuriin! Muuten\Ntörmäämme mantereeseen!
Dialogue: 0,0:10:43.09,0:10:44.26,Main-207+,,0,0,0,,Jepulista!
Dialogue: 0,0:10:44.63,0:10:47.03,Main-207+,,0,0,0,,Jos hellitämme hetkeksikään,\Nlaiva on mennyttä!
Dialogue: 0,0:10:47.03,0:10:48.00,Main-207+,,0,0,0,,Eäh?!
Dialogue: 0,0:10:49.97,0:10:51.70,Main-207+,,0,0,0,,Varokaa, ettette lennä kyydistä!
Dialogue: 0,0:10:53.77,0:10:55.51,Main-207+,,0,0,0,,Pysytään keskellä virtaa!
Dialogue: 0,0:10:55.97,0:10:57.04,Main-207+,,0,0,0,,Selvän teki!
Dialogue: 0,0:11:01.41,0:11:03.38,Main-207+,,0,0,0,,Mikä vauhti!
Dialogue: 0,0:11:05.18,0:11:06.52,Main-207+,,0,0,0,,Miten jänskää!
Dialogue: 0,0:11:18.80,0:11:19.56,Main-207+,,0,0,0,,Usopp!
Dialogue: 0,0:11:20.00,0:11:22.37,Main-207+,,0,0,0,,Ai, ai jai jai...
Dialogue: 0,0:11:23.63,0:11:25.77,Main-207+,,0,0,0,,Elän sentään...
Dialogue: 0,0:11:29.41,0:11:32.54,Main-207+,,0,0,0,,Noh, mitä te synkistelette?
Dialogue: 0,0:11:32.54,0:11:36.28,Main-207+,,0,0,0,,Voi sentään! Ettekö pärjää\Nhetkeäkään, jos en...
Dialogue: 0,0:11:37.51,0:11:39.98,Main-207+,,0,0,0,,Onpa kalsaa!
Dialogue: 0,0:11:40.35,0:11:42.72,Main-207+,,0,0,0,,Luffya ja muita ei löydy.
Dialogue: 0,0:11:42.72,0:11:43.92,Main-207+,,0,0,0,,Päädyimme erilleen.
Dialogue: 0,0:11:43.92,0:11:45.52,Main-207+,,0,0,0,,Mitäh?!
Dialogue: 0,0:11:45.52,0:11:49.23,Main-207+,,0,0,0,,Kunpa meripedot eivät olisi\Nraadelleet heitä riekaleiksi...
Dialogue: 0,0:11:49.23,0:11:51.13,Main-207+,,0,0,0,,Älä mieti noin pelottavia...
Comment: 0,0:11:52.00,0:11:55.47,Main-207+,,0,0,0,,It's too dark - I wanna look\Nfor them but I can't see anything!
Dialogue: 0,0:11:52.00,0:11:55.47,Main-207+,,0,0,0,,Ei tässä pimeydessä etsintäkään onnistu!
Dialogue: 0,0:11:55.47,0:11:58.20,Main-207+,,0,0,0,,En oikein siedä pimeää.
Dialogue: 0,0:11:58.20,0:12:01.20,Main-207+,,0,0,0,,E-Eikö tunnukin, että joku liikkuu siellä?
Dialogue: 0,0:12:01.20,0:12:04.21,Main-207+,,0,0,0,,Taidamme olla jo 7000 metrissä.
Dialogue: 0,0:12:04.21,0:12:08.18,Main-207+,,0,0,0,,Tässä vedenpaineessa\N{\i1}Uppohai{\i0} olisi jo lituskana.
Dialogue: 0,0:12:08.18,0:12:10.68,Main-207+,,0,0,0,,Onko Nereidisaari lähellä?
Dialogue: 0,0:12:10.68,0:12:13.45,Main-207+,,0,0,0,,Ehkä he ovat jo siellä...!
Dialogue: 0,0:12:13.45,0:12:17.82,Main-207+,,0,0,0,,Camien mukaan se on\N10000 metrin syvyydessä...
Dialogue: 0,0:12:18.46,0:12:21.56,Main-207+,,0,0,0,,Vielä kolme kilsaa alas?!
Dialogue: 0,0:12:21.56,0:12:24.49,Main-207+,,0,0,0,,Heillä on vain pienet kuplat.
Dialogue: 0,0:12:24.49,0:12:27.40,Main-207+,,0,0,0,,Vaikka he olisivatkin hengissä,\Nhapppi ei riittäisi kauaa!
Dialogue: 0,0:12:28.26,0:12:30.80,Main-207+,,0,0,0,,Olisivat ottaneet köydet kuten käskin...!
Dialogue: 0,0:12:30.80,0:12:33.24,Main-207+,,0,0,0,,Valittelu ei hyödytä.
Dialogue: 0,0:12:33.24,0:12:34.27,Main-207+,,0,0,0,,Etsitään heitä.
Dialogue: 0,0:12:34.27,0:12:36.11,Main-207+,,0,0,0,,Meikäläisessä on valaistustoiminto.
Dialogue: 0,0:12:36.11,0:12:37.51,Main-207+,,0,0,0,,– Täh?!\N– Täh?!
Dialogue: 0,0:12:39.01,0:12:40.54,Main-207+,,0,0,0,,Silmissä vai?!
Dialogue: 0,0:12:41.28,0:12:42.71,Main-207+,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:12:45.35,0:12:47.52,Main-207+,,0,0,0,,{\fad(150,0)}Nipple Light!
Dialogue: 0,0:12:47.52,0:12:49.49,Main-207+,,0,0,0,,Mitä sä oikein välkytät, mies!
Dialogue: 0,0:12:54.09,0:12:55.83,Main-207+,,0,0,0,,Äkkiä livohkaan!
Dialogue: 0,0:13:02.93,0:13:04.30,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:13:04.30,0:13:05.90,Main-207+,,0,0,0,,Zoro!
Dialogue: 0,0:13:05.90,0:13:07.67,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:13:07.67,0:13:10.24,Main-207+,,0,0,0,,Minne te oikein katositte?
Dialogue: 0,0:13:10.24,0:13:12.21,Main-207+,,0,0,0,,Tulkaa takaisin!
Dialogue: 0,0:13:12.54,0:13:17.58,Main-207+,,0,0,0,,Merenpohja on laaja. {\i1}Sunnyn{\i0}\N"Öögapoweri" ei yletä kauas.
Dialogue: 0,0:13:17.58,0:13:20.22,Main-207+,,0,0,0,,Sangen hankalaa...
Dialogue: 0,0:13:20.22,0:13:24.05,Main-207+,,0,0,0,,Pimeys vielä lietsoo\Nepävarmuudentunnetta...
Dialogue: 0,0:13:24.05,0:13:26.59,Main-207+,,0,0,0,,Ei tämä toimi näin.
Dialogue: 0,0:13:27.06,0:13:29.16,Main-207+,,0,0,0,,Mitä pitäisi tehdä?
Dialogue: 0,0:13:29.59,0:13:33.60,Main-207+,,0,0,0,,Emme voi ankkuroitua,\NJoten tähystäkää tarkasti koko ajan.
Dialogue: 0,0:13:36.70,0:13:38.90,Main-207+,,0,0,0,,Oho, meduusa!
Dialogue: 0,0:13:38.90,0:13:40.87,Main-207+,,0,0,0,,Yllämme on jättimeduusa!
Dialogue: 0,0:13:40.87,0:13:42.47,Main-207+,,0,0,0,,Mikä hirmu!
Dialogue: 0,0:13:42.47,0:13:44.07,Main-207+,,0,0,0,,Tosiaan!
Dialogue: 0,0:13:44.51,0:13:46.64,Main-207+,,0,0,0,,Ja se välkehtii!
Dialogue: 0,0:13:46.64,0:13:49.35,Main-207+,,0,0,0,,Vähän kuin tähti yötaivaalla!
Dialogue: 0,0:13:50.25,0:13:51.45,Main-207+,,0,0,0,,Miten nättiä!
Dialogue: 0,0:13:52.52,0:13:54.28,Main-207+,,0,0,0,,Oho, sen lonkero tuli sisälle!
Dialogue: 0,0:13:54.85,0:13:57.05,Main-207+,,0,0,0,,T-Tahtookoohan se ystävystyä?
Dialogue: 0,0:13:57.05,0:13:59.19,Main-207+,,0,0,0,,Et saa koskea siihen, Chopper!
Dialogue: 0,0:13:59.19,0:14:00.39,Main-207+,,0,0,0,,Se voi olla myrkyllinen!
Dialogue: 0,0:14:06.20,0:14:07.33,Main-207+,,0,0,0,,Voihan...!
Dialogue: 0,0:14:07.70,0:14:10.70,Main-207+,,0,0,0,,{\fad(150,150)}Himpun Verran Purskejytky!
Dialogue: 0,0:14:13.40,0:14:15.64,Main-207+,,0,0,0,,– T-Täh?!\N– T-Täh?!
Dialogue: 0,0:14:15.64,0:14:17.77,Main-207+,,0,0,0,,Se hotkaisi meduusan!
Dialogue: 0,0:14:17.77,0:14:21.61,Main-207+,,0,0,0,,Oh...! Ilma todellakin väheni hiukan.
Dialogue: 0,0:14:21.61,0:14:23.51,Main-207+,,0,0,0,,Parempi kuin päätyä kitaan!
Dialogue: 0,0:14:23.51,0:14:24.05,Main-207+,,0,0,0,,– Häh?!\N– Häh?!
Dialogue: 0,0:14:24.38,0:14:28.38,Main-207+,,0,0,0,,Purskejytkyn käyttäminen vie ilmaa.
Dialogue: 0,0:14:28.38,0:14:33.26,Main-207+,,0,0,0,,Mutta olemme veden alla.\NSitä on siis rajallisesti.
Dialogue: 0,0:14:33.26,0:14:36.86,Main-207+,,0,0,0,,Joten kun lauomme sitä ulos,\Nkupla kutistuu!
Dialogue: 0,0:14:40.50,0:14:43.17,Main-207+,,0,0,0,,Nyt syöjä kelluu selällään...!
Dialogue: 0,0:14:43.57,0:14:45.17,Main-207+,,0,0,0,,Hermomyrkkyä, kuten arvelin...
Dialogue: 0,0:14:45.17,0:14:46.04,Main-207+,,0,0,0,,– Eäh?!\N– Eäh?!
Dialogue: 0,0:14:46.04,0:14:48.77,Main-207+,,0,0,0,,Syvämeri on kamala! Ja ylipimeä...
Dialogue: 0,0:14:49.47,0:14:51.61,Main-207+,,0,0,0,,Niin paljon valkosilmäisiä kaloja...
Dialogue: 0,0:14:51.61,0:14:54.44,Main-207+,,0,0,0,,Pelottavaa!
Dialogue: 0,0:14:58.92,0:15:00.92,Main-207+,,0,0,0,,Syvänmeren pimeydessä
Dialogue: 0,0:15:00.92,0:15:04.35,Main-207+,,0,0,0,,monen eliön silmät ovat taantuneet.
Dialogue: 0,0:15:06.42,0:15:08.19,Main-207+,,0,0,0,,Ai, ne eivät siis näe hyvin.
Dialogue: 0,0:15:09.93,0:15:11.16,Main-207+,,0,0,0,,Pönttöpää!
Dialogue: 0,0:15:11.16,0:15:12.76,Main-207+,,0,0,0,,Tule tänne, jos uskallat!
Dialogue: 0,0:15:13.20,0:15:15.97,Main-207+,,0,0,0,,Joillakin silmät ovat\Npäinvastoin kehittyneet.
Dialogue: 0,0:15:18.67,0:15:22.81,Main-207+,,0,0,0,,Ai? Miksikö minä näen ilman silmiä?
Dialogue: 0,0:15:23.24,0:15:26.48,Main-207+,,0,0,0,,Haluaisitteko minun valaisevan teitä?
Dialogue: 0,0:15:27.48,0:15:28.75,Main-207+,,0,0,0,,Vastaus on...
Dialogue: 0,0:15:31.98,0:15:33.48,Main-207+,,0,0,0,,salaisuus!
Dialogue: 0,0:15:33.92,0:15:37.19,Main-207+,,0,0,0,,Mitä juttelet itseksesi?
Dialogue: 0,0:15:37.19,0:15:38.56,Main-207+,,0,0,0,,Ei hätiä.
Dialogue: 0,0:15:38.56,0:15:41.06,Main-207+,,0,0,0,,Yksinäisyys on tuttua.
Dialogue: 0,0:15:41.06,0:15:43.79,Main-207+,,0,0,0,,Hei! Lopettakaa hölmöily ja etsikää heitä!
Dialogue: 0,0:15:46.56,0:15:48.30,Main-207+,,0,0,0,,Miksi minua...?
Dialogue: 0,0:15:48.30,0:15:52.04,Main-207+,,0,0,0,,– Luffy! Zoro! Sanji!\N– Luffy! Zoro! Sanji!
Dialogue: 0,0:15:52.04,0:15:54.77,Main-207+,,0,0,0,,– Minne te oikein katositte?!\N– Minne te oikein katositte?!
Dialogue: 0,0:15:55.71,0:15:56.94,Main-207+,,0,0,0,,Jas?
Dialogue: 0,0:15:57.77,0:15:59.38,Main-207+,,0,0,0,,Tämä köysihän...
Dialogue: 0,0:15:59.98,0:16:01.21,Main-207+,,0,0,0,,Hyvä herrasväki.
Dialogue: 0,0:16:01.21,0:16:02.38,Main-207+,,0,0,0,,Häh?
Dialogue: 0,0:16:02.38,0:16:05.75,Main-207+,,0,0,0,,Oletteko nähneet sitä yhtä piraattia?
Dialogue: 0,0:16:05.75,0:16:08.08,Main-207+,,0,0,0,,Ai joo! Hän on vielä täällä jossain.
Dialogue: 0,0:16:08.08,0:16:10.05,Main-207+,,0,0,0,,Olin unohtanut sen tyypin kokonaan.
Dialogue: 0,0:16:10.05,0:16:11.55,Main-207+,,0,0,0,,Minne se meni?
Dialogue: 0,0:16:11.55,0:16:14.72,Main-207+,,0,0,0,,Ei ole näkynyt tänne saavuttuamme.
Dialogue: 0,0:16:14.72,0:16:17.93,Main-207+,,0,0,0,,{\q2}Ehkä hän tippui kyydistä, kun laskeuduttiin.
Dialogue: 0,0:16:17.93,0:16:19.10,Main-207+,,0,0,0,,Voi olla.
Dialogue: 0,0:16:19.50,0:16:24.03,Main-207+,,0,0,0,,{\q2}Sidottuna se ei voinut tarrautua mihinkään.
Dialogue: 0,0:16:24.03,0:16:25.24,Main-207+,,0,0,0,,Ei, vaan...
Dialogue: 0,0:16:25.24,0:16:26.34,Main-207+,,0,0,0,,– Täh?\N– Täh?
Dialogue: 0,0:16:26.34,0:16:28.97,Main-207+,,0,0,0,,Katsokaa, köysi on irrotettu!
Dialogue: 0,0:16:31.74,0:16:34.04,Main-207+,,0,0,0,,O-Onko se sitten laivalla?!
Dialogue: 0,0:16:34.74,0:16:36.41,Main-207+,,0,0,0,,Missä?
Dialogue: 0,0:16:36.41,0:16:38.98,Main-207+,,0,0,0,,Hän siis saattaa piileksiä jossain...
Dialogue: 0,0:16:39.32,0:16:40.45,Main-207+,,0,0,0,,Täh?
Dialogue: 0,0:16:41.68,0:16:42.45,Main-207+,,0,0,0,,Voi ei...
Comment: 0,0:16:43.89,0:16:48.16,Thoughts-207+,,0,0,0,,I'll sneak into the girls' room–\Nif that's what you want, honey.
Dialogue: 0,0:16:43.89,0:16:48.16,Thoughts-207+,,0,0,0,,Voin mie piileksiä\Nnaistentiloissa, jos niin toivot...
Dialogue: 0,0:16:48.16,0:16:49.86,Main-207+,,0,0,0,,Helkkari!
Dialogue: 0,0:16:49.86,0:16:53.63,Main-207+,,0,0,0,,Pitääkö siis varoa vihollista\Nlaivan sisälläkin?
Dialogue: 0,0:16:54.00,0:16:55.23,Main-207+,,0,0,0,,Väliäkö hällä.
Dialogue: 0,0:16:55.23,0:16:57.30,Main-207+,,0,0,0,,Ei se ollut erityisen vahva heppu.
Dialogue: 0,0:16:59.74,0:17:02.01,Thoughts-207+,,0,0,0,,Hienoa!
Dialogue: 0,0:17:02.97,0:17:09.95,Thoughts-207+,,0,0,0,,Krakenin kanssa tapellut\Nhirviökolmikkokin on poissa!
Dialogue: 0,0:17:10.51,0:17:14.22,Thoughts-207+,,0,0,0,,Päätyminen tänne pelkässä kuplassa
Dialogue: 0,0:17:14.22,0:17:17.12,Thoughts-207+,,0,0,0,,tietää varmaa kuolemaa!
Dialogue: 0,0:17:17.12,0:17:21.46,Thoughts-207+,,0,0,0,,Harmi, etten saanut Olkihatun päätä...
Dialogue: 0,0:17:22.06,0:17:31.13,Thoughts-207+,,0,0,0,,mutta näiden raadoilla voinen\Ntodistaa senkin kuolleen!
Dialogue: 0,0:17:33.24,0:17:36.57,Thoughts-207+,,0,0,0,,Mutta hoppu pois, Caribou...
Dialogue: 0,0:17:36.57,0:17:38.31,Thoughts-207+,,0,0,0,,Ei sovi hätäillä!
Dialogue: 0,0:17:38.31,0:17:42.35,Thoughts-207+,,0,0,0,,Laiva ei kulje, jos tapan ne nyt!
Dialogue: 0,0:17:42.35,0:17:45.85,Thoughts-207+,,0,0,0,,Melko hyviä purjehtijoita he ovat.
Dialogue: 0,0:17:46.45,0:17:49.42,Thoughts-207+,,0,0,0,,Mutta odottakaas, kun\Nsaavutaan Nereidisaarelle...
Dialogue: 0,0:17:50.05,0:17:53.29,Thoughts-207+,,0,0,0,,silloin koittaa loppu!
Dialogue: 0,0:17:57.96,0:17:59.63,Main-207+,,0,0,0,,Löytyi!
Comment: 0,0:18:02.37,0:18:08.17,Secondary-207+,,0,0,0,,Oh no! Shoot! Dammit!
Comment: 0,0:18:04.40,0:18:06.17,Main-207+,,0,0,0,,{\an8}Now he can't get away.
Comment: 0,0:18:06.17,0:18:08.17,Main-207+,,0,0,0,,{\an8}How did he get in there?
Dialogue: 0,0:18:02.37,0:18:03.43,Secondary-207+,,0,0,0,,Oi örväles!
Dialogue: 0,0:18:03.43,0:18:08.17,Secondary-207+,,0,0,0,,{\an8}Kirottua! Voi siun...!
Dialogue: 0,0:18:04.40,0:18:06.17,Main-207+,,0,0,0,,Ja näin ikään.
Dialogue: 0,0:18:06.17,0:18:08.17,Main-207+,,0,0,0,,Miten hän tynnyriin pääsi?
Dialogue: 0,0:18:08.74,0:18:10.37,Main-207+,,0,0,0,,Olimme varomattomia.
Dialogue: 0,0:18:10.71,0:18:13.08,Main-207+,,0,0,0,,{\q2}Olisimme vaarassa jos kaveri ei olisi hölmö.
Dialogue: 0,0:18:13.51,0:18:16.85,Main-207+,,0,0,0,,Sen kroppa oli kuin muodotonta mutaa.
Dialogue: 0,0:18:17.71,0:18:18.82,Main-207+,,0,0,0,,Mutaa?
Dialogue: 0,0:18:18.82,0:18:21.65,Main-207+,,0,0,0,,Juu, selvät pirunmarjavoimat.
Dialogue: 0,0:18:21.65,0:18:24.05,Main-207+,,0,0,0,,Ja vielä logia-tyyppiä...
Dialogue: 0,0:18:24.65,0:18:28.66,Main-207+,,0,0,0,,Äsken se vain teeskenteli avutonta.
Dialogue: 0,0:18:28.66,0:18:30.16,Secondary-207+,,0,0,0,,Hoi!
Dialogue: 0,0:18:30.16,0:18:33.63,Secondary-207+,,0,0,0,,Laske ulos, hyvä herra!\NSimmariherra!
Dialogue: 0,0:18:34.03,0:18:36.30,Secondary-207+,,0,0,0,,Mie ryhdyn vaikka siun alaiseksi!
Dialogue: 0,0:18:39.30,0:18:41.60,Main-207+,,0,0,0,,Mikä on, Chopper?
Dialogue: 0,0:18:41.60,0:18:42.97,Main-207+,,0,0,0,,En tiedä.
Dialogue: 0,0:18:42.97,0:18:45.24,Main-207+,,0,0,0,,Alkoi äkkiä kuumottaa.
Dialogue: 0,0:18:45.24,0:18:47.88,Main-207+,,0,0,0,,En kestä hellettä.
Dialogue: 0,0:18:48.44,0:18:49.81,Main-207+,,0,0,0,,Kuumaa...!
Dialogue: 0,0:18:49.81,0:18:50.91,Main-207+,,0,0,0,,Mutta miten?
Dialogue: 0,0:18:52.15,0:18:53.88,Main-207+,,0,0,0,,M-Mitä ihmettä?
Dialogue: 0,0:18:53.88,0:18:55.02,Main-207+,,0,0,0,,Savua?
Dialogue: 0,0:18:55.02,0:18:56.85,Main-207+,,0,0,0,,Näkyvyys edessä nolla!
Dialogue: 0,0:18:58.12,0:19:01.02,Main-207+,,0,0,0,,Savuaako merenpohja? Miksi?
Dialogue: 0,0:19:01.46,0:19:02.59,Main-207+,,0,0,0,,Voiko olla...!
Dialogue: 0,0:19:03.66,0:19:04.23,Main-207+,,0,0,0,,Ne ovat...
Dialogue: 0,0:19:10.57,0:19:12.44,Main-207+,,0,0,0,,Syvänmerensavuttajia!
Dialogue: 0,0:19:13.07,0:19:15.57,Main-207+,,0,0,0,,Olemme tuliperäisellä alueella!
Dialogue: 0,0:19:15.57,0:19:16.27,Main-207+,,0,0,0,,Mitäh?!
Dialogue: 0,0:19:16.71,0:19:18.98,Main-207+,,0,0,0,,Katsokaa, purkauksen jälkiä!
Dialogue: 0,0:19:19.98,0:19:21.54,Main-207+,,0,0,0,,Mennään pian kauemmas!
Dialogue: 0,0:19:21.98,0:19:24.25,Main-207+,,0,0,0,,Mehän kuollaan heti, jos tulee purkaus!
Dialogue: 0,0:19:24.81,0:19:27.48,Main-207+,,0,0,0,,Kuumaa...! Kuumaa...!
Dialogue: 0,0:19:30.69,0:19:32.29,Main-207+,,0,0,0,,Jokin tulee perässä!
Dialogue: 0,0:19:32.29,0:19:34.09,Main-207+,,0,0,0,,Lihansyöjäputkimatoja!
Dialogue: 0,0:19:34.66,0:19:35.89,Main-207+,,0,0,0,,Ei voi muutakaan.
Dialogue: 0,0:19:35.89,0:19:38.36,Main-207+,,0,0,0,,{\fad(150,150)}Himpun Verran Purskejytky!
Dialogue: 0,0:19:41.86,0:19:44.33,Main-207+,,0,0,0,,Kasvottomia rapuja!
Dialogue: 0,0:19:44.33,0:19:46.57,Main-207+,,0,0,0,,{\fad(150,150)}Himpun Verran Purskejytky!
Dialogue: 0,0:19:48.04,0:19:50.11,Main-207+,,0,0,0,,Jotain kummia!
Dialogue: 0,0:19:50.11,0:19:53.14,Main-207+,,0,0,0,,{\fad(150,150)}Himpun Verran Purskejytky!
Dialogue: 0,0:19:53.14,0:19:55.28,Main-207+,,0,0,0,,Syvämeri pelottaa!
Dialogue: 0,0:19:56.18,0:20:00.22,Main-207+,,0,0,0,,Ei Luffy ja muut voi selvitä\Ntällaisessa paikassa...
Dialogue: 0,0:20:00.22,0:20:02.05,Main-207+,,0,0,0,,Surettaa...
Dialogue: 0,0:20:02.05,0:20:04.15,Main-207+,,0,0,0,,Juuri, kun tavattiin pitkästä aikaa...
Dialogue: 0,0:20:04.15,0:20:07.12,Main-207+,,0,0,0,,Älä puhu joutavia! Ei ne helpolla kuole!
Dialogue: 0,0:20:07.56,0:20:12.70,Main-207+,,0,0,0,,Pienet Purskejytkyt ovat\Nvieneet ilmaa aika lailla.
Dialogue: 0,0:20:16.40,0:20:17.73,Main-207+,,0,0,0,,Mikä tuo on?!
Dialogue: 0,0:20:17.73,0:20:19.24,Main-207+,,0,0,0,,Tosi kirkas!
Dialogue: 0,0:20:20.47,0:20:22.47,Main-207+,,0,0,0,,Nereidisaariko?
Dialogue: 0,0:20:22.47,0:20:24.71,Main-207+,,0,0,0,,Ehkä Luffy ja muut ovat siellä!
Dialogue: 0,0:20:24.71,0:20:27.41,Main-207+,,0,0,0,,Emme ole vielä sukeltaneet\Nviimeistä 3000 metriä.
Dialogue: 0,0:20:27.41,0:20:30.48,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\b1}Kuka siellä?
Dialogue: 0,0:20:30.48,0:20:31.41,Main-207+,,0,0,0,,Hei!
Dialogue: 0,0:20:31.41,0:20:33.92,Main-207+,,0,0,0,,Mistä oikein lähetät valomerkkejä?!
Dialogue: 0,0:20:34.38,0:20:35.52,Main-207+,,0,0,0,,Näkyykö mitään?
Dialogue: 0,0:20:35.52,0:20:37.95,Main-207+,,0,0,0,,Ei, liian kirkasta.
Dialogue: 0,0:20:41.06,0:20:42.49,Main-207+,,0,0,0,,Ei perskuta!
Dialogue: 0,0:20:45.23,0:20:48.03,Main-207+,,0,0,0,,Lyhtykrotti! Meitä huijattiin!
Dialogue: 0,0:20:48.43,0:20:51.13,Main-207+,,0,0,0,,Jäimme syvänmeren saalistajan saaliiksi!
Dialogue: 0,0:20:54.87,0:20:56.44,Main-207+,,0,0,0,,Olipa hilkulla!
Dialogue: 0,0:20:56.44,0:20:58.88,Main-207+,,0,0,0,,Mentiin kunnolla halpaan!
Dialogue: 0,0:20:58.88,0:21:00.68,Main-207+,,0,0,0,,Selvitäänkö me pakoon...?
Dialogue: 0,0:21:06.75,0:21:08.55,Main-207+,,0,0,0,,Mitä tällä kertaa?!
Dialogue: 0,0:21:08.55,0:21:09.99,Main-207+,,0,0,0,,I-Ihminen?
Dialogue: 0,0:21:09.99,0:21:11.92,Main-207+,,0,0,0,,Mikä pahus tuo on?!
Dialogue: 0,0:21:11.92,0:21:16.19,Main-207+,,0,0,0,,Ihmisen näköinen meren hirviö...
Dialogue: 0,0:21:17.33,0:21:21.10,Main-207+,,0,0,0,,Meripeikko!
Dialogue: 0,0:21:24.63,0:21:27.54,Main-207+,,0,0,0,,Se hävittää purtemme!
Dialogue: 0,0:21:30.81,0:21:31.54,Main-207+,,0,0,0,,Tuotako se lyö?!
Dialogue: 0,0:21:32.04,0:21:34.14,Main-207+,,0,0,0,,Hei, Krottis!
Dialogue: 0,0:21:34.14,0:21:35.81,Main-207+,,0,0,0,,Ei saa!
Dialogue: 0,0:21:36.65,0:21:38.68,Main-207+,,0,0,0,,Ei saa syödä laivoja!
Dialogue: 0,0:21:39.08,0:21:41.28,Main-207+,,0,0,0,,Milloinka sää oikein opit?
Dialogue: 0,0:21:41.98,0:21:45.59,Main-207+,,0,0,0,,Kapteeni Vander Decken suuttuu!
Dialogue: 0,0:21:45.96,0:21:48.39,Main-207+,,0,0,0,,P-Pelastiko se meidät?
Dialogue: 0,0:21:49.29,0:21:51.66,Main-207+,,0,0,0,,Livohkaan! Oli miten oli niin livohkaan!
Dialogue: 0,0:21:51.66,0:21:53.46,Main-207+,,0,0,0,,Hirviöitä molemmat!
Dialogue: 0,0:22:02.81,0:22:04.14,Main-207+,,0,0,0,,{\an8}Onko tuo...
Dialogue: 0,0:22:04.91,0:22:05.94,Main-207+,,0,0,0,,{\an8}minä?
Dialogue: 0,0:21:59.80,0:22:05.17,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Ei kalmot laula, puhu, ei,\Nmyös toiveet, halut kuolo vei...
Dialogue: 0,0:22:05.17,0:22:10.68,Main-207+,,0,0,0,,{\fscx125\fscy125\fnBlackadder ITC\bord3.25\shad3.25\fad(150,150)\q2}Synkillä main jossa ei variksetkaan lennä lain...
Dialogue: 0,0:22:10.68,0:22:16.19,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Sormuksia turhaan kantaa näpit luiset...
Dialogue: 0,0:22:16.19,0:22:21.92,Main-207+,,0,0,0,,{\q2\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Tääl ikiyö kun kätkee murheet maiset...
Dialogue: 0,0:22:21.92,0:22:23.93,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Etsikää!
Dialogue: 0,0:22:23.93,0:22:25.93,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Etsikää!
Dialogue: 0,0:22:25.93,0:22:30.40,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}On aarteet uponneet meikäläisen omaisuutta!
Dialogue: 0,0:22:30.40,0:22:33.87,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Mies olen maailman varakkain...
Dialogue: 0,0:22:33.87,0:22:38.54,Main-207+,,0,0,0,,{\fnBlackadder ITC\fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Kapteeni Vander Decken!
Dialogue: 0,0:22:42.61,0:22:43.35,Main-207+,,0,0,0,,Ei kai...!
Dialogue: 0,0:22:47.05,0:22:48.15,Main-207+,,0,0,0,,Merenpohjassakin?!
Dialogue: 0,0:22:55.59,0:22:57.43,Main-207+,,0,0,0,,Aavelaiva?!
Dialogue: 0,0:22:57.43,0:22:59.80,Main-207+,,0,0,0,,Mitä sä sitä säikyt!
Dialogue: 0,0:23:00.46,0:23:02.47,Main-207+,,0,0,0,,Kierähdin! Vailla syytä!
Dialogue: 0,0:23:03.33,0:23:06.40,Main-207+,,0,0,0,,{\q2}Me luultiin {\i1}sinun{\i0} olevan aave kun tavattiin!
Dialogue: 0,0:23:06.40,0:23:08.70,Main-207+,,0,0,0,,T-Tuo on aito tapaus!
Dialogue: 0,0:23:08.70,0:23:10.34,Main-207+,,0,0,0,,Katsokaa purjetta!
Dialogue: 0,0:23:11.17,0:23:14.51,Main-207+,,0,0,0,,Se on itse {\i1}Lentävä Hollantilainen{\i0}!
Dialogue: 0,0:23:14.51,0:23:17.88,Main-207+,,0,0,0,,Laiva, joka ei kuulu tähän maailmaan!
Dialogue: 0,0:23:17.88,0:23:21.75,Main-207+,,0,0,0,,Siitä on satoja vuosia.
Dialogue: 0,0:23:23.19,0:23:25.15,Main-207+,,0,0,0,,Hirmumyrskyn pauhatessa...
Dialogue: 0,0:23:25.76,0:23:28.92,Main-207+,,0,0,0,,erään merirosvolaivan\Nkapteeni tuli hulluksi
Dialogue: 0,0:23:28.92,0:23:34.16,Main-207+,,0,0,0,,ja surmasi koko miehistönsä heittäen\Nnämä yksitellen mereen!
Dialogue: 0,0:23:34.16,0:23:36.87,Main-207+,,0,0,0,,Murhatyön jälkeen hän kirosi itse jumalia!
Dialogue: 0,0:23:36.87,0:23:40.27,Main-207+,,0,0,0,,Kapteenin nimi oli Vander Decken...
Dialogue: 0,0:23:40.27,0:23:42.54,Main-207+,,0,0,0,,ja laiva oli {\i1}Lentävä Hollantilainen{\i0}!
Dialogue: 0,0:23:42.54,0:23:45.47,Main-207+,,0,0,0,,Vihastutettuaan jumalat...
Dialogue: 0,0:23:45.47,0:23:52.48,Main-207+,,0,0,0,,hän joutui harhailemaan\Nikuisesti merillä, kidutettuna...
Dialogue: 0,0:23:52.48,0:23:59.49,Main-207+,,0,0,0,,Juuri tuo alus edessämme...\NSe on Vander Deckenin kirottu laiva!
Dialogue: 0,0:24:00.29,0:24:02.73,Main-207+,,0,0,0,,Krottis, Wadatsumi!
Dialogue: 0,0:24:02.73,0:24:05.53,Main-207+,,0,0,0,,Syöty alus ei anna aarteitaan...
Dialogue: 0,0:24:05.53,0:24:07.60,Main-207+,,0,0,0,,Iske se maahan!
Dialogue: 0,0:24:09.10,0:24:10.67,Main-207+,,0,0,0,,Selevä!
Dialogue: 0,0:24:11.73,0:24:13.34,Main-207+,,0,0,0,,Meripeikko aikoo...
Dialogue: 0,0:24:13.34,0:24:15.57,Main-207+,,0,0,0,,Se on kuin onkin vihollinen!
Dialogue: 0,0:24:15.57,0:24:16.57,Main-207+,,0,0,0,,Franky!
Dialogue: 0,0:24:16.57,0:24:17.91,Main-207+,,0,0,0,,Purskejytky!
Dialogue: 0,0:24:17.91,0:24:20.61,Main-207+,,0,0,0,,Ei onnaa, viime kerta söi\Npolttoaineen loppuun!
Dialogue: 0,0:24:20.61,0:24:23.71,Main-207+,,0,0,0,,Täytyisi tankata kolaa energiahuoneessa!
Dialogue: 0,0:24:27.42,0:24:28.45,Main-207+,,0,0,0,,Ei ehdi!
Dialogue: 0,0:24:29.35,0:24:30.75,Main-207+,,0,0,0,,Eih!
Dialogue: 0,0:24:30.75,0:24:31.95,Main-207+,,0,0,0,,Ollaan mennyttä!
Dialogue: 0,0:24:45.63,0:24:47.24,Main-207+,,0,0,0,,Kraken!
Dialogue: 0,0:24:52.38,0:24:55.08,Main-207+,,0,0,0,,Kraken, "Arktinen Hirmu"?
Dialogue: 0,0:25:05.22,0:25:08.26,Main-207+,,0,0,0,,Riittää jo! Lopeta!
Dialogue: 0,0:25:14.90,0:25:15.73,Main-207+,,0,0,0,,Hyvin tehty.
Dialogue: 0,0:25:18.07,0:25:20.54,Main-207+,,0,0,0,,Ohoi!
Dialogue: 0,0:25:20.97,0:25:23.84,Main-207+,,0,0,0,,Luffy! Zoro! Sanji!
Dialogue: 0,0:25:23.84,0:25:26.61,Main-207+,,0,0,0,,Mikä onni! Te elätte!
Dialogue: 0,0:25:26.61,0:25:28.51,Main-207+,,0,0,0,,Mitä te oikein puuhasitte?!
Dialogue: 0,0:25:28.51,0:25:32.35,Main-207+,,0,0,0,,Nami-neiti! Robin-kulta!
Dialogue: 0,0:25:32.35,0:25:33.98,Main-207+,,0,0,0,,Kyllä me teitä etsittiin!
Dialogue: 0,0:25:35.79,0:25:37.79,Main-207+,,0,0,0,,Tuo sakki teettää työtä.
Dialogue: 0,0:25:38.35,0:25:39.92,Main-207+,,0,0,0,,Aina eksymässä...
Dialogue: 0,0:25:40.36,0:25:41.66,Main-207+,,0,0,0,,Noh!
Dialogue: 0,0:25:41.66,0:25:43.63,Main-207+,,0,0,0,,Ylös siitä, Wadatsumi!
Dialogue: 0,0:25:43.63,0:25:46.60,Main-207+,,0,0,0,,Vastaiskun vuoro! Kosta heille!
Dialogue: 0,0:25:49.00,0:25:54.70,Main-207+,,0,0,0,,Noh, mun ja Sanjin kuplat hajosi,\Njoten paettiin Zoron kämppään.
Dialogue: 0,0:25:55.91,0:25:57.41,Main-207+,,0,0,0,,Melkein kuoltiin!
Dialogue: 0,0:25:57.41,0:25:59.44,Main-207+,,0,0,0,,Ehdimme jo pelätä!
Dialogue: 0,0:25:59.44,0:26:01.84,Main-207+,,0,0,0,,Tässä pieni laulu paluunne kunniaksi.
Dialogue: 0,0:26:03.11,0:26:06.02,Main-207+,,0,0,0,,Onpa tilavaa! Oma koti kullan kallis!
Dialogue: 0,0:26:06.02,0:26:08.75,Main-207+,,0,0,0,,Luffy! Pelkäsin niin...!
Dialogue: 0,0:26:10.42,0:26:13.19,Main-207+,,0,0,0,,Hurja elinvoima teikäläisillä.
Dialogue: 0,0:26:13.19,0:26:14.69,Main-207+,,0,0,0,,Tolkutonta!
Dialogue: 0,0:26:14.69,0:26:18.86,Main-207+,,0,0,0,,{\q2}Kesytittekö hirviömustekalan ihan oikeasti?
Comment: 0,0:26:14.69,0:26:16.93,Main-207+,,0,0,0,,You really tamed the monster octopus?
Comment: 0,0:26:16.93,0:26:18.86,Main-207+,,0,0,0,,You really tamed the monster octopus?
Dialogue: 0,0:26:19.43,0:26:21.93,Main-207+,,0,0,0,,Aiotko käyttää krakenia johonkin?
Dialogue: 0,0:26:21.93,0:26:26.67,Main-207+,,0,0,0,,Jeah, mä haluan matkata kuin ne,\Njotka osaa asiansa!
Dialogue: 0,0:26:26.67,0:26:27.67,Main-207+,,0,0,0,,Eikö niin, Jalmari?
Dialogue: 0,0:26:27.67,0:26:30.01,Main-207+,,0,0,0,,Nimi on kuin kalmarilla, hei!
Dialogue: 0,0:26:30.41,0:26:32.41,Main-207+,,0,0,0,,Jalmari!
Dialogue: 0,0:26:32.41,0:26:37.71,Main-207+,,0,0,0,,Kraken mustekala on, mutta\NJalmariksi se silti nimettiin, ou jeah!
Dialogue: 0,0:26:37.71,0:26:40.95,Main-207+,,0,0,0,,Kas niin, aika vetää {\i1}Sunnya{\i0}, Jalmari!
Dialogue: 0,0:26:41.52,0:26:44.59,Main-207+,,0,0,0,,Noh, laivaa vetäessään...
Dialogue: 0,0:26:45.05,0:26:48.09,Main-207+,,0,0,0,,pitää varoa, ettei se murskaa sitä...
Dialogue: 0,0:26:48.09,0:26:50.36,Main-207+,,0,0,0,,Kapteeni, merirosvolaiva...
Dialogue: 0,0:26:50.36,0:26:53.20,Main-207+,,0,0,0,,Älkää päästäkö sitä pakoon! Perään!
Dialogue: 0,0:26:53.20,0:26:55.10,Main-207+,,0,0,0,,– Selvä!\N– Selvä!
Dialogue: 0,0:26:59.40,0:27:00.24,Main-207+,,0,0,0,,Mitä nyt?
Dialogue: 0,0:27:06.01,0:27:10.05,Main-207+,,0,0,0,,Nyt on piru merrassa,\Nkapteeni Vander Decken!
Dialogue: 0,0:27:13.22,0:27:14.22,Main-207+,,0,0,0,,Paha juttu!
Dialogue: 0,0:27:14.22,0:27:16.69,Main-207+,,0,0,0,,Merenalainen tulivuori on purkautumassa!
Dialogue: 0,0:27:17.29,0:27:19.59,Main-207+,,0,0,0,,– Mitäh?!\N– Mitäh?!
Comment: 0,0:27:17.29,0:27:19.59,Main-207+,,0,0,0,,{=37}===============================DIALOGUE============================
