Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=28}===============================DIALOGUE============================
Dialogue: 0,0:01:56.37,0:01:58.57,Main-207+,,0,0,0,,Sen neyden bahsediyorsun, Luffy?!
Dialogue: 0,0:01:58.57,0:02:01.67,Main-207+,,0,0,0,,O ahtapotu eğitip gemimizi çekmesini sağlayacağız!
Dialogue: 0,0:02:01.67,0:02:03.14,Main-207+,,0,0,0,,Saçmasapan konuşma!
Dialogue: 0,0:02:03.87,0:02:08.81,Main-207+,,0,0,0,,Şuna dikkatli bak! Gerçi kocaman olduğu için dikkatli bakmaya gerek yok!
Dialogue: 0,0:02:08.81,0:02:11.28,Main-207+,,0,0,0,,Oo, harbi çok büyük!
Dialogue: 0,0:02:11.28,0:02:12.72,Main-207+,,0,0,0,,Sonumuz geldi!
Dialogue: 0,0:02:13.18,0:02:15.79,Main-207+,,0,0,0,,Kesin birkaç asırdır buralarda cirit atıyordur!
Comment: 0,0:02:15.79,0:02:19.02,Main-207+,,0,0,0,,Kraken, dünyadaki pek çok efsanede adı geçen...
Comment: 0,0:02:19.02,0:02:22.29,Main-207+,,0,0,0,,olağanüstü bir yaratık!
Dialogue: 0,0:02:15.79,0:02:19.02,Main-207+,,0,0,0,,Kraken, dünyadaki pek çok efsanede adı geçen...
Dialogue: 0,0:02:19.02,0:02:22.29,Main-207+,,0,0,0,,olağanüstü bir yaratık!
Dialogue: 0,0:02:22.29,0:02:24.80,Main-207+,,0,0,0,,Onun kemiği yok...
Dialogue: 0,0:02:24.80,0:02:27.03,Main-207+,,0,0,0,,Benimse etim...
Dialogue: 0,0:02:27.77,0:02:31.00,Main-207+,,0,0,0,,Tamamen zıttım olan bir canlı.
Dialogue: 0,0:02:31.00,0:02:32.34,Main-207+,,0,0,0,,Kimin umurunda?!
Dialogue: 0,0:02:33.50,0:02:35.61,Main-207+,,0,0,0,,Bu işte epey iyisin.
Dialogue: 0,0:02:35.94,0:02:38.11,Main-207+,,0,0,0,,Sonuçta nadir gördüğün bir şey...
Dialogue: 0,0:02:38.11,0:02:39.84,Main-207+,,0,0,0,,Çizim mi? Bu ne rahatlık?!
Dialogue: 0,0:02:39.84,0:02:43.68,Main-207+,,0,0,0,,Benim için sorun değil ama bir planın var mı, Luffy?
Dialogue: 0,0:02:43.68,0:02:46.62,Main-207+,,0,0,0,,Sorun denizin altında olmamız.
Dialogue: 0,0:02:47.12,0:02:49.29,Main-207+,,0,0,0,,Hayır. Hayır. Hayır.
Dialogue: 0,0:02:49.99,0:02:52.76,Main-207+,,0,0,0,,Sorun büyüklüğü.
Dialogue: 0,0:02:52.76,0:02:54.99,Main-207+,,0,0,0,,Yüzeyde olsaydık bile işimiz yaş olurdu.
Dialogue: 0,0:02:55.63,0:02:58.46,Thoughts-207+,,0,0,0,,Nesi var lan bunların?
Dialogue: 0,0:02:58.46,0:03:04.47,Thoughts-207+,,0,0,0,,Herkesin ardına bakmadan kaçacağı türden bir durumun içindeyiz be!
Dialogue: 0,0:03:04.47,0:03:06.70,Main-207+,,0,0,0,,Dümeni hemen güneye kırın!
Dialogue: 0,0:03:07.14,0:03:09.64,Main-207+,,0,0,0,,Hey Nami, dümeni direkt ahtapota kır!
Dialogue: 0,0:03:09.64,0:03:11.14,Main-207+,,0,0,0,,Aptal mısın sen?!
Dialogue: 0,0:03:09.64,0:03:11.14,Secondary-207+,,0,0,0,,İyi dinle!
Dialogue: 0,0:03:11.14,0:03:12.94,Main-207+,,0,0,0,,O ahtapot...
Dialogue: 0,0:03:11.14,0:03:12.94,Secondary-207+,,0,0,0,,Hey, hey, Nami-{\i1}san{\i0}.
Dialogue: 0,0:03:12.94,0:03:14.55,Main-207+,,0,0,0,,Ben senin için...
Dialogue: 0,0:03:15.25,0:03:16.55,Main-207+,,0,0,0,,senin için...
Dialogue: 0,0:03:20.28,0:03:21.39,Main-207+,,0,0,0,,buradayım!
Dialogue: 0,0:03:21.39,0:03:22.95,Main-207+,,0,0,0,,Dayandın!
Dialogue: 0,0:03:22.95,0:03:24.09,Main-207+,,0,0,0,,Aferin sana!
Dialogue: 0,0:03:24.09,0:03:27.62,Main-207+,,0,0,0,,Hem uyguladığımız tedavi hem de\NNami'nin montu sağ olsun.
Dialogue: 0,0:03:27.99,0:03:31.60,Thoughts-207+,,0,0,0,,Bu gemi tehlikeli,\Nbaşımın çaresine bakmalıyım!
Dialogue: 0,0:03:32.03,0:03:33.86,Main-207+,,0,0,0,,Arkamızdan bir şey yaklaşıyor.
Dialogue: 0,0:03:36.43,0:03:38.80,Main-207+,,0,0,0,,Abi!
Dialogue: 0,0:03:38.80,0:03:39.74,Main-207+,,0,0,0,,Az önceki gemi!
Dialogue: 0,0:03:40.44,0:03:43.24,Main-207+,,0,0,0,,Coribou! Adamlarım!
Dialogue: 0,0:03:43.24,0:03:46.01,Main-207+,,0,0,0,,Abimi o gemiden çekip alacağız!
Dialogue: 0,0:03:46.01,0:03:47.21,Main-207+,,0,0,0,,– Başüstüne!\N– Başüstüne!
Dialogue: 0,0:03:47.21,0:03:51.42,Main-207+,,0,0,0,,Beni kurtarmaya mı geldiniz?!
Dialogue: 0,0:03:57.02,0:03:58.46,Main-207+,,0,0,0,,Yapma!
Dialogue: 0,0:04:01.43,0:04:03.99,Main-207+,,0,0,0,,Kabarcık patladı!
Dialogue: 0,0:04:03.99,0:04:06.56,Main-207+,,0,0,0,,O gemi Sunny'den büyüktü be!
Dialogue: 0,0:04:09.97,0:04:12.74,Main-207+,,0,0,0,,Adamlarım!
Dialogue: 0,0:04:20.44,0:04:21.71,Main-207+,,0,0,0,,Denizanası gibiler.
Dialogue: 0,0:04:21.71,0:04:24.18,Main-207+,,0,0,0,,Kapa' çeneni, Roronoa! Kes şunu!
Dialogue: 0,0:04:26.18,0:04:27.42,Main-207+,,0,0,0,,Buraya geliyor!
Dialogue: 0,0:04:30.59,0:04:32.02,Main-207+,,0,0,0,,Çok büyük!
Dialogue: 0,0:04:32.02,0:04:34.69,Main-207+,,0,0,0,,Bununla nasıl savaşacağız biz?!
Dialogue: 0,0:04:35.23,0:04:36.03,Main-207+,,0,0,0,,{\fad(150,0)}Üçüncü Vit–
Dialogue: 0,0:04:36.03,0:04:38.53,Main-207+,,0,0,0,,Durun!
Dialogue: 0,0:04:38.53,0:04:40.66,Main-207+,,0,0,0,,Kabarcığı patlatacaksınız!
Dialogue: 0,0:04:43.33,0:04:45.67,Main-207+,,0,0,0,,{\fad(150,175)}Tavuk Kaçışı!
Dialogue: 0,0:04:46.97,0:04:47.77,Main-207+,,0,0,0,,Bir şekilde... 
Dialogue: 0,0:04:48.41,0:04:49.77,Main-207+,,0,0,0,,kaçamaz mıyız şundan?!
Dialogue: 0,0:04:49.77,0:04:52.04,Main-207+,,0,0,0,,Hiçbir şey yapmayın! Onunla dövüşeceğim!
Dialogue: 0,0:04:52.04,0:04:55.31,Main-207+,,0,0,0,,Yapma, kabarcığı patlatacaksın!
Dialogue: 0,0:04:55.65,0:05:01.49,Main-207+,,0,0,0,,Dinle! İlla şu canavarla kapışacağım diyorsan bir fikrim var!
Dialogue: 0,0:05:01.49,0:05:02.05,Main-207+,,0,0,0,,Hah?
Dialogue: 0,0:05:02.49,0:05:04.35,Main-207+,,0,0,0,,Nedir? Söyle.
Dialogue: 0,0:05:05.89,0:05:07.82,Main-207+,,0,0,0,,Tamam, işte bu.
Dialogue: 0,0:05:08.33,0:05:11.33,Main-207+,,0,0,0,,Karşınızda ayak vuruşlu kaplama!
Dialogue: 0,0:05:11.33,0:05:14.03,Main-207+,,0,0,0,,Bildiğiniz dalgıç kıyafeti!
Dialogue: 0,0:05:14.73,0:05:20.84,Main-207+,,0,0,0,,İçinde olduğunuz sürece,\Nsuda dilediğiniz gibi terör estirebilirsiniz!
Dialogue: 0,0:05:21.21,0:05:25.11,Thoughts-207+,,0,0,0,,Bu salakları kendi hallerine bırakırsam\Nolan bana da olacak!
Dialogue: 0,0:05:25.11,0:05:27.41,Main-207+,,0,0,0,,Bunu yapmayacaktın yabancı!
Dialogue: 0,0:05:27.41,0:05:29.98,Main-207+,,0,0,0,,Ne güzel kaçma planları yapıyorduk!
Dialogue: 0,0:05:29.98,0:05:32.08,Main-207+,,0,0,0,,Şimdi dananın kuyruğu kopacak!
Comment: 0,0:05:32.08,0:05:38.02,Main-207+,,0,0,0,,Size ta en başından kaçalım dedim ama kaptanın dinlemedi!
Dialogue: 0,0:05:32.08,0:05:38.02,Main-207+,,0,0,0,,Size ta en başından kaçalım dedim ama kaptanın dinlemedi!
Dialogue: 0,0:05:38.56,0:05:42.66,Main-207+,,0,0,0,,Gemide dövüşmelerini mi tercih ederdin?
Dialogue: 0,0:05:42.99,0:05:44.66,Main-207+,,0,0,0,,Pekâlâ, iyi şanslar!
Dialogue: 0,0:05:44.66,0:05:45.73,Main-207+,,0,0,0,,İyice uzaklaşın!
Dialogue: 0,0:05:45.73,0:05:47.23,Main-207+,,0,0,0,,Bu halat sıkıntı.
Dialogue: 0,0:05:47.63,0:05:49.87,Main-207+,,0,0,0,,Onu gemiden uzak tut!
Dialogue: 0,0:05:49.87,0:05:51.03,Main-207+,,0,0,0,,Rahat ol.
Dialogue: 0,0:05:51.90,0:05:53.20,Main-207+,,0,0,0,,Tamam, başlayalım!
Dialogue: 0,0:05:53.54,0:05:54.04,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:05:55.84,0:05:56.77,Main-207+,,0,0,0,,Ha?
Dialogue: 0,0:05:56.77,0:05:58.48,Main-207+,,0,0,0,,Bekleyin!
Dialogue: 0,0:05:58.48,0:06:00.34,Main-207+,,0,0,0,,Halatları unuttunuz!
Dialogue: 0,0:06:00.71,0:06:02.91,Main-207+,,0,0,0,,Geri dönemeyeceksiniz!
Dialogue: 0,0:06:02.91,0:06:05.38,Main-207+,,0,0,0,,Nami-{\i1}san{\i0} hakkımda endişeleniyor!
Dialogue: 0,0:06:06.15,0:06:07.05,Main-207+,,0,0,0,,Hey!
Dialogue: 0,0:06:07.72,0:06:09.72,Main-207+,,0,0,0,,Bana zaman kazandırın!
Dialogue: 0,0:06:10.05,0:06:11.96,Main-207+,,0,0,0,,İşini okkalı bir darbeyle bitireceğim!
Dialogue: 0,0:06:12.36,0:06:15.23,Main-207+,,0,0,0,,Sen hazırlandığın sırada ben onu hallederim.
Dialogue: 0,0:06:15.23,0:06:17.19,Main-207+,,0,0,0,,Onu kesersin, olmaz!
Dialogue: 0,0:06:17.69,0:06:19.80,Main-207+,,0,0,0,,O ahtapotu evcil hayvanımız yapacağız!
Dialogue: 0,0:06:22.03,0:06:23.33,Main-207+,,0,0,0,,İyi olacaklar mı?
Dialogue: 0,0:06:23.33,0:06:24.84,Main-207+,,0,0,0,,Olabildiğince uzaklaşın!
Dialogue: 0,0:06:24.84,0:06:26.24,Main-207+,,0,0,0,,Bir milim bile kâr...
Dialogue: 0,0:06:27.97,0:06:30.04,Main-207+,,0,0,0,,Hâlâ bizi hedef alıyor!
Dialogue: 0,0:06:30.04,0:06:31.81,Main-207+,,0,0,0,,Çekilin, çocuklar!
Dialogue: 0,0:06:33.38,0:06:35.45,Main-207+,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:06:38.05,0:06:41.02,Main-207+,,0,0,0,,{\fad(150,150)}Roketatar!
Dialogue: 0,0:06:42.79,0:06:43.99,Main-207+,,0,0,0,,Dokunacı saptırdı!
Dialogue: 0,0:06:43.99,0:06:45.89,Main-207+,,0,0,0,,Çok güçlü!
Dialogue: 0,0:06:46.52,0:06:49.23,Main-207+,,0,0,0,,Bir dokunaç daha geliyor!
Dialogue: 0,0:06:49.23,0:06:50.86,Main-207+,,0,0,0,,Niye hep bize saldırıyor?!
Dialogue: 0,0:06:52.90,0:06:54.10,Main-207+,,0,0,0,,{\fad(150,150)}Gard Noktası!
Dialogue: 0,0:06:55.37,0:06:57.10,Main-207+,,0,0,0,,Fena darbe aldılar!
Dialogue: 0,0:06:58.24,0:06:59.80,Main-207+,,0,0,0,,İyi misiniz millet?
Dialogue: 0,0:07:01.14,0:07:03.54,Main-207+,,0,0,0,,U-Ucuz atlattık!
Dialogue: 0,0:07:03.54,0:07:04.64,Main-207+,,0,0,0,,Aferin sana!
Dialogue: 0,0:07:04.64,0:07:06.11,Main-207+,,0,0,0,,Harikasın Chopper!
Dialogue: 0,0:07:08.25,0:07:11.32,Main-207+,,0,0,0,,Şimdi de deniz dağına çarpacağız!
Dialogue: 0,0:07:12.22,0:07:13.32,Main-207+,,0,0,0,,{\fad(150,150)}Bin Çiçek!
Dialogue: 0,0:07:14.38,0:07:16.02,Main-207+,,0,0,0,,{\fad(150,150)}Devasa El Tokadı!
Dialogue: 0,0:07:20.99,0:07:22.83,Main-207+,,0,0,0,,Elleri kocaman!
Dialogue: 0,0:07:24.96,0:07:25.83,Main-207+,,0,0,0,,– Yaşasın!\N– Yaşasın!
Dialogue: 0,0:07:25.83,0:07:28.67,Main-207+,,0,0,0,,Harikasın Robin! Kurtulduk!
Dialogue: 0,0:07:30.17,0:07:31.44,Main-207+,,0,0,0,,Şükürler olsun.
Dialogue: 0,0:07:31.44,0:07:35.24,Main-207+,,0,0,0,,Su altında olmamıza rağmen\Nbir anlığına da olsa yapabildim.
Dialogue: 0,0:07:35.74,0:07:38.91,Main-207+,,0,0,0,,Sahne sırası bende!
Dialogue: 0,0:07:42.05,0:07:43.78,Main-207+,,0,0,0,,{\fad(150,150)}Üçüncü Vites!
Dialogue: 0,0:08:01.20,0:08:02.87,Main-207+,,0,0,0,,{\fad(150,150)}Silahlanma: Sertleştirme!
Dialogue: 0,0:08:09.74,0:08:12.94,Main-207+,,0,0,0,,Deniz bütün gücümü emiyor!
Dialogue: 0,0:08:15.58,0:08:18.68,Main-207+,,0,0,0,,Lanet ahtapot onu durdurmaya mı çalışıyor?
Dialogue: 0,0:08:19.15,0:08:20.65,Main-207+,,0,0,0,,{\fad(150,150)}Mavi Yürüyüş!
Dialogue: 0,0:08:21.08,0:08:24.45,Main-207+,,0,0,0,,Ne? Sanji-{\i1}san{\i0} kabarcığından çıktı!
Dialogue: 0,0:08:24.45,0:08:26.69,Main-207+,,0,0,0,,Onu boş ver, şu hıza bak!
Dialogue: 0,0:08:26.69,0:08:28.13,Main-207+,,0,0,0,,Balıkadam gibi!
Dialogue: 0,0:08:28.13,0:08:29.03,Main-207+,,0,0,0,,İnanılmaz!
Dialogue: 0,0:08:29.59,0:08:31.46,Thoughts-207+,,0,0,0,,Kaçtım, kaçtım...
Dialogue: 0,0:08:31.46,0:08:34.30,Thoughts-207+,,0,0,0,,İki yılımı o sevimsiz ucubelerden kaçarak geçirdim.
Dialogue: 0,0:08:34.93,0:08:38.40,Thoughts-207+,,0,0,0,,Onlara kıyasla bu şey\Nneredeyse canavar bile sayılmaz.
Dialogue: 0,0:08:38.40,0:08:40.04,Thoughts-207+,,0,0,0,,Hatta sevimli denebilir.
Dialogue: 0,0:08:40.04,0:08:42.24,Main-207+,,0,0,0,,{\fad(150,150)}Şeytan Bacağı!
Dialogue: 0,0:08:47.58,0:08:48.98,Main-207+,,0,0,0,,{\fad(150,150)}İyi Pişmiş...
Dialogue: 0,0:08:49.41,0:08:51.52,Main-207+,,0,0,0,,{\fad(150,150)}Izgara Vuruşu!
Dialogue: 0,0:09:00.52,0:09:02.73,Main-207+,,0,0,0,,{\fad(150,150)}Üç Kılıç Stili Gizli Tekniği...
Dialogue: 0,0:09:02.93,0:09:04.26,Main-207+,,0,0,0,,{\fad(150,150)}Altı Yol Kesişimi!
Comment: 0,0:09:14.34,0:09:16.94,Main-207+,,0,0,0,,Lan, Zoro! Sanji!
Dialogue: 0,0:09:14.34,0:09:16.94,Main-207+,,0,0,0,,Lan, Zoro! Sanji!
Dialogue: 0,0:09:16.94,0:09:19.44,Main-207+,,0,0,0,,Kolları olmazsa işe yaramaz!
Dialogue: 0,0:09:19.44,0:09:21.75,Main-207+,,0,0,0,,{\fad(150,150)}Lastik-Lastik...
Dialogue: 0,0:09:23.65,0:09:27.15,Main-207+,,0,0,0,,{\fad(150,150)}Fil Silahı!
Dialogue: 0,0:09:33.22,0:09:34.36,Main-207+,,0,0,0,,Onu nakavt etti!
Dialogue: 0,0:09:34.36,0:09:37.16,Main-207+,,0,0,0,,Ne kadar güçlenmiş böyle?!
Dialogue: 0,0:09:42.70,0:09:44.94,Main-207+,,0,0,0,,Bakın! Bir şey var!
Dialogue: 0,0:09:44.94,0:09:45.87,Main-207+,,0,0,0,,– Ne?\N– Hah?
Dialogue: 0,0:09:46.80,0:09:48.17,Main-207+,,0,0,0,,Köpek balığı mı?
Dialogue: 0,0:09:53.84,0:09:54.85,Main-207+,,0,0,0,,Köpek balığı mı?
Dialogue: 0,0:09:54.85,0:09:57.11,Main-207+,,0,0,0,,Kıyafet mi var üstünde?
Dialogue: 0,0:09:57.11,0:09:59.25,Main-207+,,0,0,0,,Epey büyükmüş.
Dialogue: 0,0:10:12.43,0:10:14.66,Main-207+,,0,0,0,,Aşağı giden akıntıya doğru çekildiler!
Dialogue: 0,0:10:14.66,0:10:17.20,Main-207+,,0,0,0,,Eyvah, peşlerinden gidelim! Ayrılmamalıyız!
Dialogue: 0,0:10:17.20,0:10:18.50,Main-207+,,0,0,0,,Tamam!
Dialogue: 0,0:10:21.87,0:10:24.41,Main-207+,,0,0,0,,Burada ölmek istemiyorum!
Dialogue: 0,0:10:24.41,0:10:26.04,Main-207+,,0,0,0,,Şaka mısınız siz?!
Dialogue: 0,0:10:26.04,0:10:27.04,Main-207+,,0,0,0,,Hâlâ burada mısın sen?
Dialogue: 0,0:10:27.04,0:10:27.98,Main-207+,,0,0,0,,Çok sakinsin be!
Dialogue: 0,0:10:29.65,0:10:31.01,Main-207+,,0,0,0,,Gözlerim dönüyor!
Dialogue: 0,0:10:31.01,0:10:32.62,Main-207+,,0,0,0,,Gerçi gözlerim yok.
Dialogue: 0,0:10:36.95,0:10:38.82,Main-207+,,0,0,0,,Sereni düz tutun!
Dialogue: 0,0:10:38.82,0:10:42.26,Main-207+,,0,0,0,,Gemiyi iskele tarafında döndürün,\Nyoksa kıta sahanlığına çarpacağız!
Dialogue: 0,0:10:43.09,0:10:44.26,Main-207+,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:10:44.63,0:10:47.03,Main-207+,,0,0,0,,Odaklanın yoksa geminin işi biter!
Dialogue: 0,0:10:47.03,0:10:48.00,Main-207+,,0,0,0,,Nee?!
Dialogue: 0,0:10:49.97,0:10:51.70,Main-207+,,0,0,0,,Savrulmayın!
Dialogue: 0,0:10:53.77,0:10:55.51,Main-207+,,0,0,0,,Gemiyi akıntının merkezinde tutun!
Dialogue: 0,0:10:55.97,0:10:57.04,Main-207+,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:11:01.41,0:11:03.38,Main-207+,,0,0,0,,Bu nasıl bir hız?!
Dialogue: 0,0:11:05.18,0:11:06.52,Main-207+,,0,0,0,,Çok eğlenceli!
Dialogue: 0,0:11:18.80,0:11:19.56,Main-207+,,0,0,0,,Usopp!
Dialogue: 0,0:11:20.00,0:11:22.37,Main-207+,,0,0,0,,Ay, of, of, of!
Dialogue: 0,0:11:23.63,0:11:25.77,Main-207+,,0,0,0,,Sanırım hayattayım!
Dialogue: 0,0:11:29.41,0:11:32.54,Main-207+,,0,0,0,,Ne oldu? Niye suratınız asık?
Dialogue: 0,0:11:32.54,0:11:36.28,Main-207+,,0,0,0,,Cidden, ben olmadan tamamen çaresizsiniz.
Dialogue: 0,0:11:37.51,0:11:39.98,Main-207+,,0,0,0,,Çok soğuk burası!
Dialogue: 0,0:11:40.35,0:11:42.72,Main-207+,,0,0,0,,Luffy ve diğerlerini bulamıyoruz.
Dialogue: 0,0:11:42.72,0:11:43.92,Main-207+,,0,0,0,,Ayrı düştük.
Dialogue: 0,0:11:43.92,0:11:45.52,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:11:45.52,0:11:49.23,Main-207+,,0,0,0,,Umarım deniz canavarları tarafından parçalara ayrılmamışlardır.
Dialogue: 0,0:11:49.23,0:11:51.13,Main-207+,,0,0,0,,Hayal gücün korkunç.
Comment: 0,0:11:52.00,0:11:55.47,Main-207+,,0,0,0,,Bu karanlıkta onları bulmamız mümkün değil zaten!
Dialogue: 0,0:11:52.00,0:11:55.47,Main-207+,,0,0,0,,Bu karanlıkta onları bulmamız mümkün değil zaten!
Dialogue: 0,0:11:55.47,0:11:58.20,Main-207+,,0,0,0,,Karanlığı sevmiyorum.
Dialogue: 0,0:11:58.20,0:12:01.20,Main-207+,,0,0,0,,Bir şey sizi izliyormuş gibi gelmiyor mu?
Dialogue: 0,0:12:01.20,0:12:04.21,Main-207+,,0,0,0,,7 bin metre aşağıda olmalıyız.
Dialogue: 0,0:12:04.21,0:12:08.18,Main-207+,,0,0,0,,Köpek Balığı Denizaltısı bile\Nbu derinlikteki basınca dayanamaz!
Dialogue: 0,0:12:08.18,0:12:10.68,Main-207+,,0,0,0,,Balıkadam Adası'na yakın mıyız?
Dialogue: 0,0:12:10.68,0:12:13.45,Main-207+,,0,0,0,,Belki de oraya varmışlardır...
Dialogue: 0,0:12:13.45,0:12:17.82,Main-207+,,0,0,0,,Camie-{\i1}chan{\i0} 10 bin metre derinlikte olduğunu söylemişti.
Dialogue: 0,0:12:18.46,0:12:21.56,Main-207+,,0,0,0,,Hâlâ gidecek 3 bin metre yolumuz mu var?!
Dialogue: 0,0:12:21.56,0:12:24.49,Main-207+,,0,0,0,,Küçük bir kabarcık içindeydiler!
Dialogue: 0,0:12:24.49,0:12:27.40,Main-207+,,0,0,0,,Hayatta kalsalar bile oksijenleri yetmeyecek.
Dialogue: 0,0:12:28.26,0:12:30.80,Main-207+,,0,0,0,,Bu yüzden halatları kullanın demiştim!
Dialogue: 0,0:12:30.80,0:12:33.24,Main-207+,,0,0,0,,Böyle boş boş dikilerek hiçbir yere varamayız.
Dialogue: 0,0:12:33.24,0:12:34.27,Main-207+,,0,0,0,,Arayalım onları.
Dialogue: 0,0:12:34.27,0:12:36.11,Main-207+,,0,0,0,,Işık özelliğine sahibim.
Dialogue: 0,0:12:36.11,0:12:37.51,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 0,0:12:39.01,0:12:40.54,Main-207+,,0,0,0,,Yoksa gözlerin...
Dialogue: 0,0:12:41.28,0:12:42.71,Main-207+,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:12:45.35,0:12:47.52,Main-207+,,0,0,0,,{\fad(150,0)}Meme Ucu Işığı!
Dialogue: 0,0:12:47.52,0:12:49.49,Main-207+,,0,0,0,,Niye oranda lan?!
Dialogue: 0,0:12:54.09,0:12:55.83,Main-207+,,0,0,0,,Tüyelim!
Dialogue: 0,0:13:02.93,0:13:04.30,Main-207+,,0,0,0,,Luffy!
Dialogue: 0,0:13:04.30,0:13:05.90,Main-207+,,0,0,0,,Zoro!
Dialogue: 0,0:13:05.90,0:13:07.67,Main-207+,,0,0,0,,Sanji!
Dialogue: 0,0:13:07.67,0:13:10.24,Main-207+,,0,0,0,,Nereye gittiniz?
Dialogue: 0,0:13:10.24,0:13:12.21,Main-207+,,0,0,0,,Geri dönün!
Dialogue: 0,0:13:12.54,0:13:17.58,Main-207+,,0,0,0,,Bu devasa derinlikte\NSunny'nin gözleri pek işe yaramıyor.
Dialogue: 0,0:13:17.58,0:13:20.22,Main-207+,,0,0,0,,Epey iç karartıcı.
Dialogue: 0,0:13:20.22,0:13:24.05,Main-207+,,0,0,0,,Bu karanlık daha fazla moral bozuyor.
Dialogue: 0,0:13:24.05,0:13:26.59,Main-207+,,0,0,0,,Böyle bir yere varamayız.
Dialogue: 0,0:13:27.06,0:13:29.16,Main-207+,,0,0,0,,Ne yapacağız?
Dialogue: 0,0:13:29.59,0:13:33.60,Main-207+,,0,0,0,,Gemiyi durduramayız,\Nbu yüzden gözünüzü dört açın!
Dialogue: 0,0:13:36.70,0:13:38.90,Main-207+,,0,0,0,,Ha, denizanası!
Dialogue: 0,0:13:38.90,0:13:40.87,Main-207+,,0,0,0,,Üstümüzde devasa bir denizanası var!
Dialogue: 0,0:13:40.87,0:13:42.47,Main-207+,,0,0,0,,Kocaman!
Dialogue: 0,0:13:42.47,0:13:44.07,Main-207+,,0,0,0,,Harbiden öyle!
Dialogue: 0,0:13:44.51,0:13:46.64,Main-207+,,0,0,0,,Parlıyor!
Dialogue: 0,0:13:46.64,0:13:49.35,Main-207+,,0,0,0,,Tıpkı yıldızlı gökyüzü gibi!
Dialogue: 0,0:13:50.25,0:13:51.45,Main-207+,,0,0,0,,Çok güzel!
Dialogue: 0,0:13:52.52,0:13:54.28,Main-207+,,0,0,0,,Oh, dokunaçlarından biri!
Dialogue: 0,0:13:54.85,0:13:57.05,Main-207+,,0,0,0,,B-Belki arkadaş olmak istiyordur.
Dialogue: 0,0:13:57.05,0:13:59.19,Main-207+,,0,0,0,,Sakın dokunma, Chopper!
Dialogue: 0,0:13:59.19,0:14:00.39,Main-207+,,0,0,0,,Muhtemelen zehirlidir!
Dialogue: 0,0:14:06.20,0:14:07.33,Main-207+,,0,0,0,,Eyvah!
Dialogue: 0,0:14:07.70,0:14:10.70,Main-207+,,0,0,0,,{\fad(150,150)}Hafif İtici Patlama!
Dialogue: 0,0:14:13.40,0:14:15.64,Main-207+,,0,0,0,,– N-Ne?!\N– N-Ne?!
Dialogue: 0,0:14:15.64,0:14:17.77,Main-207+,,0,0,0,,Denizanasını yedi!
Dialogue: 0,0:14:17.77,0:14:21.61,Main-207+,,0,0,0,,Oh, biraz hava kaybettik.
Dialogue: 0,0:14:21.61,0:14:23.51,Main-207+,,0,0,0,,Yenilmekten iyidir!
Dialogue: 0,0:14:23.51,0:14:24.05,Main-207+,,0,0,0,,– Ha?!\N– Ha?!
Dialogue: 0,0:14:24.38,0:14:28.38,Main-207+,,0,0,0,,İtici Patlama, yüksek miktarlarda hava kullanan bir silahdır.
Dialogue: 0,0:14:28.38,0:14:33.26,Main-207+,,0,0,0,,Suyun dibinde olduğumuz için havamız epey kısıtlı!
Dialogue: 0,0:14:33.26,0:14:36.86,Main-207+,,0,0,0,,Yani havayı dışarı püskürttüğümüzde kabarcık küçülür!
Dialogue: 0,0:14:40.50,0:14:43.17,Main-207+,,0,0,0,,Denizanasına saldıran balık nalları dikti!
Dialogue: 0,0:14:43.57,0:14:45.17,Main-207+,,0,0,0,,Düşündüğüm gibi, nörotoksin.
Dialogue: 0,0:14:45.17,0:14:46.04,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 0,0:14:46.04,0:14:48.77,Main-207+,,0,0,0,,Derin deniz korkunç! Çok da karanlık.
Dialogue: 0,0:14:49.47,0:14:51.61,Main-207+,,0,0,0,,Beyaz gözlü bir sürü balık var...
Dialogue: 0,0:14:51.61,0:14:54.44,Main-207+,,0,0,0,,Çok ürkütücüler!
Dialogue: 0,0:14:58.92,0:15:00.92,Main-207+,,0,0,0,,Derin deniz, karanlığın dünyasıdır.
Dialogue: 0,0:15:00.92,0:15:04.35,Main-207+,,0,0,0,,Bu yüzden birçok canlının gözü körelmiştir.
Dialogue: 0,0:15:06.42,0:15:08.19,Main-207+,,0,0,0,,Yani bizi göremiyorlar mı?
Dialogue: 0,0:15:09.93,0:15:11.16,Main-207+,,0,0,0,,Salak!
Dialogue: 0,0:15:11.16,0:15:12.76,Main-207+,,0,0,0,,Bana bak! Gelsene buraya!
Dialogue: 0,0:15:13.20,0:15:15.97,Main-207+,,0,0,0,,Lakin gözleri çok gelişmiş olanlar da var.
Dialogue: 0,0:15:18.67,0:15:22.81,Main-207+,,0,0,0,,Ne? Gözlerim olmadan nasıl görebildiğimi mi sordunuz?
Dialogue: 0,0:15:23.24,0:15:26.48,Main-207+,,0,0,0,,Bu işin sırrını öğrenmek ister misiniz?
Dialogue: 0,0:15:27.48,0:15:28.75,Main-207+,,0,0,0,,Cevap...
Dialogue: 0,0:15:31.98,0:15:33.48,Main-207+,,0,0,0,,Bu bir sır!
Dialogue: 0,0:15:33.92,0:15:37.19,Main-207+,,0,0,0,,Kendi kendine ne konuşuyorsun sen?
Dialogue: 0,0:15:37.19,0:15:38.56,Main-207+,,0,0,0,,Sorun değil.
Dialogue: 0,0:15:38.56,0:15:41.06,Main-207+,,0,0,0,,Yalnızlığa oldukça alışığımdır.
Dialogue: 0,0:15:41.06,0:15:43.79,Main-207+,,0,0,0,,Hey! Geyiği bırakın da gözünüzü dört açın!
Dialogue: 0,0:15:46.56,0:15:48.30,Main-207+,,0,0,0,,Ben niye dayak yedim?
Dialogue: 0,0:15:48.30,0:15:52.04,Main-207+,,0,0,0,,– Luffy! Zoro! Sanji!\N– Luffy! Zoro! Sanji!
Dialogue: 0,0:15:52.04,0:15:54.77,Main-207+,,0,0,0,,– Nereye gittiniz?\N– Nereye gittiniz?
Dialogue: 0,0:15:55.71,0:15:56.94,Main-207+,,0,0,0,,Bu?
Dialogue: 0,0:15:57.77,0:15:59.38,Main-207+,,0,0,0,,Bu halat...
Dialogue: 0,0:15:59.98,0:16:01.21,Main-207+,,0,0,0,,Millet.
Dialogue: 0,0:16:01.21,0:16:02.38,Main-207+,,0,0,0,,Ha?
Dialogue: 0,0:16:02.38,0:16:05.75,Main-207+,,0,0,0,,Şu korsan herifi göreniniz oldu mu?
Dialogue: 0,0:16:05.75,0:16:08.08,Main-207+,,0,0,0,,Doğru, o da vardı!
Dialogue: 0,0:16:08.08,0:16:10.05,Main-207+,,0,0,0,,Tamamen unutmuşum.
Dialogue: 0,0:16:10.05,0:16:11.55,Main-207+,,0,0,0,,Nereye kayboldu?
Dialogue: 0,0:16:11.55,0:16:14.72,Main-207+,,0,0,0,,Derin denize ulaştığımızdan beri onu görmedim.
Dialogue: 0,0:16:14.72,0:16:17.93,Main-207+,,0,0,0,,Belki aşağı giden akıntıda gemiden dışarı fırlamıştır.
Dialogue: 0,0:16:17.93,0:16:19.10,Main-207+,,0,0,0,,Olabilir.
Dialogue: 0,0:16:19.50,0:16:24.03,Main-207+,,0,0,0,,Eli ayağı bağlıydı, bir yere tutunamamıştır.
Dialogue: 0,0:16:24.03,0:16:25.24,Main-207+,,0,0,0,,Sanmıyorum...
Dialogue: 0,0:16:25.24,0:16:26.34,Main-207+,,0,0,0,,– Ne?\N– Ne?
Dialogue: 0,0:16:26.34,0:16:28.97,Main-207+,,0,0,0,,Halattan kurtulmuş, baksanıza.
Dialogue: 0,0:16:31.74,0:16:34.04,Main-207+,,0,0,0,,Y-Yani hâlâ güvertede mi?
Dialogue: 0,0:16:34.74,0:16:36.41,Main-207+,,0,0,0,,Nerede olabilir?!
Dialogue: 0,0:16:36.41,0:16:38.98,Main-207+,,0,0,0,,Kamarada saklanıyor olabilir.
Dialogue: 0,0:16:39.32,0:16:40.45,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:16:41.68,0:16:42.45,Main-207+,,0,0,0,,Hay...
Comment: 0,0:16:43.89,0:16:48.16,Thoughts-207+,,0,0,0,,Belki de söylediğin gibi yapıp\Nkadınların kamarasına gizlice sızmalıyım.
Dialogue: 0,0:16:43.89,0:16:48.16,Thoughts-207+,,0,0,0,,Belki de söylediğin gibi yapıp\Nkadınların kamarasına gizlice sızmalıyım.
Dialogue: 0,0:16:48.16,0:16:49.86,Main-207+,,0,0,0,,Hay sokayım!
Dialogue: 0,0:16:49.86,0:16:53.63,Main-207+,,0,0,0,,Yeterince derdimiz yokmuş gibi\Nşimdi de onunla uğraşacağız.
Dialogue: 0,0:16:54.00,0:16:55.23,Main-207+,,0,0,0,,Önemi yok!
Dialogue: 0,0:16:55.23,0:16:57.30,Main-207+,,0,0,0,,O kadar güçlü biri değildi.
Dialogue: 0,0:16:59.74,0:17:02.01,Thoughts-207+,,0,0,0,,Bu çok iyi!
Dialogue: 0,0:17:02.97,0:17:09.95,Thoughts-207+,,0,0,0,,Krakenle kapışan o belalı üçlü,\Nsırra kadem bastı.
Dialogue: 0,0:17:10.51,0:17:14.22,Thoughts-207+,,0,0,0,,Nefes almaları için ellerinde sadece o uyduruk kabarcıklar varken...
Dialogue: 0,0:17:14.22,0:17:17.12,Thoughts-207+,,0,0,0,,sağ kalmalarının imkânı yok!
Dialogue: 0,0:17:17.12,0:17:21.46,Thoughts-207+,,0,0,0,,Hasır Şapka'nın işini bitirmek bana nasip olmadı...
Dialogue: 0,0:17:22.06,0:17:31.13,Thoughts-207+,,0,0,0,,ama tayfasını deşip, kellelerini alarak\Nöldüğünü yedi düvele kanıtlayabilirim.
Dialogue: 0,0:17:33.24,0:17:36.57,Thoughts-207+,,0,0,0,,Ama acele işe şeytan karışır, Caribou!
Dialogue: 0,0:17:36.57,0:17:38.31,Thoughts-207+,,0,0,0,,Erken davranmamalısın!
Dialogue: 0,0:17:38.31,0:17:42.35,Thoughts-207+,,0,0,0,,Onları burada öldürürsen\Ngemiyi kullanacak kimse kalmaz.
Dialogue: 0,0:17:42.35,0:17:45.85,Thoughts-207+,,0,0,0,,Yön konusunda epey yetenekliler.
Dialogue: 0,0:17:46.45,0:17:49.42,Thoughts-207+,,0,0,0,,Balıkadam Adası'na ulaştığımız anda...
Dialogue: 0,0:17:50.05,0:17:53.29,Thoughts-207+,,0,0,0,,alayınızı geberteceğim!
Dialogue: 0,0:17:57.96,0:17:59.63,Main-207+,,0,0,0,,Burada!
Comment: 0,0:18:02.37,0:18:08.17,Secondary-207+,,0,0,0,,Eyvah! Hassiktir! Kahretsin!
Comment: 0,0:18:04.40,0:18:06.17,Main-207+,,0,0,0,,{\an8}Artık iyiyiz.
Comment: 0,0:18:06.17,0:18:08.17,Main-207+,,0,0,0,,{\an8}Oraya nasıl girdi ki?
Dialogue: 0,0:18:02.37,0:18:03.43,Secondary-207+,,0,0,0,,Eyvah!
Dialogue: 0,0:18:03.43,0:18:08.17,Secondary-207+,,0,0,0,,{\an8}Hassiktir! Kahretsin!
Dialogue: 0,0:18:04.40,0:18:06.17,Main-207+,,0,0,0,,Artık çıkamaz.
Dialogue: 0,0:18:06.17,0:18:08.17,Main-207+,,0,0,0,,Oraya nasıl girdi ki?
Dialogue: 0,0:18:08.74,0:18:10.37,Main-207+,,0,0,0,,Dikkatsiz davrandık.
Dialogue: 0,0:18:10.71,0:18:13.08,Main-207+,,0,0,0,,Aptal biri olmasaydı\Nbaşımız belada olabilirdi.
Dialogue: 0,0:18:13.51,0:18:16.85,Main-207+,,0,0,0,,Vücudu çamur tarzı bir şeye dönüşebiliyor.
Dialogue: 0,0:18:17.71,0:18:18.82,Main-207+,,0,0,0,,Çamur mu?
Dialogue: 0,0:18:18.82,0:18:21.65,Main-207+,,0,0,0,,Evet, kesinlikle şeytan meyvesi gücü var.
Dialogue: 0,0:18:21.65,0:18:24.05,Main-207+,,0,0,0,,Hem de logia...
Dialogue: 0,0:18:24.65,0:18:28.66,Main-207+,,0,0,0,,Sadece yakalanmış numarası yapıyormuş.
Dialogue: 0,0:18:28.66,0:18:30.16,Secondary-207+,,0,0,0,,Hey!
Dialogue: 0,0:18:30.16,0:18:33.63,Secondary-207+,,0,0,0,,Çıkar beni, bay mayo!
Dialogue: 0,0:18:34.03,0:18:36.30,Secondary-207+,,0,0,0,,Kulun kölen olurum!
Dialogue: 0,0:18:39.30,0:18:41.60,Main-207+,,0,0,0,,Ha? Ne oldu, Chopper?
Dialogue: 0,0:18:41.60,0:18:42.97,Main-207+,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:18:42.97,0:18:45.24,Main-207+,,0,0,0,,Birdenbire sıcak bastı.
Dialogue: 0,0:18:45.24,0:18:47.88,Main-207+,,0,0,0,,Sıcağa dayanamıyorum.
Dialogue: 0,0:18:48.44,0:18:49.81,Main-207+,,0,0,0,,Çok sıcak!
Dialogue: 0,0:18:49.81,0:18:50.91,Main-207+,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:18:52.15,0:18:53.88,Main-207+,,0,0,0,,B-Bu da ne?
Dialogue: 0,0:18:53.88,0:18:55.02,Main-207+,,0,0,0,,Duman mı?
Dialogue: 0,0:18:55.02,0:18:56.85,Main-207+,,0,0,0,,Görüş açımızı kapatıyor!
Dialogue: 0,0:18:58.12,0:19:01.02,Main-207+,,0,0,0,,Denizin dibinde duman mı? Nasıl?
Dialogue: 0,0:19:01.46,0:19:02.59,Main-207+,,0,0,0,,Bu...
Dialogue: 0,0:19:03.66,0:19:04.23,Main-207+,,0,0,0,,Yoksa...
Dialogue: 0,0:19:10.57,0:19:12.07,Main-207+,,0,0,0,,Sıcak su yatakları!
Dialogue: 0,0:19:12.07,0:19:13.07,Main-207+,,0,0,0,,Ha?!
Dialogue: 0,0:19:13.07,0:19:15.57,Main-207+,,0,0,0,,Burası volkanik bir bölge!
Dialogue: 0,0:19:15.57,0:19:16.27,Main-207+,,0,0,0,,Ne?!
Dialogue: 0,0:19:16.71,0:19:18.98,Main-207+,,0,0,0,,Bakın, aktif hâldeler.
Dialogue: 0,0:19:19.98,0:19:21.54,Main-207+,,0,0,0,,Buradan çıkmalıyız!
Dialogue: 0,0:19:21.98,0:19:24.25,Main-207+,,0,0,0,,Biri bile patlarsa işimiz biter!
Dialogue: 0,0:19:24.81,0:19:27.48,Main-207+,,0,0,0,,Sıcak... çok sıcak!
Dialogue: 0,0:19:30.69,0:19:32.29,Main-207+,,0,0,0,,Peşimizden bir şey geliyor!
Dialogue: 0,0:19:32.29,0:19:34.09,Main-207+,,0,0,0,,Etcil tüp solucanları!
Dialogue: 0,0:19:34.66,0:19:35.89,Main-207+,,0,0,0,,Başka seçeneğimiz yok.
Dialogue: 0,0:19:35.89,0:19:38.36,Main-207+,,0,0,0,,{\fad(150,150)}Hafif İtici Patlama!
Dialogue: 0,0:19:41.86,0:19:44.33,Main-207+,,0,0,0,,Yüzsüz yengeçler!
Dialogue: 0,0:19:44.33,0:19:46.57,Main-207+,,0,0,0,,{\fad(150,150)}Hafif İtici Patlama!
Dialogue: 0,0:19:48.04,0:19:50.11,Main-207+,,0,0,0,,Bunların ne olduğunu bile bilmiyorum!
Dialogue: 0,0:19:50.11,0:19:53.14,Main-207+,,0,0,0,,{\fad(150,150)}Hafif İtici Patlama!
Dialogue: 0,0:19:53.14,0:19:55.28,Main-207+,,0,0,0,,Derin deniz korkunç!
Dialogue: 0,0:19:56.18,0:20:00.22,Main-207+,,0,0,0,,Luffylerin burada sağ olmasına imkân yok!
Dialogue: 0,0:20:00.22,0:20:02.05,Main-207+,,0,0,0,,Çok üzgünüm.
Dialogue: 0,0:20:02.05,0:20:04.15,Main-207+,,0,0,0,,İki yıl sonra tekrar buluşmuştuk oysaki.
Dialogue: 0,0:20:04.15,0:20:07.12,Main-207+,,0,0,0,,Saçmasapan konuşma!\NO kadar kolay ölmezler!
Dialogue: 0,0:20:07.56,0:20:12.70,Main-207+,,0,0,0,,Arka arkaya İtici Patlama kullandık...\NFazla havamız kalmadı.
Dialogue: 0,0:20:16.40,0:20:17.73,Main-207+,,0,0,0,,O da ne?
Dialogue: 0,0:20:17.73,0:20:19.24,Main-207+,,0,0,0,,Çok parlak!
Dialogue: 0,0:20:20.47,0:20:22.47,Main-207+,,0,0,0,,Belki de Balıkadam Adası'dır!
Dialogue: 0,0:20:22.47,0:20:24.71,Main-207+,,0,0,0,,Acaba Luffyler orada mıdır?
Dialogue: 0,0:20:24.71,0:20:27.41,Main-207+,,0,0,0,,Daha üç kilometre dalmadık.
Dialogue: 0,0:20:27.41,0:20:30.48,Main-207+,,0,0,0,,{\fnFOT-KafuTechno Std E Strp\b1}Sen de kim-sin?
Dialogue: 0,0:20:30.48,0:20:31.41,Main-207+,,0,0,0,,Hey!
Dialogue: 0,0:20:31.41,0:20:33.92,Main-207+,,0,0,0,,O sinyalleri nasıl gönderiyorsun öyle?!
Dialogue: 0,0:20:34.38,0:20:35.52,Main-207+,,0,0,0,,Var mı bir şey?
Dialogue: 0,0:20:35.52,0:20:37.95,Main-207+,,0,0,0,,Hâlâ çok parlak.
Dialogue: 0,0:20:41.06,0:20:42.49,Main-207+,,0,0,0,,Olamaz!
Dialogue: 0,0:20:45.23,0:20:48.03,Main-207+,,0,0,0,,Fener balığıymış! Bizi kandırdı!
Dialogue: 0,0:20:48.43,0:20:51.13,Main-207+,,0,0,0,,Derin deniz avcısı tarafından tuzağa düşürüldük! Eyvah!
Dialogue: 0,0:20:54.87,0:20:56.44,Main-207+,,0,0,0,,Ucuz atlattık!
Dialogue: 0,0:20:56.44,0:20:58.88,Main-207+,,0,0,0,,Bizi direkt tuzağına çekti!
Dialogue: 0,0:20:58.88,0:21:00.68,Main-207+,,0,0,0,,Kaçabilecek miyiz?
Dialogue: 0,0:21:06.75,0:21:08.55,Main-207+,,0,0,0,,Bi' rahat verin be?!
Dialogue: 0,0:21:08.55,0:21:09.99,Main-207+,,0,0,0,,İ-İnsan mı?!
Dialogue: 0,0:21:09.99,0:21:11.92,Main-207+,,0,0,0,,O da ne öyle?!
Dialogue: 0,0:21:11.92,0:21:16.19,Main-207+,,0,0,0,,Bildiğim insan şekline sahip tek bir deniz canavarı var!
Dialogue: 0,0:21:17.33,0:21:21.10,Main-207+,,0,0,0,,Umibōzu!
Dialogue: 0,0:21:24.63,0:21:27.54,Main-207+,,0,0,0,,Gemiyi alabora edecek!
Dialogue: 0,0:21:30.81,0:21:31.54,Main-207+,,0,0,0,,Ona mı vurdu?!
Dialogue: 0,0:21:32.04,0:21:34.14,Main-207+,,0,0,0,,Hey, Ankoro!
Dialogue: 0,0:21:34.14,0:21:35.81,Main-207+,,0,0,0,,Bunu yapamazsın!
Dialogue: 0,0:21:36.65,0:21:38.68,Main-207+,,0,0,0,,Gemileri yemek yok!
Dialogue: 0,0:21:39.08,0:21:41.28,Main-207+,,0,0,0,,Daha kaç kere söylemem gerek?
Dialogue: 0,0:21:41.98,0:21:45.59,Main-207+,,0,0,0,,Kaptan Vander Decken-{\i1}sama{\i0} sana çok kızacak!
Dialogue: 0,0:21:45.96,0:21:48.39,Main-207+,,0,0,0,,B-Bizi kurtardı mı?
Dialogue: 0,0:21:49.29,0:21:51.66,Main-207+,,0,0,0,,T-Tüyelim hemen! Ne olduğu kimin umrunda?
Dialogue: 0,0:21:51.66,0:21:53.46,Main-207+,,0,0,0,,İkisi de canavar!
Dialogue: 0,0:22:02.81,0:22:04.14,Main-207+,,0,0,0,,{\an8}Yoksa o...
Dialogue: 0,0:22:04.91,0:22:05.94,Main-207+,,0,0,0,,{\an8}ben miyim?
Dialogue: 0,0:21:59.80,0:22:05.17,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Ölüler konuşmaz ve açgözlülük etmez.
Dialogue: 0,0:22:05.17,0:22:10.68,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Kargaların bile uçmadığı bu kapkara dünyada,
Dialogue: 0,0:22:10.68,0:22:16.19,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}ölülerin parmaklarında mücevherlere ihtiyaç yoktur.
Dialogue: 0,0:22:16.19,0:22:21.92,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{\q2fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Zifiri karanlıkta kimsenin kederi göze çarpmaz.
Dialogue: 0,0:22:21.92,0:22:23.93,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Arayın!
Dialogue: 0,0:22:23.93,0:22:25.93,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Arayın!
Dialogue: 0,0:22:25.93,0:22:30.40,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Denizin yuttuğu hazineler benimdir!
Dialogue: 0,0:22:30.40,0:22:33.87,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Ben dünyanın en zengin adamı,
Dialogue: 0,0:22:33.87,0:22:38.54,Main-207+,,0,0,0,,{\fnCalligraph421 BT}{fscx125\fscy125\bord3.25\shad3.25\fad(150,150)}Kaptan Vander Decken'im!
Dialogue: 0,0:22:42.61,0:22:43.35,Main-207+,,0,0,0,,Olamaz...
Dialogue: 0,0:22:47.05,0:22:48.15,Main-207+,,0,0,0,,Denizin dibinde de mi?!
Dialogue: 0,0:22:55.59,0:22:57.43,Main-207+,,0,0,0,,Hayalet gemi!
Dialogue: 0,0:22:57.43,0:22:59.80,Main-207+,,0,0,0,,Sen niye korkuyorsun be?!
Dialogue: 0,0:23:00.46,0:23:02.47,Main-207+,,0,0,0,,Döndüm! Sebepsiz yere.
Dialogue: 0,0:23:03.33,0:23:06.40,Main-207+,,0,0,0,,O zaman gerçekten hayalet olduğunu düşünmüştük!
Dialogue: 0,0:23:06.40,0:23:08.70,Main-207+,,0,0,0,,B-Bu gerçek!
Dialogue: 0,0:23:08.70,0:23:10.34,Main-207+,,0,0,0,,Yelkenine bakın!
Dialogue: 0,0:23:11.17,0:23:14.51,Main-207+,,0,0,0,,Meşhur Uçan Hollandalı!
Dialogue: 0,0:23:14.51,0:23:17.88,Main-207+,,0,0,0,,O gemi bu dünyaya ait değil!
Dialogue: 0,0:23:17.88,0:23:21.75,Main-207+,,0,0,0,,Yüzlerce yıl öncesinden hikâyesi var.
Dialogue: 0,0:23:23.19,0:23:25.15,Main-207+,,0,0,0,,Fırtınalı bir günde...
Dialogue: 0,0:23:25.76,0:23:28.92,Main-207+,,0,0,0,,geminin kaptanı aniden cinnet geçirmiş...
Dialogue: 0,0:23:28.92,0:23:34.16,Main-207+,,0,0,0,,ve bütün tayfayı hırçın sulara atarak öldürmüş.
Dialogue: 0,0:23:34.16,0:23:36.87,Main-207+,,0,0,0,,Tanrılara bile lanet okumuş!
Dialogue: 0,0:23:36.87,0:23:40.27,Main-207+,,0,0,0,,Kaptanın adı Vander Decken...
Dialogue: 0,0:23:40.27,0:23:42.54,Main-207+,,0,0,0,,geminin adı da Uçan Hollandalı'ymış!
Dialogue: 0,0:23:42.54,0:23:45.47,Main-207+,,0,0,0,,Tanrıların gazabına uğramış...
Dialogue: 0,0:23:45.47,0:23:52.48,Main-207+,,0,0,0,,ve sonsuz bir işkenceyle ebediyen denizlerde sürüklenmeye mahkûm edilmiş!
Dialogue: 0,0:23:52.48,0:23:59.49,Main-207+,,0,0,0,,İşte karşımızda duran bu gemi, hikâyemizin baş kahramanı olan Vander Decken'a ait!
Dialogue: 0,0:24:00.29,0:24:02.73,Main-207+,,0,0,0,,Ankoro! Wadatsumi!
Dialogue: 0,0:24:02.73,0:24:05.53,Main-207+,,0,0,0,,Gemiyi yerseniz hazineyi alamayız!
Dialogue: 0,0:24:05.53,0:24:07.60,Main-207+,,0,0,0,,Sadece ezin!
Dialogue: 0,0:24:09.10,0:24:10.67,Main-207+,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:24:11.73,0:24:13.34,Main-207+,,0,0,0,,Ahh! Umibozu...
Dialogue: 0,0:24:13.34,0:24:15.57,Main-207+,,0,0,0,,Demek gerçekten düşman!
Dialogue: 0,0:24:15.57,0:24:16.57,Main-207+,,0,0,0,,Franky!
Dialogue: 0,0:24:16.57,0:24:17.91,Main-207+,,0,0,0,,İtici Patlama'yı kullan!
Dialogue: 0,0:24:17.91,0:24:20.61,Main-207+,,0,0,0,,Yapamam! Hiç yakıtımız kalmadı!
Dialogue: 0,0:24:20.61,0:24:23.71,Main-207+,,0,0,0,,Enerji odasına gidip kola ikmali yapmalıyım!
Dialogue: 0,0:24:27.42,0:24:28.45,Main-207+,,0,0,0,,Vaktimiz yok!
Dialogue: 0,0:24:29.35,0:24:30.75,Main-207+,,0,0,0,,Hayır!
Dialogue: 0,0:24:30.75,0:24:31.95,Main-207+,,0,0,0,,Öldürüleceğiz!
Dialogue: 0,0:24:45.63,0:24:47.24,Main-207+,,0,0,0,,Kraken!
Dialogue: 0,0:24:52.38,0:24:55.08,Main-207+,,0,0,0,,Kuzey Kutbu Canavarı Kraken mi?
Dialogue: 0,0:25:05.22,0:25:08.26,Main-207+,,0,0,0,,Hey, bu kadarı yeter! Kes şunu!
Dialogue: 0,0:25:14.90,0:25:15.73,Main-207+,,0,0,0,,Aferin sana!
Dialogue: 0,0:25:18.07,0:25:20.54,Main-207+,,0,0,0,,Heeey!
Dialogue: 0,0:25:20.97,0:25:23.84,Main-207+,,0,0,0,,Luffy! Zoro! Sanji!
Dialogue: 0,0:25:23.84,0:25:26.61,Main-207+,,0,0,0,,Çok şükür, hayattasınız!
Dialogue: 0,0:25:26.61,0:25:28.51,Main-207+,,0,0,0,,Ne halt ediyordunuz siz?!
Dialogue: 0,0:25:28.51,0:25:32.35,Main-207+,,0,0,0,,Nami-{\i1}swan{\i0}! Robin-{\i1}chwan{\i0}!
Dialogue: 0,0:25:32.35,0:25:33.98,Main-207+,,0,0,0,,Sizi her yerde aradık!
Dialogue: 0,0:25:35.79,0:25:37.79,Main-207+,,0,0,0,,Bize çok sorun çıkardıkları kesin.
Dialogue: 0,0:25:38.35,0:25:39.92,Main-207+,,0,0,0,,Bizden ayrıldılar.
Dialogue: 0,0:25:40.36,0:25:41.66,Main-207+,,0,0,0,,Hey!
Dialogue: 0,0:25:41.66,0:25:43.63,Main-207+,,0,0,0,,Uyan, Wadatsumi!
Dialogue: 0,0:25:43.63,0:25:46.60,Main-207+,,0,0,0,,İntikam zamanı! Bitir işlerini!
Dialogue: 0,0:25:49.00,0:25:54.70,Main-207+,,0,0,0,,Sanji'yle benim kabarcık patlayınca\Nmecburen Zoro'nunkine daldık!
Dialogue: 0,0:25:55.91,0:25:57.41,Main-207+,,0,0,0,,Neredeyse ölüyorduk!
Dialogue: 0,0:25:57.41,0:25:59.44,Main-207+,,0,0,0,,Bizi böyle endişelendirmeyin!
Dialogue: 0,0:25:59.44,0:26:01.84,Main-207+,,0,0,0,,Dönüşünüzün şerefine\Nsize bir şarkı patlatayım!
Dialogue: 0,0:26:03.11,0:26:06.02,Main-207+,,0,0,0,,Nihayet geniş bir yer! İnsanın evi gibisi yok!
Dialogue: 0,0:26:06.02,0:26:08.75,Main-207+,,0,0,0,,Luffy! Çok endişelendim!
Dialogue: 0,0:26:10.42,0:26:13.19,Main-207+,,0,0,0,,Yedi canlısınız resmen!
Dialogue: 0,0:26:13.19,0:26:14.69,Main-207+,,0,0,0,,İnanılmaz!
Comment: 0,0:26:14.69,0:26:18.86,Main-207+,,0,0,0,,Cidden onu evcilleştirdin mi?!\NŞu canavarımsı ahtapotu?!
Dialogue: 0,0:26:14.69,0:26:16.93,Main-207+,,0,0,0,,Cidden onu evcilleştirdin mi?!
Dialogue: 0,0:26:16.93,0:26:18.86,Main-207+,,0,0,0,,Şu canavarımsı ahtapotu?!
Dialogue: 0,0:26:19.43,0:26:21.93,Main-207+,,0,0,0,,Demek artık Kraken'i kullanacaksın.
Dialogue: 0,0:26:21.93,0:26:26.67,Main-207+,,0,0,0,,Evet, tıpkı bir profesyonel gibi yol alacağız!
Dialogue: 0,0:26:26.67,0:26:27.67,Main-207+,,0,0,0,,Değil mi Surume?
Dialogue: 0,0:26:27.67,0:26:30.01,Main-207+,,0,0,0,,Neden ona kalamar adı verdin?!
Dialogue: 0,0:26:30.41,0:26:32.41,Main-207+,,0,0,0,,Surume!
Dialogue: 0,0:26:32.41,0:26:37.71,Main-207+,,0,0,0,,Kraken ahtapot olsa da\Nona Surume adını vermiş, oh yeah!
Dialogue: 0,0:26:37.71,0:26:40.95,Main-207+,,0,0,0,,Hadi Sunny'yi çek Surume!
Dialogue: 0,0:26:41.52,0:26:44.59,Main-207+,,0,0,0,,Aslında yaptığına\Ntam olarak "çekmek" denemez.
Dialogue: 0,0:26:45.05,0:26:48.09,Main-207+,,0,0,0,,Bizi ezmeyecek kadar dikkatli olduğunu umalım.
Dialogue: 0,0:26:48.09,0:26:50.36,Main-207+,,0,0,0,,Kaptan, şu korsan gemisi...
Dialogue: 0,0:26:50.36,0:26:53.20,Main-207+,,0,0,0,,Kaçamazlar! Peşlerinden gidiyoruz!
Dialogue: 0,0:26:53.20,0:26:55.10,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 0,0:26:59.40,0:27:00.24,Main-207+,,0,0,0,,Ne oluyor?
Dialogue: 0,0:27:06.01,0:27:10.05,Main-207+,,0,0,0,,Durum kötü, Kaptan Vander Decken!
Dialogue: 0,0:27:13.22,0:27:14.22,Main-207+,,0,0,0,,Eyvah!
Dialogue: 0,0:27:14.22,0:27:16.69,Main-207+,,0,0,0,,Deniz altı volkanları patlamak üzere!
Dialogue: 0,0:27:17.29,0:27:19.59,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Comment: 0,0:00:00.00,0:00:00.00,Main-207+,,0,0,0,,{=29}===============================DIALOGUE============================
