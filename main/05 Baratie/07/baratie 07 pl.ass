Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=26}===============================DIALOGUE============================
Dialogue: 0,0:01:50.01,0:01:51.47,Main-207- PL,,0,0,0,,Hej, przydupasie!
Dialogue: 0,0:01:51.47,0:01:52.51,Main-207- PL,,0,0,0,,Trzymaj się!
Dialogue: 0,0:01:52.51,0:01:53.76,Main-207- PL,,0,0,0,,No już, oddychaj!
Dialogue: 0,0:01:53.76,0:01:55.51,Main-207- PL,,0,0,0,,Zaciągnij sobie powietrza!
Dialogue: 0,0:01:55.51,0:01:57.76,Main-207- PL,,0,0,0,,Żyjesz? Hej!
Dialogue: 0,0:01:57.76,0:02:00.14,Main-207- PL,,0,0,0,,Może chcesz trochę wody? Hej!
Dialogue: 0,0:02:01.81,0:02:03.19,Main-207- PL,,0,0,0,,Nie wygląda to dobrze.
Dialogue: 0,0:02:03.19,0:02:05.44,Main-207- PL,,0,0,0,,A co powiesz na mój specjalny budyń?
Dialogue: 0,0:02:05.44,0:02:06.15,Main-207- PL,,0,0,0,,Dobry jest!
Dialogue: 0,0:02:06.15,0:02:09.57,Main-207- PL,,0,0,0,,Głupku! Co ty? Chcesz\Notruć już otrutego faceta?!
Dialogue: 0,0:02:09.57,0:02:11.28,Main-207- PL,,0,0,0,,Ej, co to ma niby znaczyć?!
Dialogue: 0,0:02:11.28,0:02:13.07,Main-207- PL,,0,0,0,,Jakbyś ty był lepszy!
Dialogue: 0,0:02:13.07,0:02:14.07,Main-207- PL,,0,0,0,,Co żeś powiedział?!
Dialogue: 0,0:02:14.07,0:02:16.70,Main-207- PL,,0,0,0,,Moje potrawy mięsne\Nsmakują każdemu!
Dialogue: 0,0:02:16.70,0:02:19.24,Main-207- PL,,0,0,0,,Klienci są po nich wniebowzięci!
Dialogue: 0,0:02:19.87,0:02:21.12,Main-207- PL,,0,0,0,,Nie umieraj nam tu!
Dialogue: 0,0:02:23.87,0:02:26.75,Main-207- PL,,0,0,0,,J-Jak rozstrzygnie się ta bójka?
Dialogue: 0,0:02:26.75,0:02:28.84,Main-207- PL,,0,0,0,,Deklu! To był zwykły fart!
Dialogue: 0,0:02:28.84,0:02:31.84,Main-207- PL,,0,0,0,,Przecież Don nigdy by nie przegrał\Nz takim gnojkiem!
Dialogue: 0,0:02:31.84,0:02:33.22,Main-207- PL,,0,0,0,,Nie ma co się martwić!
Dialogue: 0,0:02:33.22,0:02:34.63,Main-207- PL,,0,0,0,,Majtek...
Dialogue: 0,0:02:36.30,0:02:41.27,Main-207- PL,,0,0,0,,„Nie umrę w takim miejscu”... powiadasz?{BT 07 - 26:05}
Dialogue: 0,0:02:44.27,0:02:47.69,Main-207- PL,,0,0,0,,Skoro ty tutaj nie umrzesz...
Dialogue: 0,0:02:47.69,0:02:49.65,Main-207- PL,,0,0,0,,to powiedz mi...
Dialogue: 0,0:02:50.23,0:02:52.69,Main-207- PL,,0,0,0,,Kto tu niby umrze?!
Dialogue: 0,0:02:54.15,0:02:55.66,Main-207- PL,,0,0,0,,Oczywiście, że ty!
Dialogue: 0,0:02:57.37,0:02:59.37,Main-207- PL,,0,0,0,,A właśnie, że {\i1}ty{\i0}!
Dialogue: 0,0:03:03.41,0:03:05.42,Main-207- PL,,0,0,0,,Don znów leży na deskach!
Dialogue: 0,0:03:05.42,0:03:08.00,Main-207- PL,,0,0,0,,Co tu się wyprawia?!
Dialogue: 0,0:03:08.54,0:03:14.51,Main-207- PL,,0,0,0,,D-Do tej pory nasi wrogowie umierali,\Nzanim zdążyli zbliżyć się do Dona...
Dialogue: 0,0:03:14.97,0:03:17.30,Main-207- PL,,0,0,0,,Don był przecież nietykalny...
Dialogue: 0,0:03:17.30,0:03:18.39,Main-207- PL,,0,0,0,,On...
Dialogue: 0,0:03:20.22,0:03:22.39,Main-207- PL,,0,0,0,,Kim on do cholery jest?!
Dialogue: 0,0:03:24.56,0:03:26.98,Main-207- PL,,0,0,0,,Ma skurczybyk krzepę!
Dialogue: 0,0:03:26.98,0:03:29.52,Main-207- PL,,0,0,0,,Tak. Aż brak mi słów...
Dialogue: 0,0:03:29.52,0:03:30.77,Main-207- PL,,0,0,0,,Dobry jest!
Dialogue: 0,0:03:30.77,0:03:32.36,Main-207- PL,,0,0,0,,Pokaż temu Kriegowi!
Dialogue: 0,0:03:32.36,0:03:34.69,Main-207- PL,,0,0,0,,Właśnie, poradzi sobie!
Dialogue: 0,0:03:34.69,0:03:38.07,Main-207- PL,,0,0,0,,Bez jaj. Gnojek walczy\Nz Donem jak równy z równym...
Dialogue: 0,0:03:38.07,0:03:41.24,Main-207- PL,,0,0,0,,To jakiś sen? Ktoś taki\Nnie dałby rady Donowi...
Dialogue: 0,0:03:41.24,0:03:43.08,Main-207- PL,,0,0,0,,Przecież Don jest nietykalny!
Dialogue: 0,0:03:43.08,0:03:46.21,Main-207- PL,,0,0,0,,W tym tempie legenda\No potędze Don Kriega legnie...
Dialogue: 0,0:03:46.21,0:03:48.67,Main-207- PL,,0,0,0,,Natychmiast przestańcie\Npaplać takie bzdury!
Dialogue: 0,0:03:56.84,0:03:58.09,Main-207- PL,,0,0,0,,Co jest...?
Dialogue: 0,0:03:59.05,0:04:01.35,Main-207- PL,,0,0,0,,N-Nareszcie...
Dialogue: 0,0:04:01.35,0:04:03.56,Main-207- PL,,0,0,0,,Najpotężniejsza broń Don Kriega...
Dialogue: 0,0:04:03.56,0:04:05.06,Main-207- PL,,0,0,0,,Wielka Włócznia Bojowa!
Dialogue: 0,0:04:06.23,0:04:07.48,Main-207- PL,,0,0,0,,A to co?
Dialogue: 0,0:04:07.48,0:04:08.73,Main-207- PL,,0,0,0,,Tak sobie wybuchło.
Dialogue: 0,0:04:09.15,0:04:10.65,Main-207- PL,,0,0,0,,No dobrze...
Dialogue: 0,0:04:10.65,0:04:13.40,Main-207- PL,,0,0,0,,Zobaczmy, jak długo\Ndasz radę uciekać.
Dialogue: 0,0:04:13.40,0:04:16.28,Main-207- PL,,0,0,0,,To będzie nie lada\Nwidowisko, topielcu.
Dialogue: 0,0:04:16.65,0:04:21.03,Main-207- PL,,0,0,0,,Być może i wytrzymałeś spotkanie\Nz kilkoma małymi włóczniami,
Dialogue: 0,0:04:21.03,0:04:24.74,Main-207- PL,,0,0,0,,ale Wielka Włócznia Bojowa\Nto zupełnie inna liga.
Dialogue: 0,0:04:25.54,0:04:27.75,Main-207- PL,,0,0,0,,Jedno dotknięcie\Nrozerwie cię na strzępy!
Dialogue: 0,0:04:30.42,0:04:32.38,Main-207- PL,,0,0,0,,C-Co to ma być za włócznia?!
Dialogue: 0,0:04:33.84,0:04:35.80,Main-207- PL,,0,0,0,,Tylko nie spaść, tylko nie spaść!
Dialogue: 0,0:04:36.30,0:04:38.13,Main-207- PL,,0,0,0,,C-Co jest z tą włócznią?!
Dialogue: 0,0:04:38.13,0:04:40.76,Main-207- PL,,0,0,0,,Wybucha przy każdym uderzeniu?
Dialogue: 0,0:04:42.35,0:04:44.47,Main-207- PL,,0,0,0,,Co jest? Moje kolana...
Dialogue: 0,0:04:46.56,0:04:48.81,Main-207- PL,,0,0,0,,Będzie kiepsko,\Njeśli walka się przeciągnie.
Dialogue: 0,0:04:48.81,0:04:50.44,Main-207- PL,,0,0,0,,Stracił za dużo krwi.
Dialogue: 0,0:04:50.85,0:04:52.52,Main-207- PL,,0,0,0,,Długo tak nie pociągnie...
Dialogue: 0,0:04:52.52,0:04:55.02,Main-207- PL,,0,0,0,,Za bardzo się przeforsowałeś.
Dialogue: 0,0:04:55.02,0:04:58.49,Main-207- PL,,0,0,0,,Lada moment i opuści cię resztka sił.
Dialogue: 0,0:04:58.49,0:04:59.99,Main-207- PL,,0,0,0,,Cholera...
Dialogue: 0,0:04:59.99,0:05:03.49,Main-207- PL,,0,0,0,,Ciężko będzie pójść na całość,\Ngdy wszystko się tak chwieje.
Dialogue: 0,0:05:03.49,0:05:04.99,Main-207- PL,,0,0,0,,No to po ptokach.
Dialogue: 0,0:05:04.99,0:05:09.25,Main-207- PL,,0,0,0,,Wielka Włócznia Bojowa\Njak zwykle zaskakuje.
Dialogue: 0,0:05:09.83,0:05:14.09,Main-207- PL,,0,0,0,,Tak, w końcu im mocniej\Nrąbniesz tą wielką włócznią,
Dialogue: 0,0:05:14.09,0:05:16.34,Main-207- PL,,0,0,0,,tym większy będzie jej wybuch.
Dialogue: 0,0:05:16.34,0:05:19.67,Main-207- PL,,0,0,0,,Nikt poza Donem nie zdołałby\Nwładać taką bronią!
Dialogue: 0,0:05:25.89,0:05:28.89,Main-207- PL,,0,0,0,,Ale jego siła...
Dialogue: 0,0:05:28.89,0:05:31.52,Main-207- PL,,0,0,0,,Z łatwością wymachiwać taką włócznią...
Dialogue: 0,0:05:31.52,0:05:35.52,Main-207- PL,,0,0,0,,{\q2}Razem z tymi naramiennikami\Ncałość waży przynajmniej tonę!
Dialogue: 0,0:05:35.94,0:05:39.61,Main-207- PL,,0,0,0,,Właśnie ta siła sprawia,\Nże Don nie ma sobie równych!
Comment: 0,0:05:45.78,0:05:46.99,Main-207-,,0,0,0,,Whoa...
Dialogue: 0,0:05:46.99,0:05:47.95,Main-207- PL,,0,0,0,,A masz!
Dialogue: 0,0:05:51.96,0:05:53.25,Main-207- PL,,0,0,0,,Zdychaj!
Dialogue: 0,0:05:54.21,0:05:55.17,Main-207- PL,,0,0,0,,Majtku!
Dialogue: 0,0:05:58.63,0:05:59.84,Main-207- PL,,0,0,0,,Blisko było.
Dialogue: 0,0:06:03.43,0:06:05.05,Main-207- PL,,0,0,0,,Ty mały...
Dialogue: 0,0:06:05.05,0:06:07.14,Main-207- PL,,0,0,0,,parszywy robalu!
Dialogue: 0,0:06:17.61,0:06:18.82,Main-207- PL,,0,0,0,,Majtku!
Dialogue: 0,0:06:33.08,0:06:34.54,Main-207- PL,,0,0,0,,Majtek...
Dialogue: 0,0:06:36.21,0:06:37.59,Main-207- PL,,0,0,0,,To jeszcze nie koniec.
Dialogue: 0,0:06:37.59,0:06:40.05,Main-207- PL,,0,0,0,,Nieźle mnie wnerwiłeś.
Dialogue: 0,0:06:40.05,0:06:42.26,Main-207- PL,,0,0,0,,Nie licz na bezbolesną śmierć.
Dialogue: 0,0:06:42.59,0:06:43.76,Main-207- PL,,0,0,0,,Cholera!
Dialogue: 0,0:06:43.76,0:06:47.26,Main-207- PL,,0,0,0,,Ten przeklęty Krieg chyba\Nma przy sobie cały arsenał...
Dialogue: 0,0:06:47.26,0:06:49.22,Main-207- PL,,0,0,0,,Nie ma opcji, żeby ten majtek...
Dialogue: 0,0:06:49.22,0:06:52.85,Main-207- PL,,0,0,0,,Jego ciało może ranić nawet\Nsetka najróżniejszych broni.
Dialogue: 0,0:06:52.85,0:06:57.15,Main-207- PL,,0,0,0,,Żadna z nich nie będzie równie silna,\Nco włócznia jego ślepej determinacji.
Dialogue: 0,0:07:14.08,0:07:15.16,Main-207- PL,,0,0,0,,To była pestka...
Dialogue: 0,0:07:25.63,0:07:28.14,Main-207- PL,,0,0,0,,Zasłużyłeś sobie,\Nabym zrobił z ciebie miazgę.
Dialogue: 0,0:07:36.48,0:07:39.19,Main-207- PL,,0,0,0,,Życie lub śmierć...
Dialogue: 0,0:07:39.19,0:07:45.11,Main-207- PL,,0,0,0,,{\q2}W walce piratów przegrywa ten,\Nkto choćby na chwilę zlęknie się śmierci.
Dialogue: 0,0:07:45.11,0:07:46.70,Main-207- PL,,0,0,0,,O czym ty chrzanisz?
Dialogue: 0,0:07:46.70,0:07:48.32,Main-207- PL,,0,0,0,,Przynajmniej...
Dialogue: 0,0:07:59.17,0:08:00.92,Main-207- PL,,0,0,0,,Przynajmniej...
Dialogue: 0,0:08:04.30,0:08:06.38,Main-207- PL,,0,0,0,,Ten smarkacz...
Dialogue: 0,0:08:07.01,0:08:09.34,Main-207- PL,,0,0,0,,nie ma w sobie ani krzty zwątpienia!
Dialogue: 0,0:08:21.90,0:08:24.82,Main-207- PL,,0,0,0,,Czy to instynkt samozachowawczy?
Dialogue: 0,0:08:27.15,0:08:29.95,Main-207- PL,,0,0,0,,A może wiara w samego siebie?
Dialogue: 0,0:08:32.99,0:08:34.58,Main-207- PL,,0,0,0,,Wiara...
Dialogue: 0,0:08:45.88,0:08:50.09,Main-207- PL,,0,0,0,,T-Ty nędzny szkodniku!
Dialogue: 0,0:08:55.35,0:08:56.60,Main-207- PL,,0,0,0,,Dalej! Jesteś gość!
Dialogue: 0,0:08:56.60,0:08:58.93,Main-207- PL,,0,0,0,,Dajesz, majtek! Pokaż mu!
Dialogue: 0,0:08:57.52,0:08:58.93,Secondary-207- PL,,0,0,0,,Bierz go!
Dialogue: 0,0:09:01.56,0:09:03.11,Main-207- PL,,0,0,0,,Już ci mówiłem...
Dialogue: 0,0:09:03.48,0:09:05.86,Main-207- PL,,0,0,0,,Wyzioniesz tutaj ducha!
Dialogue: 0,0:09:09.70,0:09:13.78,Main-207- PL,,0,0,0,,Jestem najsilniejszym człowiekiem!
Dialogue: 0,0:09:19.75,0:09:23.58,Main-207- PL,,0,0,0,,{\q2}Flota, którą zebrał sobie Krieg,\Nto setki broni czy trucizn...
Dialogue: 0,0:09:23.58,0:09:26.21,Main-207- PL,,0,0,0,,Skoro to ma być potęga...
Dialogue: 0,0:09:30.34,0:09:32.89,Main-207- PL,,0,0,0,,to włócznia tego smarkacza...
Dialogue: 0,0:09:32.89,0:09:35.35,Main-207- PL,,0,0,0,,jest równie potężna.
Dialogue: 0,0:09:36.76,0:09:39.68,Main-207- PL,,0,0,0,,Włócznia, która ucieleśnia jego wolę.
Dialogue: 0,0:09:40.85,0:09:47.57,Main-207- PL,,0,0,0,,Znam pewnego głupka, który schował\Nswoją własną włócznię z durnych powodów.
Dialogue: 0,0:09:57.62,0:09:59.33,Main-207- PL,,0,0,0,,W-Wielka Włócznia Bojowa...
Dialogue: 0,0:09:59.83,0:10:01.66,Main-207- PL,,0,0,0,,Coś ty najlepszego zrobił?!
Dialogue: 0,0:10:09.17,0:10:11.63,Main-207- PL,,0,0,0,,Przywaliłem w nią pięć razy.
Dialogue: 0,0:10:12.42,0:10:15.26,Main-207- PL,,0,0,0,,Nie będzie już pożytku\Nz tej twojej włóczni.
Dialogue: 0,0:10:18.72,0:10:20.35,Main-207- PL,,0,0,0,,Lepiej się przygotuj...
Dialogue: 0,0:10:24.06,0:10:26.48,Main-207- PL,,0,0,0,,Mam już gdzie stać,\Nwięc szykuj się na lanie!
Dialogue: 0,0:10:27.98,0:10:28.94,Main-207- PL,,0,0,0,,Słucham?
Dialogue: 0,0:10:28.94,0:10:33.40,Main-207- PL,,0,0,0,,Z rozwalonym ostrzem\Nto tylko wybuchający patyk.
Dialogue: 0,0:10:33.40,0:10:35.03,Main-207- PL,,0,0,0,,Jej siła spadła o połowę.
Dialogue: 0,0:10:35.03,0:10:36.57,Main-207- PL,,0,0,0,,Tak ci się wydaje?
Dialogue: 0,0:10:36.57,0:10:37.53,Main-207- PL,,0,0,0,,Właśnie tak.
Dialogue: 0,0:10:38.91,0:10:40.12,Main-207- PL,,0,0,0,,Wybuchający patyk?
Dialogue: 0,0:10:40.12,0:10:41.75,Main-207- PL,,0,0,0,,Jak dla mnie bomba.
Dialogue: 0,0:10:41.75,0:10:46.13,Main-207- PL,,0,0,0,,Biorąc pod uwagę twój stan, to starczy\Naż nadto, by roznieść cię w pył.
Dialogue: 0,0:10:46.79,0:10:51.71,Main-207- PL,,0,0,0,,{\q2}Twoje ciało ledwo trzyma się kupy,\Nzupełnie jak twoje puste słowa.
Dialogue: 0,0:10:52.09,0:10:53.42,Main-207- PL,,0,0,0,,Wcale nie są puste.
Dialogue: 0,0:10:55.51,0:10:57.55,Main-207- PL,,0,0,0,,No patrzcie go. Niezły jest!
Dialogue: 0,0:10:57.55,0:10:59.43,Main-207- PL,,0,0,0,,Jest szansa, że mu się uda!
Dialogue: 0,0:11:00.26,0:11:02.06,Main-207- PL,,0,0,0,,Przechlapane...
Dialogue: 0,0:11:02.06,0:11:04.39,Main-207- PL,,0,0,0,,Tak po prostu rozwalił\NWielką Włócznię Bojową...?
Dialogue: 0,0:11:09.90,0:11:13.28,Main-207- PL,,0,0,0,,Ale przyjęcie tylu wybuchów naraz...
Dialogue: 0,0:11:13.28,0:11:14.86,Main-207- PL,,0,0,0,,Żadne ciało tego nie wytrzyma.
Dialogue: 0,0:11:17.11,0:11:18.62,Main-207- PL,,0,0,0,,Odpuść sobie!
Dialogue: 0,0:11:18.62,0:11:21.83,Main-207- PL,,0,0,0,,W chwili, w której stanąłeś\Nw szranki z wielkim Don Kriegiem,
Dialogue: 0,0:11:22.95,0:11:25.25,Main-207- PL,,0,0,0,,stanąłeś również naprzeciw śmierci!
Dialogue: 0,0:11:25.25,0:11:26.12,Main-207- PL,,0,0,0,,Ja nie umrę!
Dialogue: 0,0:11:31.25,0:11:32.88,Main-207- PL,,0,0,0,,Hej! Tu jestem!
Dialogue: 0,0:11:32.88,0:11:34.01,Main-207- PL,,0,0,0,,Małpiszon!
Comment: 0,0:11:35.67,0:11:37.18,Main-207-,,0,0,0,,Ooh ooh ahh!
Dialogue: 0,0:11:42.01,0:11:43.43,Main-207- PL,,0,0,0,,Gibie się jak pijany!
Dialogue: 0,0:11:48.81,0:11:49.98,Main-207- PL,,0,0,0,,Marny twój trud!
Dialogue: 0,0:11:53.82,0:11:56.03,Main-207- PL,,0,0,0,,Ile on może mieć tych broni?!
Dialogue: 0,0:12:06.04,0:12:07.87,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy...
Dialogue: 0,0:12:08.25,0:12:10.00,Main-207- PL,,0,0,0,,{\fad(150,150)}Gatling!
Dialogue: 0,0:12:22.64,0:12:23.68,Main-207- PL,,0,0,0,,Słabizna!
Dialogue: 0,0:12:24.39,0:12:28.89,Main-207- PL,,0,0,0,,W starciu ze stalą damasceńską\Ntwoje ciosy są niczym pstryknięcie palcem!
Dialogue: 0,0:12:28.89,0:12:31.81,Main-207- PL,,0,0,0,,Nawet jej nie wgnieciesz.
Dialogue: 0,0:12:34.73,0:12:36.65,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy Pistolet!
Dialogue: 0,0:12:46.54,0:12:48.04,Main-207- PL,,0,0,0,,Don!
Dialogue: 0,0:12:49.75,0:12:51.58,Main-207- PL,,0,0,0,,Co za bezczelność!
Dialogue: 0,0:12:57.51,0:13:01.01,Main-207- PL,,0,0,0,,To na nic! Na nic!\NAbsolutnie na nic!
Dialogue: 0,0:13:01.01,0:13:06.60,Main-207- PL,,0,0,0,,Nawet i sto małpich ciosów\Nto nic w zetknięciu z tą zbroją!
Dialogue: 0,0:13:08.06,0:13:10.94,Main-207- PL,,0,0,0,,Jeszcze tylko trochę...
Dialogue: 0,0:13:13.86,0:13:15.07,Main-207- PL,,0,0,0,,Nie ma go...
Dialogue: 0,0:13:15.07,0:13:16.57,Main-207- PL,,0,0,0,,Tutaj jestem!
Dialogue: 0,0:13:21.61,0:13:22.61,Main-207- PL,,0,0,0,,Słuchaj uważnie.
Dialogue: 0,0:13:22.61,0:13:27.83,Main-207- PL,,0,0,0,,{\q2}Prawdziwa potęga to najznamienitszy oręż\Ndzierżony z niezachwianą siłą.
Dialogue: 0,0:13:28.83,0:13:31.83,Main-207- PL,,0,0,0,,To silni odniosą zwycięstwo.
Dialogue: 0,0:13:31.83,0:13:33.79,Main-207- PL,,0,0,0,,Silni!
Dialogue: 0,0:13:37.05,0:13:38.63,Main-207- PL,,0,0,0,,Dlatego właśnie to będę ja!
Dialogue: 0,0:13:38.63,0:13:43.76,Main-207- PL,,0,0,0,,{\fad(150,0)}Gum-Gumowa...
Dialogue: 0,0:13:41.34,0:13:43.76,Secondary-207- PL,,0,0,0,,To na nic! Na nic! Na nic!
Dialogue: 0,0:13:43.76,0:13:47.39,Main-207- PL,,0,0,0,,Samym uporem nic nie zdziałasz!
Dialogue: 0,0:13:51.10,0:13:53.73,Main-207- PL,,0,0,0,,{\fad(150,150)}Bazooka!
Dialogue: 0,0:14:03.28,0:14:04.57,Main-207- PL,,0,0,0,,To nie wystarczy!
Dialogue: 0,0:14:04.57,0:14:07.20,Main-207- PL,,0,0,0,,Właśnie tu leży granica twojej siły!
Dialogue: 0,0:14:10.58,0:14:13.83,Main-207- PL,,0,0,0,,{\q2}Jak to?!\NUszkodził moją niezniszczalną zbroję?!
Dialogue: 0,0:14:16.79,0:14:18.17,Main-207- PL,,0,0,0,,Ale już za późno.
Dialogue: 0,0:14:18.92,0:14:22.72,Main-207- PL,,0,0,0,,Już po tobie, topielcu!
Dialogue: 0,0:14:26.43,0:14:28.39,Main-207- PL,,0,0,0,,To pułapka! Uciekaj!
Dialogue: 0,0:14:38.07,0:14:39.73,Main-207- PL,,0,0,0,,Majtku!
Dialogue: 0,0:14:56.92,0:14:59.63,Flashbacks-207- PL,,0,0,0,,Czy to instynkt samozachowawczy?{08:33}
Dialogue: 0,0:15:00.00,0:15:02.71,Flashbacks-207- PL,,0,0,0,,A może wiara w samego siebie?{08:39}
Dialogue: 0,0:15:06.55,0:15:08.55,Main-207- PL,,0,0,0,,{\fad(150,0)}Gum-Gumowa...
Dialogue: 0,0:15:08.55,0:15:10.06,Main-207- PL,,0,0,0,,Że co?!
Dialogue: 0,0:15:12.93,0:15:15.98,Main-207- PL,,0,0,0,,{\fad(150,150)}Bazooka!
Dialogue: 0,0:15:41.88,0:15:43.01,Main-207- PL,,0,0,0,,Dopadł go!
Dialogue: 0,0:15:42.17,0:15:43.01,Secondary-207- PL,,0,0,0,,Dobra robota!
Dialogue: 0,0:15:43.01,0:15:44.80,Main-207- PL,,0,0,0,,Rządzisz, majtku!
Dialogue: 0,0:15:47.13,0:15:49.26,Main-207- PL,,0,0,0,,Zwycięstwo jest moje!
Dialogue: 0,0:15:53.22,0:15:55.10,Main-207- PL,,0,0,0,,Nie pochlebiaj sobie, gnoju!
Dialogue: 0,0:15:55.68,0:15:56.56,Main-207- PL,,0,0,0,,Nadal żyje!
Dialogue: 0,0:15:59.56,0:16:00.19,Main-207- PL,,0,0,0,,No nie!
Dialogue: 0,0:16:05.11,0:16:08.28,Main-207- PL,,0,0,0,,Spróbuj uciec z tej żelaznej sieci!
Dialogue: 0,0:16:19.12,0:16:20.63,Main-207- PL,,0,0,0,,Na dole czeka nas morze!
Dialogue: 0,0:16:20.63,0:16:23.13,Main-207- PL,,0,0,0,,Walka skończona, topielcu!
Dialogue: 0,0:16:23.13,0:16:26.67,Main-207- PL,,0,0,0,,To ja będę się śmiał ostatni!
Dialogue: 0,0:16:30.80,0:16:32.76,Main-207- PL,,0,0,0,,Tak jest! To właśnie nasz Don!
Dialogue: 0,0:16:32.76,0:16:35.27,Main-207- PL,,0,0,0,,Na dno z nim!
Dialogue: 0,0:16:33.68,0:16:35.27,Secondary-207- PL,,0,0,0,,Pokaż mu!
Dialogue: 0,0:16:39.44,0:16:41.90,Main-207- PL,,0,0,0,,Jak tylko uwolnię ręce\Ni nogi, wygram!
Dialogue: 0,0:16:42.61,0:16:44.61,Thoughts-207- PL,,0,0,0,,Dlaczego się nie waha?
Dialogue: 0,0:16:46.40,0:16:47.99,Thoughts-207- PL,,0,0,0,,Dlaczego posuwa się tak daleko?
Dialogue: 0,0:16:47.99,0:16:49.15,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:16:49.57,0:16:51.53,Main-207- PL,,0,0,0,,Tym razem...
Dialogue: 0,0:16:51.53,0:16:53.49,Main-207- PL,,0,0,0,,to już naprawdę koniec!
Dialogue: 0,0:16:58.50,0:17:01.54,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy...
Dialogue: 0,0:17:12.14,0:17:13.51,Main-207- PL,,0,0,0,,{\fad(150,0)}Wielki Młot!
Dialogue: 0,0:17:36.12,0:17:37.54,Main-207- PL,,0,0,0,,Don Krieg...
Dialogue: 0,0:17:37.54,0:17:41.16,Main-207- PL,,0,0,0,,Don... Don przegrał! Ale jak?!
Dialogue: 0,0:17:41.16,0:17:41.83,Main-207- PL,,0,0,0,,Cholera!
Dialogue: 0,0:17:41.83,0:17:43.38,Main-207- PL,,0,0,0,,Właśnie tak, majtku!
Dialogue: 0,0:17:43.38,0:17:45.79,Main-207- PL,,0,0,0,,Dobra robota!
Dialogue: 0,0:17:42.54,0:17:45.79,Secondary-207- PL,,0,0,0,,Cholera! Jak? Jak Don mógł...
Dialogue: 0,0:17:47.55,0:17:48.92,Main-207- PL,,0,0,0,,Dał skubany radę!
Dialogue: 0,0:17:48.92,0:17:50.59,Main-207- PL,,0,0,0,,R-Ryje czachę!
Dialogue: 0,0:17:50.59,0:17:51.97,Main-207- PL,,0,0,0,,Serio dał radę?
Dialogue: 0,0:17:51.97,0:17:54.18,Main-207- PL,,0,0,0,,Don Krieg to przecież nie byle kto!
Dialogue: 0,0:17:54.18,0:17:55.55,Main-207- PL,,0,0,0,,Cóż za siła!
Dialogue: 0,0:17:55.55,0:17:57.76,Main-207- PL,,0,0,0,,On jest niepowstrzymany!
Dialogue: 0,0:17:58.89,0:18:01.02,Main-207- PL,,0,0,0,,C-Co tu się dzieje?
Dialogue: 0,0:18:01.02,0:18:03.27,Main-207- PL,,0,0,0,,Ach! Obudziłeś się!
Dialogue: 0,0:18:03.27,0:18:04.65,Main-207- PL,,0,0,0,,Przegrał!
Dialogue: 0,0:18:04.65,0:18:06.02,Main-207- PL,,0,0,0,,Ten twój cały Don!
Dialogue: 0,0:18:06.48,0:18:07.48,Main-207- PL,,0,0,0,,Że co?!
Dialogue: 0,0:18:23.29,0:18:26.96,Main-207- PL,,0,0,0,,Przestań bujać w obłokach\Ni ruszaj mu na pomoc!
Dialogue: 0,0:18:27.34,0:18:28.42,Main-207- PL,,0,0,0,,Co?
Dialogue: 0,0:18:28.42,0:18:30.26,Main-207- PL,,0,0,0,,Sam przecież nie wypłynie!
Dialogue: 0,0:18:30.26,0:18:30.96,Main-207- PL,,0,0,0,,Jak to?!
Dialogue: 0,0:18:31.55,0:18:34.64,Main-207- PL,,0,0,0,,Morze nienawidzi władających\Nmocami diabelskich owoców.
Dialogue: 0,0:18:34.64,0:18:36.43,Main-207- PL,,0,0,0,,Idą na dno jak kotwice.
Dialogue: 0,0:18:36.43,0:18:38.60,Main-207- PL,,0,0,0,,Że co proszę, gówniany dziadygo?!
Dialogue: 0,0:18:39.35,0:18:41.06,Main-207- PL,,0,0,0,,Trzeba było mówić wcześniej!
Dialogue: 0,0:18:41.73,0:18:43.89,Main-207- PL,,0,0,0,,A co, jeżeli jest już za późno?!
Dialogue: 0,0:19:14.55,0:19:16.18,Main-207- PL,,0,0,0,,Hej! Trzymaj się!
Dialogue: 0,0:19:16.80,0:19:19.18,Thoughts-207- PL,,0,0,0,,Mówiłeś przecież,\Nże nie umrzesz, prawda?
Dialogue: 0,0:19:20.06,0:19:22.14,Thoughts-207- PL,,0,0,0,,Właśnie w to wierzyłeś, prawda?!
Dialogue: 0,0:19:22.77,0:19:24.10,Thoughts-207- PL,,0,0,0,,Prawda?!
Dialogue: 0,0:19:27.44,0:19:29.02,Flashbacks-207- PL,,0,0,0,,Ja nie zginę!{BT 07 - 23:47 (visuals from 25:37)}
Dialogue: 0,0:19:32.90,0:19:35.95,Flashbacks-207- PL,,0,0,0,,Nie umrę w takim miejscu.{BT 07 - 26:05}
Dialogue: 0,0:19:37.45,0:19:39.03,Thoughts-207- PL,,0,0,0,,Co za goście...
Dialogue: 0,0:19:42.87,0:19:45.87,Flashbacks-207- PL,,0,0,0,,Zoro!{BT 04 - 16:55}
Dialogue: 0,0:19:49.38,0:19:52.38,FlashbackThoughts-207- PL,,0,0,0,,Nie powinien był umierać za ambicje!{BT 04 - 17:30}
Dialogue: 0,0:19:52.96,0:19:54.38,Flashbacks-207- PL,,0,0,0,,Wybór jest prosty!
Dialogue: 0,0:19:54.38,0:19:56.47,Flashbacks-207- PL,,0,0,0,,Wystarczy porzucić swoje ambicje!
Dialogue: 0,0:20:06.23,0:20:08.15,Thoughts-207- PL,,0,0,0,,Jeden gorszy od drugiego...
Dialogue: 0,0:20:20.24,0:20:23.45,Flashbacks-207- PL,,0,0,0,,Sam tego nie rozumiem, ale...{BT 04 - 14:58}
Dialogue: 0,0:20:25.33,0:20:27.83,Flashbacks-207- PL,,0,0,0,,gdybym cofnął się choćby o krok,{BT 04 - 15:01}
Dialogue: 0,0:20:27.83,0:20:34.09,Flashbacks-207- PL,,0,0,0,,{\q2}to złamałbym wszystkie ważne obietnice\Ni przysięgi, które zdążyłem złożyć,
Dialogue: 0,0:20:34.09,0:20:37.47,Flashbacks-207- PL,,0,0,0,,przez co już nigdy nie byłbym\Ntym, kim teraz jestem.
Dialogue: 0,0:20:38.30,0:20:42.76,Flashbacks-207- PL,,0,0,0,,Żadna z nich nie będzie równie silna,\Nco włócznia jego ślepej determinacji.{07:05}
Dialogue: 0,0:20:44.26,0:20:50.73,Flashbacks-207- PL,,0,0,0,,Znam pewnego głupka, który schował\Nswoją własną włócznię z durnych powodów.{09:55}
Dialogue: 0,0:21:01.78,0:21:03.24,Main-207- PL,,0,0,0,,Ej, majtek!
Dialogue: 0,0:21:03.24,0:21:05.24,Main-207- PL,,0,0,0,,Nie umieraj mi tutaj!
Dialogue: 0,0:21:05.70,0:21:07.95,Main-207- PL,,0,0,0,,Don! Co się stało?!
Dialogue: 0,0:21:07.95,0:21:11.12,Main-207- PL,,0,0,0,,Dlaczego Don...?
Dialogue: 0,0:21:10.25,0:21:11.12,Secondary-207- PL,,0,0,0,,Don!
Dialogue: 0,0:21:11.12,0:21:13.50,Main-207- PL,,0,0,0,,Don Krieg poniósł klęskę...
Dialogue: 0,0:21:13.50,0:21:15.75,Main-207- PL,,0,0,0,,To nie może być prawda...
Dialogue: 0,0:21:15.75,0:21:18.34,Main-207- PL,,0,0,0,,Pogromca całego East Blue...
Dialogue: 0,0:21:18.34,0:21:20.34,Main-207- PL,,0,0,0,,Gadaj sobie, co chcesz...
Dialogue: 0,0:21:20.34,0:21:22.47,Main-207- PL,,0,0,0,,ale spójrz, jak nie wierzysz!
Dialogue: 0,0:21:22.47,0:21:26.56,Main-207- PL,,0,0,0,,Jego ukochaną zbroję szlag trafił,\Na on skończył na deskach.
Dialogue: 0,0:21:27.39,0:21:29.98,Main-207- PL,,0,0,0,,Dostał niezłe manto.\NNa pewno nie chcesz spojrzeć?
Dialogue: 0,0:21:31.73,0:21:35.23,Main-207- PL,,0,0,0,,To jedyny człowiek, którego\Ntak bardzo podziwiałem...
Dialogue: 0,0:21:35.23,0:21:37.69,Main-207- PL,,0,0,0,,Byłem przekonany,\Nże jest najsilniejszy!
Dialogue: 0,0:21:44.87,0:21:46.62,Main-207- PL,,0,0,0,,Chwila moment, przydupasie!
Dialogue: 0,0:21:46.62,0:21:48.70,Main-207- PL,,0,0,0,,Ruch przyspieszy działanie trucizny!
Dialogue: 0,0:21:48.70,0:21:50.16,Main-207- PL,,0,0,0,,Siadaj!
Dialogue: 0,0:21:50.16,0:21:52.54,Main-207- PL,,0,0,0,,Hej! Umrzesz!
Dialogue: 0,0:21:49.45,0:21:51.16,Secondary-207- PL,,0,0,0,,Dla twojego własnego dobra!
Dialogue: 0,0:21:52.54,0:21:53.92,Main-207- PL,,0,0,0,,Majtku!
Dialogue: 0,0:21:53.92,0:21:55.46,Main-207- PL,,0,0,0,,Nie umieraj!
Dialogue: 0,0:21:55.46,0:21:57.00,Main-207- PL,,0,0,0,,Słyszysz mnie?!
Dialogue: 0,0:21:57.00,0:21:59.97,Main-207- PL,,0,0,0,,Nadal masz sprawy\Ndo załatwienia, prawda?!
Dialogue: 0,0:22:00.47,0:22:01.72,Main-207- PL,,0,0,0,,Majtku! Nie umieraj!
Dialogue: 0,0:22:10.39,0:22:11.64,Main-207- PL,,0,0,0,,Rany...
Dialogue: 0,0:22:13.90,0:22:15.31,Main-207- PL,,0,0,0,,Co ja z tobą mam...
Dialogue: 0,0:22:15.31,0:22:17.90,Main-207- PL,,0,0,0,,Jestem najsilniejszy!
Dialogue: 0,0:22:17.90,0:22:20.57,Main-207- PL,,0,0,0,,To ja... To ja zwyciężę!
Dialogue: 0,0:22:20.57,0:22:24.41,Main-207- PL,,0,0,0,,Nikt nie jest równy mojej potędze!
Dialogue: 0,0:22:25.20,0:22:26.49,Main-207- PL,,0,0,0,,Don! Już wystarczy!
Dialogue: 0,0:22:26.49,0:22:29.04,Main-207- PL,,0,0,0,,Trzymajcie go!\NNic do niego nie dociera!
Dialogue: 0,0:22:30.12,0:22:31.33,Main-207- PL,,0,0,0,,Zwyciężę!
Dialogue: 0,0:22:31.33,0:22:33.25,Main-207- PL,,0,0,0,,Natychmiast przestań, Don!
Dialogue: 0,0:22:34.04,0:22:36.71,Main-207- PL,,0,0,0,,Zwyciężę własną siłą!
Dialogue: 0,0:22:44.80,0:22:47.30,Main-207- PL,,0,0,0,,Ja...
Dialogue: 0,0:22:47.30,0:22:49.51,Main-207- PL,,0,0,0,,muszę...
Dialogue: 0,0:22:49.51,0:22:51.22,Main-207- PL,,0,0,0,,wygrać!
Dialogue: 0,0:22:53.35,0:22:55.81,Main-207- PL,,0,0,0,,To ja jestem najsilniejszy!
Dialogue: 0,0:23:02.07,0:23:03.57,Main-207- PL,,0,0,0,,Don Krieg...
Dialogue: 0,0:23:03.57,0:23:05.78,Main-207- PL,,0,0,0,,Przegraliśmy.
Dialogue: 0,0:23:06.20,0:23:08.49,Main-207- PL,,0,0,0,,– Generale!\N– Generale!
Dialogue: 0,0:23:08.49,0:23:12.00,Main-207- PL,,0,0,0,,Grzecznie się wycofamy\Ni zaczniemy od nowa.
Dialogue: 0,0:23:14.79,0:23:17.58,Main-207- PL,,0,0,0,,Dziękuję za wszystko, Sanji.
Dialogue: 0,0:23:17.58,0:23:18.75,Main-207- PL,,0,0,0,,Ta.
Dialogue: 0,0:23:18.75,0:23:20.46,Main-207- PL,,0,0,0,,Nigdy nie wracaj!
Dialogue: 0,0:23:21.63,0:23:23.05,Main-207- PL,,0,0,0,,Sanji.
Dialogue: 0,0:23:23.05,0:23:27.09,Main-207- PL,,0,0,0,,Kiedy się obudzi,\Nprzekaż mu, proszę, te słowa...
Dialogue: 0,0:23:30.85,0:23:34.60,Main-207- PL,,0,0,0,,„Do zobaczenia na Grand Line.”
Dialogue: 0,0:23:35.69,0:23:36.65,Main-207- PL,,0,0,0,,Ty...
Dialogue: 0,0:23:37.48,0:23:39.90,Main-207- PL,,0,0,0,,Jakby się tak nad tym zastanowić,
Dialogue: 0,0:23:39.90,0:23:43.11,Main-207- PL,,0,0,0,,to wciąż jedyna rzecz, której pragnę...
Dialogue: 0,0:23:43.69,0:23:48.62,Main-207- PL,,0,0,0,,{\q2}Wygląda na to, że w pewnym momencie\Nzacząłem podzielać ambicje Don Kriega.
Dialogue: 0,0:23:54.16,0:23:55.62,Main-207- PL,,0,0,0,,Kto wie...
Dialogue: 0,0:23:56.16,0:23:58.88,Main-207- PL,,0,0,0,,Możliwe, że zostało mi\Nzaledwie kilka godzin...
Dialogue: 0,0:23:59.58,0:24:03.67,Main-207- PL,,0,0,0,,{\q2}W końcu próbuję coś zmienić, a przecież\Nlada moment może zabraknąć mi czasu...
Dialogue: 0,0:24:03.67,0:24:06.26,Main-207- PL,,0,0,0,,Tym razem chcę działać\Nzgodnie z moją własną wolą...
Dialogue: 0,0:24:06.26,0:24:07.38,Main-207- PL,,0,0,0,,Po swojemu...
Dialogue: 0,0:24:08.01,0:24:11.18,Main-207- PL,,0,0,0,,Poza tym i tak nie mam\Njuż dokąd uciec, no nie?
Dialogue: 0,0:24:17.89,0:24:20.19,Main-207- PL,,0,0,0,,Chrzanić lojalność wobec Dona!
Dialogue: 0,0:24:20.73,0:24:25.94,Main-207- PL,,0,0,0,,Cały ten czas uciekałem, a imię Don Krieg\Nbyło dla mnie zaledwie wygodną zasłoną.
Dialogue: 0,0:24:27.20,0:24:32.83,Main-207- PL,,0,0,0,,Gdy działasz w zgodzie z samym sobą,\Nwszelkie lęki idą w niepamięć.
Dialogue: 0,0:24:32.83,0:24:35.58,Main-207- PL,,0,0,0,,Tak błahe sprawy\Nnie będą cię martwiły.
Dialogue: 0,0:24:35.58,0:24:37.91,Main-207- PL,,0,0,0,,Tego się od niego nauczyłem.
Dialogue: 0,0:24:43.09,0:24:44.30,Main-207- PL,,0,0,0,,Patty! Carne!
Dialogue: 0,0:24:44.84,0:24:46.80,Main-207- PL,,0,0,0,,Dajcie mu tę łódkę od zakupów!
Dialogue: 0,0:24:46.80,0:24:49.22,Main-207- PL,,0,0,0,,Co?! Odbiło ci?!
Dialogue: 0,0:24:49.22,0:24:52.47,Main-207- PL,,0,0,0,,Dlaczego mielibyśmy oddać\Nnaszą łódkę tym piratom?!
Dialogue: 0,0:24:52.47,0:24:55.85,Main-207- PL,,0,0,0,,Czym wtedy będziemy pływać\Nna zakupy?! Co za dureń!
Dialogue: 0,0:24:55.85,0:24:56.98,Main-207- PL,,0,0,0,,Racja!
Dialogue: 0,0:24:56.98,0:24:59.02,Main-207- PL,,0,0,0,,Niech sobie płyną wpław!
Dialogue: 0,0:24:59.02,0:25:01.94,Main-207- PL,,0,0,0,,Pospieszcie się, ale już!
Dialogue: 0,0:25:05.57,0:25:07.19,Main-207- PL,,0,0,0,,No dobrze, w porządku...
Dialogue: 0,0:25:07.19,0:25:08.95,Main-207- PL,,0,0,0,,Nie krzycz na nas...
Dialogue: 0,0:25:09.32,0:25:12.53,Main-207- PL,,0,0,0,,– Dobrze, dobrze, już idziemy!\N– Dobrze, dobrze, już idziemy!
Dialogue: 0,0:25:20.29,0:25:22.21,Main-207- PL,,0,0,0,,Utoniemy!
Dialogue: 0,0:25:35.72,0:25:39.10,Main-207- PL,,0,0,0,,Dlaczego aż do tej pory się wahałem?
Dialogue: 0,0:25:39.10,0:25:42.10,Main-207- PL,,0,0,0,,Zadaję sobie to pytanie\Ni czuję się jak ostatni głupek.
Dialogue: 0,0:25:57.66,0:25:58.75,Main-207- PL,,0,0,0,,Do widzenia!
Dialogue: 0,0:25:59.12,0:26:00.91,Main-207- PL,,0,0,0,,Dziękujemy za łódź.
Dialogue: 0,0:26:01.41,0:26:03.75,Main-207- PL,,0,0,0,,Chyba nie musimy jej zwracać?
Dialogue: 0,0:26:03.75,0:26:04.58,Main-207- PL,,0,0,0,,Ta.
Dialogue: 0,0:26:05.00,0:26:09.21,Main-207- PL,,0,0,0,,Możecie próbować,\Njeśli wam starczy odwagi, bando cieniasów.
Dialogue: 0,0:26:09.21,0:26:10.76,Main-207- PL,,0,0,0,,Dokładnie!
Dialogue: 0,0:26:10.76,0:26:12.72,Main-207- PL,,0,0,0,,Wyryjcie to sobie w łepetynach.
Dialogue: 0,0:26:12.72,0:26:16.51,Main-207- PL,,0,0,0,,{\q2}To Morska Restauracja, która\Nnie da sobie w kaszę dmuchać – Baratie!
Dialogue: 0,0:26:16.51,0:26:17.47,Main-207- PL,,0,0,0,,– Tak!\N– Tak!
Dialogue: 0,0:26:18.72,0:26:21.43,Main-207- PL,,0,0,0,,Przerażająca restauracja.
Comment: 0,0:00:01.19,0:00:01.19,Main-207-,,0,0,0,,{=27}===============================DIALOGUE============================
