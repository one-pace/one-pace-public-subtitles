Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=97}===============================DIALOGUE============================
Dialogue: 0,0:01:50.30,0:01:54.14,Main-207- PL,,0,0,0,,Ta trójka myśli, że może sobie\Nze mnie kpić? Chrzanić to!
Dialogue: 0,0:01:54.14,0:01:57.97,Main-207- PL,,0,0,0,,Uznaję to za oficjalne wypowiedzenie wojny.
Dialogue: 0,0:01:58.72,0:02:01.18,Main-207- PL,,0,0,0,,W samą porę, Mohji!
Dialogue: 0,0:02:02.81,0:02:06.27,Main-207- PL,,0,0,0,,{\an8}Czy pozwoli pan, abym to ja załatwił Zoro?
Dialogue: 0,0:02:06.81,0:02:07.82,Main-207- PL,,0,0,0,,Jest twój.
Dialogue: 0,0:02:26.00,0:02:27.88,Main-207- PL,,0,0,0,,Co to za pies?
Dialogue: 0,0:02:28.80,0:02:30.30,Main-207- PL,,0,0,0,,Pies!
Dialogue: 0,0:02:36.30,0:02:39.26,Main-207- PL,,0,0,0,,Hej, Zoro! Nic a nic się nie rusza!
Dialogue: 0,0:02:39.26,0:02:42.18,Main-207- PL,,0,0,0,,A co mnie to! Niech sobie robi, co chce!
Dialogue: 0,0:02:42.89,0:02:44.39,Main-207- PL,,0,0,0,,Może nie żyje?
Dialogue: 0,0:02:50.32,0:02:53.74,Main-207- PL,,0,0,0,,Aa! Auć, auć, auć, auć, auć! Aua!
Dialogue: 0,0:02:53.74,0:02:58.07,Main-207- PL,,0,0,0,,Au, au, au! Co ty wyprawiasz, ty głupi psie?!
Dialogue: 0,0:02:58.07,0:03:01.33,Main-207- PL,,0,0,0,,Czy ty w ogóle rozumiesz,\Nw jakiej jesteśmy sytuacji?!
Dialogue: 0,0:03:04.16,0:03:05.58,Main-207- PL,,0,0,0,,Głupi pies...
Dialogue: 0,0:03:05.58,0:03:07.29,Main-207- PL,,0,0,0,,Za mało krwi...
Dialogue: 0,0:03:11.25,0:03:12.96,Main-207- PL,,0,0,0,,Hej, nawigatorko!
Dialogue: 0,0:03:13.72,0:03:17.39,Main-207- PL,,0,0,0,,Chyba możesz to wziąć,\Nskoro mnie uratowałeś!
Dialogue: 0,0:03:18.89,0:03:20.97,Main-207- PL,,0,0,0,,Oo! To klucz do klatki!
Dialogue: 0,0:03:20.97,0:03:23.85,Main-207- PL,,0,0,0,,Zdobyłaś go dla mnie?!
Dialogue: 0,0:03:23.85,0:03:25.85,Main-207- PL,,0,0,0,,Teraz jesteśmy kwita.
Dialogue: 0,0:03:27.35,0:03:28.40,Main-207- PL,,0,0,0,,Ocalony!
Dialogue: 0,0:03:39.87,0:03:42.45,Main-207- PL,,0,0,0,,Ty głupi, głupi psie! Głupi pies!
Dialogue: 0,0:03:42.45,0:03:45.71,Main-207- PL,,0,0,0,,To nie jest do jedzenia! Oddawaj ten klucz!
Dialogue: 0,0:03:45.71,0:03:49.13,Main-207- PL,,0,0,0,,Ty głupi, głupi,\Ngłupi, głupi psie!
Dialogue: 0,0:03:49.13,0:03:51.21,Main-207- PL,,0,0,0,,Oddawaj! Oddawaj! Oddawaj!
Dialogue: 0,0:03:51.21,0:03:52.67,Main-207- PL,,0,0,0,,Hola!
Dialogue: 0,0:03:53.67,0:03:56.63,Main-207- PL,,0,0,0,,Przestańcie dokuczać Shushu, łobuzy!
Dialogue: 0,0:03:57.76,0:03:58.38,Main-207- PL,,0,0,0,,Shushu?
Dialogue: 0,0:03:58.76,0:04:00.47,Main-207- PL,,0,0,0,,Coś ty za jeden, dziadku?
Dialogue: 0,0:04:00.47,0:04:03.22,Main-207- PL,,0,0,0,,{\an8}Jestem burmistrzem tego miasta!
Dialogue: 0,0:04:03.22,0:04:05.93,Main-207- PL,,0,0,0,,{\an8}Kim {\i1}wy{\i0} jesteście?!
Dialogue: 0,0:04:05.93,0:04:06.39,Main-207- PL,,0,0,0,,{\an8}Co?
Dialogue: 0,0:04:13.73,0:04:14.98,Main-207- PL,,0,0,0,,Co z Zoro?!
Dialogue: 0,0:04:14.98,0:04:17.45,Main-207- PL,,0,0,0,,Powinien go obejrzeć lekarz,
Dialogue: 0,0:04:17.45,0:04:20.78,Main-207- PL,,0,0,0,,ale stwierdził, że to odeśpi,\Ni poszedł się położyć.
Dialogue: 0,0:04:23.83,0:04:26.33,Main-207- PL,,0,0,0,,Czyli ten pies wabi się Shushu?
Dialogue: 0,0:04:26.95,0:04:29.96,Main-207- PL,,0,0,0,,Po co on tu właściwie siedzi?
Dialogue: 0,0:04:30.29,0:04:31.83,Main-207- PL,,0,0,0,,Pilnuje sklepu.
Dialogue: 0,0:04:32.34,0:04:36.63,Main-207- PL,,0,0,0,,Oo! Więc to jest... sklep z karmą?
Dialogue: 0,0:04:36.63,0:04:42.26,Main-207- PL,,0,0,0,,Tak. Właściciel był\Nmoim dobrym przyjacielem.
Dialogue: 0,0:04:46.68,0:04:47.56,Main-207- PL,,0,0,0,,Proszę.
Dialogue: 0,0:04:50.44,0:04:55.02,Main-207- PL,,0,0,0,,Przyszedłem tu tylko po to,\Nby nakarmić jego psa za niego.
Dialogue: 0,0:04:55.94,0:04:56.82,Main-207- PL,,0,0,0,,„Za niego”?
Dialogue: 0,0:04:56.82,0:04:57.90,Main-207- PL,,0,0,0,,Tak.
Dialogue: 0,0:04:57.90,0:05:03.37,Main-207- PL,,0,0,0,,Niestety odszedł. Choroba\Nzabrała go trzy miesiące temu.
Dialogue: 0,0:05:03.37,0:05:07.75,Main-207- PL,,0,0,0,,To znaczy, że ten pies przez cały ten czas\Nczekał na swojego pana?
Dialogue: 0,0:05:10.50,0:05:12.17,Main-207- PL,,0,0,0,,Wszyscy tak mówią...
Dialogue: 0,0:05:17.96,0:05:20.59,Main-207- PL,,0,0,0,,ale ja się z tym nie zgadzam.
Dialogue: 0,0:05:21.55,0:05:23.93,Main-207- PL,,0,0,0,,Shushu to mądry pies.
Dialogue: 0,0:05:23.93,0:05:27.72,Main-207- PL,,0,0,0,,Zapewne od dawna wie, że jego pan nie żyje.
Dialogue: 0,0:05:32.31,0:05:34.81,Main-207- PL,,0,0,0,,W takim razie dlaczego pilnuje sklepu?
Dialogue: 0,0:05:34.81,0:05:38.82,Main-207- PL,,0,0,0,,Wydaje mi się, że Shushu uważa\Nten sklep za swój skarb.
Dialogue: 0,0:05:39.15,0:05:45.12,Main-207- PL,,0,0,0,,Myślę, że w ten sposób broni pamiątki\Npo swoim ukochanym panu.
Dialogue: 0,0:05:45.49,0:05:49.66,Main-207- PL,,0,0,0,,Wiele razy próbowałem go zabrać\Nw jakieś bezpieczniejsze miejsce,
Dialogue: 0,0:05:49.66,0:05:52.08,Main-207- PL,,0,0,0,,ale nic z tego,\Nnie rusza się stąd nawet na krok.
Dialogue: 0,0:06:07.72,0:06:09.22,Main-207- PL,,0,0,0,,Co? Co to za ryk?!
Dialogue: 0,0:06:09.22,0:06:12.23,Main-207- PL,,0,0,0,,To on! Poskramiacz Bestii Mohji!
Dialogue: 0,0:06:13.44,0:06:15.40,Main-207- PL,,0,0,0,,Jak to „Poskramiacz Bestii”?!
Dialogue: 0,0:06:15.40,0:06:17.27,Main-207- PL,,0,0,0,,Cz-Czekaj! Chwila!
Dialogue: 0,0:06:18.02,0:06:20.03,Main-207- PL,,0,0,0,,No dalej, coś się zbliża.
Dialogue: 0,0:06:20.03,0:06:21.86,Main-207- PL,,0,0,0,,Oddaj mi ten klucz.
Dialogue: 0,0:06:26.66,0:06:29.29,Main-207- PL,,0,0,0,,Widzę, że twoi kompani cię porzucili.
Dialogue: 0,0:06:29.29,0:06:31.08,Main-207- PL,,0,0,0,,A dopiero co uciekłeś...
Dialogue: 0,0:06:31.75,0:06:32.87,Main-207- PL,,0,0,0,,A ty to kto?
Dialogue: 0,0:06:33.71,0:06:37.29,Main-207- PL,,0,0,0,,Jestem Poskramiacz Bestii Mohji,\Nczłonek załogi Piratów Buggy'ego.
Dialogue: 0,0:06:37.84,0:06:40.84,Main-207- PL,,0,0,0,,To twoje przebranie jest naprawdę dziwne!
Dialogue: 0,0:06:41.21,0:06:43.93,Main-207- PL,,0,0,0,,Jak śmiesz! To moje włosy!
Dialogue: 0,0:06:44.18,0:06:45.76,Main-207- PL,,0,0,0,,Tym bardziej dziwne!
Dialogue: 0,0:06:45.76,0:06:50.06,Main-207- PL,,0,0,0,,Myślisz, że w tej klatce\Nnic ci nie grozi?
Dialogue: 0,0:06:50.06,0:06:51.85,Main-207- PL,,0,0,0,,Nie wiesz, z kim masz do czynienia!
Dialogue: 0,0:06:51.85,0:06:57.27,Main-207- PL,,0,0,0,,Nie ma takiego zwierzęcia, którego\NPoskramiacz Bestii Mohji by nie okiełznał!
Dialogue: 0,0:06:58.19,0:06:58.90,Main-207- PL,,0,0,0,,Łapa!
