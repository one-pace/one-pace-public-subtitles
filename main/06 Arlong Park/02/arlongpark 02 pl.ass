Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=30}===============================DIALOGUE============================
Dialogue: 0,0:02:21.37,0:02:22.83,Main-207- PL,,0,0,0,,Powinno wystarczyć...
Dialogue: 0,0:02:27.34,0:02:31.13,Main-207- PL,,0,0,0,,Muumu! Czas na żarełko! Muumu!
Dialogue: 0,0:02:31.13,0:02:34.09,Main-207- PL,,0,0,0,,Dziwne...
Dialogue: 0,0:02:34.09,0:02:37.72,Main-207- PL,,0,0,0,,Zazwyczaj pada z głodu o tej porze.
Dialogue: 0,0:02:37.72,0:02:39.06,Main-207- PL,,0,0,0,,Gdzie go tym razem wcięło?
Dialogue: 0,0:02:47.56,0:02:48.27,Main-207- PL,,0,0,0,,Gen!
Dialogue: 0,0:02:50.78,0:02:53.40,Main-207- PL,,0,0,0,,Posiadanie broni to jawna oznaka buntu!
Dialogue: 0,0:02:53.40,0:02:56.45,Main-207- PL,,0,0,0,,Zawsze znajdą się tacy jak ty,
Dialogue: 0,0:02:56.45,0:03:01.16,Main-207- PL,,0,0,0,,dlatego zabiję cię, aby dać reszcie\Nprzykład tego, co czeka buntowników!
Dialogue: 0,0:03:01.99,0:03:06.92,Main-207- PL,,0,0,0,,Nie może być! Zabije kogoś\Nza samo posiadanie broni?!
Dialogue: 0,0:03:06.92,0:03:08.29,Main-207- PL,,0,0,0,,Nie ma prawa!
Dialogue: 0,0:03:08.29,0:03:10.13,Main-207- PL,,0,0,0,,H-Hej, ty! Hej! Hej!
Dialogue: 0,0:03:11.34,0:03:13.84,Main-207- PL,,0,0,0,,Nie masz prawa, Arlong!
Dialogue: 0,0:03:16.30,0:03:21.43,Main-207- PL,,0,0,0,,Od ośmiu lat bez przerwy\Npłacimy tę twoją daninę!
Dialogue: 0,0:03:21.43,0:03:24.27,Main-207- PL,,0,0,0,,Dlaczego nagle mielibyśmy się buntować?!
Dialogue: 0,0:03:24.68,0:03:26.52,Main-207- PL,,0,0,0,,Zabieraj łapska od Gena!
Dialogue: 0,0:03:28.86,0:03:30.06,Main-207- PL,,0,0,0,,Właśnie!
Dialogue: 0,0:03:30.06,0:03:32.78,Main-207- PL,,0,0,0,,Przecież on nawet nie użył tej broni!
Dialogue: 0,0:03:32.78,0:03:33.82,Main-207- PL,,0,0,0,,Proszę, przestań!
Dialogue: 0,0:03:33.82,0:03:35.65,Main-207- PL,,0,0,0,,Puść Gena wolno!
Dialogue: 0,0:03:36.15,0:03:40.12,Main-207- PL,,0,0,0,,Powiedziałem, że posiadanie broni\Njasno wskazuje na chęć buntu.
Dialogue: 0,0:03:40.58,0:03:44.58,Main-207- PL,,0,0,0,,Może jednak powinienem\Nzetrzeć tę wioskę z mapy.
Dialogue: 0,0:03:45.16,0:03:50.75,Main-207- PL,,0,0,0,,Jeśli ktokolwiek z was podniesie na nas\Nrękę, to pożegnacie się ze swoją wioską.
Dialogue: 0,0:03:50.75,0:03:53.30,Main-207- PL,,0,0,0,,Mnie tam wszystko jedno!
Dialogue: 0,0:03:54.05,0:03:55.80,Main-207- PL,,0,0,0,,Wracajcie do środka!
Dialogue: 0,0:03:56.80,0:04:00.39,Main-207- PL,,0,0,0,,Jeśli narobimy teraz kłopotów,\Nto osiem lat starań pójdzie na marne!
Dialogue: 0,0:04:00.39,0:04:03.77,Main-207- PL,,0,0,0,,Gdybyśmy chcieli walczyć\Nna śmierć i życie,
Dialogue: 0,0:04:03.77,0:04:06.77,Main-207- PL,,0,0,0,,zrobilibyśmy to już osiem lat temu!
Dialogue: 0,0:04:06.77,0:04:14.23,Main-207- PL,,0,0,0,,Przysięgliśmy przecież, że przetrwanie będzie\Nnaszym sposobem walki. Przysięgliśmy żyć!
Dialogue: 0,0:04:15.11,0:04:16.11,Main-207- PL,,0,0,0,,Gen!
Dialogue: 0,0:04:16.11,0:04:17.20,Main-207- PL,,0,0,0,,Tak, ale...
Dialogue: 0,0:04:17.57,0:04:20.57,Main-207- PL,,0,0,0,,Piękne słowa. Mądrego\Naż miło posłuchać.
Dialogue: 0,0:04:20.57,0:04:23.58,Main-207- PL,,0,0,0,,Zgadza się! Życie przynosi radość!
Dialogue: 0,0:04:23.58,0:04:26.75,Main-207- PL,,0,0,0,,Nawet dla takich robali jak wy!
Dialogue: 0,0:04:28.08,0:04:29.25,Main-207- PL,,0,0,0,,Gen!
Dialogue: 0,0:04:30.63,0:04:34.63,Main-207- PL,,0,0,0,,Nie wszystkie żywe istoty\Nrodzą się równe!
Dialogue: 0,0:04:36.42,0:04:37.30,Main-207- PL,,0,0,0,,A niech cię...!
Dialogue: 0,0:04:37.30,0:04:37.88,Main-207- PL,,0,0,0,,Przestań!
Dialogue: 0,0:04:38.76,0:04:41.34,Main-207- PL,,0,0,0,,Zostawcie ich!
Dialogue: 0,0:04:41.76,0:04:42.80,Main-207- PL,,0,0,0,,Ale, Gen...!
Dialogue: 0,0:04:45.22,0:04:48.23,Main-207- PL,,0,0,0,,Jeśli którekolwiek z was umrze,\Nto koniec!
Dialogue: 0,0:04:48.23,0:04:50.77,Main-207- PL,,0,0,0,,Nie porzucajcie tej walki o przetrwanie!
Dialogue: 0,0:04:51.27,0:04:52.81,Main-207- PL,,0,0,0,,Nawet jeśli umrę...
Dialogue: 0,0:04:52.81,0:04:54.94,Main-207- PL,,0,0,0,,Piękna determinacja!
Dialogue: 0,0:04:54.94,0:04:57.32,Main-207- PL,,0,0,0,,Patrzcie uważnie, człowieczki!
Dialogue: 0,0:04:58.07,0:05:02.82,Main-207- PL,,0,0,0,,Właśnie to czeka tych, którzy\Nmają tupet, by mi się stawiać!
Dialogue: 0,0:05:02.82,0:05:04.62,Main-207- PL,,0,0,0,,{\fad(150,150)}Wybuchająca Gwiazda!
Dialogue: 0,0:05:07.79,0:05:09.41,Main-207- PL,,0,0,0,,C-Co to było?!
Dialogue: 0,0:05:10.54,0:05:12.21,Main-207- PL,,0,0,0,,Spójrzcie! Tam jest!
Dialogue: 0,0:05:13.08,0:05:15.59,Main-207- PL,,0,0,0,,Ktoś jest na dachu!
Dialogue: 0,0:05:16.96,0:05:18.88,Main-207- PL,,0,0,0,,Coś ty za jeden?!
Dialogue: 0,0:05:18.88,0:05:24.72,Main-207- PL,,0,0,0,,Jam jest kapitan Usopp,\Ndzielny wojownik mórz!
Dialogue: 0,0:05:26.06,0:05:27.43,Main-207- PL,,0,0,0,,On...!
Dialogue: 0,0:05:27.43,0:05:29.68,Main-207- PL,,0,0,0,,Ś-Świecie, drżyj na mój widok,
Dialogue: 0,0:05:29.68,0:05:32.81,Main-207- PL,,0,0,0,,bowiem Mroczny Król Usopp\Nprzybył z czeluści piekła!
Dialogue: 0,0:05:32.81,0:05:34.90,Main-207- PL,,0,0,0,,Wynoście się, a okażę wam łaskę!
Dialogue: 0,0:05:34.90,0:05:36.40,Main-207- PL,,0,0,0,,Moje osiem tysięcy...
Dialogue: 0,0:05:36.40,0:05:38.44,Main-207- PL,,0,0,0,,Kapitanie Arlongu! To on!
Dialogue: 0,0:05:38.44,0:05:41.07,Main-207- PL,,0,0,0,,To ten koleś, co mi wcześniej nawiał!
Comment: 0,0:05:40.32,0:05:41.07,Secondary-207-,,0,0,0,,Eep.
Dialogue: 0,0:05:41.07,0:05:44.37,Main-207- PL,,0,0,0,,Sprowadź nawet i dziesiątki\Ntysięcy ludzi, jeśli chcesz.
Dialogue: 0,0:05:44.37,0:05:47.87,Main-207- PL,,0,0,0,,Rozerwę każdego z nich na strzępy!
Dialogue: 0,0:05:49.41,0:05:52.25,Thoughts-207- PL,,0,0,0,,Wybuchająca Gwiazda\Nnawet go nie ruszyła!
Dialogue: 0,0:05:52.25,0:05:54.75,Main-207- PL,,0,0,0,,Żaden podrzędny człowiek...
Dialogue: 0,0:05:54.75,0:05:58.25,Main-207- PL,,0,0,0,,nie będzie mnie bezkarnie\Nzaczepiał, zrozumiano?!
Dialogue: 0,0:06:04.72,0:06:06.85,Main-207- PL,,0,0,0,,Kapitanie Arlongu! To lekka przesada!
Dialogue: 0,0:06:06.85,0:06:10.68,Main-207- PL,,0,0,0,,Znowu stracimy źródło dochodu,\Npodobnie jak w miasteczku Gosa!
Dialogue: 0,0:06:11.02,0:06:16.90,Main-207- PL,,0,0,0,,Ludzkie wioski łatwo zniszczyć,\Nale my powinniśmy nimi rządzić!
Dialogue: 0,0:06:16.90,0:06:19.36,Main-207- PL,,0,0,0,,Jak ich zabraknie, to znajdziemy nowe!
Dialogue: 0,0:06:19.36,0:06:23.15,Main-207- PL,,0,0,0,,Przecież jesteśmy nadrzędną rasą!
Dialogue: 0,0:06:24.03,0:06:25.41,Main-207- PL,,0,0,0,,On zniszczy całą wioskę!
Dialogue: 0,0:06:29.12,0:06:30.29,Main-207- PL,,0,0,0,,On...?!
Comment: 0,0:06:31.20,0:06:33.41,Main-207-,,0,0,0,,Whoa! I'm gonna die! I'm gonna die!
Dialogue: 0,0:06:31.83,0:06:33.41,Main-207- PL,,0,0,0,,Wykituję! Zaraz wykituję!
Dialogue: 0,0:06:33.66,0:06:36.46,Main-207- PL,,0,0,0,,P-Przeżył to, skubany! Za nim!
Dialogue: 0,0:06:34.83,0:06:35.63,Secondary-207- PL,,0,0,0,,Cholera!
Dialogue: 0,0:06:38.29,0:06:40.38,Main-207- PL,,0,0,0,,Złapać i zatłuc!
Dialogue: 0,0:06:40.38,0:06:43.13,Main-207- PL,,0,0,0,,Hej! Lepiej zabierzmy go\Nz powrotem do Arlong Parku!
Dialogue: 0,0:06:43.13,0:06:45.51,Main-207- PL,,0,0,0,,W takim tempie zniszczy całą wioskę!
Dialogue: 0,0:06:45.51,0:06:46.34,Main-207- PL,,0,0,0,,Racja!
Dialogue: 0,0:06:47.35,0:06:49.35,Main-207- PL,,0,0,0,,Nie pozwólcie mu uciec!
Dialogue: 0,0:06:49.35,0:06:51.35,Main-207- PL,,0,0,0,,Za kogo on nas ma?!
Dialogue: 0,0:06:51.35,0:06:52.98,Main-207- PL,,0,0,0,,Jeszcze tu wrócimy.
Dialogue: 0,0:06:53.48,0:06:55.31,Main-207- PL,,0,0,0,,Tym razem ci się poszczęściło.
Dialogue: 0,0:07:01.69,0:07:03.03,Main-207- PL,,0,0,0,,Wybaczcie mi...
Dialogue: 0,0:07:03.03,0:07:05.11,Main-207- PL,,0,0,0,,Sprawiłem wam wszystkim kłopot...
Dialogue: 0,0:07:05.11,0:07:06.86,Main-207- PL,,0,0,0,,O czym ty mówisz?
Dialogue: 0,0:07:06.86,0:07:08.45,Main-207- PL,,0,0,0,,Nie zrobiłeś nic złego!
Dialogue: 0,0:07:08.45,0:07:09.41,Main-207- PL,,0,0,0,,Właśnie!
Dialogue: 0,0:07:09.41,0:07:12.20,Main-207- PL,,0,0,0,,Ale kim był ten młodzieniec?
Dialogue: 0,0:07:12.95,0:07:14.46,Main-207- PL,,0,0,0,,Hej, wy!
Dialogue: 0,0:07:14.46,0:07:16.00,Main-207- PL,,0,0,0,,Kopę lat!
Dialogue: 0,0:07:16.71,0:07:18.50,Main-207- PL,,0,0,0,,Nami!
Dialogue: 0,0:07:17.46,0:07:18.50,Secondary-207- PL,,0,0,0,,Namcia!
Dialogue: 0,0:07:18.50,0:07:19.42,Main-207- PL,,0,0,0,,To ona!
Dialogue: 0,0:07:27.01,0:07:28.34,Main-207- PL,,0,0,0,,Co to ma znaczyć?
Dialogue: 0,0:07:28.34,0:07:30.89,Main-207- PL,,0,0,0,,Spacerujesz sobie jak gdyby nigdy nic...
Dialogue: 0,0:07:31.26,0:07:33.43,Main-207- PL,,0,0,0,,Usłyszałam potworny hałas...
Dialogue: 0,0:07:33.43,0:07:34.89,Main-207- PL,,0,0,0,,To robota Arlonga, prawda...?
Comment: 0,0:07:45.57,0:07:46.86,Main-207-,,0,0,0,,Just...
Comment: 0,0:07:46.86,0:07:48.32,Main-207-,,0,0,0,,seven million berries left to go.
Dialogue: 0,0:07:45.57,0:07:48.32,Main-207- PL,,0,0,0,,Jeszcze tylko siedem milionów berry.
Dialogue: 0,0:07:49.41,0:07:52.83,Main-207- PL,,0,0,0,,Jak widzisz, nadal masz\Ntu fatalną reputację.
Dialogue: 0,0:07:52.83,0:07:55.66,Main-207- PL,,0,0,0,,No cóż. W końcu jestem piratką!
Dialogue: 0,0:07:55.66,0:07:58.08,Main-207- PL,,0,0,0,,Arlong jest zaskakująco rozsądny.
Dialogue: 0,0:07:58.08,0:08:00.38,Main-207- PL,,0,0,0,,Pieniądze załatwią sprawę.
Dialogue: 0,0:08:01.25,0:08:03.88,Main-207- PL,,0,0,0,,Jeszcze tylko trochę i dobijemy targu.
Dialogue: 0,0:08:07.26,0:08:09.76,Main-207- PL,,0,0,0,,Uzbieram te sto milionów\Nberry za wszelką cenę,
Dialogue: 0,0:08:09.76,0:08:11.43,Main-207- PL,,0,0,0,,po czym wykupię naszą wioskę!
Dialogue: 0,0:08:14.89,0:08:19.65,Main-207- PL,,0,0,0,,Kazała mi uciekać, ale niby dokąd,\Nskoro miałem trafić właśnie tutaj.
Dialogue: 0,0:08:20.02,0:08:23.86,Main-207- PL,,0,0,0,,W końcu obiecałem Luffy'emu,\Nże sprowadzę ją z powrotem.
Dialogue: 0,0:08:23.86,0:08:26.74,Main-207- PL,,0,0,0,,No dobra, to co teraz?
Dialogue: 0,0:08:26.74,0:08:28.61,Main-207- PL,,0,0,0,,Zrobił się tu niezły bałagan.
Dialogue: 0,0:08:30.70,0:08:32.91,Main-207- PL,,0,0,0,,Mówiłem ci, to moje!
Dialogue: 0,0:08:40.92,0:08:43.25,Main-207- PL,,0,0,0,,No dobrze już! Możesz sobie to wziąć!
Dialogue: 0,0:08:43.25,0:08:45.13,Main-207- PL,,0,0,0,,Przecież wiesz, że tego nie zjem!
Dialogue: 0,0:08:45.13,0:08:47.42,Main-207- PL,,0,0,0,,Nie jestem psem, cholera!
Dialogue: 0,0:08:48.63,0:08:49.63,Main-207- PL,,0,0,0,,Cichosza!
Dialogue: 0,0:08:57.89,0:08:58.89,Main-207- PL,,0,0,0,,Spory...
Dialogue: 0,0:08:58.89,0:08:59.60,Main-207- PL,,0,0,0,,Ale co?
Dialogue: 0,0:09:05.40,0:09:06.82,Main-207- PL,,0,0,0,,A to co?
Dialogue: 0,0:09:09.53,0:09:13.62,Main-207- PL,,0,0,0,,{\an8}Morski potwór!
Dialogue: 0,0:09:14.74,0:09:16.99,Main-207- PL,,0,0,0,,Jaka ogromna mućka!
Dialogue: 0,0:09:17.50,0:09:20.25,Main-207- PL,,0,0,0,,Krowa? Przecież one nie pływają.
Dialogue: 0,0:09:20.25,0:09:21.33,Main-207- PL,,0,0,0,,To raczej hipopotam.
Dialogue: 0,0:09:21.33,0:09:24.17,Main-207- PL,,0,0,0,,Co taka bestia robi na East Blue?!
Dialogue: 0,0:09:24.17,0:09:27.13,Main-207- PL,,0,0,0,,Przecież to potwór z Grand Line!
Dialogue: 0,0:09:29.76,0:09:30.84,Main-207- PL,,0,0,0,,Co jest?
Dialogue: 0,0:09:30.84,0:09:32.55,Main-207- PL,,0,0,0,,O co mu chodzi?
Dialogue: 0,0:09:36.22,0:09:37.68,Main-207- PL,,0,0,0,,Pewnie o żarcie!
Dialogue: 0,0:09:37.68,0:09:38.43,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:09:38.43,0:09:39.77,Main-207- PL,,0,0,0,,Szybko, daj mu jeść!
Dialogue: 0,0:09:39.77,0:09:41.14,Main-207- PL,,0,0,0,,Bo nam wywróci łódkę!
Dialogue: 0,0:09:41.14,0:09:43.94,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy Pistolet!
Dialogue: 0,0:09:48.32,0:09:50.57,Main-207- PL,,0,0,0,,Wara od mojego obiadu!
Dialogue: 0,0:09:50.57,0:09:52.91,Main-207- PL,,0,0,0,,Tak jest! To było niesamowite, brachu Luffy!
Dialogue: 0,0:09:56.37,0:09:57.87,Main-207- PL,,0,0,0,,Chyba go wkurzyłeś!
Dialogue: 0,0:09:57.87,0:09:59.25,Main-207- PL,,0,0,0,,Jeszcze ci mało?!
Dialogue: 0,0:09:59.25,0:10:00.45,Main-207- PL,,0,0,0,,Kretynie!
Dialogue: 0,0:10:00.45,0:10:03.29,Main-207- PL,,0,0,0,,Nie znęcaj mi się tu\Nnad głodnym stworzeniem!
Dialogue: 0,0:10:04.25,0:10:07.88,Main-207- PL,,0,0,0,,Założę się, że jest ranny\Ni nie może sam niczego upolować.
Dialogue: 0,0:10:07.88,0:10:09.63,Main-207- PL,,0,0,0,,Mam rację?
Dialogue: 0,0:10:09.63,0:10:11.34,Main-207- PL,,0,0,0,,Cóż za miłosierdzie.
Dialogue: 0,0:10:11.84,0:10:13.26,Main-207- PL,,0,0,0,,No masz, wcinaj.
Dialogue: 0,0:10:13.26,0:10:15.51,Main-207- PL,,0,0,0,,Śmiało, nie wstydź się.
Dialogue: 0,0:10:21.39,0:10:23.52,Main-207- PL,,0,0,0,,Zdychaj, gnoju!
Dialogue: 0,0:10:26.23,0:10:30.48,Main-207- PL,,0,0,0,,A to niby za co?!\NCo z miłosierdziem?!
Dialogue: 0,0:10:30.48,0:10:33.28,Main-207- PL,,0,0,0,,Drań próbował mnie zeżreć żywcem.
Dialogue: 0,0:10:37.66,0:10:39.49,Main-207- PL,,0,0,0,,Wraca! Zatopi nam łódź!
Dialogue: 0,0:10:39.49,0:10:40.33,Main-207- PL,,0,0,0,,Co za natręt!
Dialogue: 0,0:10:40.33,0:10:42.00,Main-207- PL,,0,0,0,,Odsuń się. Ja się tym zajmę.
Dialogue: 0,0:10:46.42,0:10:49.38,Main-207- PL,,0,0,0,,{\fad(150,150)}Collier Shoot!
Dialogue: 0,0:10:52.51,0:10:53.72,Main-207- PL,,0,0,0,,Hipopotamia jego mać...
Dialogue: 0,0:10:58.14,0:11:00.76,Main-207- PL,,0,0,0,,No! To wracamy do szamy!
Dialogue: 0,0:11:00.76,0:11:02.60,Main-207- PL,,0,0,0,,Kości sobie rozprostowałem.
Dialogue: 0,0:11:02.60,0:11:04.85,Main-207- PL,,0,0,0,,Przerażające typki...
Dialogue: 0,0:11:07.44,0:11:08.94,Main-207- PL,,0,0,0,,Co im tyle zajmuje?!
Dialogue: 0,0:11:13.19,0:11:15.78,Main-207- PL,,0,0,0,,Kiedy ten Luffy raczy się tu zjawić?!
Dialogue: 0,0:11:15.78,0:11:18.95,Main-207- PL,,0,0,0,,Jeszcze pięć minut i umrę z nudów!
Comment: 0,0:11:18.74,0:11:21.37,Main-207-,,0,0,0,,Oh! Oh! Oh!
Comment: 0,0:11:21.37,0:11:23.70,Main-207-,,0,0,0,,Oh! Incredible!
Dialogue: 0,0:11:22.24,0:11:23.70,Main-207- PL,,0,0,0,,To niesamowite!
Dialogue: 0,0:11:23.70,0:11:28.29,Main-207- PL,,0,0,0,,{\q2}Nawet Hachyk, wspaniały ośmiorniczy oficer\Nzałogi Arlonga, cię nie wyciągnie!
Dialogue: 0,0:11:28.29,0:11:30.79,Main-207- PL,,0,0,0,,Rybka normalnie ekstraklasa!
Dialogue: 0,0:11:30.79,0:11:36.09,Main-207- PL,,0,0,0,,Nie wiem, coś za jedna, ale odważniejszej rybki\Nna całym East Blue nie widziałem!
Dialogue: 0,0:11:36.09,0:11:37.80,Main-207- PL,,0,0,0,,Och! Co do...?!
Dialogue: 0,0:11:37.80,0:11:39.18,Main-207- PL,,0,0,0,,Och!
Dialogue: 0,0:11:39.18,0:11:41.06,Main-207- PL,,0,0,0,,Cały ten czas to byłem ja?
Dialogue: 0,0:11:43.31,0:11:47.14,Main-207- PL,,0,0,0,,Czyli to ja jestem\Nnajodważniejszą rybką całego East Blue.
Dialogue: 0,0:11:47.14,0:11:49.65,Main-207- PL,,0,0,0,,Chwila, czy to nie dziwne?
Dialogue: 0,0:11:50.27,0:11:51.32,Main-207- PL,,0,0,0,,Trochę dziwne.
Dialogue: 0,0:11:52.32,0:11:54.90,Main-207- PL,,0,0,0,,A-A ty to kto?
Dialogue: 0,0:11:56.57,0:11:57.49,Main-207- PL,,0,0,0,,Ja?
Dialogue: 0,0:11:57.49,0:11:59.53,Main-207- PL,,0,0,0,,Ja jestem Hachyk!
Dialogue: 0,0:11:59.53,0:12:01.41,Main-207- PL,,0,0,0,,Ale mów mi Hachi!
Dialogue: 0,0:12:01.41,0:12:03.29,Main-207- PL,,0,0,0,,Też jesteś ryboludziem?
Dialogue: 0,0:12:03.29,0:12:07.54,Main-207- PL,,0,0,0,,Raczej nie inaczej! Olśniewającym,\Nczarującym ryboludziem-ośmiornicą!
Dialogue: 0,0:12:07.54,0:12:09.71,Main-207- PL,,0,0,0,,Z tego, co widzę, jesteś człowiekiem?
Dialogue: 0,0:12:09.71,0:12:10.58,Main-207- PL,,0,0,0,,A-Ano.
Dialogue: 0,0:12:10.58,0:12:13.34,Main-207- PL,,0,0,0,,Przybywasz z Marynarki?\NA może w gościnę?
Dialogue: 0,0:12:13.67,0:12:14.88,Main-207- PL,,0,0,0,,W gościnę?
Dialogue: 0,0:12:16.42,0:12:18.01,Main-207- PL,,0,0,0,,No, trochę się tu ugościłem.
Dialogue: 0,0:12:18.01,0:12:20.22,Main-207- PL,,0,0,0,,Kapitana Arlonga\Njeszcze nie ma, prawda?
Dialogue: 0,0:12:20.22,0:12:21.93,Main-207- PL,,0,0,0,,Nie ma. A gdzie poszedł?
Dialogue: 0,0:12:21.93,0:12:27.35,Main-207- PL,,0,0,0,,Podobno jakiś długonosy\Nzbieg błąka się po okolicy.
Dialogue: 0,0:12:27.35,0:12:29.98,Main-207- PL,,0,0,0,,Chwilę po tym,\Njak zamknął tu jego koleżkę,
Dialogue: 0,0:12:29.98,0:12:33.07,Main-207- PL,,0,0,0,,Arlong poszedł do wioski\NCocoyashi, by go schwytać.
Dialogue: 0,0:12:33.48,0:12:35.19,Main-207- PL,,0,0,0,,Usopp, hm...?
Dialogue: 0,0:12:35.19,0:12:36.99,Thoughts-207- PL,,0,0,0,,Chyba powinienem mu pomóc.
Dialogue: 0,0:12:39.24,0:12:41.12,Main-207- PL,,0,0,0,,Ta cała wioska Cocoyashi...
Dialogue: 0,0:12:42.16,0:12:42.99,Main-207- PL,,0,0,0,,W którą to stronę?
Dialogue: 0,0:12:42.99,0:12:44.12,Main-207- PL,,0,0,0,,Wsiadaj.
Dialogue: 0,0:12:46.54,0:12:48.29,Main-207- PL,,0,0,0,,Wspominałeś, żeś gość, tak?
Dialogue: 0,0:12:48.29,0:12:49.58,Main-207- PL,,0,0,0,,Zabiorę cię tam,
Dialogue: 0,0:12:50.21,0:12:51.83,Main-207- PL,,0,0,0,,szermierzu.
Dialogue: 0,0:13:04.26,0:13:06.93,Main-207- PL,,0,0,0,,Szlag! Nie mogę ich zgubić!
Dialogue: 0,0:13:10.73,0:13:12.52,Main-207- PL,,0,0,0,,G-Gdzie on jest?
Dialogue: 0,0:13:13.23,0:13:17.57,Main-207- PL,,0,0,0,,{\q2}Który z zebranych tutaj uważa, że śmierć\NWspaniałego Usoppa byłaby wielką stratą?
Dialogue: 0,0:13:17.57,0:13:18.69,Main-207- PL,,0,0,0,,Ja!
Dialogue: 0,0:13:18.69,0:13:20.70,Main-207- PL,,0,0,0,,Ja! Ja! Ja! Ja!
Dialogue: 0,0:13:21.07,0:13:23.49,Main-207- PL,,0,0,0,,Co ten idiota kombinuje?!
Dialogue: 0,0:13:23.87,0:13:25.95,Main-207- PL,,0,0,0,,Och, czyli wy też tak myślicie?
Dialogue: 0,0:13:25.95,0:13:27.12,Main-207- PL,,0,0,0,,Ja też!
Dialogue: 0,0:13:33.04,0:13:34.04,Main-207- PL,,0,0,0,,C-Co?
Dialogue: 0,0:13:36.46,0:13:38.71,Main-207- PL,,0,0,0,,{\fad(150,150)}Zabójcza Jajkowa Gwiazda!
Dialogue: 0,0:13:48.47,0:13:51.23,Main-207- PL,,0,0,0,,Co wy na to?!\NJuż nie tacy hop do przodu!
Dialogue: 0,0:13:51.23,0:13:53.90,Main-207- PL,,0,0,0,,Wygląda na to, że kapitan\NUsopp wam uciekł!
Dialogue: 0,0:13:56.32,0:13:57.65,Main-207- PL,,0,0,0,,J-Ja nic nie wiem!
Dialogue: 0,0:14:09.75,0:14:10.66,Main-207- PL,,0,0,0,,Co jest?
Dialogue: 0,0:14:10.66,0:14:11.41,Main-207- PL,,0,0,0,,A temu co?
Dialogue: 0,0:14:14.67,0:14:16.63,Main-207- PL,,0,0,0,,Dzięki za otuchę!
Dialogue: 0,0:14:16.63,0:14:19.84,Main-207- PL,,0,0,0,,Jak widać, nic mi się nie stało!
Dialogue: 0,0:14:24.72,0:14:26.43,Main-207- PL,,0,0,0,,Oto wioska Cocoyashi.
Dialogue: 0,0:14:26.43,0:14:29.01,Main-207- PL,,0,0,0,,Kapitan Arlong powinien gdzieś tu być.
Dialogue: 0,0:14:29.01,0:14:30.52,Main-207- PL,,0,0,0,,Co? A, no tak. Dzięki.
Dialogue: 0,0:14:30.52,0:14:33.10,Main-207- PL,,0,0,0,,Nie ma za co! Na razie!
Dialogue: 0,0:14:35.73,0:14:39.27,Main-207- PL,,0,0,0,,Ups! Teraz się zorientowałem,\Nże nie spytałem cię o imię!
Dialogue: 0,0:14:39.27,0:14:42.78,Main-207- PL,,0,0,0,,Co? Moje imię? A po co ci moje imię?
Dialogue: 0,0:14:42.78,0:14:44.32,Main-207- PL,,0,0,0,,Moje imię to Hachyk!
Dialogue: 0,0:14:44.32,0:14:46.16,Main-207- PL,,0,0,0,,Do zobaczenia!
Dialogue: 0,0:14:47.57,0:14:48.78,Main-207- PL,,0,0,0,,Co za dziwak.
Dialogue: 0,0:15:01.63,0:15:03.92,Main-207- PL,,0,0,0,,C-Co się tu wydarzyło?!
Dialogue: 0,0:15:05.93,0:15:07.68,Main-207- PL,,0,0,0,,Co tu się stało...
Dialogue: 0,0:15:10.26,0:15:12.72,Main-207- PL,,0,0,0,,bracia moi?!
Dialogue: 0,0:15:14.85,0:15:16.31,Main-207- PL,,0,0,0,,Roronoa...
Dialogue: 0,0:15:17.94,0:15:20.36,Main-207- PL,,0,0,0,,Co? Co próbujesz powiedzieć?!
Dialogue: 0,0:15:21.11,0:15:23.57,Main-207- PL,,0,0,0,,Roronoa Zoro...!
Dialogue: 0,0:15:23.57,0:15:24.57,Main-207- PL,,0,0,0,,Słucham?!
Dialogue: 0,0:15:24.57,0:15:26.53,Main-207- PL,,0,0,0,,Łowca Piratów?!
Dialogue: 0,0:15:26.53,0:15:28.82,Main-207- PL,,0,0,0,,Przybył po moją głowę?!
Dialogue: 0,0:15:31.33,0:15:34.79,Main-207- PL,,0,0,0,,N-Nie, on nie przybył...\NTamten gość...
Dialogue: 0,0:15:35.58,0:15:36.92,Main-207- PL,,0,0,0,,To właśnie był... Zoro!
Dialogue: 0,0:15:36.92,0:15:37.96,Main-207- PL,,0,0,0,,Że co?!
Dialogue: 0,0:15:38.42,0:15:42.84,Main-207- PL,,0,0,0,,Tamten gość z przepaską na brzuchu,\Nktórego złapaliśmy, to był Roronoa...
Dialogue: 0,0:15:47.76,0:15:49.14,Main-207- PL,,0,0,0,,Złapałem leszcza!
Dialogue: 0,0:15:50.10,0:15:52.18,Main-207- PL,,0,0,0,,C-Co tu się stało?!
Dialogue: 0,0:15:53.18,0:15:55.10,Thoughts-207- PL,,0,0,0,,T-To robota Zoro...?!
Dialogue: 0,0:15:58.52,0:16:03.65,Main-207- PL,,0,0,0,,Złapanie tej szumowiny\Nto dla mnie za mało!
Dialogue: 0,0:16:05.07,0:16:08.32,Main-207- PL,,0,0,0,,C-Co nie?! W takim razie\Npuść mnie wolno!
Dialogue: 0,0:16:08.32,0:16:10.03,Main-207- PL,,0,0,0,,Ja się tylko chciałem przywitać!
Dialogue: 0,0:16:10.03,0:16:12.83,Main-207- PL,,0,0,0,,W-Właśnie tak się\Nwitamy w mojej wiosce!
Dialogue: 0,0:16:15.54,0:16:18.87,Main-207- PL,,0,0,0,,Nawet jeśli, to nadal jesteś\Njednym z ludzi Zoro.
Dialogue: 0,0:16:20.33,0:16:24.96,Main-207- PL,,0,0,0,,Cóż, to nic nadzwyczajnego,\Nże łowcy nagród chcą mojej głowy.
Dialogue: 0,0:16:27.67,0:16:29.76,Main-207- PL,,0,0,0,,Litości!
Dialogue: 0,0:16:29.76,0:16:34.10,Main-207- PL,,0,0,0,,Nie mam nic wspólnego z tym Zoro!
Dialogue: 0,0:16:34.97,0:16:36.93,Main-207- PL,,0,0,0,,Dość tych bezczelnych kłamstw.
Dialogue: 0,0:16:36.93,0:16:39.14,Main-207- PL,,0,0,0,,Ty też postawiłeś się\Nkapitanowi Arlongowi.
Dialogue: 0,0:16:39.14,0:16:41.56,Main-207- PL,,0,0,0,,Tak czy inaczej zginiesz.
Dialogue: 0,0:16:42.94,0:16:47.57,Main-207- PL,,0,0,0,,E-Ej! Tak naprawdę to jestem\Nbliskim kumplem Zoro!
Dialogue: 0,0:16:47.57,0:16:49.57,Main-207- PL,,0,0,0,,Więc spróbuj tylko mnie tknąć!
Dialogue: 0,0:16:49.57,0:16:51.37,Main-207- PL,,0,0,0,,Zoro nie puści ci tego płazem!
Dialogue: 0,0:16:51.37,0:16:52.24,Main-207- PL,,0,0,0,,Ach tak?
Dialogue: 0,0:16:52.24,0:16:56.20,Main-207- PL,,0,0,0,,W takim razie jeśli cię zabiję,\Nto Zoro nam tu grzecznie wróci?
Dialogue: 0,0:16:57.96,0:17:00.08,Main-207- PL,,0,0,0,,N-Nie, to zupełnie nie tak!
Dialogue: 0,0:17:00.08,0:17:04.09,Main-207- PL,,0,0,0,,Zabijanie mnie to bardzo zły pomysł!\NZoro pewnie chciałby mnie żywego!
Dialogue: 0,0:17:04.09,0:17:07.38,Main-207- PL,,0,0,0,,Wróć, Zoro wróci tu tylko wtedy,\Ngdy zostawisz mnie przy życiu!
Dialogue: 0,0:17:07.88,0:17:10.05,Main-207- PL,,0,0,0,,Zastanawia mnie jednak, jakim cudem Zoro...
Dialogue: 0,0:17:11.22,0:17:12.76,Main-207- PL,,0,0,0,,uciekł z naszego więzienia?
Dialogue: 0,0:17:12.76,0:17:14.26,Main-207- PL,,0,0,0,,Co masz na myśli?
Dialogue: 0,0:17:14.26,0:17:16.89,Main-207- PL,,0,0,0,,Mam na myśli, że ktoś\Nmusiał pomóc mu uciec.
Dialogue: 0,0:17:18.18,0:17:19.81,Main-207- PL,,0,0,0,,Kapitanie Arlongu.
Dialogue: 0,0:17:19.81,0:17:22.06,Main-207- PL,,0,0,0,,Co o tym sądzisz?
Dialogue: 0,0:17:22.06,0:17:27.23,Main-207- PL,,0,0,0,,{\q2}Co, jeśli to Nami wpuściła Zoro na twój teren,\Naby ten mógł cię łatwo dopaść?
Dialogue: 0,0:17:27.90,0:17:31.20,Main-207- PL,,0,0,0,,M-Możliwe. Dziwnie się ostatnio\Nzachowuje ta nasza Nami.
Dialogue: 0,0:17:31.20,0:17:34.24,Main-207- PL,,0,0,0,,No właśnie. Gdy Zoro wpadł do wody,\Nta skoczyła mu na ratunek.
Dialogue: 0,0:17:34.24,0:17:37.37,Main-207- PL,,0,0,0,,Nie mówcie mi, że cały ten czas\Nbyła wspólniczką Zoro.
Dialogue: 0,0:17:37.37,0:17:38.87,Main-207- PL,,0,0,0,,Daliśmy się oszukać?!
Dialogue: 0,0:17:40.08,0:17:43.17,Main-207- PL,,0,0,0,,W końcu zdrada to jej drugie imię.
Dialogue: 0,0:17:43.67,0:17:45.34,Main-207- PL,,0,0,0,,Dość tych bredni!
Dialogue: 0,0:17:47.75,0:17:50.92,Main-207- PL,,0,0,0,,Te pomówienia was\Nnigdzie nie zaprowadzą!
Dialogue: 0,0:17:52.26,0:17:53.09,Main-207- PL,,0,0,0,,Nami...
Dialogue: 0,0:17:53.72,0:17:55.60,Main-207- PL,,0,0,0,,Zważaj na słowa!
Dialogue: 0,0:17:56.10,0:17:59.35,Main-207- PL,,0,0,0,,Od ośmiu lat noszę ten tatuaż...
Dialogue: 0,0:18:00.60,0:18:02.94,Main-207- PL,,0,0,0,,jako dowód lojalności wobec załogi!
Dialogue: 0,0:18:04.56,0:18:06.61,Main-207- PL,,0,0,0,,Wybacz, wybacz.
Dialogue: 0,0:18:06.61,0:18:07.44,Main-207- PL,,0,0,0,,Nami.
Dialogue: 0,0:18:07.44,0:18:10.28,Main-207- PL,,0,0,0,,Masz prawo się gniewać.
Dialogue: 0,0:18:10.28,0:18:15.87,Main-207- PL,,0,0,0,,Ale możesz być spokojna.\NNigdy bym cię nie podejrzewał.
Dialogue: 0,0:18:15.87,0:18:18.95,Main-207- PL,,0,0,0,,To prawda, znamy się\Njuż od ośmiu długich lat!
Dialogue: 0,0:18:19.41,0:18:22.41,Main-207- PL,,0,0,0,,Po prostu nas trochę poniosło.
Dialogue: 0,0:18:22.41,0:18:24.83,Main-207- PL,,0,0,0,,Mam rację, Nami?
Dialogue: 0,0:18:24.83,0:18:29.21,Main-207- PL,,0,0,0,,Pozbyć się musimy Roronoi Zoro\Ni reszty jego bandy!
Dialogue: 0,0:18:29.21,0:18:30.80,Main-207- PL,,0,0,0,,H-Hej, Nami!
Dialogue: 0,0:18:30.80,0:18:33.30,Main-207- PL,,0,0,0,,P-Powiedz no coś!
Dialogue: 0,0:18:33.30,0:18:34.84,Main-207- PL,,0,0,0,,N-Nami!
Dialogue: 0,0:18:37.55,0:18:39.97,Thoughts-207- PL,,0,0,0,,Oczywiście, że Zoro\Nmusiał nabałaganić...
Dialogue: 0,0:18:42.93,0:18:44.27,Main-207- PL,,0,0,0,,Coś nie tak, Nami?
Dialogue: 0,0:18:47.11,0:18:49.44,Main-207- PL,,0,0,0,,Trochę zbladłaś.
Dialogue: 0,0:18:50.86,0:18:53.11,Main-207- PL,,0,0,0,,A co do koleżki długonosego...
Dialogue: 0,0:18:54.28,0:18:57.87,Main-207- PL,,0,0,0,,nawet ty nie zdołałabyś go już uratować.
Dialogue: 0,0:18:58.20,0:19:01.04,Main-207- PL,,0,0,0,,Nie po tym, jak sprzeciwił\Nsię kapitanowi Arlongowi.
Dialogue: 0,0:19:01.04,0:19:02.16,Main-207- PL,,0,0,0,,Jak długo...
Dialogue: 0,0:19:02.79,0:19:05.29,Main-207- PL,,0,0,0,,Jak długo zamierzacie\Nmnie podejrzewać?!
Dialogue: 0,0:19:05.29,0:19:08.09,Main-207- PL,,0,0,0,,Jesteś zbyt sprytna\Nna swoją niekorzyść.
Dialogue: 0,0:19:08.09,0:19:11.80,Main-207- PL,,0,0,0,,Już niebawem zgromadzę całą sumę,\Nna którą umówiłam się z Arlongiem!
Dialogue: 0,0:19:11.80,0:19:13.59,Main-207- PL,,0,0,0,,Po co miałabym was teraz zdradzać?!
Dialogue: 0,0:19:13.92,0:19:15.22,Main-207- PL,,0,0,0,,Tak, wiem o tym...
Dialogue: 0,0:19:15.97,0:19:21.39,Main-207- PL,,0,0,0,,{\q2}Osiem lat temu umówiłaś się z Arlongiem,\Nże wykupisz Cocoyashi za sto milionów berry.
Dialogue: 0,0:19:22.89,0:19:25.52,Main-207- PL,,0,0,0,,Po prostu nie mogę czegoś pojąć.
Dialogue: 0,0:19:25.89,0:19:31.07,Main-207- PL,,0,0,0,,Zdradziłaś własną matkę i mieszkańców\Nswojej wioski. Ufasz jedynie pieniądzom.
Dialogue: 0,0:19:31.07,0:19:33.53,Main-207- PL,,0,0,0,,Skąd więc ta troska o wioskę Cocoyashi?
Dialogue: 0,0:19:33.53,0:19:36.86,Main-207- PL,,0,0,0,,Co różni ją od reszty marnych wiosek?
Dialogue: 0,0:19:37.36,0:19:40.49,Main-207- PL,,0,0,0,,I tak się składa, że znalazłem coś takiego...
Dialogue: 0,0:19:40.83,0:19:42.62,Main-207- PL,,0,0,0,,w twoim pokoju.
Dialogue: 0,0:19:46.04,0:19:47.29,Main-207- PL,,0,0,0,,P-Przecież to...
Dialogue: 0,0:19:48.13,0:19:49.33,Main-207- PL,,0,0,0,,moja...
Dialogue: 0,0:19:50.42,0:19:52.09,Main-207- PL,,0,0,0,,C-Co powiedziałeś?!
Dialogue: 0,0:19:52.55,0:19:54.09,Main-207- PL,,0,0,0,,Złapali Usoppa?!
Dialogue: 0,0:19:54.09,0:19:57.59,Main-207- PL,,0,0,0,,A tak! Nie tak dawno temu\Nzabrali go do Arlong Parku!
Dialogue: 0,0:19:57.59,0:20:00.85,Main-207- PL,,0,0,0,,Dzielny to był młodzieniec!\NPostawił się samemu Arlongowi!
Dialogue: 0,0:20:00.85,0:20:02.60,Main-207- PL,,0,0,0,,Pewnie już go załatwili!
Dialogue: 0,0:20:05.10,0:20:06.06,Main-207- PL,,0,0,0,,Niech to...
Dialogue: 0,0:20:06.77,0:20:10.56,Main-207- PL,,0,0,0,,Cały czas tam byłem, a ten daje się\Nzłapać akurat, jak sobie poszedłem?
Dialogue: 0,0:20:12.69,0:20:14.94,Main-207- PL,,0,0,0,,Usopp! Nie waż mi się umierać!
Dialogue: 0,0:20:29.58,0:20:33.63,Main-207- PL,,0,0,0,,Cała naprzód! Do Arlong Parku!
Dialogue: 0,0:20:46.48,0:20:49.27,Main-207- PL,,0,0,0,,Czekaj na mnie, Nami!
Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=31}===============================DIALOGUE============================
