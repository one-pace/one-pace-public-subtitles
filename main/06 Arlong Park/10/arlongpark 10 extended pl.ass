Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=20}===============================DIALOGUE============================
Dialogue: 0,0:01:53.51,0:01:54.43,Main-207- PL,,0,0,0,,– Wygrał!\N– Wygrał!
Dialogue: 0,0:01:55.47,0:01:59.43,Main-207- PL,,0,0,0,,Arlong Park upadł!
Dialogue: 0,0:02:01.06,0:02:02.60,Main-207- PL,,0,0,0,,Udało się, Nojiko!
Dialogue: 0,0:02:02.06,0:02:02.60,Secondary-207- PL,,0,0,0,,Gen!
Dialogue: 0,0:02:02.98,0:02:06.69,Main-207- PL,,0,0,0,,To... To się dzieje naprawdę?
Dialogue: 0,0:02:06.69,0:02:08.61,Main-207- PL,,0,0,0,,Nie sądziłem,\Nże ten dzień nastanie...
Dialogue: 0,0:02:21.79,0:02:25.42,Main-207- PL,,0,0,0,,Dobra robota, Luffy!\NZasługujesz na moją pochwałę!
Dialogue: 0,0:02:25.42,0:02:31.09,Main-207- PL,,0,0,0,,{\q2}Szkoda jednak, że nie dałeś mi zabłysnąć!\NW końcu to ja jestem dzisiejszą gwiazdą!
Dialogue: 0,0:02:31.76,0:02:34.05,Main-207- PL,,0,0,0,,Ten to potrafi trzymać w napięciu...
Dialogue: 0,0:02:34.93,0:02:39.51,Main-207- PL,,0,0,0,,Następnym razem załatw sprawę\Nnieco szybciej, z łaski swojej!
Dialogue: 0,0:03:08.33,0:03:10.09,Main-207- PL,,0,0,0,,Odjazdowo!
Dialogue: 0,0:03:23.14,0:03:25.14,Main-207- PL,,0,0,0,,Koniec tego dobrego, wieśniaki!
Dialogue: 0,0:03:26.27,0:03:27.10,Main-207- PL,,0,0,0,,To znowu on...!
Dialogue: 0,0:03:28.60,0:03:30.86,Main-207- PL,,0,0,0,,Los się do mnie uśmiecha!
Dialogue: 0,0:03:30.86,0:03:34.74,Main-207- PL,,0,0,0,,Fakt, kawał dobrej roboty.\NOglądałem całą walkę osobiście.
Dialogue: 0,0:03:34.74,0:03:39.28,Main-207- PL,,0,0,0,,Może i miałeś fuksa, ale nigdy bym się\Nnie spodziewał, że ryboludzie przegrają,
Dialogue: 0,0:03:39.28,0:03:42.08,Main-207- PL,,0,0,0,,a już zwłaszcza z bandą\Npodrzędnych piracin.
Dialogue: 0,0:03:43.04,0:03:46.62,Main-207- PL,,0,0,0,,Jednakże dzięki waszej pomocy\Ndziałka Arlonga należy do mnie,
Dialogue: 0,0:03:46.62,0:03:50.96,Main-207- PL,,0,0,0,,podobnie jak reszta kosztowności\Nzgromadzona w Arlong Parku!
Dialogue: 0,0:03:50.96,0:03:52.30,Main-207- PL,,0,0,0,,Wszyscy, rzucić broń!
Dialogue: 0,0:03:52.30,0:03:55.51,Main-207- PL,,0,0,0,,Honory za wasze zasługi przejmę ja,
Dialogue: 0,0:03:55.51,0:03:57.43,Main-207- PL,,0,0,0,,komandor Nezumi z 16. Bazy Marynarki...
Dialogue: 0,0:04:00.01,0:04:00.64,Main-207- PL,,0,0,0,,Zoro!
Dialogue: 0,0:04:01.10,0:04:04.85,Main-207- PL,,0,0,0,,Ludzie cieszą się ze zwycięstwa.\NNie wtranżalaj się, dziadu.
Dialogue: 0,0:04:10.23,0:04:15.15,Main-207- PL,,0,0,0,,S-Spróbuj się na mnie krzywo\Nspojrzeć! Pożałujesz, że się...!
Dialogue: 0,0:04:15.15,0:04:16.57,Main-207- PL,,0,0,0,,Nadal coś tam jęczysz?
Dialogue: 0,0:04:20.28,0:04:22.70,Main-207- PL,,0,0,0,,To za postrzelenie Nojiko...
Dialogue: 0,0:04:23.28,0:04:27.62,Main-207- PL,,0,0,0,,oraz za zbezczeszczenie plantacji\Nmandarynek Bell-mère z premedytacją.
Dialogue: 0,0:04:27.62,0:04:28.12,Main-207- PL,,0,0,0,,Z czym?
Dialogue: 0,0:04:30.96,0:04:32.21,Main-207- PL,,0,0,0,,Panie komandorze!
Dialogue: 0,0:04:36.96,0:04:39.59,Main-207- PL,,0,0,0,,Dzięki, Nami! Troszkę mi lepiej.
Dialogue: 0,0:04:39.59,0:04:42.09,Main-207- PL,,0,0,0,,A zdziel go jeszcze tak z tysiąc razy!
Dialogue: 0,0:04:48.27,0:04:51.65,Main-207- PL,,0,0,0,,Macie zająć się bałaganem,\Nktóry zrobili nam ryboludzie!
Dialogue: 0,0:04:51.65,0:04:54.02,Main-207- PL,,0,0,0,,Miasteczko Gosa też\Nsię samo nie odbuduje!
Dialogue: 0,0:04:54.02,0:04:58.11,Main-207- PL,,0,0,0,,I ani mi się ważcie choćby\Ntknąć skarbów Arlong Parku!
Dialogue: 0,0:04:58.11,0:05:00.49,Main-207- PL,,0,0,0,,Od dziś należą do wioski! Jasne?!
Dialogue: 0,0:05:00.49,0:05:04.41,Main-207- PL,,0,0,0,,Au! Au! J-Jak słońce!
Dialogue: 0,0:05:04.41,0:05:05.99,Main-207- PL,,0,0,0,,Jeszcze jedno!
Dialogue: 0,0:05:06.45,0:05:08.20,Main-207- PL,,0,0,0,,Oddawaj moją kasę!
Dialogue: 0,0:05:08.54,0:05:13.67,Main-207- PL,,0,0,0,,Oddam! Oddam wszystko!\NWszystko mi już jedno...
Dialogue: 0,0:05:17.00,0:05:19.51,Main-207- PL,,0,0,0,,Popamiętacie mnie, przebrzydli piraci!
Dialogue: 0,0:05:19.51,0:05:22.09,Main-207- PL,,0,0,0,,Ty w słomkowym kapeluszu!\NLuffy, dobrze pamiętam?!
Dialogue: 0,0:05:22.47,0:05:25.10,Main-207- PL,,0,0,0,,To ty jesteś ich kapitanem?!\NPamiętaj o jednym!
Dialogue: 0,0:05:25.10,0:05:28.06,Main-207- PL,,0,0,0,,Było ze mną nie zadzierać!\NTeraz macie przechlapane!
Dialogue: 0,0:05:28.43,0:05:30.43,Main-207- PL,,0,0,0,,{\an8}Skrucha ci nie pomoże!
Dialogue: 0,0:05:30.43,0:05:34.19,Main-207- PL,,0,0,0,,{\an8}Zemsta będzie słodka!\NNiebawem się przekonasz!
Dialogue: 0,0:05:34.19,0:05:36.69,Main-207- PL,,0,0,0,,Słyszałeś? Mamy przechlapane.
Dialogue: 0,0:05:36.69,0:05:40.07,Main-207- PL,,0,0,0,,Ciekawe, skąd on wie,\Nże próbuję zostać Królem Piratów?
Dialogue: 0,0:05:40.07,0:05:42.95,Main-207- PL,,0,0,0,,Przecież nie o to mu\Nchodziło, deklu jeden!
Dialogue: 0,0:05:42.95,0:05:46.53,Main-207- PL,,0,0,0,,H-Hej, to co teraz?! A co, jeśli\Nserio mamy przechlapane?!
Dialogue: 0,0:05:46.53,0:05:48.58,Main-207- PL,,0,0,0,,No?! No?! Co wtedy?!
Dialogue: 0,0:05:49.08,0:05:53.08,Main-207- PL,,0,0,0,,No dobra, słuchajcie!\NNie możemy świętować sami!
Dialogue: 0,0:05:53.08,0:05:56.34,Main-207- PL,,0,0,0,,Trzeba przekazać wieści\Nreszcie mieszkańców!
Dialogue: 0,0:05:58.67,0:06:00.13,Main-207- PL,,0,0,0,,Arlong Park...
Dialogue: 0,0:06:00.13,0:06:02.84,Main-207- PL,,0,0,0,,Arlong Park upadł!
Dialogue: 0,0:06:04.05,0:06:08.06,Main-207- PL,,0,0,0,,Gdzieś cię boli, Zoro? Może tutaj?
Dialogue: 0,0:06:05.43,0:06:08.06,Secondary-207- PL,,0,0,0,,Co? O co ci... Hej!
Dialogue: 0,0:06:17.19,0:06:19.40,Main-207- PL,,0,0,0,,Masz szczęście, Nami.
Dialogue: 0,0:06:20.74,0:06:24.74,Main-207- PL,,0,0,0,,Kto by pomyślał, że ocalą nas piraci...
Dialogue: 0,0:06:24.74,0:06:26.74,Main-207- PL,,0,0,0,,Życie jest pełne niespodzianek.
Dialogue: 0,0:06:43.55,0:06:46.55,Main-207- PL,,0,0,0,,Co z tobą, Nami? Dalej tu siedzisz?
Dialogue: 0,0:06:47.30,0:06:49.56,Main-207- PL,,0,0,0,,Przyjaciele cię szukają.
Dialogue: 0,0:06:51.56,0:06:53.18,Main-207- PL,,0,0,0,,Hej, Nojiko...
Dialogue: 0,0:06:53.18,0:06:53.68,Main-207- PL,,0,0,0,,Hm?
Dialogue: 0,0:06:53.68,0:06:54.52,Main-207- PL,,0,0,0,,Gen...
Dialogue: 0,0:06:54.52,0:06:55.14,Main-207- PL,,0,0,0,,Hm?
Dialogue: 0,0:06:55.14,0:06:57.65,Main-207- PL,,0,0,0,,Gdyby Bell-mère nadal tu była,
Dialogue: 0,0:06:57.65,0:07:00.61,Main-207- PL,,0,0,0,,to zabroniłaby mi zostać piratką?
Dialogue: 0,0:07:01.23,0:07:02.61,Main-207- PL,,0,0,0,,Piratką?!
Dialogue: 0,0:07:03.24,0:07:04.99,Main-207- PL,,0,0,0,,Nawet sobie nie żartuj!
Dialogue: 0,0:07:04.99,0:07:08.24,Main-207- PL,,0,0,0,,Nigdy by nie pozwoliła, żeby\Njej córcia została piratką!
Dialogue: 0,0:07:08.24,0:07:09.91,Main-207- PL,,0,0,0,,Właśnie że by pozwoliła!
Dialogue: 0,0:07:08.95,0:07:09.91,Secondary-207- PL,,0,0,0,,Nojiko!
Dialogue: 0,0:07:09.91,0:07:11.08,Main-207- PL,,0,0,0,,A nawet gdyby nie...
Dialogue: 0,0:07:11.87,0:07:13.54,Main-207- PL,,0,0,0,,to posłuchałabyś się jej?
Dialogue: 0,0:07:15.16,0:07:17.54,Main-207- PL,,0,0,0,,A w życiu!
Dialogue: 0,0:07:20.42,0:07:21.50,Main-207- PL,,0,0,0,,Czyli to tak...
Dialogue: 0,0:07:24.17,0:07:25.51,Main-207- PL,,0,0,0,,Co w tym śmiesznego, Gen?
Dialogue: 0,0:07:28.47,0:07:31.97,Main-207- PL,,0,0,0,,Bez wątpienia jesteście\Ncórkami Bell-mère.
Dialogue: 0,0:07:31.97,0:07:33.27,Main-207- PL,,0,0,0,,Gen?
Dialogue: 0,0:07:33.27,0:07:34.23,Main-207- PL,,0,0,0,,Nami.
Dialogue: 0,0:07:34.23,0:07:36.77,Main-207- PL,,0,0,0,,Ty i tak już podjęłaś decyzję, prawda?
Dialogue: 0,0:07:36.77,0:07:38.31,Main-207- PL,,0,0,0,,Więc żyj po swojemu.
Dialogue: 0,0:07:39.06,0:07:40.98,Main-207- PL,,0,0,0,,Tak samo jak twoja matka.
Dialogue: 0,0:07:47.41,0:07:48.61,Main-207- PL,,0,0,0,,A ten znowu zaczyna.
Dialogue: 0,0:07:49.53,0:07:52.41,Main-207- PL,,0,0,0,,Drze się, jakby go\Ntam ze skóry obdzierali.
Dialogue: 0,0:07:52.41,0:07:53.91,Main-207- PL,,0,0,0,,Nie ma co się dziwić.
Dialogue: 0,0:07:53.91,0:07:56.87,Main-207- PL,,0,0,0,,W normalnym tempie\Ntakie rany goiłyby się ze dwa lata!
Dialogue: 0,0:07:58.62,0:07:59.96,Main-207- PL,,0,0,0,,No debil!
Dialogue: 0,0:08:00.46,0:08:02.92,Main-207- PL,,0,0,0,,Kto to widział opatrywać\Ntakie rany samemu!
Dialogue: 0,0:08:02.92,0:08:04.09,Main-207- PL,,0,0,0,,Aua!
Dialogue: 0,0:08:04.09,0:08:07.13,Main-207- PL,,0,0,0,,Cholera! Czy wy na pewno\Njesteście piratami?!
Dialogue: 0,0:08:07.13,0:08:08.38,Main-207- PL,,0,0,0,,Macie wy chociaż...
Dialogue: 0,0:08:09.30,0:08:10.47,Main-207- PL,,0,0,0,,lekarza na pokładzie?!
Dialogue: 0,0:08:10.47,0:08:12.89,Main-207- PL,,0,0,0,,Lekarza? Brzmi nieźle!
Dialogue: 0,0:08:13.26,0:08:13.76,Main-207- PL,,0,0,0,,Luffy?
Dialogue: 0,0:08:13.76,0:08:16.14,Main-207- PL,,0,0,0,,Ale najpierw grajek. Co nie, Zoro?
Dialogue: 0,0:08:16.14,0:08:17.39,Main-207- PL,,0,0,0,,Z jakiej racji?!
Dialogue: 0,0:08:17.39,0:08:19.65,Main-207- PL,,0,0,0,,Bo piraci muszą śpiewać!
Dialogue: 0,0:08:19.65,0:08:22.31,Main-207- PL,,0,0,0,,No dobrze, ale dlaczego najpierw on?!
Dialogue: 0,0:08:22.31,0:08:24.32,Main-207- PL,,0,0,0,,Halo?! Halo?!
Dialogue: 0,0:08:24.32,0:08:26.19,Main-207- PL,,0,0,0,,{\i1}Tak. Tu Kwatera Główna Marynarki.
Dialogue: 0,0:08:26.19,0:08:27.95,Main-207- PL,,0,0,0,,Kwatera Główna?! Dodzwoniłem się?!
Dialogue: 0,0:08:27.95,0:08:32.49,Main-207- PL,,0,0,0,,Halo halo! Mówi komandor Nezumi\Nz 16. Bazy Marynarki!
Dialogue: 0,0:08:32.49,0:08:35.08,Main-207- PL,,0,0,0,,Mój kod to zero zero, siedem, trzy trzy!
Dialogue: 0,0:08:35.62,0:08:36.95,Main-207- PL,,0,0,0,,Muszę rozmawiać z Kwaterą!
Dialogue: 0,0:08:36.95,0:08:39.33,Main-207- PL,,0,0,0,,{\q2\i1}Po co się tak drzesz? Przecież cię słyszę.
Dialogue: 0,0:08:39.33,0:08:43.25,Main-207- PL,,0,0,0,,{\an8}Słuchaj uważnie! Spotkałem pirata\Nw słomkowym kapeluszu! Nazywa się Luffy!
Dialogue: 0,0:08:43.25,0:08:47.47,Main-207- PL,,0,0,0,,{\an8\i1}Słuchaj uważnie! Spotkałem pirata\Nw słomkowym kapeluszu! Nazywa się Luffy!
Dialogue: 0,0:08:47.47,0:08:51.97,Main-207- PL,,0,0,0,,Niniejszym uznaję go oraz całą jego\Nczteroosobową załogę za wrogów rządu!
Dialogue: 0,0:08:52.43,0:08:57.06,Main-207- PL,,0,0,0,,{\i1\an8}Niniejszym uznaję go oraz całą jego\Nczteroosobową załogę za wrogów rządu!
Dialogue: 0,0:08:57.06,0:08:58.56,Main-207- PL,,0,0,0,,„Luffy”...
Dialogue: 0,0:08:58.56,0:09:03.94,Main-207- PL,,0,0,0,,{\q2}Udało im się obalić Arlong Park, a wraz z nim\Nnieposkromionych ryboludzi, załogę Arlonga!
Dialogue: 0,0:09:03.94,0:09:06.57,Main-207- PL,,0,0,0,,Biorąc pod uwagę powagę sytuacji,
Dialogue: 0,0:09:06.57,0:09:10.07,Main-207- PL,,0,0,0,,wyznaczyłem nagrodę za głowę\Nkapitana, Słomkowego Luffy'ego!
Dialogue: 0,0:09:10.07,0:09:11.70,Main-207- PL,,0,0,0,,Przesyłam wam fotografię!
Dialogue: 0,0:09:11.70,0:09:12.78,Main-207- PL,,0,0,0,,{\i1}Przyjąłem.{\i0}
Dialogue: 0,0:09:16.62,0:09:17.50,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:09:17.50,0:09:20.25,Main-207- PL,,0,0,0,,Lepszego zdjęcia nie mogłeś zrobić?!
Dialogue: 0,0:09:20.25,0:09:22.00,Main-207- PL,,0,0,0,,Niestety nie. Jakoś tak...
Dialogue: 0,0:09:22.37,0:09:26.96,Main-207- PL,,0,0,0,,{\i1}Przeprowadzimy krótką weryfikację\Nprzed oficjalnym zatwierdzeniem.{\i0}
Dialogue: 0,0:09:27.71,0:09:31.63,Main-207- PL,,0,0,0,,Pamiętajcie! To przebrzydły pirat!\NSchwytać żywego lub martwego!
Dialogue: 0,0:09:32.64,0:09:37.18,Main-207- PL,,0,0,0,,{Put him on wanted\Nposters throughout the world! - OG\i1}Niech cały świat zobaczy\Nlisty gończe z jego facjatą!
Dialogue: 0,0:09:49.74,0:09:51.70,Main-207- PL,,0,0,0,,Ale się najadłem!
Dialogue: 0,0:09:52.07,0:09:55.07,Main-207- PL,,0,0,0,,Miło tak czasami po prostu usiąść i zjeść.
Dialogue: 0,0:09:55.07,0:09:56.95,Main-207- PL,,0,0,0,,Rany już się zagoiły, Zoro?
Dialogue: 0,0:09:56.95,0:09:59.95,Main-207- PL,,0,0,0,,Nażrę się i napiję, to się zagoją.
Dialogue: 0,0:09:59.95,0:10:01.37,Main-207- PL,,0,0,0,,Czyżby?
Dialogue: 0,0:10:01.37,0:10:04.75,Main-207- PL,,0,0,0,,Swoją drogą, ta impreza\Njeszcze się nie skończyła?
Dialogue: 0,0:10:04.75,0:10:06.71,Main-207- PL,,0,0,0,,Trzy dni już to ciągną!
Dialogue: 0,0:10:06.71,0:10:08.05,Main-207- PL,,0,0,0,,I co w tym złego?
Dialogue: 0,0:10:08.05,0:10:11.67,Main-207- PL,,0,0,0,,Jak się mają bawić, to lepiej na całego.
Dialogue: 0,0:10:12.88,0:10:15.51,Main-207- PL,,0,0,0,,Hej, Sanji! Jadłeś takiego melona!
Dialogue: 0,0:10:15.51,0:10:16.89,Main-207- PL,,0,0,0,,Coś na nim było, co nie?!
Dialogue: 0,0:10:16.89,0:10:19.27,Main-207- PL,,0,0,0,,Więcej się nie dało\Nupchać tego mięsa?!
Dialogue: 0,0:10:19.27,0:10:22.73,Main-207- PL,,0,0,0,,No było. To melon z szynką,\Nwięc raczej jasne, że szynka.
Dialogue: 0,0:10:22.73,0:10:25.81,Main-207- PL,,0,0,0,,Szynka i melon?! Pychota!\NS-Skąd go wytrzasnąłeś?!
Dialogue: 0,0:10:25.81,0:10:26.36,Main-207- PL,,0,0,0,,Nie wiem.
Dialogue: 0,0:10:26.98,0:10:31.69,Main-207- PL,,0,0,0,,{\q2}Wioska to teraz jeden wielki szwedzki stół.\NCiężko powiedzieć, gdzie to było dokładnie.
Dialogue: 0,0:10:32.36,0:10:33.70,Main-207- PL,,0,0,0,,Już gdzieś polazł.
Dialogue: 0,0:10:33.70,0:10:36.03,Main-207- PL,,0,0,0,,Cały czas coś wcina, i to od trzech dni!
Dialogue: 0,0:10:36.82,0:10:39.03,Main-207- PL,,0,0,0,,Mnie tam starczy już jedzenia.
Dialogue: 0,0:10:39.83,0:10:40.91,Main-207- PL,,0,0,0,,Przyszła pora na...
Dialogue: 0,0:10:40.91,0:10:42.58,Main-207- PL,,0,0,0,,wielki podryw niewiast!
Dialogue: 0,0:10:42.58,0:10:46.58,Main-207- PL,,0,0,0,,To ja, kapitan Usopp!\NWielce uwielbiany bohater,
Dialogue: 0,0:10:46.58,0:10:50.13,Main-207- PL,,0,0,0,,który to z niebywałą brawurą pokonał\Nnajsilniejszą ryboludzką szychę!
Dialogue: 0,0:10:45.33,0:10:46.58,Secondary-207- PL,,0,0,0,,{\an8}Tak trzymaj, młody!
Dialogue: 0,0:10:46.58,0:10:48.34,Secondary-207- PL,,0,0,0,,{\an8}Mogę prosić o autograf?!
Dialogue: 0,0:10:50.92,0:10:54.93,Main-207- PL,,0,0,0,,Czy zechcecie to uczcić\Nhymnem na cześć Usoppa?!
Dialogue: 0,0:10:54.93,0:11:00.68,Main-207- PL,,0,0,0,,{\an8\fad(150,150)\b1\bord3.375\shad2.7\fnduality\fs74.25}♪ Kto to był? Kim on był? ♪\N♪ Kto skopał ryboludzki tył? ♪
Comment: 0,0:11:00.68,0:11:07.35,Main-207-,,0,0,0,,{\an8}[More of Usopp's song, untranslated.]
Dialogue: 0,0:10:59.14,0:11:00.68,Main-207- PL,,0,0,0,,Nudy.
Dialogue: 0,0:11:01.06,0:11:01.68,Main-207- PL,,0,0,0,,Czemu?
Dialogue: 0,0:11:01.68,0:11:04.23,Main-207- PL,,0,0,0,,Myślałam, że też będziesz marudził.
Dialogue: 0,0:11:04.23,0:11:08.11,Main-207- PL,,0,0,0,,„Dlaczego dopiero teraz,\Ngdy mojego tatka już nie ma”?!
Dialogue: 0,0:11:08.52,0:11:09.48,Main-207- PL,,0,0,0,,Coś w ten deseń.
Dialogue: 0,0:11:10.44,0:11:13.07,Main-207- PL,,0,0,0,,Wcześniej właśnie tak myślałem.
Dialogue: 0,0:11:13.07,0:11:15.99,Main-207- PL,,0,0,0,,Ale teraz próbuję się\Nskupić na tym, co będzie.
Dialogue: 0,0:11:15.99,0:11:17.57,Main-207- PL,,0,0,0,,Na tym, co będzie?
Dialogue: 0,0:11:18.07,0:11:21.37,Main-207- PL,,0,0,0,,Ten w słomkowym kapeluszu\Ni jego przyjaciele bardzo nam pomogli.
Dialogue: 0,0:11:21.74,0:11:26.21,Main-207- PL,,0,0,0,,Ale od jutra powinniśmy już liczyć\Nna siebie, a nie na dalszą pomoc.
Dialogue: 0,0:11:26.87,0:11:31.42,Main-207- PL,,0,0,0,,Nie da się zapomnieć o tym, co było.\NI wydaje mi się, że nie powinniśmy.
Dialogue: 0,0:11:31.42,0:11:35.51,Main-207- PL,,0,0,0,,Ale najważniejsze jest to, co będzie!
Dialogue: 0,0:11:35.51,0:11:38.59,Main-207- PL,,0,0,0,,Za co się zabrać? Co powinniśmy zrobić?
Dialogue: 0,0:11:39.30,0:11:42.47,Main-207- PL,,0,0,0,,Od teraz {\i1}nasza{\i0} wioska\Nto {\i1}nasza{\i0} własna sprawa.
Dialogue: 0,0:11:42.97,0:11:44.77,Main-207- PL,,0,0,0,,A przynajmniej tak mi się wydaje.
Dialogue: 0,0:11:46.85,0:11:47.60,Main-207- PL,,0,0,0,,Mądrala!
Dialogue: 0,0:11:47.60,0:11:48.85,Main-207- PL,,0,0,0,,Auć! Auć! Auć!
Dialogue: 0,0:11:48.85,0:11:51.86,Main-207- PL,,0,0,0,,Dlaczego mnie szczypiesz?!\NCo ja takiego zrobiłem?! Za co?!
Dialogue: 0,0:11:51.86,0:11:54.11,Main-207- PL,,0,0,0,,Miałam nadzieję,\Nże będę mogła ci nagadać!
Dialogue: 0,0:11:54.11,0:11:58.11,Main-207- PL,,0,0,0,,Nagadałaś mi już wystarczająco,\Nwytatuowana rozbójnico!
Dialogue: 0,0:12:04.04,0:12:05.41,Main-207- PL,,0,0,0,,„Rozbójnica” może być!
Dialogue: 0,0:12:08.83,0:12:09.83,Main-207- PL,,0,0,0,,I jak?
Dialogue: 0,0:12:09.83,0:12:13.50,Main-207- PL,,0,0,0,,Chciałbym powiedzieć,\Nże zejdzie bez problemu,
Dialogue: 0,0:12:13.50,0:12:15.01,Main-207- PL,,0,0,0,,ale niestety, niecałkowicie.
Dialogue: 0,0:12:15.63,0:12:16.38,Main-207- PL,,0,0,0,,Rozumiem.
Dialogue: 0,0:12:16.97,0:12:20.97,Main-207- PL,,0,0,0,,Wiem, że głupio zrobiłam.\NZostanie ze mną do końca życia.
Dialogue: 0,0:12:20.97,0:12:23.76,Flashbacks-207- PL,,0,0,0,,Nie chcę, by ktokolwiek to widział!
Dialogue: 0,0:12:24.43,0:12:27.56,Flashbacks-207- PL,,0,0,0,,Ten... Ten tatuaż...
Dialogue: 0,0:12:27.56,0:12:31.77,Flashbacks-207- PL,,0,0,0,,Ja nawet nie chcę\Ntrzymać z Arlongiem,
Dialogue: 0,0:12:31.77,0:12:34.23,Flashbacks-207- PL,,0,0,0,,ale przez to jestem\Noznaczona jako piratka!
Dialogue: 0,0:12:35.94,0:12:37.24,Flashbacks-207- PL,,0,0,0,,Nami...
Dialogue: 0,0:12:39.82,0:12:42.20,Flashbacks-207- PL,,0,0,0,,Nojiko! Co to ma być?!
Dialogue: 0,0:12:42.20,0:12:43.08,Flashbacks-207- PL,,0,0,0,,Mówisz o tym?
Dialogue: 0,0:12:43.87,0:12:47.04,Flashbacks-207- PL,,0,0,0,,To nic takiego!\NTaka mała ozdoba!
Dialogue: 0,0:12:47.37,0:12:48.96,Flashbacks-207- PL,,0,0,0,,Teraz obie takie mamy!
Dialogue: 0,0:12:56.01,0:12:57.26,Main-207- PL,,0,0,0,,Powiedz, doktorze...
Dialogue: 0,0:12:57.97,0:13:00.34,Main-207- PL,,0,0,0,,Zrobiłbyś mi pewien tatuaż?
Dialogue: 0,0:13:01.80,0:13:02.72,Main-207- PL,,0,0,0,,Proszę.
Dialogue: 0,0:13:03.89,0:13:05.26,Main-207- PL,,0,0,0,,Ta dwójka ma kocie ruchy!
Dialogue: 0,0:13:05.26,0:13:09.18,Main-207- PL,,0,0,0,,Czas na sto osiemdziesiąty piąty hymn\Nna cześć Usoppa!
Dialogue: 0,0:13:14.27,0:13:15.90,Main-207- PL,,0,0,0,,Bell-mère...
Dialogue: 0,0:13:15.90,0:13:20.15,Main-207- PL,,0,0,0,,Twoje córcie wyrosły\Nna porządne kobiety.
Dialogue: 0,0:13:21.41,0:13:24.33,Main-207- PL,,0,0,0,,Na dodatek łudząco cię przypominają.
Dialogue: 0,0:13:24.70,0:13:28.79,Main-207- PL,,0,0,0,,Od teraz będziemy żyli pełnią życia.
Dialogue: 0,0:13:29.29,0:13:32.79,Main-207- PL,,0,0,0,,Zbyt wiele nas kosztowało,\Nżeby tu dziś stanąć.
Dialogue: 0,0:13:32.79,0:13:38.09,Main-207- PL,,0,0,0,,I właśnie dlatego będziemy\Nsię śmiać i radować jak głupi!
Dialogue: 0,0:13:39.84,0:13:41.59,Main-207- PL,,0,0,0,,Dawać szynkę z melonem!
Dialogue: 0,0:13:41.93,0:13:46.60,Main-207- PL,,0,0,0,,Co...? Tutaj już nie ma jedzenia.\NA niech to. Chyba pora zawrócić...
Dialogue: 0,0:13:46.60,0:13:47.56,Main-207- PL,,0,0,0,,Stój, młokosie!
Dialogue: 0,0:13:48.85,0:13:51.85,Main-207- PL,,0,0,0,,Nagrobek? Ktoś umarł?
Dialogue: 0,0:13:51.85,0:13:54.06,Main-207- PL,,0,0,0,,Tak. Ale dawno temu.
Dialogue: 0,0:13:54.69,0:13:59.03,Main-207- PL,,0,0,0,,Składam moje najszczersze kordonencje.
Dialogue: 0,0:13:59.53,0:14:04.16,Main-207- PL,,0,0,0,,Znaczy się... Najszczersze kolędencje.\NChwila. Najszczersze kondo...
Dialogue: 0,0:14:04.16,0:14:06.41,Main-207- PL,,0,0,0,,Kondolencje.
Dialogue: 0,0:14:06.41,0:14:08.12,Main-207- PL,,0,0,0,,No, właśnie to.
Dialogue: 0,0:14:08.12,0:14:09.41,Main-207- PL,,0,0,0,,Hej, młokosie.
Dialogue: 0,0:14:10.12,0:14:13.96,Main-207- PL,,0,0,0,,Nami wejdzie z wami na pokład.\NWkrótce zostanie piratką.
Dialogue: 0,0:14:13.96,0:14:15.96,Main-207- PL,,0,0,0,,To niebezpieczna droga.
Dialogue: 0,0:14:15.96,0:14:18.09,Main-207- PL,,0,0,0,,Ale nie ma innego wyjścia.
Dialogue: 0,0:14:18.09,0:14:20.76,Main-207- PL,,0,0,0,,Już to zrozumiałem. Ale wiedz jedno.
Dialogue: 0,0:14:20.76,0:14:24.26,Main-207- PL,,0,0,0,,Jeśli którykolwiek z was sprawi,\Nże z jej twarzy zniknie uśmiech,
Dialogue: 0,0:14:24.26,0:14:26.72,Main-207- PL,,0,0,0,,to ukatrupię go własnoręcznie!
Dialogue: 0,0:14:26.72,0:14:29.68,Main-207- PL,,0,0,0,,Raczej nie inaczej.\NAle nie mam zamiaru, jakby co.
Dialogue: 0,0:14:30.35,0:14:31.14,Main-207- PL,,0,0,0,,Zrozumiano?!
Dialogue: 0,0:14:33.14,0:14:34.10,Main-207- PL,,0,0,0,,Zrozumiano!
Dialogue: 0,0:15:07.05,0:15:11.31,Flashbacks-207- PL,,0,0,0,,O ja! Co za wyżerka!
Dialogue: 0,0:15:11.31,0:15:14.56,Flashbacks-207- PL,,0,0,0,,Dziś jest wyjątkowy dzień, wiecie?
Dialogue: 0,0:15:14.89,0:15:18.69,Flashbacks-207- PL,,0,0,0,,To rocznica naszego pierwszego spotkania!
Dialogue: 0,0:15:19.31,0:15:21.69,Flashbacks-207- PL,,0,0,0,,Zostałyście wtedy moimi córkami!
Dialogue: 0,0:15:21.69,0:15:22.57,Flashbacks-207- PL,,0,0,0,,Ach!
Dialogue: 0,0:15:26.53,0:15:28.41,Flashbacks-207- PL,,0,0,0,,No już, po co tak beczeć?!
Dialogue: 0,0:15:28.41,0:15:31.54,Flashbacks-207- PL,,0,0,0,,I co z tego, że wicher potargał sad?
Dialogue: 0,0:15:31.54,0:15:36.00,Flashbacks-207- PL,,0,0,0,,W trudnych chwilach trzeba być silnym!
Dialogue: 0,0:15:36.54,0:15:40.25,Flashbacks-207- PL,,0,0,0,,Szczęście czeka na tych,\Nktórzy o tym pamiętają!{nao - Resembling AP05 @08:40}
Dialogue: 0,0:15:41.71,0:15:43.92,Flashbacks-207- PL,,0,0,0,,I na was też czeka. Jestem pewna!
Dialogue: 0,0:15:44.84,0:15:46.76,Flashbacks-207- PL,,0,0,0,,Nami! Podasz mi sól?
Dialogue: 0,0:15:48.01,0:15:50.72,Flashbacks-207- PL,,0,0,0,,Rysowałaś mapy morskie,\Na teraz również mapy lądu!{AP04 @06:33}
Dialogue: 0,0:15:51.22,0:15:54.27,Flashbacks-207- PL,,0,0,0,,Uczę się też nawigacji!{AP04 @06:47}
Dialogue: 0,0:15:54.64,0:15:56.39,Flashbacks-207- PL,,0,0,0,,Nawigacji?!
Dialogue: 0,0:15:56.39,0:15:58.35,Flashbacks-207- PL,,0,0,0,,W końcu to marzenie Nami!
Dialogue: 0,0:15:59.06,0:16:02.94,Flashbacks-207- PL,,0,0,0,,Wykorzystam wiedzę o nawigacji,\Nżeby przepłynąć wszystkie morza!
Dialogue: 0,0:16:02.94,0:16:06.57,Flashbacks-207- PL,,0,0,0,,Gdy już to wszystko zobaczę,\Nnarysuję mapę całego świata!
Dialogue: 0,0:16:07.07,0:16:11.53,Flashbacks-207- PL,,0,0,0,,Skoro tak, to ta mapa jest pierwszym\Nkrokiem w kierunku tego marzenia!
Dialogue: 0,0:16:12.24,0:16:13.04,Flashbacks-207- PL,,0,0,0,,Tak!
Dialogue: 0,0:16:44.07,0:16:46.74,Main-207- PL,,0,0,0,,Udało się, Bell-mère.
Dialogue: 0,0:16:47.32,0:16:50.82,Main-207- PL,,0,0,0,,Może zajęło to osiem lat,\Nale w końcu jesteśmy wolni!
Dialogue: 0,0:16:50.82,0:16:53.49,Main-207- PL,,0,0,0,,Nie tylko ja, ale i cała reszta...
Dialogue: 0,0:16:53.49,0:16:55.95,Main-207- PL,,0,0,0,,Jest dokładnie tak, jak mówiłaś.
Dialogue: 0,0:16:55.95,0:16:59.83,Main-207- PL,,0,0,0,,„Szczęście czeka na tych,\Nktórzy przetrwają trudne chwile”.{nao - Referencing AP05 @08:36}
Dialogue: 0,0:16:59.83,0:17:01.21,Main-207- PL,,0,0,0,,Miałaś rację!
Dialogue: 0,0:17:01.21,0:17:04.84,Main-207- PL,,0,0,0,,Cała wioska raduje się z głębi serca!
Comment: 0,0:17:07.42,0:17:08.55,Main-207-,,0,0,0,,{And me! - OG}As for me,{nao}
Comment: 0,0:17:08.55,0:17:10.18,Main-207-,,0,0,0,,{I'm thinking of leaving this island! - OG}I think I might leave the island!{nao}
Dialogue: 0,0:17:07.42,0:17:10.18,Main-207- PL,,0,0,0,,Ale ja postanowiłam,\Nże pora opuścić wyspę!
Dialogue: 0,0:17:11.13,0:17:13.93,Main-207- PL,,0,0,0,,Będzie dobrze! Nie bój nic!
Dialogue: 0,0:17:13.93,0:17:17.64,Main-207- PL,,0,0,0,,Dobrzy z nich ludzie,\Na na dodatek silni!
Dialogue: 0,0:17:19.27,0:17:23.27,Main-207- PL,,0,0,0,,Spędziłam długie osiem lat\Nna rysowaniu różnych map,
Dialogue: 0,0:17:23.27,0:17:25.61,Main-207- PL,,0,0,0,,a mimo to tylko\Nta jedna mi została.
Dialogue: 0,0:17:26.36,0:17:32.20,Main-207- PL,,0,0,0,,Ale najwidoczniej tak musiało być!\NTym razem będę rysować dla siebie!
Dialogue: 0,0:17:32.20,0:17:36.41,Main-207- PL,,0,0,0,,Przepłyniemy razem świat!\NCzuję, że jestem jedną z nich!
Dialogue: 0,0:17:37.91,0:17:40.33,Main-207- PL,,0,0,0,,Zawsze o tym marzyłam...
Dialogue: 0,0:17:41.75,0:17:42.83,Main-207- PL,,0,0,0,,No i...
Dialogue: 0,0:17:44.25,0:17:47.59,Main-207- PL,,0,0,0,,No i nie wiem, na jak długo\Nopuszczam wyspę...
Dialogue: 0,0:17:56.39,0:17:58.43,Main-207- PL,,0,0,0,,No cóż... Chyba już pora.
Dialogue: 0,0:18:24.79,0:18:26.08,Main-207- PL,,0,0,0,,To już ostatni?
Dialogue: 0,0:18:26.08,0:18:26.79,Main-207- PL,,0,0,0,,Tak!
Dialogue: 0,0:18:26.79,0:18:27.38,Main-207- PL,,0,0,0,,W porządku!
Dialogue: 0,0:18:27.38,0:18:28.63,Main-207- PL,,0,0,0,,Wszystko załadowane?
Dialogue: 0,0:18:28.63,0:18:29.50,Main-207- PL,,0,0,0,,Wszystko!
Dialogue: 0,0:18:29.50,0:18:32.38,Main-207- PL,,0,0,0,,No, to prowiantu powinno\Nnam starczyć na długo.
Dialogue: 0,0:18:32.38,0:18:33.59,Main-207- PL,,0,0,0,,Wszystko gotowe.
Dialogue: 0,0:18:34.72,0:18:36.76,Main-207- PL,,0,0,0,,Byliśmy tu zaledwie parę dni,
Dialogue: 0,0:18:36.76,0:18:39.10,Main-207- PL,,0,0,0,,ale prędko o tym\Nnie zapomnimy, prawda?
Dialogue: 0,0:18:39.43,0:18:40.52,Main-207- PL,,0,0,0,,Prawda!
Dialogue: 0,0:18:47.44,0:18:51.07,Main-207- PL,,0,0,0,,Jesteśmy wam wdzięczni\Nza wszystko, co dla nas zrobiliście.
Dialogue: 0,0:18:51.07,0:18:54.49,Main-207- PL,,0,0,0,,Pora, żebyśmy wrócili do fachu!\NKtoś musi być łowcą nagród!
Dialogue: 0,0:18:54.49,0:18:55.41,Main-207- PL,,0,0,0,,Żegnajcie więc.
Dialogue: 0,0:18:56.11,0:18:58.91,Main-207- PL,,0,0,0,,Mamy nadzieję, że kiedyś\Nznów się spotkamy!
Dialogue: 0,0:18:59.91,0:19:00.87,Main-207- PL,,0,0,0,,Trzymajcie się!
Dialogue: 0,0:19:01.50,0:19:03.12,Main-207- PL,,0,0,0,,– Wy też!\N– Wy też!
Dialogue: 0,0:19:03.12,0:19:05.33,Main-207- PL,,0,0,0,,No cóż, najwyższa pora\Npodnieść kotwicę!
Dialogue: 0,0:19:06.54,0:19:08.88,Main-207- PL,,0,0,0,,Hej, chwila moment!\NA co z Nami?!
Dialogue: 0,0:19:09.63,0:19:11.05,Main-207- PL,,0,0,0,,Może zmieniła zdanie?
Dialogue: 0,0:19:11.05,0:19:13.09,Main-207- PL,,0,0,0,,Co...?! Ale jak to?!
Dialogue: 0,0:19:13.59,0:19:17.09,Main-207- PL,,0,0,0,,Ty! Znowu powiedziałeś Nami\Ncoś niestosownego, mam rację?!
Dialogue: 0,0:19:17.09,0:19:18.35,Main-207- PL,,0,0,0,,A po co miałbym?
Dialogue: 0,0:19:18.35,0:19:20.10,Main-207- PL,,0,0,0,,Skoro o tym mowa...
Dialogue: 0,0:19:20.10,0:19:24.23,Main-207- PL,,0,0,0,,Osiągnęła to, o co tak długo walczyła,\Nwięc nie ma powodu, by zostawać piratką.
Dialogue: 0,0:19:24.23,0:19:27.60,Main-207- PL,,0,0,0,,Może gdyby tu została,\Nto byłaby szczęśliwa...
Dialogue: 0,0:19:18.35,0:19:20.10,Secondary-207- PL,,0,0,0,,{\an8}Na pewno to zrobiłeś!
Dialogue: 0,0:19:20.10,0:19:24.23,Secondary-207- PL,,0,0,0,,{\an8}Zazdrościsz, że ja i Nami\Ntak bardzo się kochamy!
Dialogue: 0,0:19:24.23,0:19:25.23,Secondary-207- PL,,0,0,0,,{\an8}Pogięło cię?
Dialogue: 0,0:19:25.23,0:19:26.85,Secondary-207- PL,,0,0,0,,{\an8}Że co proszę?!
Dialogue: 0,0:19:27.60,0:19:29.06,Main-207- PL,,0,0,0,,A co z {\i1}moim{\i0} szczęściem?!
Dialogue: 0,0:19:29.69,0:19:32.73,Main-207- PL,,0,0,0,,Jeśli na pokładzie\Ntego statku zabraknie Nami,
Dialogue: 0,0:19:32.73,0:19:36.07,Main-207- PL,,0,0,0,,to stracę 98,72% powodów,\Nżeby dalej z wami pływać!
Dialogue: 0,0:19:36.07,0:19:39.07,Main-207- PL,,0,0,0,,Tak przy okazji,\Nnigdzie nie było tego melona z szynką!
Dialogue: 0,0:19:39.57,0:19:40.70,Main-207- PL,,0,0,0,,Hej! A gdzie Namcia?
Dialogue: 0,0:19:40.70,0:19:43.62,Main-207- PL,,0,0,0,,Dobre pytanie! Od rana\Nnikt jej nie widział!
Dialogue: 0,0:19:43.62,0:19:44.25,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:19:44.62,0:19:46.54,Main-207- PL,,0,0,0,,Zostawia nam wszystkie pieniądze?!
Dialogue: 0,0:19:46.54,0:19:48.75,Main-207- PL,,0,0,0,,Okrągłe sto milionów berry?!
Dialogue: 0,0:19:48.75,0:19:51.04,Main-207- PL,,0,0,0,,Wypływa w rejs bez jakiejkolwiek kasy?!
Dialogue: 0,0:19:51.04,0:19:53.84,Main-207- PL,,0,0,0,,Przecież tak bardzo się\Nnarażała, żeby je zdobyć!
Dialogue: 0,0:19:53.84,0:19:57.01,Main-207- PL,,0,0,0,,Powiedziała, że po prostu\Nukradnie jeszcze więcej.
Dialogue: 0,0:19:58.39,0:20:01.01,Main-207- PL,,0,0,0,,Nie przegadasz jej, gdy ta\Njuż coś sobie postanowi.
Dialogue: 0,0:20:01.39,0:20:02.76,Main-207- PL,,0,0,0,,Wariatka!
Dialogue: 0,0:20:02.76,0:20:06.48,Main-207- PL,,0,0,0,,To my powinniśmy zrobić coś\Ndla niej, a nie na odwrót!
Dialogue: 0,0:20:10.98,0:20:12.90,Main-207- PL,,0,0,0,,– Nami!\N– Nami!
Dialogue: 0,0:20:12.90,0:20:14.28,Main-207- PL,,0,0,0,,Nami!
Dialogue: 0,0:20:13.44,0:20:14.28,Secondary-207- PL,,0,0,0,,Nami!
Dialogue: 0,0:20:14.28,0:20:16.40,Main-207- PL,,0,0,0,,Hej, Nami!
Dialogue: 0,0:20:14.82,0:20:16.40,Secondary-207- PL,,0,0,0,,To Namcia!
Dialogue: 0,0:20:16.40,0:20:17.74,Main-207- PL,,0,0,0,,Stawiać żagle!
Dialogue: 0,0:20:24.29,0:20:26.66,Main-207- PL,,0,0,0,,Co? Wystrzeliła jak pędziwiatr!
Dialogue: 0,0:20:26.66,0:20:27.91,Main-207- PL,,0,0,0,,Stawiać żagle, głuchy?
Dialogue: 0,0:20:27.91,0:20:28.50,Main-207- PL,,0,0,0,,No, ale...!
Dialogue: 0,0:20:29.96,0:20:31.46,Main-207- PL,,0,0,0,,Skubana chce odejść,
Dialogue: 0,0:20:31.46,0:20:35.30,Main-207- PL,,0,0,0,,zanim zdążymy jej podziękować\Nalbo chociaż się z nią pożegnać?!
Dialogue: 0,0:20:35.30,0:20:35.88,Main-207- PL,,0,0,0,,No chyba nie!
Dialogue: 0,0:20:36.21,0:20:37.88,Main-207- PL,,0,0,0,,Stawiać żagle!
Dialogue: 0,0:20:42.76,0:20:44.26,Main-207- PL,,0,0,0,,H-Hej!
Dialogue: 0,0:20:44.26,0:20:45.93,Main-207- PL,,0,0,0,,Odpływają!
Dialogue: 0,0:20:45.93,0:20:48.69,Main-207- PL,,0,0,0,,Stój! Jesteśmy ci winni podziękowania!
Dialogue: 0,0:20:50.40,0:20:51.65,Main-207- PL,,0,0,0,,Zaczekaj, Namcia!
Dialogue: 0,0:20:51.65,0:20:53.11,Main-207- PL,,0,0,0,,Pozwól nam chociaż podziękować!
Dialogue: 0,0:20:53.94,0:20:54.86,Main-207- PL,,0,0,0,,– Nami!\N– Nami! Spokojnie!
Dialogue: 0,0:20:54.86,0:20:58.86,Main-207- PL,,0,0,0,,Hola! Nie myśl sobie, że na to pozwolę!
Dialogue: 0,0:20:58.86,0:21:02.12,Main-207- PL,,0,0,0,,Słuchaj, pewien jesteś,\Nże tak będzie w porządku?
Dialogue: 0,0:21:02.12,0:21:04.83,Main-207- PL,,0,0,0,,A czemu nie? W końcu to jej wybór.
Dialogue: 0,0:21:23.05,0:21:23.60,Main-207- PL,,0,0,0,,Nami!
Dialogue: 0,0:21:32.19,0:21:33.31,Main-207- PL,,0,0,0,,Dlaczego?!
Dialogue: 0,0:21:34.06,0:21:35.07,Main-207- PL,,0,0,0,,Nami!
Dialogue: 0,0:21:56.42,0:21:56.96,Main-207- PL,,0,0,0,,No nie gadaj!
Dialogue: 0,0:21:57.92,0:21:59.71,Main-207- PL,,0,0,0,,– Co to ma być...?!\N– Mój portfel zniknął!
Dialogue: 0,0:22:00.09,0:22:01.05,Main-207- PL,,0,0,0,,Mój też!
Dialogue: 0,0:22:01.05,0:22:02.26,Main-207- PL,,0,0,0,,I mój!
Dialogue: 0,0:22:07.31,0:22:08.89,Main-207- PL,,0,0,0,,Trzymajcie się!
Dialogue: 0,0:22:08.89,0:22:09.68,Main-207- PL,,0,0,0,,Jak...?!
Dialogue: 0,0:22:09.68,0:22:13.98,Main-207- PL,,0,0,0,,– Jak śmiesz?! Bachorze ty jeden!\N– Jak mogłaś?! Wstrętna smarkulo!
Dialogue: 0,0:22:14.94,0:22:17.94,Main-207- PL,,0,0,0,,No, niczego się nie nauczyła.
Dialogue: 0,0:22:17.94,0:22:19.78,Main-207- PL,,0,0,0,,Daj jej chwilę, a znowu nas zdradzi...
Dialogue: 0,0:22:19.78,0:22:21.49,Main-207- PL,,0,0,0,,Nami! Rządzisz!
Dialogue: 0,0:22:24.16,0:22:25.78,Main-207- PL,,0,0,0,,Złodziejko ty jedna!
Dialogue: 0,0:22:25.78,0:22:26.70,Main-207- PL,,0,0,0,,Wracaj no tu, ale już!
Dialogue: 0,0:22:26.70,0:22:27.66,Main-207- PL,,0,0,0,,Oddawaj portfel!
Dialogue: 0,0:22:27.66,0:22:29.08,Main-207- PL,,0,0,0,,Rozbójnico!
Dialogue: 0,0:22:29.08,0:22:30.83,Main-207- PL,,0,0,0,,Wracaj, kiedy tylko zechcesz!
Dialogue: 0,0:22:30.83,0:22:31.96,Main-207- PL,,0,0,0,,Uważaj na siebie!
Dialogue: 0,0:22:31.96,0:22:33.71,Main-207- PL,,0,0,0,,Jesteśmy wam bardzo wdzięczni!
Dialogue: 0,0:22:35.21,0:22:36.59,Main-207- PL,,0,0,0,,Młokosie!
Dialogue: 0,0:22:37.92,0:22:40.42,Main-207- PL,,0,0,0,,Nie zapomnij o naszej obietnicy!
Dialogue: 0,0:22:44.47,0:22:47.55,Main-207- PL,,0,0,0,,Żegnajcie!\NDo następnego!
Dialogue: 0,0:22:50.85,0:22:52.56,Main-207- PL,,0,0,0,,Ale nas zrobiła!
Dialogue: 0,0:22:52.56,0:22:55.35,Main-207- PL,,0,0,0,,Moja siostra to niezłe ziółko!
Dialogue: 0,0:22:56.81,0:22:58.06,Main-207- PL,,0,0,0,,Baw się dobrze!
Dialogue: 0,0:23:02.07,0:23:04.32,Main-207- PL,,0,0,0,,Trzymaj, Genzo.
Dialogue: 0,0:23:04.32,0:23:06.62,Main-207- PL,,0,0,0,,Co to za kartka?\NPo co mi ona, doktorze?
Dialogue: 0,0:23:07.20,0:23:11.95,Main-207- PL,,0,0,0,,{\q2}Głupiutka dziewucha. I lekkomyślna.\NZażyczyła sobie nowego tatuażu.
Dialogue: 0,0:23:12.91,0:23:14.29,Main-207- PL,,0,0,0,,Co to za wzór?
Dialogue: 0,0:23:14.75,0:23:17.75,Main-207- PL,,0,0,0,,Mandarynka na wiatraczku, rzekomo.
Dialogue: 0,0:23:19.00,0:23:22.42,Main-207- PL,,0,0,0,,Och? Właśnie, Gen!\NGdzie się podział twój wiatraczek?
Dialogue: 0,0:23:26.68,0:23:28.55,Main-207- PL,,0,0,0,,Już mi nie będzie potrzebny.
Dialogue: 0,0:23:39.31,0:23:41.57,Thoughts-207- PL,,0,0,0,,Ruszam w drogę, Bell-mère.
Dialogue: 0,0:23:48.11,0:23:51.41,Flashbacks-207- PL,,0,0,0,,Chwila moment, Gen!\NNie podchodź do Nami!
Dialogue: 0,0:23:51.87,0:23:55.50,Flashbacks-207- PL,,0,0,0,,Tyle że ja też chcę\Nzobaczyć jej uśmiech!
Dialogue: 0,0:23:55.50,0:23:58.71,Flashbacks-207- PL,,0,0,0,,Ona się boi twojej twarzy, Gen.
Dialogue: 0,0:23:58.71,0:24:01.21,Flashbacks-207- PL,,0,0,0,,Ale co ja mam na to poradzić?!
Dialogue: 0,0:24:01.84,0:24:02.38,Flashbacks-207- PL,,0,0,0,,Już wiem!
Dialogue: 0,0:24:03.00,0:24:06.30,Flashbacks-207- PL,,0,0,0,,Przyczepię go tutaj, żebyś mogła\Nsię cały czas śmiać, dobrze?!
Dialogue: 0,0:24:06.30,0:24:08.34,Flashbacks-207- PL,,0,0,0,,Co ty na to, Nami?!
Dialogue: 0,0:24:08.34,0:24:11.97,Flashbacks-207- PL,,0,0,0,,No nie wiem... Wątpię, żeby\Njakiś głupi wiatraczek miał...
Dialogue: 0,0:24:19.90,0:24:22.02,Flashbacks-207- PL,,0,0,0,,Och. Śmieje się.
Dialogue: 0,0:24:27.70,0:24:31.37,Narrator-207- PL,,0,0,0,,Na niebie ani chmurki,\Nwiatr wieje z południa.
Dialogue: 0,0:24:31.37,0:24:35.16,Narrator-207- PL,,0,0,0,,Wiatraczek się kręci,\Nczekając na kolejny dzień.
