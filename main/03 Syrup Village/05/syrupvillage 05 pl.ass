Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=8}===============================DIALOGUE============================
Dialogue: 0,0:01:57.26,0:01:58.35,Main-207- PL,,0,0,0,,Co to było?!
Dialogue: 0,0:01:58.35,0:01:59.64,Main-207- PL,,0,0,0,,Co on zrobił?!
Dialogue: 0,0:01:59.64,0:02:02.10,Main-207- PL,,0,0,0,,Ręka mu się rozciągnęła!
Dialogue: 0,0:02:00.73,0:02:02.10,Secondary-207- PL,,0,0,0,,Nie wygłupiaj się!
Dialogue: 0,0:02:02.10,0:02:05.65,Main-207- PL,,0,0,0,,Powalił kapitana Kuro na łopatki!
Dialogue: 0,0:02:23.04,0:02:24.62,Main-207- PL,,0,0,0,,Resztę zostawiam tobie...{Syrup 04 - 22:44}
Dialogue: 0,0:02:26.54,0:02:28.46,Main-207- PL,,0,0,0,,a ja zajmę się skarbem!
Dialogue: 0,0:02:29.71,0:02:34.93,Main-207- PL,,0,0,0,,– Piraci Usoppa przybyli!\N– Piraci Usoppa przybyli!
Dialogue: 0,0:02:35.59,0:02:36.34,Main-207- PL,,0,0,0,,Chłopaki!
Dialogue: 0,0:02:36.34,0:02:37.35,Main-207- PL,,0,0,0,,Nie wtrącajcie się!
Dialogue: 0,0:02:37.89,0:02:39.51,Main-207- PL,,0,0,0,,Zmawiaj paciorek, głupi lokaju!
Dialogue: 0,0:02:40.52,0:02:41.77,Main-207- PL,,0,0,0,,Nagrabiłeś sobie!
Dialogue: 0,0:02:42.18,0:02:45.06,Main-207- PL,,0,0,0,,Głupi piracie! Nie będziesz\Nnam wioski niepokoił...!
Dialogue: 0,0:02:43.89,0:02:45.81,Main-207- PL,,0,0,0,,{\an8}P-Przestańcie!
Dialogue: 0,0:02:47.06,0:02:50.11,Main-207- PL,,0,0,0,,Co wy sobie myślicie, gówniarze?!
Dialogue: 0,0:02:51.28,0:02:53.11,Main-207- PL,,0,0,0,,Co te bachory wyprawiają?!
Dialogue: 0,0:02:53.11,0:02:56.78,Main-207- PL,,0,0,0,,Przestańcie chłopaki... Przestańcie!
Dialogue: 0,0:03:00.20,0:03:03.33,Main-207- PL,,0,0,0,,Dobra! Niech cię to czegoś nauczy!
Dialogue: 0,0:03:05.96,0:03:10.42,Main-207- PL,,0,0,0,,T-Teraz to się doigrają!\NKapitan Kuro tego tak nie zostawi!
Dialogue: 0,0:03:12.05,0:03:13.97,Main-207- PL,,0,0,0,,Kapitanie, czyli to prawda!
Dialogue: 0,0:03:13.97,0:03:15.72,Main-207- PL,,0,0,0,,Stanął kapitan do walki!
Dialogue: 0,0:03:15.72,0:03:17.84,Main-207- PL,,0,0,0,,Dlaczego nam nie powiedziałeś?!
Dialogue: 0,0:03:17.84,0:03:19.22,Main-207- PL,,0,0,0,,Okłamałeś nas w żywe uszy!
Dialogue: 0,0:03:19.22,0:03:21.43,Main-207- PL,,0,0,0,,Mówi się „żywe oczy”, nie „uszy”!
Dialogue: 0,0:03:21.43,0:03:22.77,Main-207- PL,,0,0,0,,Wszystko jedno w co!
Dialogue: 0,0:03:23.43,0:03:25.89,Main-207- PL,,0,0,0,,Mniejsza o to, musicie stąd uciekać!
Dialogue: 0,0:03:25.89,0:03:27.23,Main-207- PL,,0,0,0,,Zwiewajcie!
Dialogue: 0,0:03:27.98,0:03:28.98,Main-207- PL,,0,0,0,,Nigdy!
Dialogue: 0,0:03:28.98,0:03:30.98,Main-207- PL,,0,0,0,,Też staniemy do walki!
Dialogue: 0,0:03:30.98,0:03:34.15,Main-207- PL,,0,0,0,,Ucieczka byłaby hańbą\Ndla Piratów Uso...
Dialogue: 0,0:03:44.66,0:03:48.00,Main-207- PL,,0,0,0,,Gamonie! Zwiewać mi stąd, ale już!
Dialogue: 0,0:04:00.39,0:04:01.89,Main-207- PL,,0,0,0,,– Kapitanie!\N– Kapitanie!
Dialogue: 0,0:04:06.52,0:04:08.90,Main-207- PL,,0,0,0,,To nawet zabolało...
Dialogue: 0,0:04:08.90,0:04:12.86,Main-207- PL,,0,0,0,,Cóż za dziwny styl walki...
Dialogue: 0,0:04:12.86,0:04:14.28,Main-207- PL,,0,0,0,,Jak mniemam...
Dialogue: 0,0:04:14.65,0:04:16.94,Main-207- PL,,0,0,0,,to była moc\Ndiabelskiego owocu, prawda?!
Dialogue: 0,0:04:17.32,0:04:19.95,Main-207- PL,,0,0,0,,Zgadza się! Zjadłem Gum-Gumowoc!
Dialogue: 0,0:04:21.57,0:04:22.91,Main-207- PL,,0,0,0,,Jestem Człowiekiem-Gumą!
Dialogue: 0,0:04:22.91,0:04:24.58,Main-207- PL,,0,0,0,,Co?! Diabelski owoc?!
Dialogue: 0,0:04:24.58,0:04:25.87,Main-207- PL,,0,0,0,,No to mamy kłopoty!
Dialogue: 0,0:04:25.87,0:04:27.33,Main-207- PL,,0,0,0,,Diabelskie owoce naprawdę istnieją?!
Dialogue: 0,0:04:27.33,0:04:28.75,Main-207- PL,,0,0,0,,Wiedziałem, że to jakiś dziwak!
Dialogue: 0,0:04:28.75,0:04:31.13,Main-207- PL,,0,0,0,,Więc to Człowiek-Guma, co?
Dialogue: 0,0:04:31.13,0:04:34.38,Main-207- PL,,0,0,0,,Czyli rozciągająca się ręka\Nto nie były zwidy...
Dialogue: 0,0:04:35.80,0:04:36.59,Main-207- PL,,0,0,0,,Jango!
Dialogue: 0,0:04:36.59,0:04:37.42,Main-207- PL,,0,0,0,,T-Tak?
Dialogue: 0,0:04:37.42,0:04:40.26,Main-207- PL,,0,0,0,,Smarkaczem zajmę się ja.
Dialogue: 0,0:04:40.26,0:04:43.05,Main-207- PL,,0,0,0,,Ty zaopiekuj się panienką Kayą.
Dialogue: 0,0:04:43.89,0:04:46.89,Main-207- PL,,0,0,0,,Zgodnie z planem,\Ndopilnuj, by spisała testament...
Dialogue: 0,0:04:47.23,0:04:48.85,Main-207- PL,,0,0,0,,a potem się jej pozbądź!
Dialogue: 0,0:04:49.69,0:04:52.10,Main-207- PL,,0,0,0,,A co do tych trzech szkodników...
Dialogue: 0,0:04:52.61,0:04:53.61,Main-207- PL,,0,0,0,,Zawadzają mi!
Dialogue: 0,0:04:56.53,0:04:58.19,Main-207- PL,,0,0,0,,Nie musisz więcej mówić.
Dialogue: 0,0:05:02.49,0:05:03.66,Main-207- PL,,0,0,0,,Zatrzymaj się.
Dialogue: 0,0:05:04.33,0:05:07.50,Main-207- PL,,0,0,0,,Obawiam się, że dalej nie przejdziesz.
Dialogue: 0,0:05:07.50,0:05:09.83,Main-207- PL,,0,0,0,,Buchi!
Dialogue: 0,0:05:12.46,0:05:15.96,Main-207- PL,,0,0,0,,{\fad(150,150)}Koci Koci Nóżki!
Dialogue: 0,0:05:16.34,0:05:17.76,Main-207- PL,,0,0,0,,Tylko nie to!
Dialogue: 0,0:05:51.00,0:05:53.96,Main-207- PL,,0,0,0,,Jest o wiele silniejszy niż przedtem...
Dialogue: 0,0:05:55.46,0:05:56.42,Main-207- PL,,0,0,0,,Niech to!
Dialogue: 0,0:05:57.04,0:05:58.71,Thoughts-207- PL,,0,0,0,,Cholera...
Dialogue: 0,0:06:00.21,0:06:02.38,Thoughts-207- PL,,0,0,0,,Kompletnie opadłem z sił...
Dialogue: 0,0:06:02.38,0:06:05.05,Thoughts-207- PL,,0,0,0,,Cholera... Cholera...
Dialogue: 0,0:06:05.05,0:06:06.93,Thoughts-207- PL,,0,0,0,,Szlag...
Dialogue: 0,0:06:06.93,0:06:11.52,Main-207- PL,,0,0,0,,Piraci Usoppa!
Dialogue: 0,0:06:12.39,0:06:14.85,Main-207- PL,,0,0,0,,– T-Tak?!\N– T-Tak?!
Dialogue: 0,0:06:14.85,0:06:16.40,Main-207- PL,,0,0,0,,Posłuchajcie mnie!
Dialogue: 0,0:06:17.11,0:06:18.52,Main-207- PL,,0,0,0,,Nie mamy zamiaru uciekać!
Dialogue: 0,0:06:18.52,0:06:20.32,Main-207- PL,,0,0,0,,Po tym wszystkim, co ci zrobili...
Dialogue: 0,0:06:20.32,0:06:22.32,Main-207- PL,,0,0,0,,...musimy cię pomścić!
Dialogue: 0,0:06:22.70,0:06:24.57,Main-207- PL,,0,0,0,,Macie chronić Kayę!
Dialogue: 0,0:06:27.20,0:06:29.83,Main-207- PL,,0,0,0,,Słuchajcie uważnie!
Dialogue: 0,0:06:29.83,0:06:31.45,Main-207- PL,,0,0,0,,Powierzam wam...
Dialogue: 0,0:06:31.45,0:06:37.08,Main-207- PL,,0,0,0,,Powierzam wam najważniejsze zadanie\Nw tej walce!
Dialogue: 0,0:06:37.08,0:06:40.09,Main-207- PL,,0,0,0,,Zabierzcie Kayę i zwiewajcie\Njak najdalej stąd!
Dialogue: 0,0:06:40.09,0:06:42.01,Main-207- PL,,0,0,0,,I nie przyjmuję odmowy!
Dialogue: 0,0:06:42.01,0:06:46.09,Main-207- PL,,0,0,0,,Przypomnijcie sobie,\Nco jest celem naszej załogi!
Dialogue: 0,0:06:46.09,0:06:50.10,Main-207- PL,,0,0,0,,Macie być mężczyznami, którzy\Nbronią tego, na czym wam zależy!
Dialogue: 0,0:06:52.43,0:06:53.85,Main-207- PL,,0,0,0,,Usopp...
Dialogue: 0,0:06:58.94,0:07:02.32,Main-207- PL,,0,0,0,,To... rozkaz kapitana...
Dialogue: 0,0:07:02.32,0:07:05.28,Main-207- PL,,0,0,0,,– Tak jest, kapitanie!\N– Tak jest, kapitanie!
Dialogue: 0,0:07:05.28,0:07:06.61,Main-207- PL,,0,0,0,,Prędko, panienko Kayo!
Dialogue: 0,0:07:06.61,0:07:07.74,Main-207- PL,,0,0,0,,Tędy! Tędy!
Dialogue: 0,0:07:07.07,0:07:07.74,Secondary-207- PL,,0,0,0,,W tę stronę!
Dialogue: 0,0:07:08.37,0:07:10.70,Thoughts-207- PL,,0,0,0,,Ma chłopak gadane...
Dialogue: 0,0:07:10.70,0:07:12.75,Thoughts-207- PL,,0,0,0,,Przemową przekonał ich do ucieczki...!
Dialogue: 0,0:07:12.75,0:07:15.29,Main-207- PL,,0,0,0,,Znamy ten las jak własną kieszeń!
Dialogue: 0,0:07:15.29,0:07:16.17,Main-207- PL,,0,0,0,,W porządku...
Dialogue: 0,0:07:19.34,0:07:20.29,Main-207- PL,,0,0,0,,Jango!
Dialogue: 0,0:07:20.29,0:07:22.34,Main-207- PL,,0,0,0,,Ach, zagapiłem się!
Dialogue: 0,0:07:22.76,0:07:25.93,Main-207- PL,,0,0,0,,Są głupi, jeśli wydaje im się,\Nże mogą mi ucie...
Dialogue: 0,0:07:31.14,0:07:32.10,Main-207- PL,,0,0,0,,Co powiesz na to?
Dialogue: 0,0:07:32.52,0:07:34.23,Main-207- PL,,0,0,0,,Ty bezczelny draniu!
Dialogue: 0,0:07:34.23,0:07:36.64,Main-207- PL,,0,0,0,,Biegnij za nimi, idioto!
Dialogue: 0,0:07:39.23,0:07:40.31,Main-207- PL,,0,0,0,,Wiem przecież!
Dialogue: 0,0:07:42.78,0:07:44.69,Main-207- PL,,0,0,0,,Daremny wasz trud...
Dialogue: 0,0:07:45.24,0:07:49.12,Main-207- PL,,0,0,0,,Sam wiem najlepiej,\Nw jak słabej kondycji jest Kaya.
Dialogue: 0,0:07:49.12,0:07:52.12,Main-207- PL,,0,0,0,,Nie ma mowy, żeby uciekła przed Jango.
Dialogue: 0,0:07:52.99,0:07:55.25,Main-207- PL,,0,0,0,,Jeśli chcecie jej pomóc, to proszę bardzo.
Dialogue: 0,0:07:56.71,0:08:00.92,Main-207- PL,,0,0,0,,Ale ta ścieżka poprowadzi\Nwas tylko do pewnej śmierci.
Dialogue: 0,0:08:06.30,0:08:07.76,Main-207- PL,,0,0,0,,Buchi!
Dialogue: 0,0:08:09.30,0:08:13.14,Main-207- PL,,0,0,0,,Już raz ze mną przegrałeś!
Dialogue: 0,0:08:13.14,0:08:16.98,Main-207- PL,,0,0,0,,Nie marnuj mojego czasu!
Dialogue: 0,0:08:17.39,0:08:19.23,Main-207- PL,,0,0,0,,Spadaj!
Dialogue: 0,0:09:02.69,0:09:05.48,Main-207- PL,,0,0,0,,Hipnotyzer dalej nas goni?!
Dialogue: 0,0:09:05.48,0:09:07.15,Main-207- PL,,0,0,0,,Nie, nie widzę go!
Dialogue: 0,0:09:07.15,0:09:08.94,Main-207- PL,,0,0,0,,Zaraz zgubimy go na dobre!
Dialogue: 0,0:09:08.94,0:09:12.45,Main-207- PL,,0,0,0,,W lesie i tak nie ma szans nas złapać!
Dialogue: 0,0:09:12.99,0:09:14.49,Main-207- PL,,0,0,0,,Nie bój nic, panienko Kayo!
Dialogue: 0,0:09:14.49,0:09:16.66,Main-207- PL,,0,0,0,,Z nami jesteś bezpieczna!
Dialogue: 0,0:09:16.99,0:09:20.00,Main-207- PL,,0,0,0,,Właśnie! Przysięgamy\Nna imię Piratów Usoppa!
Dialogue: 0,0:09:22.00,0:09:23.33,Main-207- PL,,0,0,0,,Dziękuję...
Dialogue: 0,0:09:46.57,0:09:48.07,Main-207- PL,,0,0,0,,Tutaj też nie...
Dialogue: 0,0:09:49.28,0:09:51.57,Main-207- PL,,0,0,0,,Gdzieżeście poleźli, kurduple?!
Dialogue: 0,0:09:52.32,0:09:54.70,Main-207- PL,,0,0,0,,Nie myślcie, że możecie mi uciec!
Dialogue: 0,0:09:58.04,0:10:03.04,Main-207- PL,,0,0,0,,Jeśli będzie trzeba, to zetnę cały las!
Dialogue: 0,0:10:03.04,0:10:04.25,Main-207- PL,,0,0,0,,Rany...
Dialogue: 0,0:10:04.25,0:10:06.50,Main-207- PL,,0,0,0,,Zaraz żyłka mu pęknie...
Dialogue: 0,0:10:06.50,0:10:09.76,Main-207- PL,,0,0,0,,On nie był przypadkiem\Nzwykłym hipnotyzerem?!
Dialogue: 0,0:10:14.22,0:10:16.43,Main-207- PL,,0,0,0,,Gdzie was wcięło?
Dialogue: 0,0:10:17.51,0:10:18.51,Main-207- PL,,0,0,0,,Tutaj!
Dialogue: 0,0:10:26.23,0:10:28.48,Main-207- PL,,0,0,0,,C-Co to było?!
Dialogue: 0,0:10:28.48,0:10:29.86,Main-207- PL,,0,0,0,,Kto wie?
Dialogue: 0,0:10:29.86,0:10:32.11,Main-207- PL,,0,0,0,,Wygląda na to, że Jango\Nwziął się do roboty.
Dialogue: 0,0:10:32.11,0:10:34.57,Main-207- PL,,0,0,0,,Może sami pójdziecie się przekonać?
Dialogue: 0,0:10:34.95,0:10:39.54,Main-207- PL,,0,0,0,,Choć zapewne i tak jest już za późno...
Dialogue: 0,0:10:41.54,0:10:43.00,Main-207- PL,,0,0,0,,Niech cię...!
Dialogue: 0,0:10:43.33,0:10:46.46,Main-207- PL,,0,0,0,,Nie masz w sobie ani krzty litości?!
Dialogue: 0,0:10:46.46,0:10:48.59,Main-207- PL,,0,0,0,,Mieszkaliście razem przez trzy lata!
Dialogue: 0,0:10:48.59,0:10:49.75,Main-207- PL,,0,0,0,,Nie mam!
Dialogue: 0,0:10:49.75,0:10:53.97,Main-207- PL,,0,0,0,,Tak jak mówiłem, Kaya to jedynie\Npionek w moim planie.
Dialogue: 0,0:10:53.97,0:10:58.43,Main-207- PL,,0,0,0,,Gdy spełni swoją rolę\Ni zginie, to jej podziękuję.
Dialogue: 0,0:10:59.05,0:11:01.35,Main-207- PL,,0,0,0,,Niech cię...!
Dialogue: 0,0:11:01.35,0:11:03.60,Main-207- PL,,0,0,0,,Nie ma ratunku dla takich jak on...
Dialogue: 0,0:11:03.60,0:11:05.90,Main-207- PL,,0,0,0,,Nie żebym zamierzał go ratować.
Dialogue: 0,0:11:07.15,0:11:08.86,Main-207- PL,,0,0,0,,Usopp!
Dialogue: 0,0:11:10.27,0:11:12.78,Main-207- PL,,0,0,0,,Zasuwaj im pomóc!
Dialogue: 0,0:11:13.78,0:11:16.28,Main-207- PL,,0,0,0,,Tych tutaj zostaw nam!
Dialogue: 0,0:11:17.16,0:11:18.57,Main-207- PL,,0,0,0,,Możesz na nas liczyć!
Dialogue: 0,0:11:28.58,0:11:32.92,Main-207- PL,,0,0,0,,Och? Nadal się ruszasz?\NZdumiewające.
Dialogue: 0,0:11:32.92,0:11:34.42,Main-207- PL,,0,0,0,,Zamknij się...!
Dialogue: 0,0:11:34.42,0:11:36.18,Main-207- PL,,0,0,0,,Nie pozwolę...
Dialogue: 0,0:11:36.18,0:11:38.97,Main-207- PL,,0,0,0,,aby uszło ci to na sucho!
Dialogue: 0,0:11:39.85,0:11:44.93,Main-207- PL,,0,0,0,,Zagrałeś sobie na uczuciach\Nmieszkańców wioski... na uczuciach Kai!
Dialogue: 0,0:11:46.10,0:11:50.86,Main-207- PL,,0,0,0,,Nie pozwolę ci zrealizować\Nżadnego z twoich planów!
Dialogue: 0,0:11:52.23,0:11:53.32,Main-207- PL,,0,0,0,,Usopp!
Dialogue: 0,0:11:56.82,0:11:59.03,Main-207- PL,,0,0,0,,Ch-Cholera...
Dialogue: 0,0:11:59.03,0:12:03.04,Main-207- PL,,0,0,0,,Nie mogę... się ruszyć...
Dialogue: 0,0:12:09.00,0:12:12.59,Main-207- PL,,0,0,0,,Zaprawdę piękne przedstawienie!
Dialogue: 0,0:12:12.92,0:12:16.01,Main-207- PL,,0,0,0,,Lepiej dalej sobie tam leż.
Dialogue: 0,0:12:16.59,0:12:19.84,Main-207- PL,,0,0,0,,Nawet jakbyś jakimś cudem\Ndogonił Jango,
Dialogue: 0,0:12:19.84,0:12:22.64,Main-207- PL,,0,0,0,,to i tak nie miałbyś\Nz nim najmniejszych szans.
Dialogue: 0,0:12:22.64,0:12:25.14,Main-207- PL,,0,0,0,,Tak będzie dla ciebie najbezpieczniej!
Dialogue: 0,0:12:26.31,0:12:27.98,Main-207- PL,,0,0,0,,Nawet jeżeli nie mam szans...
Dialogue: 0,0:12:29.44,0:12:32.69,Main-207- PL,,0,0,0,,Nawet jeżeli nie mam z nim szans...
Dialogue: 0,0:12:32.69,0:12:35.86,Main-207- PL,,0,0,0,,{\fad(0,937)}Ochronię ich!
Dialogue: 0,0:12:36.03,0:12:39.32,Main-207- PL,,0,0,0,,{\q2}Jestem przecież kapitanem\NPiratów Usoppa,
Dialogue: 0,0:12:39.32,0:12:42.41,Main-207- PL,,0,0,0,,i mam zamiar zostać\Ndzielnym wojownikiem mórz!{Z - should match up with other instances of "brave warrior of the sea" like on Little Garden at 05:09}
Dialogue: 0,0:12:43.03,0:12:50.83,Main-207- PL,,0,0,0,,Za nic nie pozwolę ci tknąć tej wioski!
Dialogue: 0,0:12:53.96,0:12:56.17,Main-207- PL,,0,0,0,,A temu co?
Dialogue: 0,0:12:54.71,0:12:56.17,Secondary-207- PL,,0,0,0,,Coś tam skrzeczy!
Dialogue: 0,0:12:56.17,0:12:58.63,Main-207- PL,,0,0,0,,Patrzcie na to, popłakał się!
Dialogue: 0,0:13:11.52,0:13:13.23,Main-207- PL,,0,0,0,,Co was tak bawi?!
Dialogue: 0,0:13:16.03,0:13:16.98,Main-207- PL,,0,0,0,,Luffy!
Dialogue: 0,0:13:17.57,0:13:20.95,Main-207- PL,,0,0,0,,Biorę Usoppa i lecę za tym\Nhipno-świrem! Jakieś obiekcje?!
Dialogue: 0,0:13:20.95,0:13:22.91,Main-207- PL,,0,0,0,,Brak! Pospiesz się!
Dialogue: 0,0:13:22.91,0:13:25.16,Main-207- PL,,0,0,0,,W-Wybacz...
Dialogue: 0,0:13:25.16,0:13:29.41,Main-207- PL,,0,0,0,,Samemu byłbym znacznie szybszy,\Nale los chciał, że poszli do lasu.
Dialogue: 0,0:13:29.41,0:13:32.62,Main-207- PL,,0,0,0,,Jeśli chcemy go dogonić,\Nbędziesz musiał mnie pokierować.
Dialogue: 0,0:13:32.62,0:13:34.63,Main-207- PL,,0,0,0,,Chwila moment, panowie.
Dialogue: 0,0:13:34.63,0:13:37.88,Main-207- PL,,0,0,0,,Kto wam pozwolił tędy przejść?
Dialogue: 0,0:13:38.21,0:13:39.51,Main-207- PL,,0,0,0,,Ja!
Dialogue: 0,0:13:40.84,0:13:42.47,Main-207- PL,,0,0,0,,Teraz! Zoro! Usopp!
Dialogue: 0,0:13:44.55,0:13:45.47,Main-207- PL,,0,0,0,,I kolejny!
Dialogue: 0,0:13:51.94,0:13:56.52,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowa Włócznia!
Dialogue: 0,0:13:56.52,0:13:58.23,Main-207- PL,,0,0,0,,Niech to! Znowu zniknął!
Dialogue: 0,0:14:00.65,0:14:03.86,Main-207- PL,,0,0,0,,A mniejsza! Najważniejsze,\Nże weszli po skarpie!
Dialogue: 0,0:14:03.86,0:14:07.49,Main-207- PL,,0,0,0,,Zanim staniemy do walki,\Nzadam jedno pytanie.
Dialogue: 0,0:14:07.49,0:14:11.96,Main-207- PL,,0,0,0,,Dlaczego ktoś z zewnątrz\Nwtyka nos w sprawy wioski?!
Dialogue: 0,0:14:13.17,0:14:16.42,Main-207- PL,,0,0,0,,Bo mieszka w niej ktoś,\Nkomu nie pozwolę zginąć.
Dialogue: 0,0:14:17.25,0:14:18.88,Main-207- PL,,0,0,0,,Taka błahostka.
Dialogue: 0,0:14:18.88,0:14:22.26,Main-207- PL,,0,0,0,,Coś tak prostego wystarczy ci\Nza powód, by umrzeć?
Dialogue: 0,0:14:22.26,0:14:23.97,Main-207- PL,,0,0,0,,Wystarczy!
Dialogue: 0,0:14:23.97,0:14:25.34,Main-207- PL,,0,0,0,,Ale nie zamierzam umierać!
Dialogue: 0,0:14:25.84,0:14:27.81,Main-207- PL,,0,0,0,,A ja dopilnuję, żebyś umarł!
Dialogue: 0,0:14:34.77,0:14:37.56,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy Bicz!
Dialogue: 0,0:14:38.52,0:14:40.28,Main-207- PL,,0,0,0,,{\fad(150,150)}No i Pistolet!
Dialogue: 0,0:14:46.24,0:14:47.74,Main-207- PL,,0,0,0,,Chyba umrę z nudów!
Dialogue: 0,0:14:47.74,0:14:50.04,Main-207- PL,,0,0,0,,Oż ty...!
Dialogue: 0,0:14:55.87,0:14:59.67,Main-207- PL,,0,0,0,,Hej! Na wschód! Wschód, mówię!
Dialogue: 0,0:14:59.67,0:15:01.92,Main-207- PL,,0,0,0,,To mi nic nie mówi! Mów: lewo czy prawo!
Dialogue: 0,0:15:01.92,0:15:03.42,Main-207- PL,,0,0,0,,N-No to w takim razie w prawo!
Dialogue: 0,0:15:03.42,0:15:04.63,Main-207- PL,,0,0,0,,Przecież to w drugą stronę!
Dialogue: 0,0:15:07.97,0:15:09.56,Main-207- PL,,0,0,0,,Panienko Kayo!
Dialogue: 0,0:15:11.56,0:15:13.31,Main-207- PL,,0,0,0,,Przepraszam...
Dialogue: 0,0:15:13.31,0:15:15.14,Main-207- PL,,0,0,0,,Wy biegnijcie dalej...
Dialogue: 0,0:15:15.14,0:15:16.27,Main-207- PL,,0,0,0,,Co ty wygadujesz?!
Dialogue: 0,0:15:16.27,0:15:19.40,Main-207- PL,,0,0,0,,Naszym zadaniem jest cię chronić!
Dialogue: 0,0:15:20.73,0:15:22.57,Main-207- PL,,0,0,0,,O nie, ma paskudnie wysoką gorączkę!
Dialogue: 0,0:15:22.57,0:15:24.65,Main-207- PL,,0,0,0,,Co?! Trzymaj się, panienko Kayo!
Dialogue: 0,0:15:24.65,0:15:25.78,Main-207- PL,,0,0,0,,Lekarza...! Idź po lekarza!
Dialogue: 0,0:15:25.78,0:15:28.16,Main-207- PL,,0,0,0,,Kretynie! Nie mamy na to czasu!
Dialogue: 0,0:15:28.16,0:15:29.95,Main-207- PL,,0,0,0,,Ktoś próbuje ją zabić!
Dialogue: 0,0:15:30.45,0:15:32.79,Main-207- PL,,0,0,0,,Ale to zbyt niebezpieczne,\Nby dalej biegła!
Dialogue: 0,0:15:32.79,0:15:34.08,Main-207- PL,,0,0,0,,Tak, ale...
Dialogue: 0,0:15:34.08,0:15:36.46,Main-207- PL,,0,0,0,,Gdzie się chowacie, kurduple?!
Dialogue: 0,0:15:44.30,0:15:45.76,Main-207- PL,,0,0,0,,Dziękuję wam...
Dialogue: 0,0:15:45.76,0:15:47.43,Main-207- PL,,0,0,0,,Jestem wam wdzięczna za pomoc...
Dialogue: 0,0:15:48.14,0:15:50.76,Main-207- PL,,0,0,0,,Już same chęci wiele znaczą...
Dialogue: 0,0:15:50.76,0:15:52.51,Main-207- PL,,0,0,0,,No już, uciekajcie.
Dialogue: 0,0:15:54.14,0:15:56.06,Main-207- PL,,0,0,0,,Dokąd żeście zwiali?
Dialogue: 0,0:15:58.19,0:16:02.86,Main-207- PL,,0,0,0,,Jeśli zostawimy panienkę Kayę\Ni uciekniemy, to przeżyjemy, prawda?
Dialogue: 0,0:16:02.86,0:16:05.19,Main-207- PL,,0,0,0,,Pewnie tak.
Dialogue: 0,0:16:05.19,0:16:10.53,Main-207- PL,,0,0,0,,{\q2}Kapitan zawsze powtarzał, żeby uciekać\Nz podkulonym ogonem, jeśli masz przegrać...
Dialogue: 0,0:16:10.53,0:16:13.20,Main-207- PL,,0,0,0,,Nasz kapitan rzeczywiście jest kłamcą!
Dialogue: 0,0:16:15.37,0:16:17.96,Main-207- PL,,0,0,0,,Nawet {\i1}on{\i0} stanął do walki!
Dialogue: 0,0:16:17.96,0:16:21.04,Main-207- PL,,0,0,0,,Starał się z całych sił, by nas chronić!
Dialogue: 0,0:16:23.55,0:16:25.84,Main-207- PL,,0,0,0,,Nie pozwolimy panience Kai umrzeć!
Dialogue: 0,0:16:26.22,0:16:29.26,Main-207- PL,,0,0,0,,No dobra! Przygotujcie się, Piraci Usoppa!
Dialogue: 0,0:16:29.26,0:16:30.09,Main-207- PL,,0,0,0,,Tak!
Dialogue: 0,0:16:30.09,0:16:31.55,Main-207- PL,,0,0,0,,Walczmy z nim!
Dialogue: 0,0:16:31.55,0:16:32.68,Main-207- PL,,0,0,0,,Nie!
Dialogue: 0,0:16:32.68,0:16:34.93,Main-207- PL,,0,0,0,,Jesteście jeszcze dziećmi!
Dialogue: 0,0:16:34.93,0:16:37.52,Main-207- PL,,0,0,0,,Nie możecie umrzeć z mojego powodu!
Dialogue: 0,0:16:37.52,0:16:39.14,Main-207- PL,,0,0,0,,Nie mamy zamiaru umierać.{Syrup 07 - 17:22}
Dialogue: 0,0:16:39.14,0:16:40.52,Main-207- PL,,0,0,0,,Będziemy walczyć o życie!{Syrup 07 - 17:22}
Dialogue: 0,0:16:41.73,0:16:43.40,Main-207- PL,,0,0,0,,Szlag...
Dialogue: 0,0:16:43.94,0:16:45.15,Main-207- PL,,0,0,0,,Rozciął mi wargę...
Dialogue: 0,0:16:45.61,0:16:49.49,Main-207- PL,,0,0,0,,Ten słomkowy chłopak jest\Nnieziemsko silny, ale...
Dialogue: 0,0:16:49.49,0:16:52.41,Main-207- PL,,0,0,0,,P-Przy kapitanie Kuro to się chowa!
Dialogue: 0,0:16:53.16,0:16:54.95,Main-207- PL,,0,0,0,,Dalej!
Dialogue: 0,0:16:54.95,0:16:56.58,Main-207- PL,,0,0,0,,Wiwat kapitan Kuro!
Dialogue: 0,0:16:55.66,0:16:56.58,Secondary-207- PL,,0,0,0,,Kapitan Kuro!
Dialogue: 0,0:16:56.58,0:16:59.12,Main-207- PL,,0,0,0,,Wymiatasz, kapitanie Kuro!
Dialogue: 0,0:16:59.12,0:17:02.08,Main-207- PL,,0,0,0,,Nie ważcie się mnie tak nazywać!
Dialogue: 0,0:17:04.04,0:17:07.05,Main-207- PL,,0,0,0,,Nadal wam coś nie trybi?!
Dialogue: 0,0:17:07.05,0:17:13.55,Main-207- PL,,0,0,0,,Ten plan ma pogrzebać\Nimię „kapitan Kuro” raz na zawsze!
Dialogue: 0,0:17:14.76,0:17:16.85,Main-207- PL,,0,0,0,,Jestem zmęczony...{Z - needs to match 22:09}
Dialogue: 0,0:17:17.43,0:17:23.44,Main-207- PL,,0,0,0,,Każdego dnia snułem plany dla hołoty,\Nktórej jedynie zależy na sianiu zamętu...
Dialogue: 0,0:17:23.44,0:17:27.94,Main-207- PL,,0,0,0,,podczas gdy psy na rządowej smyczy\Ni łowcy głów deptali mi po piętach...
Dialogue: 0,0:17:27.94,0:17:32.45,Main-207- PL,,0,0,0,,Miałem już tego serdecznie dosyć!
Dialogue: 0,0:17:36.20,0:17:38.29,Flashbacks-207- PL,,0,0,0,,Marynarka, co...?
Dialogue: 0,0:17:39.04,0:17:42.67,Flashbacks-207- PL,,0,0,0,,{\pos(720,1073)}To już trzeci raz w tym tygodniu...
Dialogue: 0,0:17:43.38,0:17:45.42,Flashbacks-207- PL,,0,0,0,,Tak to już bywa.
Dialogue: 0,0:17:45.42,0:17:49.01,Flashbacks-207- PL,,0,0,0,,Ludziom nie podoba się to,\Nco robimy, więc nas ścigają.
Dialogue: 0,0:17:49.01,0:17:51.68,Flashbacks-207- PL,,0,0,0,,Na dodatek wyrobiłeś sobie\Nniezłą reputację...
Dialogue: 0,0:17:51.68,0:17:53.09,Flashbacks-207- PL,,0,0,0,,Fakt...
Dialogue: 0,0:17:53.09,0:17:56.60,Flashbacks-207- PL,,0,0,0,,I to właśnie ta reputacja ich przyciąga.
Dialogue: 0,0:17:56.60,0:18:01.14,Flashbacks-207- PL,,0,0,0,,Dlatego też porzucam\Nimię kapitana Kuro.
Dialogue: 0,0:18:02.85,0:18:05.61,Flashbacks-207- PL,,0,0,0,,Muszę przyznać, brzmi to nieźle,
Dialogue: 0,0:18:05.61,0:18:06.98,Flashbacks-207- PL,,0,0,0,,ale to się nie uda.
Dialogue: 0,0:18:06.98,0:18:10.36,Flashbacks-207- PL,,0,0,0,,Dopóki żyjesz,\NMarynarka się nie odczepi.
Dialogue: 0,0:18:14.57,0:18:17.03,Flashbacks-207- PL,,0,0,0,,I właśnie dlatego umrę.
Dialogue: 0,0:18:18.41,0:18:22.71,Flashbacks-207- PL,,0,0,0,,Wygląda na to,\Nże pirackie życie nie jest mi pisane...
Dialogue: 0,0:18:22.71,0:18:25.83,Flashbacks-207- PL,,0,0,0,,Ale... jesteś przecież\Nkapitanem tego statku!
Dialogue: 0,0:18:25.83,0:18:28.59,Flashbacks-207- PL,,0,0,0,,To teraz ty będziesz kapitanem!
Dialogue: 0,0:18:28.59,0:18:32.72,Flashbacks-207- PL,,0,0,0,,Mam już dosyć tego szaleństwa.
Dialogue: 0,0:18:35.30,0:18:39.31,Flashbacks-207- PL,,0,0,0,,Ja... zamierzam umrzeć,\Na każdy dowie się o mojej śmierci!
Dialogue: 0,0:18:40.06,0:18:41.14,Flashbacks-207- PL,,0,0,0,,Kapitanie Kuro!
Dialogue: 0,0:18:41.14,0:18:42.06,Flashbacks-207- PL,,0,0,0,,Kapitanie...
Dialogue: 0,0:18:42.06,0:18:43.02,Flashbacks-207- PL,,0,0,0,,Kapitanie!
Dialogue: 0,0:18:43.02,0:18:44.77,Flashbacks-207- PL,,0,0,0,,Ile statków?
Dialogue: 0,0:18:44.77,0:18:46.40,Flashbacks-207- PL,,0,0,0,,T-Tylko jeden!
Dialogue: 0,0:18:46.40,0:18:47.90,Flashbacks-207- PL,,0,0,0,,Co robić, kapitanie?
Dialogue: 0,0:18:47.90,0:18:50.15,Flashbacks-207- PL,,0,0,0,,Mamy odpowiedzieć im ogniem?
Dialogue: 0,0:18:50.15,0:18:52.49,Flashbacks-207- PL,,0,0,0,,Przygotować szalupę.
Dialogue: 0,0:18:52.49,0:18:53.61,Flashbacks-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:18:53.61,0:18:54.61,Flashbacks-207- PL,,0,0,0,,Szalupę!
Dialogue: 0,0:18:58.41,0:19:00.33,Flashbacks-207- PL,,0,0,0,,Pierwszy oficerze Jango! Kapitan Kuro...!
Dialogue: 0,0:19:00.33,0:19:01.66,Flashbacks-207- PL,,0,0,0,,Tak, wiem.
Dialogue: 0,0:19:01.66,0:19:02.58,Flashbacks-207- PL,,0,0,0,,„Wiesz”?!
Dialogue: 0,0:19:02.58,0:19:05.12,Flashbacks-207- PL,,0,0,0,,To zbyt niebezpieczne, by płynął tam sam!
Dialogue: 0,0:19:05.12,0:19:07.88,Flashbacks-207- PL,,0,0,0,,Chyba nie popłynął,\Naby się dobrowolnie poddać?!
Dialogue: 0,0:19:22.68,0:19:25.06,Flashbacks-207- PL,,0,0,0,,Co?! Armaty przestały strzelać...
Dialogue: 0,0:19:25.60,0:19:27.23,Flashbacks-207- PL,,0,0,0,,Dobić do ich statku.
Dialogue: 0,0:19:27.23,0:19:28.56,Flashbacks-207- PL,,0,0,0,,A-Ale...
Dialogue: 0,0:19:28.56,0:19:30.98,Flashbacks-207- PL,,0,0,0,,Po prostu róbcie, co wam każę!
Dialogue: 0,0:19:30.98,0:19:32.15,Flashbacks-207- PL,,0,0,0,,T-Tak jest!
Dialogue: 0,0:19:32.15,0:19:34.24,FlashbacksSecondary-207- PL,,0,0,0,,Hej, szykować się do walki!
Dialogue: 0,0:19:32.90,0:19:34.24,FlashbackThoughts-207- PL,,0,0,0,,{\an8}Rozumiem...
Dialogue: 0,0:19:34.24,0:19:36.41,FlashbacksSecondary-207- PL,,0,0,0,,Dobić do statku!
Dialogue: 0,0:19:34.24,0:19:36.41,FlashbackThoughts-207- PL,,0,0,0,,{\an8}Czyli to dlatego...
Dialogue: 0,0:19:48.08,0:19:50.42,Flashbacks-207- PL,,0,0,0,,M-Marynarze...
Dialogue: 0,0:19:50.42,0:19:52.67,Flashbacks-207- PL,,0,0,0,,Wyrżnął ich w pień!
Dialogue: 0,0:19:56.38,0:19:58.30,Flashbacks-207- PL,,0,0,0,,A więc...
Dialogue: 0,0:19:58.97,0:20:01.81,Flashbacks-207- PL,,0,0,0,,Czas na realizację planu...!
Dialogue: 0,0:20:05.98,0:20:09.06,Flashbacks-207- PL,,0,0,0,,No już. Weź się w garść.
Dialogue: 0,0:20:09.06,0:20:12.23,Flashbacks-207- PL,,0,0,0,,Byłem na tyle miły,\Naby zostawić cię przy życiu...
Dialogue: 0,0:20:12.23,0:20:15.24,Flashbacks-207- PL,,0,0,0,,Z-Zamknij się...
Dialogue: 0,0:20:15.24,0:20:18.20,Flashbacks-207- PL,,0,0,0,,N-Nie będę cię błagał o życie...
Dialogue: 0,0:20:18.99,0:20:22.03,Flashbacks-207- PL,,0,0,0,,W-Wykończ mnie, łachudro...
Dialogue: 0,0:20:24.79,0:20:26.75,Flashbacks-207- PL,,0,0,0,,Podoba mi się ta mina.
Dialogue: 0,0:20:26.75,0:20:30.38,Flashbacks-207- PL,,0,0,0,,Skoro tyle szczekasz\Npomimo złamanej szczęki, to idealnie!
Dialogue: 0,0:20:33.34,0:20:39.43,Flashbacks-207- PL,,0,0,0,,Bezimienny szeregowiec taki jak ty\Ndostanie ode mnie nagrodę.
Dialogue: 0,0:20:39.43,0:20:42.10,Flashbacks-207- PL,,0,0,0,,Więc bądź wdzięczny i ją przyjmij...
Dialogue: 0,0:20:42.85,0:20:46.56,Flashbacks-207- PL,,0,0,0,,Głowę Kuro Tysiąca Planów!
Dialogue: 0,0:20:46.98,0:20:49.27,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Twe imię brzmi kapitan Kuro.
Dialogue: 0,0:20:49.27,0:20:52.19,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Twe imię brzmi kapitan Kuro.
Dialogue: 0,0:20:52.19,0:20:55.07,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Ta rzeź to twoja sprawka.
Dialogue: 0,0:20:55.07,0:20:56.19,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Raz,
Dialogue: 0,0:20:56.19,0:20:57.44,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}dwa,
Dialogue: 0,0:20:57.44,0:20:58.53,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Jango!
Dialogue: 0,0:20:58.95,0:21:01.53,Flashbacks-207- PL,,0,0,0,,Moje imię brzmi kapitan Kuro.
Dialogue: 0,0:21:01.53,0:21:04.37,Flashbacks-207- PL,,0,0,0,,Ta rzeź to moja sprawka.
Dialogue: 0,0:21:04.37,0:21:08.79,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}A ty zaś jesteś tym,\Nktóry schwytał kapitana Kuro.
Dialogue: 0,0:21:08.79,0:21:11.83,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Wrócisz do bazy, po czym\Nzaprowadzisz go na egzekucję.
Dialogue: 0,0:21:11.83,0:21:12.75,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Raz,
Dialogue: 0,0:21:12.75,0:21:13.84,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}dwa,
Dialogue: 0,0:21:13.84,0:21:14.80,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Jango!
Dialogue: 0,0:21:15.88,0:21:19.63,Flashbacks-207- PL,,0,0,0,,Jestem tym, który schwytał kapitana Kuro!
Dialogue: 0,0:21:19.63,0:21:21.76,Flashbacks-207- PL,,0,0,0,,Znowu to zrobiłeś, pierwszy oficerze!
Dialogue: 0,0:21:22.22,0:21:23.89,FlashbackThoughts-207- PL,,0,0,0,,Wspaniale...
Dialogue: 0,0:21:23.89,0:21:32.69,FlashbackThoughts-207- PL,,0,0,0,,{\t(6904,0,1,\c&H000000&\3c&H000000&)}{\q2}Gdy zajmą się tą fałszywką,\Nimię kapitana Kuro zniknie z tego świata.
Dialogue: 0,0:21:32.94,0:21:40.40,Main-207- PL,,0,0,0,,Dziś, gdy mój plan się powiedzie,\Nten cel w końcu zostanie osiągnięty...!
Dialogue: 0,0:21:40.99,0:21:43.74,Main-207- PL,,0,0,0,,Będę miał pieniądze i święty spokój.
Dialogue: 0,0:21:44.12,0:21:46.20,Main-207- PL,,0,0,0,,Rozumiesz, smarkaczu?
Dialogue: 0,0:21:46.20,0:21:51.12,Main-207- PL,,0,0,0,,Nie pozwolę, aby trzy lata\Nrealizacji planu poszły na marne!
Dialogue: 0,0:21:51.46,0:21:55.38,Main-207- PL,,0,0,0,,Nic nie powstrzyma mojego planu!
Dialogue: 0,0:22:01.55,0:22:04.51,Main-207- PL,,0,0,0,,Czyli potrafisz coś jeszcze\Npoza rozciąganiem!
Dialogue: 0,0:22:04.51,0:22:05.60,Main-207- PL,,0,0,0,,Ano potrafię!
Dialogue: 0,0:22:05.60,0:22:09.39,Main-207- PL,,0,0,0,,Zahartowałem się, żeby zostać piratem!
Dialogue: 0,0:22:11.81,0:22:13.56,Main-207- PL,,0,0,0,,Jesteś „zmęczony”?!{Z - needs to match 17:11}
Dialogue: 0,0:22:13.56,0:22:18.11,Main-207- PL,,0,0,0,,Nie nadajesz się na pirata,\Nskoro boisz się sławy na morzach!
Dialogue: 0,0:22:24.78,0:22:27.03,Main-207- PL,,0,0,0,,Twoje ambicje...
Dialogue: 0,0:22:27.03,0:22:29.91,Main-207- PL,,0,0,0,,są niczym w porównaniu z moimi!
