Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=18}===============================DIALOGUE============================
Dialogue: 0,0:01:54.89,0:01:56.85,Main-207- PL,,0,0,0,,S-Skurczybyk...
Dialogue: 0,0:01:56.85,0:01:59.27,Main-207- PL,,0,0,0,,Zniszczył kocią łapę kapitana Kuro!
Dialogue: 0,0:02:02.35,0:02:05.15,Main-207- PL,,0,0,0,,Pora rozwalić kolejne pięć\Ntych dziwacznych mieczy!
Dialogue: 0,0:02:08.86,0:02:11.07,Main-207- PL,,0,0,0,,Będzie dobrze! Takie coś\Ngo nie powstrzyma!
Dialogue: 0,0:02:11.07,0:02:13.07,Main-207- PL,,0,0,0,,Właśnie! Ma jeszcze jedną łapę!
Dialogue: 0,0:02:13.57,0:02:16.70,Main-207- PL,,0,0,0,,Zadrap go na śmierć, kapitanie Kuro!
Dialogue: 0,0:02:16.70,0:02:19.83,Main-207- PL,,0,0,0,,Mieliśmy nie używać tego imienia!
Dialogue: 0,0:02:19.83,0:02:23.54,Main-207- PL,,0,0,0,,Jak dobrze pamiętam... w wiosce\Nmówią na niego Klaha... coś tam...
Dialogue: 0,0:02:23.54,0:02:25.67,Main-207- PL,,0,0,0,,W takim razie pan Kla!
Dialogue: 0,0:02:25.67,0:02:28.04,Main-207- PL,,0,0,0,,– Panie Kla! Rozwal go!\N– Panie Kla! Rozwal go!
Dialogue: 0,0:02:30.13,0:02:31.96,Main-207- PL,,0,0,0,,Przygłupy...
Dialogue: 0,0:02:32.38,0:02:33.38,Main-207- PL,,0,0,0,,Zamknijcie się!
Dialogue: 0,0:02:39.35,0:02:41.72,Main-207- PL,,0,0,0,,Wyłaźcie, kurduple!
Dialogue: 0,0:02:41.72,0:02:44.35,Main-207- PL,,0,0,0,,Wiem, że gdzieś tu jesteście!
Dialogue: 0,0:02:44.35,0:02:45.94,Main-207- PL,,0,0,0,,Dajcie sobie spokój!
Dialogue: 0,0:02:48.69,0:02:50.15,Main-207- PL,,0,0,0,,Chodź tędy!
Dialogue: 0,0:02:50.15,0:02:52.82,Main-207- PL,,0,0,0,,Zabierzemy cię prosto do Kai!
Dialogue: 0,0:02:55.03,0:03:00.54,Main-207- PL,,0,0,0,,Myślicie, że jestem aż taki naiwny?\NNie dam się ograć zgrai bachorów!
Comment: 0,0:03:00.83,0:03:01.54,Main-207- PL,,0,0,0,,Co jest?!
Dialogue: 0,0:03:01.54,0:03:02.95,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:03:05.58,0:03:07.04,Main-207- PL,,0,0,0,,Mamy go!
Dialogue: 0,0:03:07.04,0:03:08.04,Main-207- PL,,0,0,0,,Teraz!
Dialogue: 0,0:03:10.55,0:03:11.55,Main-207- PL,,0,0,0,,A masz!
Dialogue: 0,0:03:11.55,0:03:13.72,Main-207- PL,,0,0,0,,{\fad(150,150)}Pieprzny Atak!
Dialogue: 0,0:03:29.98,0:03:32.78,Main-207- PL,,0,0,0,,– Rusz się!\N– Rusz się!
Dialogue: 0,0:03:39.53,0:03:41.28,Main-207- PL,,0,0,0,,Aua, boli!
Dialogue: 0,0:03:41.28,0:03:42.91,Main-207- PL,,0,0,0,,Boli! Boli!
Dialogue: 0,0:03:45.37,0:03:48.42,Main-207- PL,,0,0,0,,– To koniec, hipnotyzerze!\N– To koniec, hipnotyzerze!
Dialogue: 0,0:03:53.71,0:03:56.01,Main-207- PL,,0,0,0,,Nie wyobrażajcie sobie.
Dialogue: 0,0:03:57.34,0:03:59.39,Main-207- PL,,0,0,0,,Niech to! Wtopa...!
Dialogue: 0,0:03:59.93,0:04:02.22,Main-207- PL,,0,0,0,,Potraktowaliście mnie jak durnia.
Dialogue: 0,0:04:02.22,0:04:04.97,Main-207- PL,,0,0,0,,Zapominacie, że jestem piratem...
Dialogue: 0,0:04:07.14,0:04:08.27,Main-207- PL,,0,0,0,,– Cebul!\N– Cebul!
Dialogue: 0,0:04:08.27,0:04:13.11,Main-207- PL,,0,0,0,,Trochę przesadziliście z tą zabawą w piratów,\Ngówniarze...
Dialogue: 0,0:04:16.90,0:04:19.28,Main-207- PL,,0,0,0,,Gdzie się ukryłaś, panienko?!
Dialogue: 0,0:04:19.28,0:04:22.78,Main-207- PL,,0,0,0,,Najpierw pozbędę się tej trójki.
Dialogue: 0,0:04:22.78,0:04:26.87,Main-207- PL,,0,0,0,,Wtykanie nosa w sprawy\Nprawdziwych piratów było głupotą...
Dialogue: 0,0:04:26.87,0:04:30.37,Main-207- PL,,0,0,0,,Będziecie mogli sobie to przemyśleć\Nw drodze na tamten świat.
Dialogue: 0,0:04:37.47,0:04:39.34,Main-207- PL,,0,0,0,,Tu cię mam.
Dialogue: 0,0:04:40.59,0:04:41.89,Main-207- PL,,0,0,0,,Tylko nie to!
Dialogue: 0,0:04:41.89,0:04:43.30,Main-207- PL,,0,0,0,,Uciekaj, panienko Kayo!
Dialogue: 0,0:04:43.30,0:04:44.18,Main-207- PL,,0,0,0,,Ej!
Dialogue: 0,0:04:44.18,0:04:46.35,Main-207- PL,,0,0,0,,Tak! To ich głos!
Dialogue: 0,0:04:46.35,0:04:47.77,Main-207- PL,,0,0,0,,Czyli to w drugą stronę?!
Dialogue: 0,0:04:49.06,0:04:54.19,Main-207- PL,,0,0,0,,Możecie być pewni, że potem zaszlachtuję\Nwas wszystkich, co do jednego...
Dialogue: 0,0:04:54.86,0:04:57.78,Main-207- PL,,0,0,0,,Oczywiście to dotyczy też Jango!
Dialogue: 0,0:04:57.78,0:05:00.61,Main-207- PL,,0,0,0,,D-Dlaczego nas też?!
Dialogue: 0,0:05:00.61,0:05:03.74,Main-207- PL,,0,0,0,,Odpuść sobie takie żarty,\Nkapitanie Kuro!
Dialogue: 0,0:05:04.12,0:05:07.50,Main-207- PL,,0,0,0,,Mamy jeszcze sporo czasu,\Nżeby zaatakować wioskę, prawda?!
Dialogue: 0,0:05:07.50,0:05:12.71,Main-207- PL,,0,0,0,,A do tego, jeśli kapitan Jango zdobędzie\Njej testament, to twój plan się powiedzie!
Dialogue: 0,0:05:13.84,0:05:17.00,Main-207- PL,,0,0,0,,Nie musicie się już martwić\Nszczegółami mojego planu...
Dialogue: 0,0:05:17.00,0:05:22.13,Main-207- PL,,0,0,0,,Wszystko, czego mi teraz potrzeba,\Nto truchła, na które zrzucę winę.
Dialogue: 0,0:05:23.34,0:05:27.77,Main-207- PL,,0,0,0,,I tak nie miałem zamiaru pozwolić\Nktóremukolwiek z was opuścić wioski.
Dialogue: 0,0:05:28.39,0:05:34.23,Main-207- PL,,0,0,0,,Nikt, kto zna moją tożsamość,\Nnie może zostać przy życiu.
Dialogue: 0,0:05:34.61,0:05:35.57,Main-207- PL,,0,0,0,,No nie...
Dialogue: 0,0:05:35.57,0:05:39.69,Main-207- PL,,0,0,0,,Więc... zamierzałeś nas pozabijać\Njuż od samego początku?!
Dialogue: 0,0:05:41.40,0:05:43.66,Main-207- PL,,0,0,0,,Dokładnie tak...
Dialogue: 0,0:05:44.03,0:05:49.45,Main-207- PL,,0,0,0,,Jeszcze gdy zwałem się\Nkapitanem Kuro... Przez trzy długie lata...
Dialogue: 0,0:05:49.45,0:05:51.58,Main-207- PL,,0,0,0,,To wszystko było...
Dialogue: 0,0:05:52.08,0:05:54.58,Main-207- PL,,0,0,0,,Wszystko było częścią mojego planu!
Dialogue: 0,0:05:56.59,0:05:58.80,Main-207- PL,,0,0,0,,Ale z was wszystkich kretyni.
Dialogue: 0,0:05:58.80,0:06:01.05,Main-207- PL,,0,0,0,,Niefajną masz tę załogę!
Dialogue: 0,0:06:02.13,0:06:03.89,Main-207- PL,,0,0,0,,„Niefajną”?
Dialogue: 0,0:06:03.89,0:06:09.10,Main-207- PL,,0,0,0,,Piraci to tylko bezpańskie kundle\Nwyrzucone poza margines społeczeństwa!
Dialogue: 0,0:06:09.43,0:06:12.52,Main-207- PL,,0,0,0,,Co by takie niedojdy\Nosiągnęły bez planu?!
Dialogue: 0,0:06:12.52,0:06:16.77,Main-207- PL,,0,0,0,,Wszyscy co do jednego powinni\Nsię zamknąć i robić to, co im każę!
Dialogue: 0,0:06:17.57,0:06:21.11,Main-207- PL,,0,0,0,,Załoga to nic innego\Njak pionki w rękach kapitana!
Dialogue: 0,0:06:21.11,0:06:25.03,Main-207- PL,,0,0,0,,O ich życiu i śmierci\Ndecyduję tylko ja.
Dialogue: 0,0:06:25.03,0:06:29.83,Main-207- PL,,0,0,0,,Nieważne, jak wielka przeszkoda\Nstanie im na drodze, mają walczyć...
Dialogue: 0,0:06:29.83,0:06:33.29,Main-207- PL,,0,0,0,,i jeśli tego wymaga\Nmój plan, to nawet zginąć.
Dialogue: 0,0:06:34.87,0:06:37.71,Main-207- PL,,0,0,0,,Właśnie tacy są prawdziwi piraci!
Dialogue: 0,0:06:37.71,0:06:40.80,Main-207- PL,,0,0,0,,Ale co taki przybłęda\Njak ty może o tym wiedzieć!
Dialogue: 0,0:06:45.93,0:06:47.89,Main-207- PL,,0,0,0,,Nawet jeśli jesteś kapitanem...
Dialogue: 0,0:06:48.26,0:06:51.43,Main-207- PL,,0,0,0,,za którym idą setki czy tysiące ludzi...
Dialogue: 0,0:06:52.52,0:06:55.23,Main-207- PL,,0,0,0,,I tak nie przebijesz Usoppa!
Dialogue: 0,0:06:57.23,0:06:59.11,Main-207- PL,,0,0,0,,Co proszę?!
Dialogue: 0,0:06:59.73,0:07:03.86,Main-207- PL,,0,0,0,,Mówisz, że jestem gorszy od dzieciaka,\Nktóry tylko {\i1}udaje{\i0} kapitana piratów?
Dialogue: 0,0:07:03.86,0:07:04.70,Main-207- PL,,0,0,0,,Zgadza się!
Dialogue: 0,0:07:07.24,0:07:09.12,Main-207- PL,,0,0,0,,Śmiechu warte!
Dialogue: 0,0:07:09.12,0:07:13.20,Main-207- PL,,0,0,0,,Nie bądź taki pewny siebie tylko dlatego,\Nże zniszczyłeś jedną z moich łap!
Dialogue: 0,0:07:13.54,0:07:15.67,Main-207- PL,,0,0,0,,Niby w czym jest lepszy ode mnie?!
Dialogue: 0,0:07:16.17,0:07:17.63,Main-207- PL,,0,0,0,,Oświeć mnie!
Dialogue: 0,0:07:22.13,0:07:23.59,Main-207- PL,,0,0,0,,Charakter.
Dialogue: 0,0:07:24.47,0:07:25.84,Main-207- PL,,0,0,0,,Co takiego?!
Dialogue: 0,0:07:25.84,0:07:31.72,Main-207- PL,,0,0,0,,Nie masz zielonego pojęcia,\Nco naprawdę znaczy być piratem!
Dialogue: 0,0:07:42.27,0:07:43.99,Main-207- PL,,0,0,0,,O-On...
Dialogue: 0,0:07:43.99,0:07:47.45,Main-207- PL,,0,0,0,,Nadążył za techniką Lekkiej Stopy!
Dialogue: 0,0:07:49.91,0:07:52.79,Main-207- PL,,0,0,0,,To dopiero upokorzenie...
Dialogue: 0,0:07:54.83,0:08:00.79,Main-207- PL,,0,0,0,,Skoro {\i1}prawdziwi{\i0} piraci aż tak cię\Ninteresują, to pozwól, że pokażę ci...
Dialogue: 0,0:08:00.79,0:08:03.38,Main-207- PL,,0,0,0,,{\i1}prawdziwe{\i0} oblicze strachu.
Dialogue: 0,0:08:03.75,0:08:09.55,Main-207- PL,,0,0,0,,Grozę pirata, który otarł się o śmierć\Nniezliczenie wiele razy!
Dialogue: 0,0:08:14.52,0:08:17.23,Main-207- PL,,0,0,0,,Ej! Ta postawa! Czy on...?!
Dialogue: 0,0:08:17.23,0:08:19.23,Main-207- PL,,0,0,0,,To {\i1}tego{\i0} chce teraz użyć?!
Dialogue: 0,0:08:19.23,0:08:21.65,Main-207- PL,,0,0,0,,Przecież przeciwnik jest tylko jeden!
Dialogue: 0,0:08:21.65,0:08:23.44,Main-207- PL,,0,0,0,,Nie ma mowy o pomyłce!
Dialogue: 0,0:08:23.44,0:08:26.90,Main-207- PL,,0,0,0,,Chce użyć Wszechkociej Nabierkaźni!
Dialogue: 0,0:08:28.28,0:08:29.91,Main-207- PL,,0,0,0,,Czyli też mamy przechlapane?!
Dialogue: 0,0:08:29.91,0:08:31.28,Main-207- PL,,0,0,0,,Nas też dorwie!
Dialogue: 0,0:08:31.28,0:08:33.03,Main-207- PL,,0,0,0,,I tak miał zamiar nas pozabijać!
Dialogue: 0,0:08:33.03,0:08:34.87,Main-207- PL,,0,0,0,,Przecież sam tak wcześniej mówił!
Dialogue: 0,0:08:35.45,0:08:36.95,Main-207- PL,,0,0,0,,Proszę, przestań, kapitanie Kuro!
Dialogue: 0,0:08:36.95,0:08:38.50,Main-207- PL,,0,0,0,,Wszystko tylko nie ta technika!
Dialogue: 0,0:08:38.50,0:08:40.25,Main-207- PL,,0,0,0,,Zrobimy, co tylko zechcesz!
Dialogue: 0,0:08:40.25,0:08:43.00,Main-207- PL,,0,0,0,,Proszę, kapitanie Kuro!
Dialogue: 0,0:08:43.00,0:08:44.34,Main-207- PL,,0,0,0,,A tym co odbiło?
Dialogue: 0,0:08:45.09,0:08:47.80,Main-207- PL,,0,0,0,,Przecież facet się\Ntylko chwieje na boki...
Dialogue: 0,0:08:47.80,0:08:50.47,Main-207- PL,,0,0,0,,– Proszę przestać, kapitanie Kuro!\N– Proszę przestać, kapitanie Kuro!
Dialogue: 0,0:08:50.97,0:08:52.30,Main-207- PL,,0,0,0,,{\fad(150,150)}Wszechkocia Nabierkaźń!
Dialogue: 0,0:09:02.44,0:09:04.02,Main-207- PL,,0,0,0,,Ale bieda...
Dialogue: 0,0:09:04.65,0:09:07.99,Main-207- PL,,0,0,0,,Spodziewałam się jednak\Ntrochę większego skarbu...
Dialogue: 0,0:09:08.44,0:09:11.53,Main-207- PL,,0,0,0,,Zobaczmy. Walka się już skończyła?
Dialogue: 0,0:09:13.16,0:09:14.49,Main-207- PL,,0,0,0,,Co jest?
Dialogue: 0,0:09:14.49,0:09:16.24,Main-207- PL,,0,0,0,,Nikt się nie rusza...
Dialogue: 0,0:09:16.24,0:09:17.70,Main-207- PL,,0,0,0,,Już po wszystkim?
Dialogue: 0,0:09:25.75,0:09:26.59,Main-207- PL,,0,0,0,,Nadchodzi!
Dialogue: 0,0:09:28.21,0:09:30.76,Main-207- PL,,0,0,0,,S-Skąd on się tam wziął?!
Dialogue: 0,0:09:33.14,0:09:34.47,Main-207- PL,,0,0,0,,Znowu!
Dialogue: 0,0:09:36.22,0:09:37.60,Main-207- PL,,0,0,0,,A teraz ściana!
Dialogue: 0,0:09:43.60,0:09:46.07,Main-207- PL,,0,0,0,,Proszę, przestań, kapitanie Kuro!
Dialogue: 0,0:09:46.07,0:09:49.03,Main-207- PL,,0,0,0,,To na nic! Nie kontroluje ataków,\Ngdy korzysta z Lekkiej Stopy!
Dialogue: 0,0:09:49.03,0:09:52.86,Main-207- PL,,0,0,0,,Porusza się tak szybko,\Nże nawet nie wie, kogo rani!
Dialogue: 0,0:09:53.53,0:09:56.08,Main-207- PL,,0,0,0,,Pociął już tylu swoich towarzy...
Dialogue: 0,0:09:57.16,0:09:58.08,Main-207- PL,,0,0,0,,Hej!
Dialogue: 0,0:10:03.54,0:10:06.04,Thoughts-207- PL,,0,0,0,,C-Co tam się wyprawia?!
Dialogue: 0,0:10:06.04,0:10:08.55,Thoughts-207- PL,,0,0,0,,Coś tnie jednego po drugim,\Nnie wiadomo skąd!
Dialogue: 0,0:10:23.06,0:10:24.44,Thoughts-207- PL,,0,0,0,,Pokaż się...
Dialogue: 0,0:10:25.02,0:10:25.90,Thoughts-207- PL,,0,0,0,,lokaju...
Dialogue: 0,0:10:39.03,0:10:43.79,Main-207- PL,,0,0,0,,Twoja załoga naprawdę\Nnic dla ciebie nie znaczy?!
Dialogue: 0,0:10:46.25,0:10:47.54,Main-207- PL,,0,0,0,,Luffy...
Dialogue: 0,0:11:13.32,0:11:14.78,Main-207- PL,,0,0,0,,Mam cię!
Dialogue: 0,0:11:15.40,0:11:16.91,Main-207- PL,,0,0,0,,Szczwany draniu!
Dialogue: 0,0:11:16.91,0:11:19.74,Main-207- PL,,0,0,0,,Trzeba było być grzecznym chłopcem\Ni dać się pociąć!
Dialogue: 0,0:11:19.74,0:11:20.87,Main-207- PL,,0,0,0,,Spójrz!
Dialogue: 0,0:11:20.87,0:11:26.42,Main-207- PL,,0,0,0,,Przez ciebie moja biedna załoga\Nmusi zwijać się teraz z bólu!
Dialogue: 0,0:11:26.42,0:11:30.04,Main-207- PL,,0,0,0,,Mogłeś oszczędzić im cierpienia\Ni po prostu pozwolić im umrzeć!
Dialogue: 0,0:11:33.05,0:11:35.13,Main-207- PL,,0,0,0,,Co znowu?
Dialogue: 0,0:11:35.13,0:11:37.22,Main-207- PL,,0,0,0,,Chyba masz mi coś do powiedzenia...?
Dialogue: 0,0:11:37.22,0:11:38.01,Main-207- PL,,0,0,0,,Tak...
Dialogue: 0,0:11:38.43,0:11:40.18,Main-207- PL,,0,0,0,,Nieważne co...
Dialogue: 0,0:11:42.10,0:11:44.14,Main-207- PL,,0,0,0,,nigdy nie zostanę taki jak ty.
Dialogue: 0,0:11:44.14,0:11:46.35,Main-207- PL,,0,0,0,,Nie zostaniesz...
Dialogue: 0,0:11:48.10,0:11:51.98,Main-207- PL,,0,0,0,,Bo nie zdołałbyś zostać,\Nchoćbyś nie wiem jak się starał.
Dialogue: 0,0:11:54.40,0:11:55.82,Main-207- PL,,0,0,0,,Bądź co bądź...
Dialogue: 0,0:11:56.53,0:11:58.82,Main-207- PL,,0,0,0,,i tak za chwilę tutaj zginiesz.
Dialogue: 0,0:12:00.07,0:12:02.33,Main-207- PL,,0,0,0,,Proszę, przestań!
Dialogue: 0,0:12:02.33,0:12:04.16,Main-207- PL,,0,0,0,,Zostaw ich w spokoju!
Dialogue: 0,0:12:04.95,0:12:06.79,Main-207- PL,,0,0,0,,Spiszę testament!
Dialogue: 0,0:12:06.79,0:12:08.17,Main-207- PL,,0,0,0,,N-Nie!
Dialogue: 0,0:12:08.58,0:12:12.00,Main-207- PL,,0,0,0,,Jeśli to zrobisz,\Nto cię zabiją, panienko Kayo!
Dialogue: 0,0:12:12.00,0:12:15.84,Main-207- PL,,0,0,0,,Kretynko, to nie ty\Ntutaj stawiasz warunki.
Dialogue: 0,0:12:15.84,0:12:19.55,Main-207- PL,,0,0,0,,Kapitan Kuro kazał mi\Npozbyć się {\i1}każdego{\i0}.
Dialogue: 0,0:12:19.55,0:12:20.80,Main-207- PL,,0,0,0,,Przecież to...!
Dialogue: 0,0:12:28.64,0:12:32.65,Main-207- PL,,0,0,0,,Rób, co każę, albo sama\Nodbiorę sobie życie!
Dialogue: 0,0:12:32.65,0:12:33.98,Main-207- PL,,0,0,0,,A wtedy z testamentu nici!
Dialogue: 0,0:12:33.98,0:12:35.94,Main-207- PL,,0,0,0,,Ch-Chwilunia! Opamiętaj się!
Dialogue: 0,0:12:35.94,0:12:36.99,Main-207- PL,,0,0,0,,Pohamuj się!
Dialogue: 0,0:12:37.32,0:12:40.86,Main-207- PL,,0,0,0,,Muszę za wszelką cenę\Nwydobyć od ciebie ten testament!
Dialogue: 0,0:12:41.62,0:12:43.24,Main-207- PL,,0,0,0,,P-Panienko Kayo!
Dialogue: 0,0:12:45.87,0:12:48.04,Main-207- PL,,0,0,0,,Niech będzie! Kurduple mogą odejść!
Dialogue: 0,0:12:48.54,0:12:52.17,Main-207- PL,,0,0,0,,Chociaż w tym stanie\Ni tak nigdzie nie uciekną...
Dialogue: 0,0:12:55.92,0:12:57.46,Main-207- PL,,0,0,0,,Nie zapomnij podpisać!
Dialogue: 0,0:12:57.46,0:12:58.80,Main-207- PL,,0,0,0,,Wiem...
Dialogue: 0,0:13:02.09,0:13:05.89,Main-207- PL,,0,0,0,,„Cały majątek zapisuję\Nswojemu kamerdynerowi, Klahadore'owi...”
Dialogue: 0,0:13:05.89,0:13:06.97,Main-207- PL,,0,0,0,,Wspaniale!
Dialogue: 0,0:13:06.97,0:13:08.85,Main-207- PL,,0,0,0,,To z całą pewnością twój testament!
Dialogue: 0,0:13:08.85,0:13:11.73,Main-207- PL,,0,0,0,,Nawet nie musiałem cię hipnotyzować!
Dialogue: 0,0:13:12.86,0:13:16.69,Main-207- PL,,0,0,0,,Obiecujesz, że ich nie zabijesz, prawda?
Dialogue: 0,0:13:18.32,0:13:19.82,Main-207- PL,,0,0,0,,Nie martw się.
Dialogue: 0,0:13:19.82,0:13:23.28,Main-207- PL,,0,0,0,,Może na takiego nie wyglądam,\Nale dotrzymuję danego słowa.
Dialogue: 0,0:13:23.28,0:13:25.33,Main-207- PL,,0,0,0,,– Panienko Kayo!\N– Panienko Kayo!
Dialogue: 0,0:13:26.54,0:13:27.83,Main-207- PL,,0,0,0,,Tam są!
Dialogue: 0,0:13:27.83,0:13:31.79,Main-207- PL,,0,0,0,,Tam są! Tam są! Stój!
Dialogue: 0,0:13:27.83,0:13:29.91,Secondary-207- PL,,0,0,0,,Aua! Au, au, au!
Dialogue: 0,0:13:29.91,0:13:31.79,Secondary-207- PL,,0,0,0,,Pacasz mnie prosto w ranę!
Dialogue: 0,0:13:31.79,0:13:33.08,Main-207- PL,,0,0,0,,Właśnie tam!
Dialogue: 0,0:13:35.34,0:13:36.42,Main-207- PL,,0,0,0,,Dobra, zaraz wracam!
Dialogue: 0,0:13:36.42,0:13:37.34,Main-207- PL,,0,0,0,,Hej!
Dialogue: 0,0:13:38.01,0:13:40.51,Main-207- PL,,0,0,0,,Koniec zabawy, hipno-świrze!
Dialogue: 0,0:13:41.59,0:13:43.59,Main-207- PL,,0,0,0,,Pobiegł za mną?!
Dialogue: 0,0:13:49.56,0:13:54.06,Main-207- PL,,0,0,0,,No nic, w takim razie pora to zakończyć!
Dialogue: 0,0:13:58.65,0:14:01.03,Main-207- PL,,0,0,0,,Wszystko do tej pory\Nbyło tylko przystawką.
Dialogue: 0,0:14:02.78,0:14:04.53,Main-207- PL,,0,0,0,,Szykuj się na danie główne.
Dialogue: 0,0:14:06.08,0:14:11.71,Main-207- PL,,0,0,0,,Zaserwuję ci pełnię grozy,\Nżebyś do cna zasmakował strachu.
Dialogue: 0,0:14:14.29,0:14:15.54,Main-207- PL,,0,0,0,,{\fad(150,150)}Wszechkocia Nabierkaźń!
Dialogue: 0,0:14:37.19,0:14:38.98,Main-207- PL,,0,0,0,,No dalej! Użyj tej swojej stopy!
Dialogue: 0,0:14:38.98,0:14:41.24,Main-207- PL,,0,0,0,,Niech cię! Puszczaj mnie!
Dialogue: 0,0:14:41.61,0:14:45.91,Main-207- PL,,0,0,0,,Twój trzyletni plan\Nwłaśnie spalił na panewce!
Dialogue: 0,0:14:45.91,0:14:47.41,Main-207- PL,,0,0,0,,Że co?!
Dialogue: 0,0:14:47.41,0:14:50.33,Main-207- PL,,0,0,0,,Złapał kapitana Kuro!
Dialogue: 0,0:14:50.87,0:14:55.87,Main-207- PL,,0,0,0,,Hej, jeśli z nim wygra,\Nto nie umrzemy, co nie?!
Dialogue: 0,0:14:57.84,0:15:00.17,Main-207- PL,,0,0,0,,Pora umierać!
Dialogue: 0,0:15:00.17,0:15:02.55,Main-207- PL,,0,0,0,,Nawet nie próbuj!
Dialogue: 0,0:15:07.93,0:15:11.10,Main-207- PL,,0,0,0,,Przeklęte dzieciaki!
Dialogue: 0,0:15:13.77,0:15:15.85,Main-207- PL,,0,0,0,,Spóźniłeś się, kolego w przepasce!
Dialogue: 0,0:15:15.85,0:15:17.40,Main-207- PL,,0,0,0,,Nie byłbym taki pewny!
Dialogue: 0,0:15:21.11,0:15:23.94,Main-207- PL,,0,0,0,,Tak! Ta gałąź stała mi na drodze!
Dialogue: 0,0:15:25.20,0:15:26.32,Main-207- PL,,0,0,0,,Co?!
Dialogue: 0,0:15:26.32,0:15:27.49,Main-207- PL,,0,0,0,,Usopp...
Dialogue: 0,0:15:28.24,0:15:29.37,Main-207- PL,,0,0,0,,– Kapitan!\N– Kapitan!
Dialogue: 0,0:15:30.37,0:15:32.62,Main-207- PL,,0,0,0,,Spróbuj tego, hipnotyzerze!
Dialogue: 0,0:15:32.62,0:15:34.91,Main-207- PL,,0,0,0,,Bierz go, gumiaku!
Dialogue: 0,0:15:34.91,0:15:36.92,Main-207- PL,,0,0,0,,Skop kapitanowi Kuro zadek!
Dialogue: 0,0:15:37.46,0:15:38.67,Main-207- PL,,0,0,0,,Puszczaj!
Dialogue: 0,0:15:39.84,0:15:44.42,Main-207- PL,,0,0,0,,Nie macie prawa mi kibicować!
Dialogue: 0,0:15:45.01,0:15:46.80,Main-207- PL,,0,0,0,,Puszczaj, mówię!
Dialogue: 0,0:15:46.80,0:15:49.51,Main-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowy...
Dialogue: 0,0:15:50.18,0:15:52.35,Main-207- PL,,0,0,0,,{\fad(150,150)}Zabójcza Wybuchająca Gwiazda!
Dialogue: 0,0:15:56.39,0:16:03.36,Main-207- PL,,0,0,0,,{\an8\fad(150,0)\t(5521,0,1,\c&HF8F8F8&\3c&HF8F8F8&\4c&HF8F8F8&)}...Dzwon!
Dialogue: 0,0:15:55.56,0:15:57.44,Main-207- PL,,0,0,0,,Mój...
Dialogue: 0,0:15:57.44,0:16:03.36,Main-207- PL,,0,0,0,,{\t(4481,0,1,\c&HF8F8F8&\3c&HF8F8F8&\4c&HF8F8F8&)}Mój plan nie ma prawa zawieść!
