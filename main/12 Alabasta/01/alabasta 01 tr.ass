Dialogue: 0,0:02:14.66,0:02:16.32,Main-207-,,0,0,0,,Crocodile-sama...
Dialogue: 0,0:02:16.74,0:02:18.16,Main-207-,,0,0,0,,Crocodile!
Dialogue: 0,0:02:18.49,0:02:19.29,Main-207-,,0,0,0,,Ha?
Dialogue: 0,0:02:20.66,0:02:22.66,Main-207-,,0,0,0,,Ahh... Crocodile-sama!
Dialogue: 0,0:02:22.66,0:02:24.00,Main-207-,,0,0,0,,Geleceğinizi biliyordum!
Dialogue: 0,0:02:24.00,0:02:25.83,Main-207-,,0,0,0,,Crocodile mı?!
Dialogue: 0,0:02:25.83,0:02:27.50,Main-207-,,0,0,0,,Shichibukai olan mı?
Dialogue: 0,0:02:28.92,0:02:31.21,Main-207-,,0,0,0,,Sessiz olun, aptallar!
Dialogue: 0,0:02:31.21,0:02:35.47,Main-207-,,0,0,0,,Sadece korsanların başı için geldim!
Dialogue: 0,0:02:35.47,0:02:37.30,Main-207-,,0,0,0,,Harika birisi...
Dialogue: 0,0:02:37.30,0:02:40.43,Main-207-,,0,0,0,,Hep bunu söylüyor ama\Nyine de imdadımıza yetişiyor!
Dialogue: 0,0:02:40.43,0:02:42.35,Main-207-,,0,0,0,,Çok yaşa, Crocodile!
Dialogue: 0,0:02:46.44,0:02:48.23,Main-207-,,0,0,0,,Alabasta'nın koruyucu meleği!
Dialogue: 0,0:02:48.23,0:02:50.19,Main-207-,,0,0,0,,Crocodile!
Dialogue: 0,0:02:49.23,0:02:50.19,Secondary-207-,,0,0,0,,Crocodile!
Dialogue: 0,0:02:50.19,0:02:52.07,Main-207-,,0,0,0,,Çöl kralı! Crocodile!
Dialogue: 0,0:02:56.28,0:02:58.83,Main-207-,,0,0,9,,Dilediğiniz gibi seslenin bana.
Dialogue: 0,0:02:58.83,0:03:03.50,Main-207-,,0,0,0,,Bu ülkeye öyle rahatça girip talan\Nedebileceğinizi düşünmeyin, korsanlar.
Dialogue: 0,0:03:03.96,0:03:07.46,Main-207-,,0,0,0,,Hey, hey, hey, hey!\NBizi hafife mi alıyorsun?
Dialogue: 0,0:03:07.46,0:03:10.46,Main-207-,,0,0,0,,Hepimizi tek başına mı yeneceksin?!
Dialogue: 0,0:03:10.88,0:03:14.13,Main-207-,,0,0,0,,Otoriteye satılmış hükûmet iti!
Dialogue: 0,0:03:14.13,0:03:16.34,Main-207-,,0,0,0,,Kendini kahraman falan mı sanıyorsun?!
Dialogue: 0,0:03:17.14,0:03:19.30,Main-207-,,0,0,0,,Yaşamak isteyenler, yere yatsın.
Dialogue: 0,0:03:19.30,0:03:22.27,Main-207-,,0,0,0,,Aptal mısın? Etrafını sardık!
Dialogue: 0,0:03:22.77,0:03:26.73,Main-207-,,0,0,0,,Haklayın şunu! Bu şehrin\Nganimetlerinden alıkoyamaz bizi!
Dialogue: 0,0:03:26.73,0:03:28.48,Main-207-,,0,0,0,,– Aynen!\N– Aynen!
Dialogue: 0,0:03:35.61,0:03:37.24,Main-207-,,0,0,0,,Bu muymuş Shichibukai?!
Dialogue: 0,0:04:14.03,0:04:17.90,Main-207-,,0,0,0,,Korsanlardan farklı bir\Nseviyedeyim, seni domuz.
Dialogue: 0,0:04:27.12,0:04:28.29,Main-207-,,0,0,0,,Crocodile!
Dialogue: 0,0:04:32.84,0:04:59.45,Main-207-,,0,0,0,,Crocodile! Crocodile! Crocodile!\NCrocodile! Crocodile! Crocodile!
Dialogue: 0,0:04:59.45,0:05:02.91,Main-207-,,0,0,0,,{\fad(0,1410)}Yine Crocodile...
Dialogue: 0,0:05:03.74,0:05:05.91,Main-207-,,0,0,0,,Yine mi bir adım öndeydi?
Dialogue: 0,0:05:06.45,0:05:09.75,Main-207-,,0,0,0,,Nanohana'ya vardığımızda\Nher şey çoktan hâllolmuştu.
Dialogue: 0,0:05:10.12,0:05:11.29,Main-207-,,0,0,0,,Anlıyorum.
Dialogue: 0,0:05:11.92,0:05:14.63,Main-207-,,0,0,0,,Önemli olan halkın güvende olması.
Dialogue: 0,0:05:15.09,0:05:18.63,Main-207-,,0,0,0,,{\fad(0,1500)}Ona borçlandık.
Dialogue: 0,0:05:20.97,0:05:22.30,Main-207-,,0,0,0,,Her şey yolunda.
Dialogue: 0,0:05:22.30,0:05:25.64,Main-207-,,0,0,0,,Dosdoğru Alabasta'ya gidiyoruz.
Dialogue: 0,0:05:29.14,0:05:30.81,Main-207-,,0,0,0,,Luffy! Yalan söyleme!
Dialogue: 0,0:05:31.81,0:05:33.77,Main-207-,,0,0,0,,Bildiklerini anlat.
Dialogue: 0,0:05:34.77,0:05:38.23,Main-207-,,0,0,0,,Hey, nereye bakıyorsun?\NGözlerimin içine bak!
Dialogue: 0,0:05:39.69,0:05:43.20,Main-207-,,0,0,0,,Yani... şey, hiçbir şey bilmiyorum.
Dialogue: 0,0:05:43.57,0:05:44.87,Main-207-,,0,0,0,,O zaman söyle.
Dialogue: 0,0:05:44.87,0:05:50.20,Main-207-,,0,0,0,,Bu Alabasta seyahati için sekiz kişilik\Nyiyeceği dikkatle ayarlayıp pay ettim,
Dialogue: 0,0:05:50.20,0:05:52.96,Main-207-,,0,0,0,,peki gece vakti\Nnasıl oldu da yok oldu?
Dialogue: 0,0:05:52.96,0:05:57.71,Main-207-,,0,0,0,,Beni kandıramazsın!\NYüzünden her şey okunuyor.
Dialogue: 0,0:06:02.05,0:06:04.84,Main-207-,,0,0,0,,Hey, ağzının kenarında bir şey var.
Dialogue: 0,0:06:04.84,0:06:07.31,Main-207-,,0,0,0,,Ah! Eyvah! Yemek mi?!
Dialogue: 0,0:06:08.89,0:06:11.60,Main-207-,,0,0,0,,Sendin demek!
Dialogue: 0,0:06:16.19,0:06:17.44,Main-207-,,0,0,0,,Hay...
Dialogue: 0,0:06:18.07,0:06:20.57,Main-207-,,0,0,0,,Ah, Nami-{\i1}san{\i0}, gördün değil mi?
Dialogue: 0,0:06:21.03,0:06:23.53,Main-207-,,0,0,0,,O büyük fare kapanı da yetmiyor artık.
Dialogue: 0,0:06:23.95,0:06:26.24,Main-207-,,0,0,0,,Lütfen kilidi olan bir buzdolabı alalım.
Dialogue: 0,0:06:26.70,0:06:28.45,Main-207-,,0,0,0,,Öyle mi?
Dialogue: 0,0:06:29.62,0:06:31.20,Main-207-,,0,0,0,,Düşüneceğim...
Dialogue: 0,0:06:31.58,0:06:33.66,Main-207-,,0,0,0,,Ne de olsa hayatlarımız buna bağlı.
Dialogue: 0,0:06:35.50,0:06:36.50,Main-207-,,0,0,0,,Ha?
Dialogue: 0,0:06:37.46,0:06:40.21,Main-207-,,0,0,0,,Pekâlâ! Sanji-{\i1}kun{\i0} için\Nbir şeyler yakalasak iyi olur.
Dialogue: 0,0:06:41.38,0:06:43.22,Main-207-,,0,0,0,,Hey, var mı bir şeyler?
Dialogue: 0,0:06:44.55,0:06:46.47,Main-207-,,0,0,0,,Ş-Şey...
Dialogue: 0,0:06:51.81,0:06:53.98,Main-207-,,0,0,0,,Harika...
Dialogue: 0,0:06:53.98,0:06:56.65,Main-207-,,0,0,0,,Bir saniye arkamı dönemiyorum!
Dialogue: 0,0:07:04.99,0:07:07.37,Main-207-,,0,0,0,,Off... Öleceğim açlıktan.
Dialogue: 0,0:07:07.37,0:07:09.24,Main-207-,,0,0,0,,Balık da yok ortalıkta.
Dialogue: 0,0:07:09.24,0:07:12.62,Main-207-,,0,0,0,,Luffy! Senin suçun bu!\NKalkıp yemleri de yedin!
Dialogue: 0,0:07:12.62,0:07:14.96,Main-207-,,0,0,0,,Yemimiz yoksa balık tabii gelmez!
Dialogue: 0,0:07:14.96,0:07:16.67,Main-207-,,0,0,0,,Sen de yedin biraz.
Dialogue: 0,0:07:16.67,0:07:20.00,Main-207-,,0,0,0,,Yani... kapağına sıkışmıştı,\Nonu yedim.
Dialogue: 0,0:07:20.38,0:07:23.51,Main-207-,,0,0,0,,Luffy-{\i1}san{\i0}. Usopp-{\i1}san{\i0}.\NBir şeyler yakalayabildiniz mi?
Dialogue: 0,0:07:26.84,0:07:29.60,Main-207-,,0,0,0,,Karoo! Olamaz!
Dialogue: 0,0:07:30.10,0:07:32.01,Main-207-,,0,0,0,,Belki köpek balığı yakalayabilir.
Dialogue: 0,0:07:32.01,0:07:34.81,Main-207-,,0,0,0,,Deniz kralı istiyorum ben.
Dialogue: 0,0:07:34.81,0:07:38.48,Main-207-,,0,0,0,,Bunu Karoo'ya nasıl yaparsınız?
Dialogue: 0,0:07:45.53,0:07:46.78,Main-207-,,0,0,0,,O da ne?
Dialogue: 0,0:07:50.87,0:07:52.49,Main-207-,,0,0,0,,O ne be?
Dialogue: 0,0:07:52.49,0:07:53.79,Main-207-,,0,0,0,,Galiba pamuk şeker.
Dialogue: 0,0:07:54.16,0:07:56.00,Main-207-,,0,0,0,,Nami-{\i1}san{\i0}'ı çağıracağım!
Dialogue: 0,0:08:01.04,0:08:02.00,Main-207-,,0,0,0,,Hım?
Dialogue: 0,0:08:02.00,0:08:03.84,Main-207-,,0,0,0,,Nami-{\i1}san{\i0}, bir şey var! Gelmelisin!
Dialogue: 0,0:08:08.30,0:08:11.93,Main-207-,,0,0,0,,Ahh... endişelenmeyin.\NBir şey yok. Buhar sadece.
Dialogue: 0,0:08:12.43,0:08:14.43,Main-207-,,0,0,0,,Denizden buhar mı çıkıyor?
Dialogue: 0,0:08:14.43,0:08:15.89,Main-207-,,0,0,0,,Evet. Sıcak bölgedeyiz.
Dialogue: 0,0:08:15.89,0:08:17.44,Main-207-,,0,0,0,,O da ne öyle?
Dialogue: 0,0:08:17.44,0:08:19.85,Main-207-,,0,0,0,,Orası magmanın aktığı bir bölge.
Dialogue: 0,0:08:19.85,0:08:22.57,Main-207-,,0,0,0,,O bölgenin altında\Nbir deniz altı volkanı var.
Dialogue: 0,0:08:22.57,0:08:23.36,Main-207-,,0,0,0,,Ha?
Dialogue: 0,0:08:23.73,0:08:25.86,Main-207-,,0,0,0,,Su altında bir volkan mı?
Dialogue: 0,0:08:26.36,0:08:31.78,Main-207-,,0,0,0,,Aynen öyle. Suda, karadakinden\Nfazla volkan bulunuyor.
Dialogue: 0,0:08:31.78,0:08:35.29,Main-207-,,0,0,0,,Ohaaa...
Dialogue: 0,0:08:33.41,0:08:35.29,Secondary-207-,,0,0,0,,Bize ne? Yenmiyor sonuçta.
Dialogue: 0,0:08:35.29,0:08:38.96,Main-207-,,0,0,0,,Burada aktif bir volkan olduğu için\Nbinlerce hatta on binlerce...
Dialogue: 0,0:08:38.96,0:08:41.25,Main-207-,,0,0,0,,yıl içinde yeni bir ada oluşacak.
Dialogue: 0,0:08:41.88,0:08:43.71,Main-207-,,0,0,0,,Harikasın, Nami-{\i1}san{\i0}!
Dialogue: 0,0:08:44.09,0:08:47.26,Main-207-,,0,0,0,,On binlerce yıl...\NAcaba o kadar yaşar mıyım?
Dialogue: 0,0:08:47.26,0:08:49.72,Main-207-,,0,0,0,,Yok be, insan ömrü o kadar uzun değil.
Dialogue: 0,0:08:51.59,0:08:52.72,Main-207-,,0,0,0,,Nasıl gidiyor?
Dialogue: 0,0:08:52.72,0:08:56.60,Main-207-,,0,0,0,,Aa, Sanji. Acıktım.\NYapsana bir şeyler.
Dialogue: 0,0:08:56.60,0:08:58.73,Main-207-,,0,0,0,,Sizden adam olmaz.
Dialogue: 0,0:08:58.73,0:09:02.65,Main-207-,,0,0,0,,Deponun altını üstüne getireceğim,\Nbir şey kalmıştır belki.
Dialogue: 0,0:09:13.91,0:09:15.62,Main-207-,,0,0,0,,İyy! Sülfür kokuyor!
Dialogue: 0,0:09:15.62,0:09:17.91,Main-207-,,0,0,0,,Buhardan hiçbir şey göremiyoruz!
Dialogue: 0,0:09:17.91,0:09:20.58,Main-207-,,0,0,0,,Dayanın. Birazdan geçecek.
Dialogue: 0,0:09:22.25,0:09:24.09,Main-207-,,0,0,0,,Bay 2, Bon Kurei-{\i1}sama{\i0}!
Dialogue: 0,0:09:24.09,0:09:25.25,Main-207-,,0,0,0,,Ne var be?!
Dialogue: 0,0:09:25.75,0:09:28.38,Main-207-,,0,0,0,,Saat 12 yönünde duman var!
Dialogue: 0,0:09:28.38,0:09:31.18,Main-207-,,0,0,0,,Ne olmuş?! İçinden geçin!
Dialogue: 0,0:09:32.09,0:09:34.14,Main-207-,,0,0,0,,Başüstüne! Giriyoruz!
Dialogue: 0,0:09:34.14,0:09:35.55,Main-207-,,0,0,0,,Bu duman ne ya?
Dialogue: 0,0:09:35.55,0:09:36.97,Main-207-,,0,0,0,,Önümüzü göremiyoruz!
Dialogue: 0,0:09:44.98,0:09:45.98,Main-207-,,0,0,0,,Atlattık!
Dialogue: 0,0:09:47.15,0:09:49.49,Main-207-,,0,0,0,,Bay 2, Bon Kurei-{\i1}sama{\i0} yok!
Dialogue: 0,0:09:49.49,0:09:50.90,Main-207-,,0,0,0,,Her yeri arayın!
Dialogue: 0,0:09:51.32,0:09:52.53,Main-207-,,0,0,0,,Bulamıyoruz!
Dialogue: 0,0:09:52.53,0:09:53.41,Main-207-,,0,0,0,,Olamaz!
Dialogue: 0,0:09:53.41,0:09:55.91,Main-207-,,0,0,0,,Bay 2, Bon Kurei-{\i1}sama{\i0}!
Dialogue: 0,0:09:56.74,0:09:58.74,Main-207-,,0,0,0,,Oha...!
Dialogue: 0,0:10:05.08,0:10:07.00,Main-207-,,0,0,0,,Tanrım!
Dialogue: 0,0:10:07.00,0:10:10.76,Main-207-,,0,0,0,,Neden aniden karşıma çıkan\Nördeğin üstüne atladım ki?!
Dialogue: 0,0:10:12.05,0:10:13.22,Main-207-,,0,0,0,,– İnsan mı?\N– Bilmiyorum...
Dialogue: 0,0:10:13.93,0:10:16.47,Main-207-,,0,0,0,,Ne?! Vahhh!
Dialogue: 0,0:10:18.85,0:10:21.73,Main-207-,,0,0,0,,Yardım edin! Lütfen!
Dialogue: 0,0:10:21.73,0:10:24.40,Main-207-,,0,0,0,,Yüzemiyorum! Yüzemi–
Dialogue: 0,0:10:35.95,0:10:37.95,Main-207-,,0,0,0,,Öleceğimi sandım…
Dialogue: 0,0:10:38.58,0:10:41.50,Main-207-,,0,0,0,,Ama şimdi,\Ntam anlamıyla kuğu gibiyim.
Dialogue: 0,0:10:41.50,0:10:45.37,Main-207-,,0,0,0,,Hiç tanımadığım korsanlar\Ntarafından kurtarıldım.
Dialogue: 0,0:10:45.37,0:10:48.25,Main-207-,,0,0,0,,Bu iyiliğinizi daima hatırlayacağım!
Dialogue: 0,0:10:48.25,0:10:51.76,Main-207-,,0,0,0,,Bir de sıcak çorba alabilir miyim?
Dialogue: 0,0:10:51.76,0:10:52.76,Main-207-,,0,0,0,,-Yok ki!\N-Yok ki!
Dialogue: 0,0:10:52.76,0:10:54.43,Main-207-,,0,0,0,,Aç olan biziz be!
Dialogue: 0,0:10:56.30,0:10:57.30,Main-207-,,0,0,0,,Aha!
Dialogue: 0,0:10:57.30,0:10:59.89,Main-207-,,0,0,0,,Ne kadar tatlısın sen!
Dialogue: 0,0:10:59.89,0:11:02.14,Main-207-,,0,0,0,,Tam benliksin! Yerim seni!
Dialogue: 0,0:11:03.81,0:11:04.60,Main-207-,,0,0,0,,Rahatsız...
Dialogue: 0,0:11:04.98,0:11:06.85,Main-207-,,0,0,0,,Demek yüzemiyorsun ha?
Dialogue: 0,0:11:07.35,0:11:10.82,Main-207-,,0,0,0,,Evet. Şeytan meyvesi yedim de.
Dialogue: 0,0:11:10.82,0:11:12.78,Main-207-,,0,0,0,,Cidden mi? Ne tür bir meyve?
Dialogue: 0,0:11:13.53,0:11:18.66,Main-207-,,0,0,0,,Yani, şimdi gemimin gelmesini\Nbeklemekten başka çarem yok.
Dialogue: 0,0:11:19.03,0:11:21.12,Main-207-,,0,0,0,,Ufak bir gösteri fena olmaz gibi.
Dialogue: 0,0:11:21.87,0:11:24.58,Main-207-,,0,0,0,,Gücüme iyi bakın!
Dialogue: 0,0:11:29.21,0:11:30.34,Main-207-,,0,0,0,,Ne oluyo'?!
Dialogue: 0,0:11:30.34,0:11:33.59,Main-207-,,0,0,0,,Bekle! Bekle! Bekle!
Dialogue: 0,0:11:33.59,0:11:35.93,Main-207-,,0,0,0,,Gösteri yapacağımı söylemedim mi?
Dialogue: 0,0:11:35.93,0:11:36.88,Main-207-,,0,0,0,,Ne?!
Dialogue: 0,0:11:36.88,0:11:39.72,Main-207-,,0,0,0,,Bunun şakası yok.
Dialogue: 0,0:11:41.64,0:11:42.56,Main-207-,,0,0,0,,Aha ben!
Dialogue: 0,0:11:42.89,0:11:44.64,Main-207-,,0,0,0,,Şaşırdınız mı?! Şaşırdınız mı?!
Dialogue: 0,0:11:46.81,0:11:49.23,Main-207-,,0,0,0,,Sol elimle yüzüme dokunursam...
Dialogue: 0,0:11:49.23,0:11:50.77,Main-207-,,0,0,0,,Gördünüz mü?! Normale döndüm!
Dialogue: 0,0:11:50.77,0:11:53.61,Main-207-,,0,0,0,,Klon-Klon Meyvesi'nin gücü bu!
Dialogue: 0,0:11:54.11,0:11:55.57,Main-207-,,0,0,0,,Sesi bile değişiyor...
Dialogue: 0,0:11:55.57,0:11:57.57,Main-207-,,0,0,0,,Fiziği de aynıydı!
Dialogue: 0,0:11:57.95,0:11:59.66,Main-207-,,0,0,0,,H-Harika!
Dialogue: 0,0:11:59.66,0:12:01.24,Main-207-,,0,0,0,,İşte!
Dialogue: 0,0:12:01.24,0:12:05.08,Main-207-,,0,0,0,,Ah! Şimdi düşününce\Nseni yere sermeme gerek yoktu.
Dialogue: 0,0:12:05.08,0:12:07.46,Main-207-,,0,0,0,,Çünkü bakın...!
Dialogue: 0,0:12:07.46,0:12:09.83,Main-207-,,0,0,0,,Tek gereken,
Dialogue: 0,0:12:09.83,0:12:12.34,Main-207-,,0,0,0,,sağ elimle yüzünüze dokunmam.
Dialogue: 0,0:12:12.34,0:12:15.09,Main-207-,,0,0,0,,Ve gördüğünüz gibi ben...
Dialogue: 0,0:12:15.09,0:12:16.63,Main-207-,,0,0,0,,herkese dönüşebilirim!
Dialogue: 0,0:12:17.13,0:12:18.38,Main-207-,,0,0,0,,Beden de dahil.
Dialogue: 0,0:12:20.01,0:12:21.55,Main-207-,,0,0,0,,Ah!
Dialogue: 0,0:12:21.55,0:12:22.47,Main-207-,,0,0,0,,Kes şunu!
Dialogue: 0,0:12:22.85,0:12:24.56,Main-207-,,0,0,0,,Hey, iyi misin?
Dialogue: 0,0:12:24.56,0:12:26.56,Main-207-,,0,0,0,,Ah, ah, ah...
Dialogue: 0,0:12:26.56,0:12:31.31,Main-207-,,0,0,0,,Acıdı... Üzgünüm ama\Ndaha fazla gücümü gösteremem.
Dialogue: 0,0:12:31.31,0:12:34.28,Main-207-,,0,0,0,,Harikasın! Biraz daha göster!
Dialogue: 0,0:12:34.78,0:12:38.40,Main-207-,,0,0,0,,Ahh... Şey... Madem ısrarcısınız...\NDaha fazlasını gösterebilirim!
Dialogue: 0,0:12:38.40,0:12:41.12,Main-207-,,0,0,0,,Evet! Göster! Göster!
Dialogue: 0,0:12:39.15,0:12:41.12,Secondary-207-,,0,0,0,,Çok da etkileyici değil.
Dialogue: 0,0:12:41.12,0:12:43.62,Main-207-,,0,0,0,,Göstereceğim galiba...
Dialogue: 0,0:12:41.12,0:12:43.62,Secondary-207-,,0,0,0,,Göster bize!
Dialogue: 0,0:12:43.62,0:12:46.62,Main-207-,,0,0,0,,Üstelik bir hafıza yeteneğim de mevcut!
Dialogue: 0,0:12:49.54,0:12:51.08,Main-207-,,0,0,0,,Başlıyoruz!
Dialogue: 0,0:12:51.08,0:12:52.58,Main-207-,,0,0,0,,Vay!
Dialogue: 0,0:13:00.43,0:13:02.89,Main-207-,,0,0,0,,Dön! Dön! Dön!
Dialogue: 0,0:13:03.35,0:13:04.76,Main-207-,,0,0,0,,Çok salakça!
Dialogue: 0,0:13:04.76,0:13:07.18,Main-207-,,0,0,0,,Dön! Dön!
Dialogue: 0,0:13:08.60,0:13:12.02,Main-207-,,0,0,0,,Özel yeteneğimi beğendiniz mi?
Dialogue: 0,0:13:12.02,0:13:14.73,Main-207-,,0,0,0,,Herkese göstermem ha.
Dialogue: 0,0:13:16.19,0:13:18.36,Main-207-,,0,0,0,,Çok iyi!
Dialogue: 0,0:13:18.36,0:13:22.16,Main-207-,,0,0,0,,Bunun şakası yok! Bunun şakası yok!
Dialogue: 0,0:13:22.16,0:13:23.62,Main-207-,,0,0,0,,Öf be!
Dialogue: 0,0:13:23.62,0:13:25.83,Main-207-,,0,0,0,,İşte benim gemim!
Dialogue: 0,0:13:25.83,0:13:27.16,Main-207-,,0,0,0,,Harika! Harika!
Dialogue: 0,0:13:27.66,0:13:28.66,Main-207-,,0,0,0,,Görüşürüz!
Dialogue: 0,0:13:31.42,0:13:34.92,Main-207-,,0,0,0,,Şimdiden ayrılık vakti geldi mi?\NKader utansın.
Dialogue: 0,0:13:34.92,0:13:35.88,Main-207-,,0,0,0,,– Nee?!\N– Nee?!
Dialogue: 0,0:13:36.63,0:13:38.34,Main-207-,,0,0,0,,Lütfen gitme!
Dialogue: 0,0:13:38.84,0:13:40.97,Main-207-,,0,0,0,,Metanetinizi kaybetmeyin!
Dialogue: 0,0:13:40.97,0:13:43.34,Main-207-,,0,0,0,,Her yolculuğun içinde vedalar vardır.
Dialogue: 0,0:13:43.34,0:13:45.68,Main-207-,,0,0,0,,Ama bunu asla unutmayın:
Dialogue: 0,0:13:46.10,0:13:47.64,Main-207-,,0,0,0,,Arkadaşlık,
Dialogue: 0,0:13:49.02,0:13:52.48,Main-207-,,0,0,0,,ne kadar zamandır\Ntanıştığınızla alakalı değildir.
Dialogue: 0,0:13:52.48,0:13:54.44,Main-207-,,0,0,0,,Ağlamayın!
Dialogue: 0,0:13:54.44,0:13:57.40,Main-207-,,0,0,0,,Tekrar görüşelim!
Dialogue: 0,0:13:57.40,0:14:00.03,Main-207-,,0,0,0,,Şimdi, gidelim çocuklar!
Dialogue: 0,0:14:00.03,0:14:02.36,Main-207-,,0,0,0,,Başüstüne! Bay 2, Bon Kurei-{\i1}sama{\i0}!
Dialogue: 0,0:14:07.83,0:14:09.75,Main-207-,,0,0,0,,Bay 2 mi?!
Dialogue: 0,0:14:09.75,0:14:12.58,Main-207-,,0,0,0,,Öyleyse o... Bay 2, Bon Kurei'di!
Dialogue: 0,0:14:12.96,0:14:15.25,Main-207-,,0,0,0,,Vivi! Daha önce onu görmedin mi?!
Dialogue: 0,0:14:15.71,0:14:20.21,Main-207-,,0,0,0,,Hayır… Bay 2 ve\NBay 1 çiftlerini hiç görmedim.
Dialogue: 0,0:14:20.21,0:14:22.42,Main-207-,,0,0,0,,Güçlerini de bilmiyorum.
Dialogue: 0,0:14:24.22,0:14:26.18,Main-207-,,0,0,0,,Bir iki şey duydum sadece.
Dialogue: 0,0:14:27.14,0:14:28.64,Main-207-,,0,0,0,,Bay 2'nin...
Dialogue: 0,0:14:31.56,0:14:35.15,Main-207-,,0,0,0,,kadın gibi konuşan kaba vücutlu bir balerin olduğunu duydum.
Dialogue: 0,0:14:35.15,0:14:40.73,Main-207-,,0,0,0,,Her zaman arkasında ''Bon Kurei"\Nyazan kuğu paltosu giyiyormuş.
Dialogue: 0,0:14:42.57,0:14:43.65,Main-207-,,0,0,0,,– Fark etmeliydin!\N– Fark etmeliydin!
Dialogue: 0,0:14:44.41,0:14:46.24,Main-207-,,0,0,0,,Sorun ne, Vivi?
Dialogue: 0,0:14:46.24,0:14:50.45,Main-207-,,0,0,0,,Hafıza yeteneğiyle gösterdiği...
Dialogue: 0,0:14:51.20,0:14:52.79,Main-207-,,0,0,0,,yüzler arasında...
Dialogue: 0,0:14:53.37,0:14:54.92,Main-207-,,0,0,0,,babamın yüzünü gördüm.
Dialogue: 0,0:14:56.04,0:14:59.92,Main-207-,,0,0,0,,Alabasta'nın hükümdarı,\NNefertari Cobra'nın yüzünü...!
Dialogue: 0,0:15:00.67,0:15:04.17,Main-207-,,0,0,0,,Yani kralın kılığına girebiliyorsan...
Dialogue: 0,0:15:04.17,0:15:07.18,Main-207-,,0,0,0,,istediğin her şeyi yapabilirsin.
Dialogue: 0,0:15:07.18,0:15:09.89,Main-207-,,0,0,0,,Desene baş belası birini elimizden kaçırdık.
Dialogue: 0,0:15:10.51,0:15:12.22,Main-207-,,0,0,0,,Düşmanımız mıydı yani?
Dialogue: 0,0:15:12.77,0:15:16.19,Main-207-,,0,0,0,,Eğer karşı taraftaysa\Nciddi bir sorun olacaktır.
Dialogue: 0,0:15:17.19,0:15:20.90,Main-207-,,0,0,0,,Düşman olduğumuzu fark ederse...
Dialogue: 0,0:15:20.90,0:15:24.65,Main-207-,,0,0,0,,hafıza yeteneğiyle\Nbirimizin kılığına girebilir.
Dialogue: 0,0:15:24.65,0:15:27.66,Main-207-,,0,0,0,,Birbirimize bile kuşkuyla yaklaşmalıyız.
Dialogue: 0,0:15:28.91,0:15:30.37,Main-207-,,0,0,0,,Öyle mi?
Dialogue: 0,0:15:30.37,0:15:32.12,Main-207-,,0,0,0,,Dinle, Luffy–
Dialogue: 0,0:15:32.12,0:15:33.75,Main-207-,,0,0,0,,Durun, bakalım.
Dialogue: 0,0:15:33.75,0:15:36.83,Main-207-,,0,0,0,,Luffy sadece hisleriyle\Nhareket ediyor ama...
Dialogue: 0,0:15:36.83,0:15:40.17,Main-207-,,0,0,0,,bence korkmamamız gerektiğinde haklı.
Dialogue: 0,0:15:40.71,0:15:44.84,Main-207-,,0,0,0,,Onunla tanışmamız şansımıza oldu.
Dialogue: 0,0:15:44.84,0:15:47.13,Main-207-,,0,0,0,,Çünkü ondan daha akıllı davranacağız.
Dialogue: 0,0:15:47.76,0:15:49.97,Main-207-,,0,0,0,,Bay 2, Bon Kurei-{\i1}sama{\i0}'nın...
Dialogue: 0,0:15:47.76,0:15:49.39,Secondary-207-,,0,0,0,,{\i1}Un{\i0}, {\i1}deux{\i0}, {\i1}trois{\i0}!
Dialogue: 0,0:15:49.97,0:15:51.93,Main-207-,,0,0,0,,nedense keyfi yerinde.
Dialogue: 0,0:15:49.39,0:15:51.93,Secondary-207-,,0,0,0,,''Dört'' ne demekti?
Dialogue: 0,0:15:54.31,0:15:56.60,Main-207-,,0,0,0,,Bugün yeni arkadaşlar edindim!
Dialogue: 0,0:16:06.49,0:16:08.61,Main-207-,,0,0,0,,Bir şey çıktı!
Dialogue: 0,0:16:08.61,0:16:09.78,Main-207-,,0,0,0,,Deniz kedisi!
Dialogue: 0,0:16:09.78,0:16:12.78,Main-207-,,0,0,0,,Deniz canavarı!
Dialogue: 0,0:16:13.54,0:16:16.00,Main-207-,,0,0,0,,Dört günün ardından ilk yemeğimiz!
Dialogue: 0,0:16:16.00,0:16:17.29,Main-207-,,0,0,0,,Yemeek!
Dialogue: 0,0:16:17.29,0:16:19.37,Main-207-,,0,0,0,,Doğru yolda ilerliyoruz.
Dialogue: 0,0:16:20.00,0:16:22.84,Main-207-,,0,0,0,,Umarım çok yolumuz kalmamıştır.
Dialogue: 0,0:16:22.84,0:16:24.67,Main-207-,,0,0,0,,Yemek!
Dialogue: 0,0:16:26.55,0:16:28.01,Main-207-,,0,0,0,,Oha! Geri çekiliyor!
Dialogue: 0,0:16:28.01,0:16:29.84,Main-207-,,0,0,0,,Geriye! Tam geri!
Dialogue: 0,0:16:29.84,0:16:31.76,Main-207-,,0,0,0,,Y-Y-Y-Y-Yapamayız!
Dialogue: 0,0:16:33.01,0:16:33.72,Main-207-,,0,0,0,,Oo!
Dialogue: 0,0:16:34.10,0:16:37.06,Main-207-,,0,0,0,,Kaçmasına izin vermeyin!\NOnu yakalamalıyız!
Dialogue: 0,0:16:39.27,0:16:42.40,Main-207-,,0,0,0,,Şimdi seni nasıl pişirelim,\Ncanavar kedi?!
Dialogue: 0,0:16:43.36,0:16:45.36,Main-207-,,0,0,0,,Yapamazsınız!
Dialogue: 0,0:16:48.32,0:16:51.32,Main-207-,,0,0,0,,Vivi! Lan! Ne yaptığını sanıyorsun?!
Dialogue: 0,0:16:51.32,0:16:53.66,Main-207-,,0,0,0,,N... Neden... Vivi-{\i1}chan{\i0}?
Dialogue: 0,0:16:54.03,0:16:55.41,Main-207-,,0,0,0,,Onu yiyemezsiniz!
Dialogue: 0,0:16:55.83,0:16:59.37,Main-207-,,0,0,0,,Deniz kedileri,\NAlabasta'da kutsal kabul edilir!
Dialogue: 0,0:16:59.37,0:17:00.37,Main-207-,,0,0,0,,Erken söylesene!
Dialogue: 0,0:17:00.37,0:17:03.09,Main-207-,,0,0,0,,Denizde bir sürü yaratık var!
Dialogue: 0,0:17:04.38,0:17:07.09,Main-207-,,0,0,0,,Ondan korktuysanız\Ndaha çok yolunuz var.
Dialogue: 0,0:17:07.09,0:17:08.67,Main-207-,,0,0,0,,Pekâlâ!
Dialogue: 0,0:17:08.67,0:17:13.51,Main-207-,,0,0,0,,Size Calm Belt'de deniz krallarıyla\Nnasıl cesurca savaştığımı anlatayım.
Dialogue: 0,0:17:13.51,0:17:15.14,Main-207-,,0,0,0,,Deniz krallarıyla mı savaştın?!
Dialogue: 0,0:17:15.14,0:17:17.85,Main-207-,,0,0,0,,Çok büyüklerdi! Aha bu kadar!
Dialogue: 0,0:17:18.31,0:17:21.31,Main-207-,,0,0,0,,K-Kaçtı gitti yemeğimiz...
Dialogue: 0,0:17:21.31,0:17:24.86,Main-207-,,0,0,0,,Endişelenme! Yakında karnını\Ndoyuracak kadar yiyebileceksin!
Dialogue: 0,0:17:25.27,0:17:28.32,Main-207-,,0,0,0,,Harbi mi?! Bu sefer nasıl\Nbir kediyle karşılaşacağız?!
Dialogue: 0,0:17:29.15,0:17:32.28,Main-207-,,0,0,0,,Vivi! Rüzgâr ve hava\Nsakinleşiyor gibi gözüküyor.
Dialogue: 0,0:17:32.28,0:17:33.66,Main-207-,,0,0,0,,Evet.
Dialogue: 0,0:17:33.66,0:17:36.16,Main-207-,,0,0,0,,Alabasta'nın iklimine giriyoruz.
Dialogue: 0,0:17:36.16,0:17:38.75,Main-207-,,0,0,0,,Deniz kedisiyle de\Nkarşılaşmamızdan belliydi.
Dialogue: 0,0:17:39.16,0:17:41.37,Main-207-,,0,0,0,,Arkamızdaki manzara da\Nmuhtemelen...
Dialogue: 0,0:17:41.83,0:17:43.71,Main-207-,,0,0,0,,Alabasta'ya yaklaştığımızın kanıtı.
Dialogue: 0,0:17:55.30,0:17:57.47,Main-207-,,0,0,0,,Bir sürü gemi! Nereden çıktılar?!
Dialogue: 0,0:17:57.85,0:18:02.44,Main-207-,,0,0,0,,Hepsinin de Baroque Works\Nsembolleri var!
Dialogue: 0,0:18:03.02,0:18:05.90,Main-207-,,0,0,0,,Elemanları toplanmaya başladı.
Dialogue: 0,0:18:05.90,0:18:10.78,Main-207-,,0,0,0,,Büyük ihtimalle, rütbeli ajanların astları milyarlar olmalılar.
Dialogue: 0,0:18:10.78,0:18:14.03,Main-207-,,0,0,0,,O hâlde en az 200 adam vardır orada.
Dialogue: 0,0:18:14.03,0:18:17.74,Main-207-,,0,0,0,,Daha doğrusu onlar,\NBaroque Works'ün 200 seçkini.
Dialogue: 0,0:18:18.29,0:18:21.20,Main-207-,,0,0,0,,Whisky Peak'teki ödül avcıları\Nonlarla kıyaslanamaz bile.
Dialogue: 0,0:18:22.21,0:18:24.46,Main-207-,,0,0,0,,Fırsatımız varken ateş etsek mi?!
Dialogue: 0,0:18:25.63,0:18:27.88,Main-207-,,0,0,0,,Ateş edelim gitsin!
Dialogue: 0,0:18:27.88,0:18:30.42,Main-207-,,0,0,0,,Yanlarına gidip dövsek daha hızlı olur!
Dialogue: 0,0:18:31.67,0:18:33.88,Main-207-,,0,0,0,,Durun! Önce karnımızı doyurmalıyız!
Dialogue: 0,0:18:34.26,0:18:36.85,Main-207-,,0,0,0,,Küçük balıklarla uğraşmak aptallık olur.
Dialogue: 0,0:18:37.55,0:18:38.97,Main-207-,,0,0,0,,Haklı.
Dialogue: 0,0:18:38.97,0:18:41.81,Main-207-,,0,0,0,,Asıl amacımızı kaybedersek vay hâlimize.
Dialogue: 0,0:18:41.81,0:18:44.27,Main-207-,,0,0,0,,Hem sadece 8 kişiyiz.
Dialogue: 0,0:18:46.27,0:18:49.07,Main-207-,,0,0,0,,Her neyse, sıkıca bağlayın.
Dialogue: 0,0:18:49.07,0:18:51.23,Main-207-,,0,0,0,,Bu seferki düşmanımız oldukça ketum.
Dialogue: 0,0:18:51.23,0:18:52.53,Main-207-,,0,0,0,,Anladım.
Dialogue: 0,0:18:52.53,0:18:56.20,Main-207-,,0,0,0,,Bunlar birbirimizi ayırt etmemizi sağlayacak.
Dialogue: 0,0:18:56.78,0:18:59.20,Main-207-,,0,0,0,,O Klon-Klon Meyvesi yiyen adam,
Dialogue: 0,0:18:59.66,0:19:02.62,Main-207-,,0,0,0,,dönüştüklerine çok mu\Nbenziyor cidden?
Dialogue: 0,0:19:02.62,0:19:05.12,Main-207-,,0,0,0,,Görmeliydin! Benzemek ne kelime..
Dialogue: 0,0:19:05.58,0:19:06.67,Main-207-,,0,0,0,,tıpatıp dönüşüyor!
Dialogue: 0,0:19:06.67,0:19:11.80,Main-207-,,0,0,0,,Yazık ki kaçırdın!\NOnunla dans bile ettik.
Dialogue: 0,0:19:11.80,0:19:15.22,Main-207-,,0,0,0,,Düşmanlarımız arasında öyleleri varken,
Dialogue: 0,0:19:15.22,0:19:17.76,Main-207-,,0,0,0,,tek başımıza düşüncesizce\Nhareket edemeyiz.
Dialogue: 0,0:19:19.89,0:19:22.72,Main-207-,,0,0,0,,Hey, ben ne yapmalıyım?
Dialogue: 0,0:19:22.72,0:19:26.81,Main-207-,,0,0,0,,Ahh... Ne yapabilirsen...\NFazlasına gerek yok.
Dialogue: 0,0:19:26.81,0:19:29.36,Main-207-,,0,0,0,,Yenemediğin bir düşmandan\Nkaçmak sorun değil!
Dialogue: 0,0:19:29.77,0:19:32.15,Main-207-,,0,0,0,,Bunu ona mı söylüyorsun, kendine mi?
Dialogue: 0,0:19:33.69,0:19:35.78,Main-207-,,0,0,0,,Ne yapabilirsem ha?
Dialogue: 0,0:19:36.28,0:19:37.49,Main-207-,,0,0,0,,Anladım!
Dialogue: 0,0:19:37.49,0:19:40.03,Main-207-,,0,0,0,,Ada göründü!
Dialogue: 0,0:19:40.03,0:19:43.45,Main-207-,,0,0,0,,Nanohana'ya gideceğiz ama \Nönce gemiyi saklamalıyız.
Dialogue: 0,0:19:43.45,0:19:47.33,Main-207-,,0,0,0,,Tamamdır! Öyleyse ne olursa olsun,
Dialogue: 0,0:19:47.33,0:19:50.96,Main-207-,,0,0,0,,bu kolumuzdaki şey,\Ntayfadan olduğumuzun kanıtıdır.
Dialogue: 0,0:19:53.76,0:19:56.17,Main-207-,,0,0,0,,Şimdi, karaya çıkalım!
Dialogue: 0,0:19:56.17,0:19:58.84,Main-207-,,0,0,0,,Önce restorana!\NSonra Alabasta'ya.
Dialogue: 0,0:19:59.59,0:20:01.18,Main-207-,,0,0,0,,– Sonra mı?\N– Sonra mı?
Dialogue: 0,0:20:03.14,0:20:06.89,Main-207-,,0,0,0,,Bu seferki düşmanımız\Nbir suikastçı grubu, Luffy.
Dialogue: 0,0:20:06.89,0:20:08.23,Main-207-,,0,0,0,,Evet. Öyle.
Dialogue: 0,0:20:08.23,0:20:11.11,Main-207-,,0,0,0,,İçgüdüyle hareket ederken\Ntedbirli ol, tamam mı?
Dialogue: 0,0:20:11.11,0:20:16.74,Main-207-,,0,0,0,,Haklısın. Anladım.\NEvet! Doğru! Evet! Anladım!
Dialogue: 0,0:20:29.83,0:20:32.21,Main-207-,,0,0,0,,Hey! Neler oluyor? Sorun ne?
Dialogue: 0,0:20:32.21,0:20:36.67,Main-207-,,0,0,0,,Ahh. Birisi restoranda yerken\Ndevrilip kalmış.
Dialogue: 0,0:20:36.67,0:20:37.67,Main-207-,,0,0,0,,Devrilmiş mi?!
Dialogue: 0,0:20:38.59,0:20:42.47,Main-207-,,0,0,0,,Sanırım restoranın sahibiyle muhabbet \Nederken bir anda ölmüş.
Dialogue: 0,0:20:42.47,0:20:44.35,Main-207-,,0,0,0,,Buralardan değilmiş.
Dialogue: 0,0:20:44.35,0:20:48.60,Main-207-,,0,0,0,,Yolculuğu sırasında farkında olmadan\Nçöl çileği yediğini düşünüyoruz.
Dialogue: 0,0:20:48.60,0:20:50.40,Main-207-,,0,0,0,,Çöl çileği mi?
Dialogue: 0,0:20:50.81,0:20:54.27,Main-207-,,0,0,0,,Kırmızı çileğe benzeyen\Nzehirli örümceklerden.
Dialogue: 0,0:20:54.27,0:20:58.70,Main-207-,,0,0,0,,Yanlışlıkla bir tane yersen\Nbir kaç güne tahtalı köydesin.
Dialogue: 0,0:20:58.70,0:21:03.24,Main-207-,,0,0,0,,Ölümün ardından zehir birkaç saat\Nboyunca bulaşıcılığını koruduğu için...
Dialogue: 0,0:21:03.24,0:21:05.83,Main-207-,,0,0,0,,kimse yanına da yaklaşamıyor.
Dialogue: 0,0:21:05.83,0:21:10.00,Main-207-,,0,0,0,,Çölde ölümün nereden\Ngeleceğini bilemezsin.
Dialogue: 0,0:21:10.00,0:21:15.46,Main-207-,,0,0,0,,Bakın! Hâlâ eti tutuyor.\NO pozisyonda donup kalması,
Dialogue: 0,0:21:15.46,0:21:19.72,Main-207-,,0,0,0,,çöl çileği zehrinin\Nne kadar güçlü olduğunun kanıtı!
Dialogue: 0,0:21:24.97,0:21:26.14,Main-207-,,0,0,0,,Canlandı!
Dialogue: 0,0:21:32.06,0:21:34.44,Main-207-,,0,0,0,,İ-İyi misin?
Dialogue: 0,0:21:39.78,0:21:41.61,Main-207-,,0,0,0,,Pardon.
Dialogue: 0,0:21:41.61,0:21:42.78,Main-207-,,0,0,0,,Uyumuşum.
Dialogue: 0,0:21:42.78,0:21:44.91,Main-207-,,0,0,0,,– Uyudun mu?!\N– Uyudun mu?!
Dialogue: 0,0:21:44.91,0:21:48.50,Main-207-,,0,0,0,,İ-İnanılmaz! Tam da sohbetin\Nve yemeğin ortasında ha?!
Dialogue: 0,0:21:48.50,0:21:50.62,Main-207-,,0,0,0,,Ve yine yemeye başladı!
Dialogue: 0,0:21:52.62,0:21:54.58,Main-207-,,0,0,0,,Ee, bu tantana da ne?
Dialogue: 0,0:21:54.58,0:21:57.59,Main-207-,,0,0,0,,– Öldüğünü düşündük be adam!\N– Öldüğünü düşündük be adam!
Dialogue: 0,0:21:57.59,0:22:00.59,Main-207-,,0,0,0,,Burada komedi gösterileri mi yapılıyor?
Dialogue: 0,0:22:00.59,0:22:05.30,Main-207-,,0,0,0,,Yok, öyle değil.\NNeyse, iyi olduğuna sevindik.
Dialogue: 0,0:22:06.01,0:22:08.06,Main-207-,,0,0,0,,– Hey! Yine uyuma!\N– Hey! Yine uyuma!
Dialogue: 0,0:22:12.10,0:22:14.27,Main-207-,,0,0,0,,Ne yani? Ölmemiş mi?
Dialogue: 0,0:22:14.27,0:22:16.23,Main-207-,,0,0,0,,Yanlış alarm.
Dialogue: 0,0:22:24.70,0:22:27.24,Main-207-,,0,0,0,,Çok iyi geldi!
Dialogue: 0,0:22:27.24,0:22:28.49,Main-207-,,0,0,0,,Söyleyin, bayım.
Dialogue: 0,0:22:28.49,0:22:30.08,Main-207-,,0,0,0,,Ne var?
Dialogue: 0,0:22:30.08,0:22:32.54,Main-207-,,0,0,0,,Bu adamı buralarda gördün mü?
Dialogue: 0,0:22:32.54,0:22:34.71,Main-207-,,0,0,0,,Hasır şapkalı bir korsan...
Dialogue: 0,0:22:34.71,0:22:38.92,Main-207-,,0,0,0,,Böyle halkın ortasında yediğine\Ngöre bayağı cesursun,
Dialogue: 0,0:22:39.46,0:22:42.63,Main-207-,,0,0,0,,Beyazsakal Korsanları,\N2. Tümen Komutanı...
Dialogue: 0,0:22:43.63,0:22:47.80,Main-207-,,0,0,10,,Portgas D. Ace.
Dialogue: 0,0:22:47.80,0:22:51.18,Main-207-,,0,0,0,,B-Beyazsakal mı?!\NBeyazsakal Korsanları mı?!
Dialogue: 0,0:22:51.77,0:22:54.90,Main-207-,,0,0,0,,Şu andaval\NBeyazsakal Korsanlarından mı?
Dialogue: 0,0:22:54.90,0:22:57.44,Main-207-,,0,0,0,,Sırtındaki dövme tanıdık gelmişti zaten!
Dialogue: 0,0:22:57.44,0:23:00.19,Main-207-,,0,0,0,,Beyazsakal Korsanlarının sembolü!
Dialogue: 0,0:23:00.19,0:23:01.69,Main-207-,,0,0,0,,Burada ne arıyor ki?!
Dialogue: 0,0:23:02.65,0:23:06.66,Main-207-,,0,0,0,,Senin gibi meşhur bir korsan,\Nbu ülkede ne arıyor?
Dialogue: 0,0:23:12.29,0:23:13.75,Main-207-,,0,0,0,,Küçük kardeşimi...
Dialogue: 0,0:23:17.17,0:23:19.17,Main-207-,,0,0,0,,arıyorum!
Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=35}===============================DIALOGUE============================
