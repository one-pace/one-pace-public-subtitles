Comment: 0,0:00:00.00,0:00:00.00,Main-207-,,0,0,0,,{=8}===============================DIALOGUE============================
Dialogue: 0,0:01:50.63,0:01:53.38,Flashbacks-207-,,0,0,0,,{\fad(150,150)}ゴムゴムのバズーカ！
Dialogue: 0,0:01:55.72,0:01:58.14,Flashbacks-207-,,0,0,0,,てめえら！いったん退却だ
Dialogue: 0,0:01:58.14,0:02:01.14,Flashbacks-207-,,0,0,0,,みんな！勝手に逃げやがれ
Dialogue: 0,0:02:01.73,0:02:04.27,Main-207-,,0,0,0,,–　待ってくれ〜\N–　待ってくれ〜
Dialogue: 0,0:02:07.73,0:02:09.32,Main-207-,,0,0,0,,みんないるか？
Dialogue: 0,0:02:09.32,0:02:12.61,Main-207-,,0,0,0,,船を下りる時\N隣にいた人が戻っているかな？
Dialogue: 0,0:02:12.61,0:02:14.32,Main-207-,,0,0,0,,いまーす
Dialogue: 0,0:02:14.32,0:02:15.49,Main-207-,,0,0,0,,いまーす
Dialogue: 0,0:02:15.49,0:02:16.62,Main-207-,,0,0,0,,いまーす
Dialogue: 0,0:02:16.62,0:02:17.58,Main-207-,,0,0,0,,はーい
Dialogue: 0,0:02:18.12,0:02:19.70,Main-207-,,0,0,0,,バギー船長が…
Dialogue: 0,0:02:19.70,0:02:21.91,Main-207-,,0,0,0,,バギー船長がいませーん
Dialogue: 0,0:02:26.00,0:02:28.50,Main-207-,,0,0,0,,よっしゃーっ！
Dialogue: 0,0:02:28.96,0:02:31.26,Main-207-,,0,0,0,,ついにできたぜ派手イカダ
Dialogue: 0,0:02:34.63,0:02:36.14,Main-207-,,0,0,0,,行け！
Dialogue: 0,0:02:36.14,0:02:38.76,Main-207-,,0,0,0,,出航だ！
Dialogue: 0,0:02:44.48,0:02:46.19,Main-207-,,0,0,0,,いきなりこれかよ！おい
Dialogue: 0,0:02:46.65,0:02:49.86,Main-207-,,0,0,0,,負けるもんか！チクショーッ
Dialogue: 0,0:03:01.24,0:03:02.20,Main-207-,,0,0,0,,食っちゃる
Dialogue: 0,0:03:10.59,0:03:12.26,Main-207-,,0,0,0,,{\fad(150,150)}バラバラ砲！
Dialogue: 0,0:03:19.93,0:03:21.64,Main-207-,,0,0,0,,じたばたすんじゃねえ
Dialogue: 0,0:03:22.14,0:03:23.43,Main-207-,,0,0,0,,往生しな
Dialogue: 0,0:03:33.36,0:03:36.32,Main-207-,,0,0,0,,ごめんちゃい　すいやせん
Dialogue: 0,0:03:37.41,0:03:40.12,Main-207-,,0,0,0,,お許しを！
Dialogue: 0,0:03:52.42,0:03:53.63,Thoughts-207-,,0,0,0,,来い来い
Dialogue: 0,0:03:54.13,0:03:56.76,Thoughts-207-,,0,0,0,,俺様の計画は完璧だ
Dialogue: 0,0:04:02.47,0:04:04.02,Main-207-,,0,0,0,,{\fad(0,276)}バカバカバカッ
Dialogue: 0,0:04:11.48,0:04:12.65,Main-207-,,0,0,0,,捕まった…
Dialogue: 0,0:04:13.11,0:04:15.03,Main-207-,,0,0,0,,捕まった！あら？ゲッ
Dialogue: 0,0:04:16.36,0:04:18.61,Main-207-,,0,0,0,,なんでこんなことに\Nなっちまうんだ　ちょちょ…
Dialogue: 0,0:04:18.61,0:04:20.78,Main-207-,,0,0,0,,やめてやめて\Nイテイテイテテ…
Dialogue: 0,0:04:20.78,0:04:24.20,Main-207-,,0,0,0,,もはや　これまでか〜
Dialogue: 0,0:04:24.20,0:04:24.95,Main-207-,,0,0,0,,やめて…
Dialogue: 0,0:04:39.43,0:04:41.26,Main-207-,,0,0,0,,ここはどこだ？
Dialogue: 0,0:04:43.97,0:04:46.14,Main-207-,,0,0,0,,{\i1}出ていけ
Dialogue: 0,0:04:47.06,0:04:47.89,Main-207-,,0,0,0,,誰だ？
Dialogue: 0,0:04:48.56,0:04:51.98,Main-207-,,0,0,0,,{\i1}命惜しくば\Nすぐにここを立ち去れ
Dialogue: 0,0:04:55.82,0:04:57.49,Main-207-,,0,0,0,,何だ？こいつら
Dialogue: 0,0:04:57.49,0:04:59.57,Main-207-,,0,0,0,,{\i1}この森の動物たちだ
Dialogue: 0,0:04:59.57,0:05:02.95,Main-207-,,0,0,0,,{\i1}手を出すなよ\N死にたくなかったらな
Dialogue: 0,0:05:02.95,0:05:03.95,Main-207-,,0,0,0,,ほう…
Dialogue: 0,0:05:03.95,0:05:07.37,Main-207-,,0,0,0,,これは派手に面白え動物たちだな
Dialogue: 0,0:05:07.91,0:05:10.50,Main-207-,,0,0,0,,それ以上進むなと言ったはずだ
Dialogue: 0,0:05:12.63,0:05:13.63,Main-207-,,0,0,0,,こなクソッ
Dialogue: 0,0:05:13.63,0:05:15.71,Main-207-,,0,0,0,,いきなり撃ちやがったな
Dialogue: 0,0:05:15.71,0:05:17.42,Main-207-,,0,0,0,,チッ　外したか
Dialogue: 0,0:05:18.01,0:05:19.17,Main-207-,,0,0,0,,そこだ！
Dialogue: 0,0:05:21.18,0:05:22.22,Main-207-,,0,0,0,,何だ！？これは
Dialogue: 0,0:05:23.47,0:05:25.01,Main-207-,,0,0,0,,捕まえたぜ
Dialogue: 0,0:05:25.56,0:05:27.97,Main-207-,,0,0,0,,出てこい
Dialogue: 0,0:05:26.10,0:05:27.97,Secondary-207-,,0,0,0,,イテッ痛い痛い痛い
Dialogue: 0,0:05:27.97,0:05:30.81,Main-207-,,0,0,0,,クソッ\N悪魔の実の能力者だったか
Dialogue: 0,0:05:31.19,0:05:32.85,Main-207-,,0,0,0,,だったらどうした
Dialogue: 0,0:05:32.85,0:05:33.94,Main-207-,,0,0,0,,てめえなんか…
Dialogue: 0,0:05:34.65,0:05:36.02,Main-207-,,0,0,0,,て、てめえなんざ…
Dialogue: 0,0:05:36.73,0:05:38.11,Main-207-,,0,0,0,,てめえは？
Dialogue: 0,0:05:43.28,0:05:45.45,Main-207-,,0,0,0,,箱入り息子か？
Dialogue: 0,0:05:45.45,0:05:49.12,Main-207-,,0,0,0,,ああ　小さな頃から\N大切なお坊ちゃんで…
Dialogue: 0,0:05:49.12,0:05:50.29,Main-207-,,0,0,0,,…なわけあるか！
Dialogue: 0,0:05:50.29,0:05:52.12,Main-207-,,0,0,0,,つまらんギャグさすな
Dialogue: 0,0:05:52.50,0:05:54.96,Main-207-,,0,0,0,,てめえ\N調子に乗るなよ
Dialogue: 0,0:05:54.96,0:05:59.67,Main-207-,,0,0,0,,そいつらに手出しするやつは\N誰であろうとも容赦しねえ
Dialogue: 0,0:06:00.46,0:06:02.97,Main-207-,,0,0,0,,うん？俺とやる気かい
Dialogue: 0,0:06:02.97,0:06:06.80,Main-207-,,0,0,0,,その度胸は褒めてやるが\N死んで後悔すんなよ
Dialogue: 0,0:06:16.40,0:06:18.19,Main-207-,,0,0,0,,捕まえた
Dialogue: 0,0:06:18.19,0:06:19.73,Main-207-,,0,0,0,,クソッ
Dialogue: 0,0:06:22.65,0:06:24.99,Main-207-,,0,0,0,,飛び道具とは卑怯だぞ
Dialogue: 0,0:06:24.99,0:06:27.66,Main-207-,,0,0,0,,お前のこれはじゃあ一体何なんだ
Dialogue: 0,0:06:27.66,0:06:29.49,Main-207-,,0,0,0,,勝手なことぬかしおって
Dialogue: 0,0:06:29.49,0:06:30.62,Main-207-,,0,0,0,,成仏せい
Dialogue: 0,0:06:46.68,0:06:49.43,Main-207-,,0,0,0,,{\fad(150,150)}バラバラ緊急脱出！
Dialogue: 0,0:06:49.89,0:06:51.35,Main-207-,,0,0,0,,アイテッ
Comment: 0,0:06:51.35,0:06:57.19,Main-207-,,0,0,0,,{unintelligible}
Comment: 0,0:06:54.31,0:06:57.19,Secondary-207-,,0,0,0,,{unintelligible}
Dialogue: 0,0:07:06.91,0:07:10.83,Main-207-,,0,0,0,,動物たちに手を出すやつは\Nこの俺が許さん
Dialogue: 0,0:07:10.83,0:07:15.41,Main-207-,,0,0,0,,現にてめえは動物を狙って\Nこの島に来とるではないか
Dialogue: 0,0:07:15.41,0:07:17.17,Main-207-,,0,0,0,,なんで俺様が
Dialogue: 0,0:07:17.17,0:07:19.38,Main-207-,,0,0,0,,こんな島に来たくて\N来たんじゃねえやい
Dialogue: 0,0:07:20.75,0:07:23.30,Main-207-,,0,0,0,,お前密猟者じゃないのか？
Dialogue: 0,0:07:36.77,0:07:38.56,Main-207-,,0,0,0,,どうだ？うまいだろ？
Dialogue: 0,0:07:38.56,0:07:40.86,Main-207-,,0,0,0,,俺が作ったドブロクだ
Dialogue: 0,0:07:40.86,0:07:42.98,Main-207-,,0,0,0,,ああ　こら最高だ
Dialogue: 0,0:07:42.98,0:07:45.49,Main-207-,,0,0,0,,酒なんて何日ぶりだろう
Dialogue: 0,0:07:45.49,0:07:49.74,Main-207-,,0,0,0,,さあ　お代わりならいくらでもある\Nどんどんやってくれ
Dialogue: 0,0:07:49.74,0:07:52.83,Main-207-,,0,0,0,,しかし　さっきは\Nホントにすまなかった
Dialogue: 0,0:07:53.24,0:07:55.50,Main-207-,,0,0,0,,まったくひでえことしやがるぜ
Dialogue: 0,0:07:55.50,0:07:57.67,Main-207-,,0,0,0,,だがもういいってことよ
Dialogue: 0,0:07:57.67,0:07:59.04,Main-207-,,0,0,0,,–　乾杯\N–　乾杯
Dialogue: 0,0:08:09.51,0:08:13.60,Main-207-,,0,0,0,,悪かったな\Nイカダ作りまで手伝わせちまってよ
Dialogue: 0,0:08:13.60,0:08:16.73,Main-207-,,0,0,0,,なーに　お安い御用だ
Dialogue: 0,0:08:17.73,0:08:20.06,Main-207-,,0,0,0,,分かった　達者でやれよ
Dialogue: 0,0:08:20.06,0:08:21.40,Main-207-,,0,0,0,,お前もな
Dialogue: 0,0:08:34.58,0:08:36.29,Main-207-,,0,0,0,,さらば友よ
Dialogue: 0,0:08:37.00,0:08:38.12,Main-207-,,0,0,0,,元気でな
Dialogue: 0,0:08:41.08,0:08:42.84,Main-207-,,0,0,0,,ああ
Dialogue: 0,0:08:42.84,0:08:44.80,Main-207-,,0,0,0,,おめえもな
Dialogue: 0,0:08:47.72,0:08:49.88,Main-207-,,0,0,0,,出航！
Dialogue: 0,0:08:53.26,0:08:55.72,Main-207-,,0,0,0,,でやああっ
Dialogue: 0,0:08:56.97,0:08:58.23,Thoughts-207-,,0,0,0,,バギー
Dialogue: 0,0:08:59.48,0:09:03.15,Thoughts-207-,,0,0,0,,この辺りの海域には\N変な生き物も多い
Dialogue: 0,0:09:03.65,0:09:07.11,Thoughts-207-,,0,0,0,,くれぐれも気をつけて行くんだぞ
Dialogue: 0,0:09:11.07,0:09:13.91,Main-207-,,0,0,0,,…って言うの忘れてた！
Dialogue: 0,0:09:23.25,0:09:25.88,Main-207-,,0,0,0,,逃げろバギー！
Dialogue: 0,0:09:27.80,0:09:29.59,Main-207-,,0,0,0,,ああっ！危ない
Dialogue: 0,0:09:29.59,0:09:32.59,Main-207-,,0,0,0,,逃げろ\Nとにかく逃げるんだ
Dialogue: 0,0:09:36.51,0:09:38.06,Main-207-,,0,0,0,,何だありゃ
Dialogue: 0,0:10:01.46,0:10:02.87,Thoughts-207-,,0,0,0,,マブい
Dialogue: 0,0:10:04.00,0:10:05.67,Main-207-,,0,0,0,,誰だ？ありゃ
Dialogue: 0,0:10:06.04,0:10:08.71,Main-207-,,0,0,0,,えらくべっぴんさんじゃないか
Dialogue: 0,0:10:08.71,0:10:12.76,Main-207-,,0,0,0,,まあ　とりあえず\N何とか助かったみたいだな
Dialogue: 0,0:10:13.38,0:10:15.93,Main-207-,,0,0,0,,まったく\Nヒヤヒヤさせるぜこの
Dialogue: 0,0:10:19.52,0:10:26.48,Main-207-,,0,0,0,,{\fad(0,3941)}何にしても\N達者でやれよ
Dialogue: 0,0:10:26.77,0:10:29.65,Main-207-,,0,0,0,,いやあ　悪かったなあ
Dialogue: 0,0:10:29.65,0:10:32.19,Main-207-,,0,0,0,,派手にもうダメかと思ったぜ
Dialogue: 0,0:10:32.19,0:10:34.07,Main-207-,,0,0,0,,礼には及ばないよ
Dialogue: 0,0:10:35.11,0:10:36.95,Main-207-,,0,0,0,,あんた道化のバギーだろ？
Dialogue: 0,0:10:37.49,0:10:39.12,Main-207-,,0,0,0,,な、なんでそれを…
Dialogue: 0,0:10:39.83,0:10:41.29,Main-207-,,0,0,0,,おめえ何もんだ
Dialogue: 0,0:10:41.29,0:10:44.04,Main-207-,,0,0,0,,私はある男を捜しててね
Dialogue: 0,0:10:45.12,0:10:46.75,Main-207-,,0,0,0,,この男知ってるだろ？
Dialogue: 0,0:10:47.71,0:10:49.04,Main-207-,,0,0,0,,クソゴム！
Dialogue: 0,0:10:49.04,0:10:50.38,Main-207-,,0,0,0,,この野郎！
Dialogue: 0,0:10:50.38,0:10:52.88,Main-207-,,0,0,0,,いつか絶対に\N決着つけてやるからな
Dialogue: 0,0:10:52.88,0:10:54.68,Main-207-,,0,0,0,,覚えてろ…
Dialogue: 0,0:10:56.01,0:10:58.01,Main-207-,,0,0,0,,捜してる男ってこいつか？
Dialogue: 0,0:11:00.51,0:11:02.64,Main-207-,,0,0,0,,なるほどね
Dialogue: 0,0:11:02.64,0:11:05.44,Main-207-,,0,0,0,,それで俺様を\N助けてくれたってわけか
Dialogue: 0,0:11:05.44,0:11:06.77,Main-207-,,0,0,0,,…でどう？
Dialogue: 0,0:11:07.44,0:11:08.86,Main-207-,,0,0,0,,手を組まない？
Dialogue: 0,0:11:12.69,0:11:13.82,Main-207-,,0,0,0,,いいだろう
Dialogue: 0,0:11:13.82,0:11:15.82,Main-207-,,0,0,0,,同じ目的を持った者同士
Dialogue: 0,0:11:15.82,0:11:17.74,Main-207-,,0,0,0,,仲良くしようじゃねえか
Dialogue: 0,0:11:17.74,0:11:20.58,Main-207-,,0,0,0,,よかった　じゃ乾杯
Dialogue: 0,0:11:21.49,0:11:22.62,Main-207-,,0,0,0,,乾杯
Dialogue: 0,0:11:32.76,0:11:34.59,Main-207-,,0,0,0,,バギー船長
Dialogue: 0,0:11:37.59,0:11:42.68,Main-207-,,0,0,0,,元気な頃は　なんて非情で\Nおっそろしい船長だと思ってたけど
Dialogue: 0,0:11:42.68,0:11:48.02,Main-207-,,0,0,0,,思い起こせば豪放磊落\N海賊らしい海賊だったよなあ
Dialogue: 0,0:11:48.02,0:11:51.52,Main-207-,,0,0,0,,考えてみりゃ\N俺たちが好き放題に暴れられたのも
Dialogue: 0,0:11:51.52,0:11:54.65,Main-207-,,0,0,0,,バギー船長の後ろ盾が\Nあったからこそ
Dialogue: 0,0:11:55.19,0:12:01.12,Main-207-,,0,0,0,,今日はバギー船長らしく\N思いっきり派手に弔ってやろうぜ
Dialogue: 0,0:12:03.33,0:12:06.16,Main-207-,,0,0,0,,船長\N安らかに眠ってくれ
Dialogue: 0,0:12:06.62,0:12:09.67,Main-207-,,0,0,0,,あとのことは\Nこのバギー一味のナンバー２
Dialogue: 0,0:12:09.67,0:12:12.96,Main-207-,,0,0,0,,曲芸のカバジ参謀長に\N任せておいてください
Dialogue: 0,0:12:13.80,0:12:17.42,Main-207-,,0,0,0,,バギー海賊団は\N必ず立て直してみせます
Dialogue: 0,0:12:17.42,0:12:19.05,Main-207-,,0,0,0,,待ちな！
Dialogue: 0,0:12:19.68,0:12:21.97,Main-207-,,0,0,0,,カバジ！
Dialogue: 0,0:12:20.43,0:12:21.97,Secondary-207-,,0,0,0,,な、何だ？
Dialogue: 0,0:12:22.30,0:12:27.81,Main-207-,,0,0,0,,バギー船長の跡を継いで\Nバギー海賊団の船長になるのは当然…
Dialogue: 0,0:12:27.81,0:12:32.36,Main-207-,,0,0,0,,副船長である\Nこの猛獣使いのモージ様だろうよ
Dialogue: 0,0:12:32.86,0:12:35.32,Main-207-,,0,0,0,,フンッ\N船長はこの俺だ
Dialogue: 0,0:12:36.32,0:12:37.44,Main-207-,,0,0,0,,なあみんな
Dialogue: 0,0:12:37.44,0:12:40.28,Main-207-,,0,0,0,,船長の座は\Nどっちが強いかで決めだ
Dialogue: 0,0:12:41.57,0:12:43.37,Main-207-,,0,0,0,,望むところだ
Dialogue: 0,0:12:49.83,0:12:52.88,Main-207-,,0,0,0,,{\an8\fad(440,0)}–　モージ！モージ！モージ！\N–　モージ！モージ！モージ！
Dialogue: 0,0:12:53.71,0:12:56.63,Main-207-,,0,0,0,,{\an8}–　カバジ！カバジ！カバジ！\N–　カバジ！カバジ！カバジ！
Dialogue: 0,0:12:56.63,0:12:58.59,Main-207-,,0,0,0,,–　モージ！モージ！\N–　モージ！モージ！
Dialogue: 0,0:12:58.59,0:13:00.47,Main-207-,,0,0,0,,–　カバジ！カバジ！\N–　カバジ！カバジ！
Dialogue: 0,0:13:00.47,0:13:02.59,Main-207-,,0,0,0,,–　モージ！モージ！\N–　モージ！モージ！
Dialogue: 0,0:13:02.59,0:13:04.47,Main-207-,,0,0,0,,–　カバジ！カバジ！\N–　カバジ！カバジ！
Dialogue: 0,0:13:04.47,0:13:06.93,Main-207-,,0,0,0,,–　モージ！モージ！\N–　モージ！モージ！
Dialogue: 0,0:13:23.87,0:13:27.87,Main-207-,,0,0,0,,こうなりゃ　肉体が\Nぶっ潰れるまで戦ってやる
Dialogue: 0,0:13:27.87,0:13:30.50,Main-207-,,0,0,0,,なあ　男と男の勝負
Dialogue: 0,0:13:30.50,0:13:32.83,Main-207-,,0,0,0,,{\q2}この拳で決めてやろうじゃねえか
Dialogue: 0,0:13:45.39,0:13:50.85,Main-207-,,0,0,0,,いいかげんに諦めねえか…
Dialogue: 0,0:13:50.85,0:13:54.15,Main-207-,,0,0,0,,お前こそいいかげんにしろ…
Dialogue: 0,0:14:17.34,0:14:20.67,Main-207-,,0,0,0,,–　おおーっ！我らのリッチー船長！\N–　おおーっ！我らのリッチー船長！
Dialogue: 0,0:14:50.45,0:14:52.83,Main-207-,,0,0,0,,–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:14:52.83,0:14:54.96,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:14:54.96,0:14:57.42,Secondary-207-,,0,0,0,,{\an8}–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:14:57.42,0:14:59.67,Secondary-207-,,0,0,0,,{\an8}–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:14:59.67,0:15:00.42,Secondary-207-,,0,0,0,,{\an8}–　リッチー船長！\N–　リッチー船長！
Dialogue: 0,0:15:00.42,0:15:01.63,Main-207-,,0,0,0,,–　リッチー船長！\N–　リッチー船長！
Dialogue: 0,0:15:01.63,0:15:03.80,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:14:54.96,0:14:56.58,Main-207-,,0,0,0,,バギー船長亡き今
Dialogue: 0,0:14:56.58,0:15:00.42,Main-207-,,0,0,0,,我らの船長にふさわしいのは\Nリッチー船長です
Dialogue: 0,0:15:03.80,0:15:05.88,Main-207-,,0,0,0,,–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:15:05.88,0:15:08.60,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:15:08.60,0:15:10.56,Main-207-,,0,0,0,,{\an8}–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:15:10.56,0:15:12.85,Main-207-,,0,0,0,,{\an8}–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:15:12.85,0:15:14.56,Main-207-,,0,0,0,,{\an8}–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:15:15.10,0:15:17.23,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:15:17.23,0:15:19.44,Main-207-,,0,0,0,,–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:15:19.44,0:15:21.69,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:15:21.69,0:15:23.86,Main-207-,,0,0,0,,–　リッチー船長！リッチー船長！\N–　リッチー船長！リッチー船長！
Dialogue: 0,0:15:23.86,0:15:26.28,Main-207-,,0,0,0,,–　我らの大船長！\N–　我らの大船長！
Dialogue: 0,0:15:41.09,0:15:45.80,Main-207-,,0,0,0,,ここが俺たちクマテ族の島だって\N知ってのことだろうな
Dialogue: 0,0:15:47.43,0:15:48.43,Main-207-,,0,0,0,,船長！
Dialogue: 0,0:15:53.89,0:15:56.06,Main-207-,,0,0,0,,面白い　やろうってのか
Dialogue: 0,0:16:14.79,0:16:16.66,Main-207-,,0,0,0,,こ、降参です
Dialogue: 0,0:16:22.84,0:16:24.84,Main-207-,,0,0,0,,何かいいもんが\N見つかったのかい？
Dialogue: 0,0:16:24.84,0:16:26.80,Main-207-,,0,0,0,,ああ！俺様の…
Dialogue: 0,0:16:27.47,0:16:31.93,Main-207-,,0,0,0,,バギー海賊団の\Nド派手な海賊船だぜ
Dialogue: 0,0:16:32.80,0:16:36.35,Main-207-,,0,0,0,,しかし誰だい\N縁起でもねえ
Dialogue: 0,0:16:36.93,0:16:40.48,Main-207-,,0,0,0,,しかも古い\N手配写真じゃねえかこりゃ
Dialogue: 0,0:16:40.94,0:16:43.86,Main-207-,,0,0,0,,おや？\Nあそこに誰か倒れてるね
Dialogue: 0,0:16:44.90,0:16:46.15,Main-207-,,0,0,0,,なぬっ？
Dialogue: 0,0:16:46.61,0:16:49.03,Main-207-,,0,0,0,,モージ！カバジ！
Dialogue: 0,0:16:49.03,0:16:50.61,Main-207-,,0,0,0,,おめえらどうした？
Dialogue: 0,0:16:51.11,0:16:54.58,Main-207-,,0,0,0,,バ、バギー船長…
Dialogue: 0,0:16:55.08,0:16:58.54,Main-207-,,0,0,0,,おお、お懐かしや…
Dialogue: 0,0:16:59.79,0:17:02.50,Main-207-,,0,0,0,,よくぞご無事で…
Dialogue: 0,0:17:02.50,0:17:04.92,Main-207-,,0,0,0,,また会えるなんて…
Dialogue: 0,0:17:04.92,0:17:07.55,Main-207-,,0,0,0,,うんうん\N俺もうれしいぞ
Dialogue: 0,0:17:09.01,0:17:13.10,Main-207-,,0,0,0,,だがよ　そのザマは\N一体何があったんだ？
Dialogue: 0,0:17:14.22,0:17:16.01,Main-207-,,0,0,0,,誰にやられた？
Dialogue: 0,0:17:16.01,0:17:17.27,Main-207-,,0,0,0,,えっ
Dialogue: 0,0:17:17.27,0:17:20.77,Main-207-,,0,0,0,,いきなりかっぱーんと\N殴られたもんで…
Dialogue: 0,0:17:21.14,0:17:25.07,Main-207-,,0,0,0,,恥ずかしながら\N何も覚えていなくて…
Dialogue: 0,0:17:25.82,0:17:29.74,Main-207-,,0,0,0,,そいつらをやったのは\Nクマテ族だよ
Dialogue: 0,0:17:30.28,0:17:32.91,Main-207-,,0,0,0,,助けるなら\N急いだほうがいいね
Dialogue: 0,0:17:34.87,0:17:38.25,Main-207-,,0,0,0,,クマテ族は\N美食家で有名なんだよ
Dialogue: 0,0:17:51.68,0:17:55.05,Main-207-,,0,0,0,,船長は“ライオンはまずい”と\Nおっしゃられています
Dialogue: 0,0:17:55.05,0:17:56.97,Main-207-,,0,0,0,,俺たちもまずいよ
Dialogue: 0,0:17:56.97,0:17:58.72,Main-207-,,0,0,0,,俺なんか食ってもうまくねえ
Dialogue: 0,0:17:58.72,0:18:01.44,Main-207-,,0,0,0,,俺よりもこいつのほうがうまいって
Dialogue: 0,0:18:00.23,0:18:01.44,Secondary-207-,,0,0,0,,ああ！ウソウソ
Dialogue: 0,0:18:01.44,0:18:03.27,Main-207-,,0,0,0,,こっちのやつのほうがうまい
Dialogue: 0,0:18:03.27,0:18:06.57,Main-207-,,0,0,0,,い、いや\N俺痩せてっから食うとこない
Dialogue: 0,0:18:08.78,0:18:10.28,Main-207-,,0,0,0,,大丈夫
Dialogue: 0,0:18:10.28,0:18:13.28,Main-207-,,0,0,0,,俺たちクマテ族料理の鉄人
Dialogue: 0,0:18:13.28,0:18:15.74,Main-207-,,0,0,0,,ワインと香辛料でにおい消す
Dialogue: 0,0:18:20.58,0:18:22.62,Main-207-,,0,0,0,,この食材はどうする？
Dialogue: 0,0:18:22.62,0:18:24.00,Main-207-,,0,0,0,,何だ？これは
Dialogue: 0,0:18:24.00,0:18:26.21,Main-207-,,0,0,0,,こんな変わった食材は初めてだな
Dialogue: 0,0:18:26.67,0:18:28.17,Main-207-,,0,0,0,,一緒に煮るか
Dialogue: 0,0:18:28.80,0:18:31.01,Main-207-,,0,0,0,,腹壊さなきゃいいがな
Dialogue: 0,0:18:31.01,0:18:32.47,Main-207-,,0,0,0,,{\fad(150,150)}バラバラバラ
Dialogue: 0,0:18:37.05,0:18:39.01,Main-207-,,0,0,0,,{\fad(150,150)}バラバラバラバラ
Dialogue: 0,0:19:06.42,0:19:08.09,Main-207-,,0,0,0,,あ、あれは…
Dialogue: 0,0:19:10.67,0:19:12.96,Main-207-,,0,0,0,,{\fad(150,150)}派手に合体だ！
Dialogue: 0,0:19:41.33,0:19:44.50,Main-207-,,0,0,8,,復活！
Dialogue: 0,0:19:45.37,0:19:49.38,Main-207-,,0,0,0,,–　バギー船長！\N–　バギー船長！
Dialogue: 0,0:19:51.42,0:19:54.09,Main-207-,,0,0,0,,待たせたな！野郎ども
Dialogue: 0,0:19:55.42,0:19:59.43,Main-207-,,0,0,0,,ド派手にバギー玉で景気づけだ
Dialogue: 0,0:20:08.73,0:20:10.52,Main-207-,,0,0,0,,リッチー！
Dialogue: 0,0:20:18.95,0:20:22.87,Main-207-,,0,0,0,,{\fad(150,150)}曲技！湯けむり殺人事件！
Dialogue: 0,0:20:22.87,0:20:26.12,Main-207-,,0,0,0,,猛獣ショーの開幕だ
Dialogue: 0,0:20:33.25,0:20:37.59,Main-207-,,0,0,0,,てめえらにこの道化の\Nバギー様を討てると思うのか？
Dialogue: 0,0:20:39.97,0:20:44.39,Main-207-,,0,0,0,,俺の部下たちがさんざん世話になった分\Nお礼をしなくちゃな
Dialogue: 0,0:20:45.02,0:20:47.43,Main-207-,,0,0,0,,派手にいくぜ！
Dialogue: 0,0:20:48.81,0:20:50.90,Main-207-,,0,0,0,,{\fad(150,150)}バラバラキック！
Dialogue: 0,0:20:56.53,0:20:58.86,Main-207-,,0,0,0,,{\fad(150,150)}バラバラパンチ！
Dialogue: 0,0:21:00.70,0:21:02.62,Main-207-,,0,0,0,,我が船長が！
Dialogue: 0,0:21:06.79,0:21:11.29,Main-207-,,0,0,0,,–　バギー船長！\N–　バギー船長！
Dialogue: 0,0:21:13.75,0:21:15.67,Main-207-,,0,0,0,,よくぞご無事で
Dialogue: 0,0:21:16.55,0:21:20.63,Main-207-,,0,0,0,,かわいいてめえらに\Nえらい苦労かけちまったな
Dialogue: 0,0:21:21.01,0:21:24.97,Main-207-,,0,0,0,,俺たちの苦労なんざ\N大したことありません
Dialogue: 0,0:21:30.02,0:21:34.44,Main-207-,,0,0,0,,みんなにこんな苦労を\Nかけることになったのもあの
Dialogue: 0,0:21:34.44,0:21:36.69,Main-207-,,0,0,0,,クソ麦わらのせいだ
Dialogue: 0,0:21:38.03,0:21:41.66,Main-207-,,0,0,0,,ところで　このきれいな\N女性はどこのどなたで？
Dialogue: 0,0:21:42.36,0:21:46.33,Main-207-,,0,0,0,,この方は俺様の命の恩人で…
Dialogue: 0,0:21:47.04,0:21:48.37,Main-207-,,0,0,0,,あの…
Dialogue: 0,0:21:48.37,0:21:50.33,Main-207-,,0,0,0,,あの　すみません
Dialogue: 0,0:21:50.33,0:21:52.54,Main-207-,,0,0,0,,名前 何でしたっけ？
Dialogue: 0,0:21:55.29,0:21:56.67,Main-207-,,0,0,0,,みんな！
Dialogue: 0,0:21:56.67,0:21:59.80,Main-207-,,0,0,0,,バギー海賊団の復活だ
Dialogue: 0,0:22:01.88,0:22:05.51,Main-207-,,0,0,0,,船長！\Nまず第１の目的は？
Dialogue: 0,0:22:05.51,0:22:09.93,Main-207-,,0,0,0,,モンキー・Ｄ・ルフィの首だ！
