Dialogue: 0,0:01:50.63,0:01:53.38,Flashbacks-207- PL,,0,0,0,,{\fad(150,150)}Gum-Gumowa Bazooka!
Dialogue: 0,0:01:55.72,0:01:58.14,Flashbacks-207- PL,,0,0,0,,Wszyscy, odwrót!
Dialogue: 0,0:01:58.14,0:02:01.14,Flashbacks-207- PL,,0,0,0,,Migiem! Ratuj się, kto może!
Dialogue: 0,0:02:01.73,0:02:04.27,Main-207- PL,,0,0,0,,– Czekajcie!\N– Czekajcie!
Dialogue: 0,0:02:07.73,0:02:09.32,Main-207- PL,,0,0,0,,Wszystkim się udało?!
Dialogue: 0,0:02:09.32,0:02:12.61,Main-207- PL,,0,0,0,,Czy każdy wrócił z każdym,\Nz którym wcześniej zszedł?!
Dialogue: 0,0:02:12.61,0:02:14.32,Main-207- PL,,0,0,0,,Zgadza się!
Dialogue: 0,0:02:14.32,0:02:15.49,Main-207- PL,,0,0,0,,No.
Dialogue: 0,0:02:15.49,0:02:16.62,Main-207- PL,,0,0,0,,Tak.
Dialogue: 0,0:02:16.62,0:02:17.58,Main-207- PL,,0,0,0,,Chyba!
Dialogue: 0,0:02:18.12,0:02:19.70,Main-207- PL,,0,0,0,,Kapitan Buggy...
Dialogue: 0,0:02:19.70,0:02:21.91,Main-207- PL,,0,0,0,,Nie ma z nami kapitana Buggy'ego!
Dialogue: 0,0:02:26.00,0:02:28.50,Main-207- PL,,0,0,0,,W porządku!
Dialogue: 0,0:02:28.96,0:02:31.26,Main-207- PL,,0,0,0,,Efektowna tratwa nareszcie skończona!
Dialogue: 0,0:02:34.63,0:02:36.14,Main-207- PL,,0,0,0,,Naprzód!
Dialogue: 0,0:02:36.14,0:02:38.76,Main-207- PL,,0,0,0,,Stawiać żagle!
Dialogue: 0,0:02:44.48,0:02:46.19,Main-207- PL,,0,0,0,,Od razu na głęboką wodę?!
Dialogue: 0,0:02:46.65,0:02:49.86,Main-207- PL,,0,0,0,,Nie dam się! Niech was!
Dialogue: 0,0:03:01.24,0:03:02.20,Main-207- PL,,0,0,0,,No to smacznego!
Dialogue: 0,0:03:10.59,0:03:12.26,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowa Armata!
Dialogue: 0,0:03:19.93,0:03:21.64,Main-207- PL,,0,0,0,,Marny twój trud!
Dialogue: 0,0:03:22.14,0:03:23.43,Main-207- PL,,0,0,0,,Pogódź się z losem!
Dialogue: 0,0:03:33.36,0:03:36.32,Main-207- PL,,0,0,0,,Przepraszam! Wybacz mi!
Dialogue: 0,0:03:37.41,0:03:40.12,Main-207- PL,,0,0,0,,Błagam o litość!
Dialogue: 0,0:03:52.42,0:03:53.63,Thoughts-207- PL,,0,0,0,,Dalej, dalej!
Dialogue: 0,0:03:54.13,0:03:56.76,Thoughts-207- PL,,0,0,0,,To plan doskonały!
Dialogue: 0,0:04:02.47,0:04:04.02,Main-207- PL,,0,0,0,,{\fad(0,276)}Gamoń! Gamoń! Gamoń!
Dialogue: 0,0:04:11.48,0:04:12.65,Main-207- PL,,0,0,0,,Mam cię!
Dialogue: 0,0:04:13.11,0:04:15.03,Main-207- PL,,0,0,0,,{\i1}Mnie{\i0} ma?! Co?! Chwila!
Dialogue: 0,0:04:16.36,0:04:18.61,Main-207- PL,,0,0,0,,Jak do tego doszło?!
Dialogue: 0,0:04:18.61,0:04:20.78,Main-207- PL,,0,0,0,,Czekaj! Przestań! Au, au, au!
Dialogue: 0,0:04:20.78,0:04:24.20,Main-207- PL,,0,0,0,,Czy to naprawdę koniec?!
Dialogue: 0,0:04:24.20,0:04:24.95,Main-207- PL,,0,0,0,,Nie rób tego...
Dialogue: 0,0:04:39.43,0:04:41.26,Main-207- PL,,0,0,0,,Gdzie ja jestem?
Dialogue: 0,0:04:43.97,0:04:46.14,Main-207- PL,,0,0,0,,{\i1}Wynoście się!{Gaimon 06:32}
Dialogue: 0,0:04:47.06,0:04:47.89,Main-207- PL,,0,0,0,,Kto mówi?!
Dialogue: 0,0:04:48.56,0:04:51.98,Main-207- PL,,0,0,0,,{\i1}Natychmiast opuść to miejsce,\Njeśli cenisz swój żywot!{Gaimon 06:39}
Dialogue: 0,0:04:55.82,0:04:57.49,Main-207- PL,,0,0,0,,Co to ma być?
Dialogue: 0,0:04:57.49,0:04:59.57,Main-207- PL,,0,0,0,,{\i1}To fauna tej puszczy.
Dialogue: 0,0:04:59.57,0:05:02.95,Main-207- PL,,0,0,0,,{\i1}Lepiej z nimi nie zadzieraj.\NNo, chyba że życie ci niemiłe!
Dialogue: 0,0:05:02.95,0:05:03.95,Main-207- PL,,0,0,0,,Czyżby?
Dialogue: 0,0:05:03.95,0:05:07.37,Main-207- PL,,0,0,0,,Całkiem efektownie\Ninteresujące zwierzątka...
Dialogue: 0,0:05:07.91,0:05:10.50,Main-207- PL,,0,0,0,,Mówiłem, żebyś się nie zbliżał!
Dialogue: 0,0:05:12.63,0:05:13.63,Main-207- PL,,0,0,0,,Cholera jasna!
Dialogue: 0,0:05:13.63,0:05:15.71,Main-207- PL,,0,0,0,,Wziął mnie z zaskoczenia!
Dialogue: 0,0:05:15.71,0:05:17.42,Main-207- PL,,0,0,0,,Szlag by to! Pudło!
Dialogue: 0,0:05:18.01,0:05:19.17,Main-207- PL,,0,0,0,,Tu jesteś!
Dialogue: 0,0:05:21.18,0:05:22.22,Main-207- PL,,0,0,0,,Co jest?!
Dialogue: 0,0:05:23.47,0:05:25.01,Main-207- PL,,0,0,0,,Mam cię!
Dialogue: 0,0:05:25.56,0:05:27.97,Main-207- PL,,0,0,0,,Wyłaź!
Dialogue: 0,0:05:26.10,0:05:27.97,Secondary-207- PL,,0,0,0,,Au! Au! Au!
Dialogue: 0,0:05:27.97,0:05:30.81,Main-207- PL,,0,0,0,,Niech to! Władasz mocą\Ndiabelskiego owocu!
Dialogue: 0,0:05:31.19,0:05:32.85,Main-207- PL,,0,0,0,,No władam, i co?!
Dialogue: 0,0:05:32.85,0:05:33.94,Main-207- PL,,0,0,0,,Jesteś zazdrosny...
Dialogue: 0,0:05:34.65,0:05:36.02,Main-207- PL,,0,0,0,,Jesteś...
Dialogue: 0,0:05:36.73,0:05:38.11,Main-207- PL,,0,0,0,,Czym ty jesteś?
Dialogue: 0,0:05:43.28,0:05:45.45,Main-207- PL,,0,0,0,,{Gaimon 09:49}Rodzice traktowali cię jak skarb, co?
Dialogue: 0,0:05:45.45,0:05:49.12,Main-207- PL,,0,0,0,,Tak. Odkąd byłem małym chłopcem,\Nwyrażali swoją miłość poprzez...{Gaimon 09:51}
Dialogue: 0,0:05:49.12,0:05:50.29,Main-207- PL,,0,0,0,,A niech cię!{Gaimon 09:54}
Dialogue: 0,0:05:50.29,0:05:52.12,Main-207- PL,,0,0,0,,Ten żart już nie jest zabawny!
Dialogue: 0,0:05:52.50,0:05:54.96,Main-207- PL,,0,0,0,,Draniu! Nie bądź taki cwany!
Dialogue: 0,0:05:54.96,0:05:59.67,Main-207- PL,,0,0,0,,Nie daruję nikomu,\Nkto zadziera ze zwierzętami!
Dialogue: 0,0:06:00.46,0:06:02.97,Main-207- PL,,0,0,0,,Och? Chcesz się bić?
Dialogue: 0,0:06:02.97,0:06:06.80,Main-207- PL,,0,0,0,,Ciekawe, czy będziesz tak samo\Nodważny, gdy już będziesz konał!
Dialogue: 0,0:06:16.40,0:06:18.19,Main-207- PL,,0,0,0,,A masz!
Dialogue: 0,0:06:18.19,0:06:19.73,Main-207- PL,,0,0,0,,Chrzań się!
Dialogue: 0,0:06:22.65,0:06:24.99,Main-207- PL,,0,0,0,,Walka na odległość to oszustwo!
Dialogue: 0,0:06:24.99,0:06:27.66,Main-207- PL,,0,0,0,,W takim razie co to ma być?!
Dialogue: 0,0:06:27.66,0:06:29.49,Main-207- PL,,0,0,0,,Widzisz tylko czubek własnego nosa!
Dialogue: 0,0:06:29.49,0:06:30.62,Main-207- PL,,0,0,0,,Lepiej zmów paciorek!
Dialogue: 0,0:06:46.68,0:06:49.43,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowa Ewakuacja!
Dialogue: 0,0:06:49.89,0:06:51.35,Main-207- PL,,0,0,0,,Boli!
Dialogue: 0,0:06:51.35,0:06:57.19,Main-207- PL,,0,0,0,,Jak mogłeś?! Chrzań się! Auć!
Dialogue: 0,0:06:54.31,0:06:57.19,Secondary-207- PL,,0,0,0,,Jak mogłem?! Niby co?!
Dialogue: 0,0:07:06.91,0:07:10.83,Main-207- PL,,0,0,0,,Każdy, kto zadziera ze zwierzętami,\Nponiesie konsekwencje!
Dialogue: 0,0:07:10.83,0:07:15.41,Main-207- PL,,0,0,0,,Perfidny z ciebie drań. Fatygować się\Ntaki kawał tylko po to, żeby na nie zapolować!
Dialogue: 0,0:07:15.41,0:07:17.17,Main-207- PL,,0,0,0,,A po co miałbym to robić?!
Dialogue: 0,0:07:17.17,0:07:19.38,Main-207- PL,,0,0,0,,Ja nawet {\i1}nie chciałem{\i0} tutaj trafić!
Dialogue: 0,0:07:20.75,0:07:23.30,Main-207- PL,,0,0,0,,Czyli nie jesteś kłusownikiem?
Dialogue: 0,0:07:36.77,0:07:38.56,Main-207- PL,,0,0,0,,I co? Dobre, nie?!
Dialogue: 0,0:07:38.56,0:07:40.86,Main-207- PL,,0,0,0,,To moja własna gorzała,\Nniepasteryzowana!
Dialogue: 0,0:07:40.86,0:07:42.98,Main-207- PL,,0,0,0,,No, najwyższa półka!
Dialogue: 0,0:07:42.98,0:07:45.49,Main-207- PL,,0,0,0,,Nie pamiętam, kiedy ostatni raz coś piłem...
Dialogue: 0,0:07:45.49,0:07:49.74,Main-207- PL,,0,0,0,,Dolewaj sobie, ile chcesz! Częstuj się!
Dialogue: 0,0:07:49.74,0:07:52.83,Main-207- PL,,0,0,0,,I wybacz mi za wcześniej!
Dialogue: 0,0:07:53.24,0:07:55.50,Main-207- PL,,0,0,0,,No, dałeś mi nieźle popalić,
Dialogue: 0,0:07:55.50,0:07:57.67,Main-207- PL,,0,0,0,,ale było minęło!
Dialogue: 0,0:07:57.67,0:07:59.04,Main-207- PL,,0,0,0,,– Zdrówko!\N– Zdrówko!
Dialogue: 0,0:08:09.51,0:08:13.60,Main-207- PL,,0,0,0,,Dzięki za pomoc przy tratwie.
Dialogue: 0,0:08:13.60,0:08:16.73,Main-207- PL,,0,0,0,,Nie ma za co.\NPolecam się na przyszłość.
Dialogue: 0,0:08:17.73,0:08:20.06,Main-207- PL,,0,0,0,,No dobra! Trzymaj się!
Dialogue: 0,0:08:20.06,0:08:21.40,Main-207- PL,,0,0,0,,Ty również!
Dialogue: 0,0:08:34.58,0:08:36.29,Main-207- PL,,0,0,0,,Żegnaj, przyjacielu!
Dialogue: 0,0:08:37.00,0:08:38.12,Main-207- PL,,0,0,0,,Bądź zdrów!
Dialogue: 0,0:08:41.08,0:08:42.84,Main-207- PL,,0,0,0,,Tak...
Dialogue: 0,0:08:42.84,0:08:44.80,Main-207- PL,,0,0,0,,Ty też!
Dialogue: 0,0:08:47.72,0:08:49.88,Main-207- PL,,0,0,0,,Stawiać żagle!
Dialogue: 0,0:08:53.26,0:08:55.72,Main-207- PL,,0,0,0,,W drogę!
Dialogue: 0,0:08:56.97,0:08:58.23,Thoughts-207- PL,,0,0,0,,Buggy...
Dialogue: 0,0:08:59.48,0:09:03.15,Thoughts-207- PL,,0,0,0,,Morze skrywa wiele dziwnych rzeczy.
Dialogue: 0,0:09:03.65,0:09:07.11,Thoughts-207- PL,,0,0,0,,Niech ci wiatry sprzyjają,\Nuważaj tam na siebie!
Dialogue: 0,0:09:11.07,0:09:13.91,Main-207- PL,,0,0,0,,Cholera, zapomniałem\Nmu o tym wspomnieć!
Dialogue: 0,0:09:23.25,0:09:25.88,Main-207- PL,,0,0,0,,Uciekaj, Buggy!
Dialogue: 0,0:09:27.80,0:09:29.59,Main-207- PL,,0,0,0,,Uwaga!
Dialogue: 0,0:09:29.59,0:09:32.59,Main-207- PL,,0,0,0,,Uciekaj! Czym prędzej uciekaj!
Dialogue: 0,0:09:36.51,0:09:38.06,Main-207- PL,,0,0,0,,A to co?
Dialogue: 0,0:10:01.46,0:10:02.87,Thoughts-207- PL,,0,0,0,,Ładna...
Dialogue: 0,0:10:04.00,0:10:05.67,Main-207- PL,,0,0,0,,Kto to?
Dialogue: 0,0:10:06.04,0:10:08.71,Main-207- PL,,0,0,0,,Prawdziwa piękność!
Dialogue: 0,0:10:08.71,0:10:12.76,Main-207- PL,,0,0,0,,No cóż. Tyle dobrego,\Nże nic mu nie jest!
Dialogue: 0,0:10:13.38,0:10:15.93,Main-207- PL,,0,0,0,,Napędził mi niezłego stracha!
Dialogue: 0,0:10:19.52,0:10:26.48,Main-207- PL,,0,0,0,,{\fad(0,3941)}Mniejsza o to, żegnaj!
Dialogue: 0,0:10:26.77,0:10:29.65,Main-207- PL,,0,0,0,,Dzięki za pomoc!
Dialogue: 0,0:10:29.65,0:10:32.19,Main-207- PL,,0,0,0,,Już efektownie żegnałem się z życiem!
Dialogue: 0,0:10:32.19,0:10:34.07,Main-207- PL,,0,0,0,,Nie musisz mi dziękować.
Dialogue: 0,0:10:35.11,0:10:36.95,Main-207- PL,,0,0,0,,Klaun Buggy, czyż nie?
Dialogue: 0,0:10:37.49,0:10:39.12,Main-207- PL,,0,0,0,,S-Skąd wiedziałaś?!
Dialogue: 0,0:10:39.83,0:10:41.29,Main-207- PL,,0,0,0,,A ty to niby kto?
Dialogue: 0,0:10:41.29,0:10:44.04,Main-207- PL,,0,0,0,,Tak się składa, że kogoś szukam.
Dialogue: 0,0:10:45.12,0:10:46.75,Main-207- PL,,0,0,0,,Znacie się, jak mniemam?
Dialogue: 0,0:10:47.71,0:10:49.04,Main-207- PL,,0,0,0,,To ten gumowy padalec!
Dialogue: 0,0:10:49.04,0:10:50.38,Main-207- PL,,0,0,0,,Niech go dorwę!
Dialogue: 0,0:10:50.38,0:10:52.88,Main-207- PL,,0,0,0,,Pożałujesz, że ze mną zadarłeś!
Dialogue: 0,0:10:52.88,0:10:54.68,Main-207- PL,,0,0,0,,Popamiętasz moje słowa!
Dialogue: 0,0:10:56.01,0:10:58.01,Main-207- PL,,0,0,0,,Czyli to jego szukasz?
Dialogue: 0,0:11:00.51,0:11:02.64,Main-207- PL,,0,0,0,,Wszystko jasne.
Dialogue: 0,0:11:02.64,0:11:05.44,Main-207- PL,,0,0,0,,To dlatego mi pomogłaś.
Dialogue: 0,0:11:05.44,0:11:06.77,Main-207- PL,,0,0,0,,No, to jak będzie?
Dialogue: 0,0:11:07.44,0:11:08.86,Main-207- PL,,0,0,0,,Połączymy siły?
Dialogue: 0,0:11:12.69,0:11:13.82,Main-207- PL,,0,0,0,,Się rozumie, czemu nie?
Dialogue: 0,0:11:13.82,0:11:15.82,Main-207- PL,,0,0,0,,W końcu mamy ten sam cel.
Dialogue: 0,0:11:15.82,0:11:17.74,Main-207- PL,,0,0,0,,Jakoś się dogadamy.
Dialogue: 0,0:11:17.74,0:11:20.58,Main-207- PL,,0,0,0,,Wspaniale. Wznieśmy więc toast.
Dialogue: 0,0:11:21.49,0:11:22.62,Main-207- PL,,0,0,0,,Zdróweczko!
Dialogue: 0,0:11:32.76,0:11:34.59,Main-207- PL,,0,0,0,,Kapitanie Buggy!
Dialogue: 0,0:11:37.59,0:11:42.68,Main-207- PL,,0,0,0,,Za życia uważałem go\Nza okrutnego i przerażającego pirata,
Dialogue: 0,0:11:42.68,0:11:48.02,Main-207- PL,,0,0,0,,ale w końcu zrozumiałem, że był szczerym\Ndo bólu i prawdziwie pirackim piratem!
Dialogue: 0,0:11:48.02,0:11:51.52,Main-207- PL,,0,0,0,,Gdyby się tak zastanowić,\Nto zawsze mogliśmy łupić, ile wlezie,
Dialogue: 0,0:11:51.52,0:11:54.65,Main-207- PL,,0,0,0,,bo nasz wspaniały kapitan Buggy\Nnam na to pozwalał!
Dialogue: 0,0:11:55.19,0:12:01.12,Main-207- PL,,0,0,0,,{\q2}Dziś oddajemy cześć kapitanowi Buggy'emu,\Nurządzając mu ten jakże efektowny pogrzeb!
Dialogue: 0,0:12:03.33,0:12:06.16,Main-207- PL,,0,0,0,,Kapitanie, spoczywaj w pokoju!
Dialogue: 0,0:12:06.62,0:12:09.67,Main-207- PL,,0,0,0,,Ja, Akrobata Cabaji,\Nnumer dwa w załodze Buggy'ego,
Dialogue: 0,0:12:09.67,0:12:12.96,Main-207- PL,,0,0,0,,dopilnuję porządku i będę\Nkontynuował twoje dzieło!
Dialogue: 0,0:12:13.80,0:12:17.42,Main-207- PL,,0,0,0,,{\q2}Przysięgam, że poprowadzę\NPiratów Buggy'ego w dobrym kierunku!
Dialogue: 0,0:12:17.42,0:12:19.05,Main-207- PL,,0,0,0,,Nie pozwalaj sobie!
Dialogue: 0,0:12:19.68,0:12:21.97,Main-207- PL,,0,0,0,,Cabaji!
Dialogue: 0,0:12:20.43,0:12:21.97,Secondary-207- PL,,0,0,0,,Czego?!
Dialogue: 0,0:12:22.30,0:12:27.81,Main-207- PL,,0,0,0,,To chyba oczywiste, że następnym przywódcą\Npirackiej załogi naszego kapitana Buggy'ego
Dialogue: 0,0:12:27.81,0:12:32.36,Main-207- PL,,0,0,0,,zostanie jego pierwszy oficer,\Nwspaniały Poskramiacz Bestii Mohji!
Dialogue: 0,0:12:32.86,0:12:35.32,Main-207- PL,,0,0,0,,To {\i1}ja{\i0} jestem teraz kapitanem!
Dialogue: 0,0:12:36.32,0:12:37.44,Main-207- PL,,0,0,0,,Panowie!
Dialogue: 0,0:12:37.44,0:12:40.28,Main-207- PL,,0,0,0,,Niech pięści wyłonią\Nnastępnego kapitana!
Dialogue: 0,0:12:41.57,0:12:43.37,Main-207- PL,,0,0,0,,Niech będzie!
Dialogue: 0,0:12:49.83,0:12:52.88,Main-207- PL,,0,0,0,,{\an8\fad(440,0)}– Mohji! Mohji! Mohji!\N– Mohji! Mohji! Mohji!
Dialogue: 0,0:12:53.71,0:12:56.63,Main-207- PL,,0,0,0,,{\an8}– Cabaji! Cabaji! Cabaji!\N– Cabaji! Cabaji! Cabaji!
Dialogue: 0,0:12:56.63,0:12:58.59,Main-207- PL,,0,0,0,,– Mohji! Mohji!\N– Mohji! Mohji!
Dialogue: 0,0:12:58.59,0:13:00.47,Main-207- PL,,0,0,0,,– Cabaji! Cabaji!\N– Cabaji! Cabaji!
Dialogue: 0,0:13:00.47,0:13:02.59,Main-207- PL,,0,0,0,,– Mohji! Mohji!\N– Mohji! Mohji!
Dialogue: 0,0:13:02.59,0:13:04.47,Main-207- PL,,0,0,0,,– Cabaji! Cabaji!\N– Cabaji! Cabaji!
Dialogue: 0,0:13:04.47,0:13:06.93,Main-207- PL,,0,0,0,,– Mohji! Mohji!\N– Mohji! Mohji!
Dialogue: 0,0:13:23.87,0:13:27.87,Main-207- PL,,0,0,0,,Wygląda na to, że będę musiał cię lać,\Naż twoje ciało odmówi posłuszeństwa.
Dialogue: 0,0:13:27.87,0:13:30.50,Main-207- PL,,0,0,0,,Ta, trzeba to rozstrzygnąć jak mężczyźni.
Dialogue: 0,0:13:30.50,0:13:32.83,Main-207- PL,,0,0,0,,{\q2}Rozwalę cię gołymi rękoma!
Dialogue: 0,0:13:45.39,0:13:50.85,Main-207- PL,,0,0,0,,Ty... P-Poddaj się wreszcie.
Dialogue: 0,0:13:50.85,0:13:54.15,Main-207- PL,,0,0,0,,N-Nie ma mowy. Sam się poddaj.
Dialogue: 0,0:14:17.34,0:14:20.67,Main-207- PL,,0,0,0,,– Tak jest! Nasz kapitan Richie!\N– Tak jest! Nasz kapitan Richie!
Dialogue: 0,0:14:50.45,0:14:52.83,Main-207- PL,,0,0,0,,– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:14:52.83,0:14:54.96,Main-207- PL,,0,0,0,,– Nasz wspaniały kapitan!\N– Nasz wspaniały kapitan!
Dialogue: 0,0:14:54.96,0:14:57.42,Secondary-207- PL,,0,0,0,,{\an8}– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:14:57.42,0:14:59.67,Secondary-207- PL,,0,0,0,,{\an8}– Najwspanialszy kapitan!\N– Najwspanialszy kapitan!
Dialogue: 0,0:14:59.67,0:15:00.42,Secondary-207- PL,,0,0,0,,{\an8}– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:00.42,0:15:01.63,Main-207- PL,,0,0,0,,– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:01.63,0:15:03.80,Main-207- PL,,0,0,0,,– Wielki nasz kapitan!\N– Wielki nasz kapitan!
Dialogue: 0,0:14:54.96,0:14:56.58,Main-207- PL,,0,0,0,,Ku pamięci kapitana Buggy'ego,
Dialogue: 0,0:14:56.58,0:15:00.42,Main-207- PL,,0,0,0,,jego miejsce zajmuje najlepszy\Nz nas wszystkich, kapitan Richie!
Dialogue: 0,0:15:03.80,0:15:05.88,Main-207- PL,,0,0,0,,– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:05.88,0:15:08.60,Main-207- PL,,0,0,0,,– Nasz wspaniały kapitan!\N– Nasz wspaniały kapitan!
Dialogue: 0,0:15:08.60,0:15:10.56,Main-207- PL,,0,0,0,,{\an8}– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:10.56,0:15:12.85,Main-207- PL,,0,0,0,,{\an8}– Nasz wspaniały kapitan!\N– Nasz wspaniały kapitan!
Dialogue: 0,0:15:12.85,0:15:14.56,Main-207- PL,,0,0,0,,{\an8}– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:15.10,0:15:17.23,Main-207- PL,,0,0,0,,– Nasz wielki kapitan!\N– Nasz wielki kapitan!
Dialogue: 0,0:15:17.23,0:15:19.44,Main-207- PL,,0,0,0,,– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:19.44,0:15:21.69,Main-207- PL,,0,0,0,,– Nasz wielki kapitan!\N– Nasz wielki kapitan!
Dialogue: 0,0:15:21.69,0:15:23.86,Main-207- PL,,0,0,0,,– Kapitan Richie! Kapitan Richie!\N– Kapitan Richie! Kapitan Richie!
Dialogue: 0,0:15:23.86,0:15:26.28,Main-207- PL,,0,0,0,,– Najwspanialszy kapitan!\N– Najwspanialszy kapitan!
Dialogue: 0,0:15:41.09,0:15:45.80,Main-207- PL,,0,0,0,,Chyba nie zdajecie sobie sprawy, że ta wyspa\Nnależy do Plemienia Niedźwiedziej Łapy, co?
Dialogue: 0,0:15:47.43,0:15:48.43,Main-207- PL,,0,0,0,,Kapitanie!
Dialogue: 0,0:15:53.89,0:15:56.06,Main-207- PL,,0,0,0,,No proszę.\NAż tak rwiecie się do walki?!
Dialogue: 0,0:16:14.79,0:16:16.66,Main-207- PL,,0,0,0,,P-Poddajemy się.
Dialogue: 0,0:16:22.84,0:16:24.84,Main-207- PL,,0,0,0,,Znalazłeś coś ciekawego?
Dialogue: 0,0:16:24.84,0:16:26.80,Main-207- PL,,0,0,0,,Tak! Przecież to...
Dialogue: 0,0:16:27.47,0:16:31.93,Main-207- PL,,0,0,0,,superancko popisowy okręt\Nzałogi Piratów Buggy'ego!
Dialogue: 0,0:16:32.80,0:16:36.35,Main-207- PL,,0,0,0,,Ale czyja to sprawka?\NAbsolutny brak wyczucia!
Dialogue: 0,0:16:36.93,0:16:40.48,Main-207- PL,,0,0,0,,Pomijając fakt, że to stary list gończy.
Dialogue: 0,0:16:40.94,0:16:43.86,Main-207- PL,,0,0,0,,Och? Wygląda na to, że ktoś tam leży.
Dialogue: 0,0:16:44.90,0:16:46.15,Main-207- PL,,0,0,0,,Co...?!
Dialogue: 0,0:16:46.61,0:16:49.03,Main-207- PL,,0,0,0,,Mohji! Cabaji!
Dialogue: 0,0:16:49.03,0:16:50.61,Main-207- PL,,0,0,0,,Co z wami, gamonie?!
Dialogue: 0,0:16:51.11,0:16:54.58,Main-207- PL,,0,0,0,,K-Kapitanie Buggy...
Dialogue: 0,0:16:55.08,0:16:58.54,Main-207- PL,,0,0,0,,T-Tak dobrze cię znów widzieć...
Dialogue: 0,0:16:59.79,0:17:02.50,Main-207- PL,,0,0,0,,Jakie to szczęście, że żyjesz!
Dialogue: 0,0:17:02.50,0:17:04.92,Main-207- PL,,0,0,0,,Byliśmy przekonani, że cię straciliśmy!
Dialogue: 0,0:17:04.92,0:17:07.55,Main-207- PL,,0,0,0,,T-Też się cieszę!
Dialogue: 0,0:17:09.01,0:17:13.10,Main-207- PL,,0,0,0,,Ale co to ma do cholery znaczyć?
Dialogue: 0,0:17:14.22,0:17:16.01,Main-207- PL,,0,0,0,,Kto was tak urządził?!
Dialogue: 0,0:17:16.01,0:17:17.27,Main-207- PL,,0,0,0,,Co?
Dialogue: 0,0:17:17.27,0:17:20.77,Main-207- PL,,0,0,0,,Wzięli nas z zaskoczenia, więc tego...
Dialogue: 0,0:17:21.14,0:17:25.07,Main-207- PL,,0,0,0,,Wstyd się przyznać, ale nic nie pamiętam.
Dialogue: 0,0:17:25.82,0:17:29.74,Main-207- PL,,0,0,0,,Wygląda na to, że padli ofiarą\NPlemienia Niedźwiedziej Łapy.
Dialogue: 0,0:17:30.28,0:17:32.91,Main-207- PL,,0,0,0,,Lepiej się pospiesz,\Nbo inaczej nie ocalisz reszty.
Dialogue: 0,0:17:34.87,0:17:38.25,Main-207- PL,,0,0,0,,Plemię Niedźwiedziej Łapy\Nznane jest ze swojego apetytu.
Dialogue: 0,0:17:51.68,0:17:55.05,Main-207- PL,,0,0,0,,Kapitan mówi, że lwy nie smakują dobrze!
Dialogue: 0,0:17:55.05,0:17:56.97,Main-207- PL,,0,0,0,,My też nie jesteśmy smaczni!
Dialogue: 0,0:17:56.97,0:17:58.72,Main-207- PL,,0,0,0,,Nie będzie ze mnie żaden posiłek!
Dialogue: 0,0:17:58.72,0:18:01.44,Main-207- PL,,0,0,0,,Ten tutaj wygląda na smaczniejszego!
Dialogue: 0,0:18:00.23,0:18:01.44,Secondary-207- PL,,0,0,0,,On kłamie! Kłamie!
Dialogue: 0,0:18:01.44,0:18:03.27,Main-207- PL,,0,0,0,,On jest smaczniejszy!
Dialogue: 0,0:18:03.27,0:18:06.57,Main-207- PL,,0,0,0,,Gdzie tam, sama skóra i kości!\NNikt się mną nie naje!
Dialogue: 0,0:18:08.78,0:18:10.28,Main-207- PL,,0,0,0,,Nie martwcie się!
Dialogue: 0,0:18:10.28,0:18:13.28,Main-207- PL,,0,0,0,,To Plemię Niedźwiedziej Łapy!\NŚwietnie gotujemy!
Dialogue: 0,0:18:13.28,0:18:15.74,Main-207- PL,,0,0,0,,Trochę winka, przypraw,\Na przykry zapach znika.
Dialogue: 0,0:18:20.58,0:18:22.62,Main-207- PL,,0,0,0,,A z tego co przyrządzimy?
Dialogue: 0,0:18:22.62,0:18:24.00,Main-207- PL,,0,0,0,,Co to ma być?
Dialogue: 0,0:18:24.00,0:18:26.21,Main-207- PL,,0,0,0,,Nigdy żem nie widział\Ntakich składników.
Dialogue: 0,0:18:26.67,0:18:28.17,Main-207- PL,,0,0,0,,Wrzucamy do jednego gara?
Dialogue: 0,0:18:28.80,0:18:31.01,Main-207- PL,,0,0,0,,Oby tylko były lekkostrawne...
Dialogue: 0,0:18:31.01,0:18:32.47,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowe-Pod-Podziałowe...
Dialogue: 0,0:18:37.05,0:18:39.01,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowe-Pod-Podziałowe...
Dialogue: 0,0:19:06.42,0:19:08.09,Main-207- PL,,0,0,0,,Czy to...?!
Dialogue: 0,0:19:10.67,0:19:12.96,Main-207- PL,,0,0,0,,{\fad(150,150)}...Efektowne Ujednolicenie!
Dialogue: 0,0:19:41.33,0:19:44.50,Main-207- PL,,0,0,0,,{\an8}Wróciłem!
Dialogue: 0,0:19:45.37,0:19:49.38,Main-207- PL,,0,0,0,,– Kapitan Buggy!\N– Kapitan Buggy!
Dialogue: 0,0:19:51.42,0:19:54.09,Main-207- PL,,0,0,0,,Wybaczcie zwłokę, panowie!
Dialogue: 0,0:19:55.42,0:19:59.43,Main-207- PL,,0,0,0,,Czas efektownie ożywić atmosferę!\NPora na super Kulę Buggy'ego!
Dialogue: 0,0:20:08.73,0:20:10.52,Main-207- PL,,0,0,0,,Richie!
Dialogue: 0,0:20:18.95,0:20:22.87,Main-207- PL,,0,0,0,,{\fad(150,150)}Sztuka Akrobacji: Czar Par!
Dialogue: 0,0:20:22.87,0:20:26.12,Main-207- PL,,0,0,0,,Pora poskromić parę bestii!
Dialogue: 0,0:20:33.25,0:20:37.59,Main-207- PL,,0,0,0,,Naprawdę sądziłeś, że zdołasz trafić\N{\i1}mnie{\i0}, wielkiego Klauna Buggy'ego?!
Dialogue: 0,0:20:39.97,0:20:44.39,Main-207- PL,,0,0,0,,Pozwólcie, że odwdzięczę się za wszystko,\Nco zgotowaliście mojej załodze!
Dialogue: 0,0:20:45.02,0:20:47.43,Main-207- PL,,0,0,0,,Efektownie nadchodzę!
Dialogue: 0,0:20:48.81,0:20:50.90,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowe Kopnięcie!
Dialogue: 0,0:20:56.53,0:20:58.86,Main-207- PL,,0,0,0,,{\fad(150,150)}Pod-Podziałowe Uderzenie!
Dialogue: 0,0:21:00.70,0:21:02.62,Main-207- PL,,0,0,0,,To właśnie nasz kapitan!
Dialogue: 0,0:21:06.79,0:21:11.29,Main-207- PL,,0,0,0,,– Kapitan Buggy!\N– Kapitan Buggy!
Dialogue: 0,0:21:13.75,0:21:15.67,Main-207- PL,,0,0,0,,Tak się cieszymy, że jesteś cały!
Dialogue: 0,0:21:16.55,0:21:20.63,Main-207- PL,,0,0,0,,Moi drodzy poddani! Wybaczcie,\Nże sprawiłem wam tyle kłopotów!
Dialogue: 0,0:21:21.01,0:21:24.97,Main-207- PL,,0,0,0,,Nasze zmartwienia to nic!
Dialogue: 0,0:21:30.02,0:21:34.44,Main-207- PL,,0,0,0,,Ten okrutny ciąg nieszczęść,\Nw który zostaliście wplątani...
Dialogue: 0,0:21:34.44,0:21:36.69,Main-207- PL,,0,0,0,,to wszystko wina Słomkowego!
Dialogue: 0,0:21:38.03,0:21:41.66,Main-207- PL,,0,0,0,,A tak przy okazji,\Nkim jest ta urocza niewiasta?
Dialogue: 0,0:21:42.36,0:21:46.33,Main-207- PL,,0,0,0,,Przed wami moja wybawicielka,\Nprzemiła kobieta, którą zowią...
Dialogue: 0,0:21:47.04,0:21:48.37,Main-207- PL,,0,0,0,,Tego...
Dialogue: 0,0:21:48.37,0:21:50.33,Main-207- PL,,0,0,0,,Ten, wybacz.
Dialogue: 0,0:21:50.33,0:21:52.54,Main-207- PL,,0,0,0,,Ale jak ci właściwie na imię?
Dialogue: 0,0:21:55.29,0:21:56.67,Main-207- PL,,0,0,0,,Słuchajcie!
Dialogue: 0,0:21:56.67,0:21:59.80,Main-207- PL,,0,0,0,,Piraci Buggy'ego wracają do akcji!
Dialogue: 0,0:22:01.88,0:22:05.51,Main-207- PL,,0,0,0,,Kapitanie! Dokąd powinniśmy się udać?
Dialogue: 0,0:22:05.51,0:22:09.93,Main-207- PL,,0,0,0,,Po głowę Monkey D. Luffy'ego!
